<article class="CutomerDetails">
    <div style="height:300px; overflow-y:scroll; overflow-x:hidden;">
    <div class="row">
        <div class="CustomerTwoColumn BorderColumn">
            <div class="CustomerColumnTitle">Customer Details</div>
            <div class="row">
                <div class="label">Card No/Type</div>
                <div class="label" style="display:inline; width:auto">
                    @Html.Label(string.IsNullOrWhiteSpace(Model.CardNumber) ? "-" : Model.CardNumber)
                    @Html.Label("/") 
                    @Html.Label(string.IsNullOrWhiteSpace(Model.CardTypeDesc) ? "-" : Model.CardTypeDesc)
                </div>
            </div>
            <div class="row">
                <div class="label">Application Ref.No./Slno</div>
                <div class="label" style="display:inline; width:auto">
                    @Html.Label(string.IsNullOrWhiteSpace(Model.ApplicationReferenceNo) == null ? "-" : Model.ApplicationReferenceNo)
                    @Html.Label("/")
                    @Html.Label(string.IsNullOrWhiteSpace(Model.SerialNo) == null ? "-" : Model.SerialNo)
                </div>
            </div>
            <div class="row">
                <div class="label">Name</div>
                <div class="label" style="display:inline; width:auto">
                    @Html.Label(string.IsNullOrWhiteSpace(Model.CustomerName) == null ? "-" : Model.CustomerName)
                </div>
            </div>
            <div class="row">
                <div class="label">Date of birth/Gender</div>
                <div class="label" style="display:inline; width:auto">
                    @Html.Label(Model.DateOfBirth == null ? "-" : Model.DateOfBirth.Value.ToShortDateString())
                    @Html.Label("/")
                    @Html.Label(Model.Gender)
                </div>
            </div>
            <div class="row">
                <div class="label">RUT</div>
                <div class="label" style="display:inline; width:auto">
                    @Html.Label(Model.RUT)               
                </div>
            </div>
