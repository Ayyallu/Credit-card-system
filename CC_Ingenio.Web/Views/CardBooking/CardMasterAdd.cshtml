</style>



<script type ="text/javascript">
    $(document).ready(function () {
        
        $('#RUT').mask('aaaaaaaaa-*');
        function loading() {
            $("div.loader").show();
        }

        var model = @Html.Raw(Json.Encode(Model));
        $("#btnSearch").click(function () {

            $.ajax({
                url: "/CardBooking/RUTCardNumberSearchList",
                type: "POST",
                data: { ARUT: "", ACardnumber: "", ACustomername: "", AAddonCardNumber: model["CardNumber"] },
                contenttype: "application/json ; charset = utf-8",
                success: function (data) {
                    $("#RUTSearchDiv").html(data);
                },
                error: function (ts) { alert(ts.responseText) }
            });

            loading(); // loading
            setTimeout(function () { // then show popup, deley in .5 second
                loadPopup(); // function show popup
            }, 500); // .5 second
        });

        function EnableDisableAccNoSearch() {
            if ($("#CardMemberType").val() != "A") {
                $("#btnSearch").attr('disabled', true);
                $("#btnSearch").removeClass('searchbutton').addClass('searchbuttondisabled');
            }
            else {
                $("#btnSearch").attr('disabled', false);
                $("#btnSearch").removeClass('searchbuttondisabled').addClass('searchbutton');
            };
        }

        $("#CardMemberType").change(function () {
            EnableDisableAccNoSearch();
        })

        EnableDisableAccNoSearch();
        

    })



</script>


