    List<SelectListItem> CardTypeItems = new List<SelectListItem>();
    List<SelectListItem> CardStatusItems = new List<SelectListItem>();
    List<SelectListItem> OrganizationItems = new List<SelectListItem>();
    List<SelectListItem> CountryItems = new List<SelectListItem>();
    List<SelectListItem> genderList = new List<SelectListItem>();
    List<SelectListItem> ProductList = new List<SelectListItem>();
    List<SelectListItem> AddressTypeList = new List<SelectListItem>();
    List<SelectListItem> ProductMemberTypeList = new List<SelectListItem>();
    List<SelectListItem> CustomerSegmentList = new List<SelectListItem>();
    List<SelectListItem> CustomerSubSegmentList = new List<SelectListItem>();
    List<string> lstPriv = new List<string>();
    
    foreach (var itm in ViewBag.CardType)
    {
        CardTypeItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }

    foreach (var itm in ViewBag.CardStatus)
    {
        CardStatusItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }

    foreach (var itm in ViewBag.Organization)
    {
        OrganizationItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }

    foreach (var itm in ViewBag.Country)
    {
        CountryItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }

    foreach (var item in ViewBag.GenderList)
    {
        genderList.Add(new SelectListItem { Text = item.Text, Value = item.Value });
    }

    foreach (var itm in ViewBag.Product)
    {
        ProductList.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }

    foreach (var itm in ViewBag.AddressType)
    {
        AddressTypeList.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }

    foreach (var itm in ViewBag.ProductMemberType)
    {
        ProductMemberTypeList.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }

    foreach (var itm in ViewBag.CustomerSegmentList)
    {
        CustomerSegmentList.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }

    foreach (var itm in ViewBag.CustomerSubSegmentList)
    {
        CustomerSubSegmentList.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }
    
    if (ViewBag.Privileges != null)
    {

        foreach (var item in ViewBag.Privileges)
        {
            lstPriv.Add(item);
        }
    }
    
    }

