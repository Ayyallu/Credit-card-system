
@using CC_Ingenio.Web.ViewModel.CardBooking;
@using CC_Ingenio_Resources;

@{
    ViewBag.Title = String.Concat(new object[] { Resources.CardEmbossing + " " + Resources.List });
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model CardEmbossingSearch
@{     
    var grid = new WebGrid(Model.SearchResults, canSort: false, canPage: true, rowsPerPage: CC_Ingenio.Common.Utils.Utils.GRD_ROWS_PER_PAGE);//selectionFieldName: "CardNumber", ajaxUpdateContainerId: "container-body");
    grid.Pager(WebGridPagerModes.All);
        
}

<script type="text/javascript">

    $(function () {
        $('.PagerLink').click(function () {

            $('form').attr('action', $(this).attr('href')).submit();
            return false;
        });
    });

    var index = 1;  

    $(document).ready(function () {

        $("#allBox").click(function () {
           
            var all = $(".select").attr("checked") ? true : false;
            $(".select").attr("checked", $(this).attr("checked") ? true : false);
            $.ajax({
                url: '/CardBooking/UpdatingSessionCardEmbossingCheckAll/',
                data: { ischecked: all },
                type: 'get',
                cache: false,
                contentType: 'application/json; charset=utf-8',
                success: function (data) {

                }
            });
        });

        $("input.select").each(function () {
            $(this).data('row', index);
            $(this).click(function () {


                var tr = $(this).parents('tr:first');

                var Name = tr.find("#Name").val();
                var CardNumber = tr.find("#CardNumber").text();

                var UserID = tr.find("#RUT").val();
                var Isprinted = tr.find("#IsPrinted").val();

                tr.find("#ISPrinted").text(Isprinted);

                var Isprinted = tr.find('#IsPrinted').attr('checked') ? "True" : "False";
                $.ajax({
                    url: '/CardBooking/UpdatingSessionCardEmbossingData/',
                    data: { CardNumber: CardNumber, ischecked: Isprinted },
                    type: 'get',
                    cache: false,
                    contentType: 'application/json; charset=utf-8',
                    success: function (data) {
                    }

                });
            });
            index++;
        });

        $("#Search").click(function () {           
            $.ajax({
                type: 'POST',
                url: '/CardBooking/CardEmbossingData',

                success: function (returnData) {
                    ShowSimpleModalDialog(returnData.Message, returnData.RedirectUrl);                   
                }
            });
            return true;
        });
    });

    function ClearSession() {
        $.ajax({
            type: 'POST',
            url: '/CardBooking/DeletingSessionCardEmbossingData',
            success: function (returnData) {
            }
        });
    };

</script>
<section class="featured">

    <div class="PageTitle">@ViewBag.Title</div>

    <div class="PageRow">

        <ul class="tabs-nav">
            <li>@Html.ActionLink(Resources.SearchPageHeading, "EmbossedSearchList", "CardBooking")</li>
            <li class="active">@Html.ActionLink(Resources.DetailsPageHeading, "CardEmbossingList", "CardBooking")</li>
        </ul>

        <div class="tabs-container">
            <div class="tab-content" id="tab1">
                <div class="row">
                    @using (Html.BeginForm("CardEmbossingList", "CardBooking", FormMethod.Get))
                    {                              
                        <div class="SearchBox">
                            <div class="row">
                                <div class="row">
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.RUT</div>
                                        <div class="Field">
                                            @Html.TextBoxFor(x => x.RUT, new { id = "RUT", maxlength = 9, @class="AlphaNumericOnly" })
                                        </div>
                                    </div>
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.CardNumber</div>
                                        <div class="Field">
                                            @Html.TextBoxFor(x => x.CardNumber, new { id = "CardNumber", maxlength = 16, @class = "NumericOnly" })
                                        </div>
                                    </div>
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.CustomerName</div>
                                        <div class="Field">
                                            @Html.TextBoxFor(x => x.Name, new { id = "Name", maxlength = 50 })
                                        </div>
                                    </div>
                                    <div class="TwoColumn">
                                        <div class="label">&nbsp</div>
                                        <div class="Field">&nbsp</div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="SearchColumnbtn">
                                        <div>
                                            <input id="SearchButton" name="SearchButton" class="Greenbutton" type="submit" value="@Resources.Search" onclick="ClearSession()" />
                                            <input id="ClearButton" name="ClearButton" class="Greenbutton" type="submit" value="@Resources.Clear" onclick="ClearSession()" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                                                     
                    }
                </div>
                <div class="row">

                    <div class="standard-table">
                        @MvcHtmlString.Create(grid.GetHtml(alternatingRowStyle: "alt", columns: grid.Columns(
                         grid.Column(columnName: "IsPrinted", header: "{CheckBoxHeading}",
                            format:
                        (item) => @Html.Raw("<input type='checkbox' class = 'select' id='IsPrinted'  " + (((item.Value).IsPrinted == 1) ? "checked" : "") + " />")),
                            grid.Column("Name", Resources.CustomerName),
                            grid.Column("RUT", Resources.RUT),
                            grid.Column("CardNumber", Resources.CardNumber, format: @<text><label id="CardNumber" style="font-size: .95em; font-family: 'Segoe UI', 'Verdana', 'Helvetica', 'Sans-Serif';">@item.CardNumber</label>
                        </text>),
                                         grid.Column("ProductName", Resources.ProductName)

                                      )).ToString().Replace("{CheckBoxHeading}", "<input type='checkbox' id='allBox'/>"))
                    </div>
                </div>

                <div class="row">
                    <div class="SearchColumnbtn">
                        <input id="Search" name="" value="@Resources.Submit" type="submit" class="Greenbutton" style="float: right;" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
