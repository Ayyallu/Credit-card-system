@using CC_Ingenio.Web.ViewModel.CardBooking;
@using CC_Ingenio_Resources;

@{
    ViewBag.Title = String.Concat(new object[] { Resources.CardEmbossing + " " + Resources.Search });
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@model CardEmbossingFetch
@{     
   
    var grid = new WebGrid(Model.SearchResults, canSort: false, canPage: true, rowsPerPage: CC_Ingenio.Common.Utils.Utils.GRD_ROWS_PER_PAGE, selectionFieldName: "", ajaxUpdateContainerId: "container-body");
   
    grid.Pager(WebGridPagerModes.All);
        
    }

<section class="feature">

    <div class="PageTitle">@ViewBag.Title</div>

    <!-- Tabs
	================================================== -->

    <div class="PageRow">

        <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            <li class="active">@Html.ActionLink(Resources.SearchPageHeading,"EmbossedSearchList","CardBooking" )</li>
            <li> @Html.ActionLink(Resources.DetailsPageHeading,"CardEmbossingList","CardBooking" )</li>
        </ul>

        <!-- Tabs Content -->
        <div class="tabs-container">
            <div class="tab-content" id="tab1">
                <div class="row">   
                    @using (Html.BeginForm("EmbossedSearchList", "CardBooking", FormMethod.Get))   
                    {      
                        
                        <div class="SearchBox">
                            <div class="row">
                                <div class="row">
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.RUT</div>
                                        <div class="Field">
                                            @Html.TextBoxFor(x => x.RUT, new { id = "RUT", @class = "AlphaNumericOnly", maxlength = 9 })
                                        </div>
                                    </div>
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.CardNumber</div>
                                        <div class="Field">
                                            @Html.TextBoxFor(x => x.CardNumber, new { id = "CardNumber", @class = "NumericOnly", maxlength = 16 })
                                        </div>
                                    </div>
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.CustomerName</div>
                                        <div class="Field">
                                            @Html.TextBoxFor(x => x.CustomerName, new { id = "CustomerName", maxlength = 50 })
                                        </div>
                                    </div>
                                    <div class="TwoColumn">
                                        <div class="label">&nbsp</div>
                                        <div class="Field">&nbsp</div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="SearchColumnbtn">
                                        <span>
                                            <input id="SearchButton" name="SearchButton" class="Greenbutton" type="submit" value="@Resources.Search" />
                                        </span>                                      
                                        <span>
                                            <input id="ClearButton" name="ClearButton"  type="submit" class="Greenbutton" value="@Resources.Clear" />
                                        </span>
                                    </div>  
                                </div>                              
                            </div>
                            <div class="clear"></div>
                        </div>                                                     
                    }
                </div>
                <div class="row">
                   
                              <div class="standard-table">
                        @grid.GetHtml(alternatingRowStyle: "alt", columns:grid.Columns(
                                                  
                            grid.Column("CustomerName", Resources.CustomerName),            
                            grid.Column("RUT",Resources.RUT, format: @<text><label id="RUT" style="font-size: .95em;font-family: 'Segoe UI', 'Verdana', 'Helvetica', 'Sans-Serif';">@item.MaskedRUT</label> </text>),
                            grid.Column("CardNumber", Resources.CardNumber, format: @<text><label id="CardNumber" style="font-size: .95em;font-family: 'Segoe UI', 'Verdana', 'Helvetica', 'Sans-Serif';">@item.CardNumber</label> </text>) ,                       
                            grid.Column("ProductName", Resources.ProductName),
                            grid.Column(Resources.EmbossedKit, format: 
                                        (item) =>
                                            {
                                                return Html.Raw(Html.Raw(Html.ActionLink(Resources.View, "ViewAttachment", "CardBooking", new { AFileName = item.EmbossedKitFileName, AType = "pdf" }, new { target = "_blank"})));
                                            }),
                            grid.Column(Resources.EmbossedFile, format: 
                                        (item) =>
                                            {
                                                return Html.Raw(Html.Raw(Html.ActionLink(Resources.View, "ViewAttachment", "CardBooking", new { AFileName = item.EmbossedFileName ,AType = "txt"}, new { target = "_blank"})));
                                            })
                            
                         ))
                                  
                    </div>
                </div>

            </div>


        </div>

    </div>

</section>

