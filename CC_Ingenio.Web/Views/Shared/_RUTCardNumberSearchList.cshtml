@using CC_Ingenio.DataTranfer.MasterInfo;
@using CC_Ingenio_Resources;


@model List<RUTCardNumberSearchDTO>
@{
    var resultGrid = new WebGrid(Model, canPage: true, rowsPerPage: 10, selectionFieldName: "", ajaxUpdateContainerId: "container-body");
    resultGrid.Pager(WebGridPagerModes.All);
}
<script>
    var isParentCustomerSearch;
    var model;
   
    $("div.close").hover(
                  function () {
                      $('span.ecs_tooltip').show();
                  },
                  function () {
                      $('span.ecs_tooltip').hide();
                  }
              );

    $("div.close").click(function () {
        disablePopup();  // function close pop up
    });

    $(this).keyup(function (event) {
        if (event.which == 27) { // 27 is 'Ecs' in the keyboard
            disablePopup();  // function close pop up
        }
    });


    /************** start: functions. **************/
    function loading() {
        $("div.loader").show();
    }
    function closeloading() {
        $("div.loader").fadeOut('normal');
    }

    var popupStatus = 0; // set value

    function loadPopup() {
        if (popupStatus == 0) { // if value is 0, show popup
            closeloading(); // fadeout loading
            $("#divPopup").fadeIn(0500); // fadein popup div
            $("#backgroundPopup").css("opacity", "0.7"); // css opacity, supports IE7, IE8
            $("#backgroundPopup").fadeIn(0001);
            popupStatus = 1; // and set value to 1
        }
    }

    function disablePopup() {

            if (popupStatus == 1) { // if value is 1, close popup
            $("#divPopup").fadeOut("normal");
            $("#backgroundPopup").fadeOut("normal");
            popupStatus = 0;  // and set value to 0           
        }
    }


    $('#SearchButton').click(function () {
        
        if ($('#RUT').val() == '' && $('#CardNumber').val() == '' && $('#CustomerName').val() == ''){
            $('#lblCriteria').text("@Html.Raw(Resources.MsgErrAnySearchCriteria)");
            return false;
        };

        var RUT = $('#RUT').val();
        var CardNumber = $('#CardNumber').val();
        var CustomerName = $('#CustomerName').val();



        if('@TempData["isParentCustomerSearchForTransaction"]' == 'True'){             
            $.ajax({
                url: '/Billing/GetParentCustomersForTransaction/',
                type: 'GET',
                data: { ARUT: RUT, ACardnumber: CardNumber, ACustomername: CustomerName ,IsLoading: true },  
                dataType: 'html',
                success: function (data) {
                    if (data.length > 0) {
                        $('#RUTCardNumberSearchDiv').html(data);
                        //$('#RUT').val(RUT);
                        //$('#CardNumber').val(CardNumber);
                        //$('#CustomerName').val(CustomerName);
                    }
                }
            });
        }
        else{
            $.ajax({
                url: '/Master/RUTCardNumberSearchList/',
                type: 'GET',
                data: { ARUT: RUT, ACardnumber: CardNumber, ACustomername: CustomerName, AIsLoading: true, AIsParentCustomerSearch: isParentCustomerSearch },
                dataType: 'html',
                success: function (data) {
                    if (data.length > 0) {
                        $('#RUTCardNumberSearchDiv').html(data);

                        //$('#RUT').val(RUT);
                        //$('#CardNumber').val(CardNumber);
                        //$('#CustomerName').val(CustomerName);
                    }
                }
            });
        }

        loading(); // loading
        setTimeout(function () { // then show popup, deley in .5 second
            loadPopup(); // function show popup
        }, 500); // .5 second        
    });
    $('#ClearButton').click(function () {
        $('#RUT').val("");
        $('#CardNumber').val("");
        $('#CustomerName').val("");
        //$('#SearchButton').click();
        $('#lblCriteria').text("");
    });

    $('body').on('dblclick', 'table tbody tr', function (event) {
       
        var row = $(event.target).closest('tr');
        var rowIndex = $(this).index();       
        //Finding the page index
        var pageIndex = parseInt($('tfoot td').clone().children('a').remove().end().text().trim(),10); 
        if(pageIndex = "NaN") // when there are no pages
        {
            pageIndex = 1;
        }
        var rowCurrentIndex = ((pageIndex - 1) * 10) + rowIndex;       
        var count = (@Html.Raw(Json.Encode(Model.Count )));    
        
@*        var model = @Html.Raw(serializer.Serialize(Model));*@

        var model =    @Html.Raw(Json.Encode(Model));

        // cell values       
        if(count != "0")
        {           
            var CustomerName = row.find('td:eq(0)').text();
            var RUT = row.find('td:eq(1)').text();
            var CardNumber =  row.find('td:eq(3)').text();
            var AccountNumber = row.find('td:eq(4)').text();
        
            var CustomerSegmentCode = model[rowCurrentIndex]["CustomerSegmentCode"];
            var CustomerSubSegmentCode = model[rowCurrentIndex]["CustomerSubSegmentCode"];
            var OrganizationCode = model[rowCurrentIndex]["OrganizationCode"];
            var ProductCode = model[rowCurrentIndex]["ProductCode"];
            var CustomerId = model[rowCurrentIndex]["CustomerId"];
            var SalesId = model[rowCurrentIndex]["SalesId"];
        
            var parentForm = $('input[type=text]').closest("form").parent();
        
            parentForm.find('input[name=RUT]').val(RUT);
            parentForm.find('input[name=CardNumber]').val(CardNumber);
            parentForm.find('input[id=CardNumberNew]').val(CardNumber);
            parentForm.find('input[id=SalesId]').val(SalesId);
            //parentForm.find('input[id=CardNumberNew]').val(CardNumber);
            parentForm.find('input[name=AccountNo]').val(AccountNumber);
            parentForm.find('select[name=CustomerSegmentCode]').val(CustomerSegmentCode);
            parentForm.find('select[name=CustomerSubSegmentCode]').val(CustomerSubSegmentCode);
            parentForm.find('select[name=OrganizationCode]').val(OrganizationCode);
            parentForm.find('select[name=ProductCode]').val(ProductCode);
            parentForm.find('input[name=CustomerName]').val(CustomerName);
       
            parentForm.find('input[id=hidCustomerSegmentCode]').val(CustomerSegmentCode);
            parentForm.find('input[id=hidCustomerSubSegmentCode]').val(CustomerSubSegmentCode);
            parentForm.find('input[id=hidOrganizationCode]').val(OrganizationCode);
            parentForm.find('input[id=hidProductCode]').val(ProductCode);
       
            parentForm.find('input[id=hidParentCustomerId]').val(CustomerId);
            parentForm.find('input[id=ParentCustomerName]').val(CustomerName);
            parentForm.find('input[name=CardNumber]').focus();

            parentForm.find('input[id=CustCardNumber]').val(CardNumber);
            var splitRUT = RUT.split('-');
            parentForm.find('input[id=CustRUT]').val(splitRUT[0]);
            parentForm.find('input[id=CustCheckDigit]').val(splitRUT[1]);

            //alert(parentForm.find('input[id=hidCustomerId]').val());
            //alert(parentForm.find('input[id=CustomerName]').val());
            popupStatus = 1;
            disablePopup();
        }
    });
  


    $(document).ready(function(){         
        $(function(){

            $('#RUT').focusin(function () {
                $('#lblCriteria').text("");
            });
            $('#CardNumber').focusin(function () {
                $('#lblCriteria').text("");
            });
            $('#CustomerName').focusin(function () {
                $('#lblCriteria').text("");
            });

            if('@TempData["isParentCustomerSearch"]' == 'True'){                
                isParentCustomerSearch = true;                 
            }
            else{
                isParentCustomerSearch = false;         
            }
        });
    });


</script>
