@using CC_Ingenio.DataTranfer.ApprovalQueueInfo;
@using CC_Ingenio_Resources;
@using System.Web.Script.Serialization;
@{
    
    bool ApproveAll = ViewBag.RequestQueueId == null ? false : true;
    
    List<SelectListItem> ResonContextItems = new List<SelectListItem>();
    if (ViewBag.ReasonCodes != null)
    {
        foreach (var itm in ViewBag.ReasonCodes)
        {
            ResonContextItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
        }
    }
    else
    {
        ResonContextItems.Add(new SelectListItem { Text = Resources.SelectOne, Value = "" });
    }

       @*<link href="~/Content/PopUpStyle.css" rel="stylesheet" />*@
    @*<script src="~/Scripts/PopUpScript.js"></script>*@    
    
<script type="text/javascript">
    var ReasonContextList = @Html.Raw(new JavaScriptSerializer().Serialize(ResonContextItems));
</script>           
<script>

    $(document).ready(function () {


        $('input:hidden[name="ContextCode"]').val('@TempData["ContextCode"]');

        $('#href2').click(function (event) {           
            //event.preventDefault();
            //$(this).closest('form').submit();
            //$('#frmApprovalAll').submit();
            //$(this).closest('form').submit();
            //alert($(this).closest('form'));

            var form = $("#frmApprovalAll").serialize();
            
            $("#toPopupAuthorizeAll").fadeOut("normal");
            $("#backgroundPopup").fadeOut("normal");


            $.ajax({
                url: '/Approval/RequestAuthorizeAll/',
                data: form,
                type: 'POST',
                cache: false,
                success: function (data) {
                    //ShowMessage(data.RedirectUrl, data.Message);
                    document.location.href = "ApprovalQueueList";
                }
            });

           
            //$.ajax({
            //    type: 'POST',
            //    url: "/Approval/RequestAuthorizeAll",
            //    data: form,
            //    dataType: 'json',
            //    success: function (data) {
            //        if (data.result == "Error") {
            //            alert(data.message);
            //        }
            //        alert(hai);
            //    }
            //});


        });


        $('#ContextDesc2').focusin(function () {
            $('#ContextDesc_validate2').text("");
        });
        $('#ReasonCode2').focusin(function () {
            $('#ReasonCode_validate2').text("");
        });

        $("input[name=ApprovalOption1]:radio").change(function () {

            var objReasonCode = $('#ReasonCode2');
            objReasonCode.empty();

            objReasonCode.append($('<option/>',
              {
                  value: "",
                  text: "@Resources.SelectOne"
              }));

            if ($('input:radio[name=ApprovalOption1]:checked').val() == 'Approve') {

                $.each(ReasonContextList, function (index, itemData) {
                
                    if (itemData["Value"].substring(itemData["Value"].length - 1) == "A") {
                        objReasonCode.append($('<option/>',
                                {
                                    value: itemData.Value,
                                    text: itemData.Text
                                }));
                    }
                });
            }
            else if ($('input:radio[name=ApprovalOption1]:checked').val() == 'Reject') {
                $.each(ReasonContextList, function (index, itemData) {
                    if (itemData["Value"].substring(itemData["Value"].length - 1) == "R") {
                        objReasonCode.append($('<option/>',
                                {
                                    value: itemData.Value,
                                    text: itemData.Text
                                }));
                    }
                });
            }
            else if ($('input:radio[name=ApprovalOption1]:checked').val() == 'Discard') {
                $.each(ReasonContextList, function (index, itemData) {
                    if (itemData["Value"].substring(itemData["Value"].length - 1) == "D") {
                        objReasonCode.append($('<option/>',
                                {
                                    value: itemData.Value,
                                    text: itemData.Text
                                }));
                    }
                });
            }
        });
        $('input:radio[name=ApprovalOption1]:checked').trigger("change");


        /* event for close the popup */
        $("div.close").hover(
                        function () {
                            $('span.ecs_tooltip').show();
                        },
                        function () {
                            $('span.ecs_tooltip').hide();
                        }
                    );

        $("div.close").click(function () {
            $("#toPopupAuthorizeAll").fadeOut("normal");
            $("#backgroundPopup").fadeOut("normal");
        });

        /************** start: functions. **************/
        //function loading() {
        //    $("div.loader").show();
        //}
        //function closeloading() {
        //    $("div.loader").fadeOut('normal');
        //}

        //var popupStatus = 0; // set value

        //function loadPopup() {
        //    if (popupStatus == 0) { // if value is 0, show popup
        //        closeloading(); // fadeout loading
        //        $("#toPopupAuthorizeAll").fadeIn(0500); // fadein popup div
        //        $("#backgroundPopup").css("opacity", "0.7"); // css opacity, supports IE7, IE8
        //        $("#backgroundPopup").fadeIn(0001);
        //        popupStatus = 1; // and set value to 1
        //    }
        //}

        //function disablePopup() {
        //    if (popupStatus == 1) { // if value is 1, close popup
        //        $("#toPopupAuthorizeAll").fadeOut("normal");
        //        $("#backgroundPopup").fadeOut("normal");
        //        popupStatus = 0;  // and set value to 0
        //        $('#ContextDesc_validate2').text("");
        //        $('#ReasonCode_validate2').text("");
        //    }
        //}
        /************** end: functions. **************/

        
        //$("div.close").click(function () {
        //    disablePopup();  // function close pop up
        //});

        $(this).keyup(function (event) {
            if (event.which == 27) { // 27 is 'Ecs' in the keyboard
                $("#toPopupAuthorizeAll").fadeOut("normal");
                $("#backgroundPopup").fadeOut("normal");
            }
        });

        



    });
</script>    
    
    <div id="divApprovalAll">
       
                 <div id="toPopupAuthorizeAll" class="Popup">
                    <div class="close"></div>
                    <span class="ecs_tooltip">@Resources.PressEsctoclose <span class="arrow"></span></span>
                        <div id="popup_content">
                            @using (Html.BeginForm("RequestAuthorizeAll", "Approval", FormMethod.Post, new { id = "frmApprovalAll", name = "frmApprovalAll" }))
                            {
                                  <fieldset class="authorize">
                                    <legend>@Resources.Authorize</legend>
                                    <div class="PageRowPopup">
                                        <div class="row">
                                            <div class="left;"></div>
                                            <div class="left;"></div>
                                            <label class="popupauthorize" for="Approve">@Resources.Approve @Html.RadioButton("ApprovalOption1", true, true, new { @name = "ApprovalOption1", @id = "Approve", @Value = "Approve" }) </label>
                                            <label class="popupauthorize" for="Reject">@Resources.Reject  @Html.RadioButton("ApprovalOption1", false, false, new { @name = "ApprovalOption1", @id = "Reject", @Value = "Reject" })</label>
                                           <label class="popupauthorize" for="Discard">@Resources.Discard  @Html.RadioButton("ApprovalOption1", false, false, new { @name = "ApprovalOption1", @id = "Discard", @Value = "Discard" })</label>
                                        </div>
                                            <div class="row">
                                            <div class="label">@Resources.Reason</div>
                                            <div class="Field" style="float: left;">
                                                @Html.DropDownList("ReasonCode", new List<SelectListItem>(), new { @id = "ReasonCode2", @name = "ReasonCode2" })
                                                <label id="ReasonCode_validate2" style="color: red ;font-size: .95em;" class="validation"></label>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="label">&nbsp;</div>
                                            <div class="Field">@Html.TextArea("ReasonDescription", new { @id = "ContextDesc2", @name = "ContextDesc2", @class = "required", maxlength = 50 })
                                                <label id="ContextDesc_validate2" style="color: red ;font-size: .95em;" class="validation"></label>
                                            </div>
                                            @Html.Hidden("ContextCode")
                                        </div>
                                        <div class="PageRowPopupBtn">
                                            <a href="#" id="href2">@Resources.Submit</a>

                                        </div>
                                    </div>
                                </fieldset>       
                            }
                        </div>
                 </div>
        
                <div class="loader"></div>
                <div id="backgroundPopup"></div>
    </div>
    
}

