                            unbilledTransactionGrid.Column("TransactionAmount",Resources.TransactionAmount,format:@<text> @String.Format("{0:N0}",item.TransactionAmount)</text>, style: "gridColAmount"),
                      //  unbilledTransactionGrid.Column("AmountCancelled",Resources.AdjustedAmount,format:@<text> @String.Format("{0:N0}",item.AmountCancelled)</text>, style: "gridColAmount"),
                            unbilledTransactionGrid.Column("TransactionDate",Resources.TransactionDate,format:@<text>@item.TransactionDate.ToShortDateString()</text>, style: "gridColWidthMedium")                           
                       // unbilledTransactionGrid.Column("AdjustedDate",Resources.AdjustmentDate,format:@<text>@item.AdjustedDate.ToShortDateString()</text>, style: "gridColWidthMedium")    ,                       
                      
                         // unbilledTransactionGrid.Column("Remarks",Resources.AdjustmentNarration , style: "gridColWidthMedium")                                 
                            
