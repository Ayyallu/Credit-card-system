                                    unbilledTransactionGrid.Column("ReferenceNo", Resources.ReferenceNo),
                                    unbilledTransactionGrid.Column("TransactionDate", Resources.TransactionDate, format: @<text>@item.TransactionDate.ToShortDateString()</text>),
                                    unbilledTransactionGrid.Column("TransactionAmount", Resources.TransactionAmount, format: @<text> @String.Format("{0:N0}", item.TransactionAmount)</text>),
