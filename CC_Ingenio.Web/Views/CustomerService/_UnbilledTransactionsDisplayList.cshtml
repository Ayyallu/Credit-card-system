@using CC_Ingenio_Resources;
@using CC_Ingenio.DataTranfer.CustomerServiceInfo;
@model List<UnbilledTransactionsDTO>  
@{
    var unbilledTransactionGrid = new WebGrid(Model, canPage: true, rowsPerPage: 5, ajaxUpdateContainerId: "container-body");
    unbilledTransactionGrid.Pager(WebGridPagerModes.All);
}
<style>
.gridColWidthMedium
    {
        width: 14%;
        text-align:center;
    }
.gridColWidthShort
    {
        width: 5%;
        text-align:center;
    }
.gridColAmount
    {
        width: 20%;
        text-align:right;
    }
</style>

<div class="row">
        <div class=" BorderColumn" style="width: 98.6%">
             @if (ViewBag.TransactionType == "UnbilledPurchase")
                { 
                    <div class="CustomerColumnTitle">@Resources.UnbilledPurchaseDetails</div>
                    <div style="width:100%; overflow:scroll">
                    <div class="standard-table"> 
               
                             @unbilledTransactionGrid.GetHtml(htmlAttributes: new {  id = "container-body" },
                             alternatingRowStyle: "alt", 
                             columns:unbilledTransactionGrid.Columns(
                                    unbilledTransactionGrid.Column("InvoiceNo",Resources.InvoiceNo),
                                    unbilledTransactionGrid.Column("TransactionDate",Resources.TransactionDate,format:@<text>@item.TransactionDate.ToShortDateString()</text>),
                                    unbilledTransactionGrid.Column("MerchantName",Resources.MerchantName),
                                    unbilledTransactionGrid.Column("TransactionAmount",Resources.TransactionAmount,format:@<text> @String.Format("{0:N0}",item.TransactionAmount)</text>)
                                    //unbilledTransactionGrid.Column("AmountCancelled",Resources.AmountCancelled,format:@<text> @String.Format("{0:N0}",item.AmountCancelled)</text>)
                                ))
                    </div>
                    </div>
                }
             else if (ViewBag.TransactionType == "UnbilledCreditNote")
