                                    unbilledTransactionGrid.Column("RevolvingServiceTax",Resources.RevolvingServiceTax,format:@<text> @String.Format("{0:N0}",item.RevolvingServiceTax)</text>),
                                    unbilledTransactionGrid.Column("DelinquencyServiceTax",Resources.DelinquencyServiceTax,format:@<text> @String.Format("{0:N0}",item.DelinquencyServiceTax)</text>)
                                    
