@using CC_Ingenio_Resources;
@using CC_Ingenio.Web.ViewModel.CustomerService;
@{
    ViewBag.Title = String.Concat(new object[] { Resources.Customer + " " + Resources.Search });
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model CustomerServiceViewModel
@{
    var resultGrid = new WebGrid(Model.SearchResults, canPage: true, rowsPerPage: CC_Ingenio.Common.Utils.Utils.GRD_ROWS_PER_PAGE, selectionFieldName: "", ajaxUpdateContainerId: "container-body");
    resultGrid.Pager(WebGridPagerModes.All);
}

<section class="featured">
    <div class="PageTitle">@ViewBag.Title</div>
    <div class="PageRow">
        <div id="RUTCardNumberSearchDiv"></div>
        <div class="tabs-container">
            <div class="tab-content" id="tab1">
                <div class="row">
                    @using (Html.BeginForm("CustomerServiceSearch", "CustomerService", FormMethod.Get, new { id = "frmSearch" }))
                    {
                        <div class="SearchBox">
                            <div class="row">                                   
                                <div class="row">
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.RUT</div>
                                        <div class="Field">                                                                                     
                                            @Html.TextBoxFor(x => x.RUT, new { id = "RUT", @class = "NumberHyphen", maxlength = 11 })
                                        </div>
                                    </div>
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.CardNumber</div>
                                        <div class="Field">
                                            @Html.TextBoxFor(x => x.CardNumber, new { id = "CardNumber", @class = "NumericOnly", maxlength = 16 })
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.CustomerName</div>
                                        <div class="Field">
                                            @Html.TextBoxFor(x => x.CustomerName, new { id = "CustomerName", maxlength = 50 })
                                        </div>
                                    </div>
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.SalesId</div>
                                        <div class="Field">
                                            @Html.TextBoxFor(x => x.SalesId, new { id = "SalesId", @class = "NumericOnly", maxlength = 8 })
                                        </div>
                                    </div>
                                </div>
                                <div class="SearchColumnbtn">
                                        <div>
                                            <input id="SearchButton" name="SearchButton" class="Greenbutton" type="submit" value="@Resources.Search" />
                                            <input id="ClearButton" name="ClearButton" class="Greenbutton" type="submit" value="@Resources.Clear" />
                                        </div>
                                    </div>                                
                            </div>
                             <div class="clear"></div>
                        </div>   
                    }
                </div>
                <div class="row">
                    <div class="standard-table">
                       
                        @resultGrid.GetHtml(//htmlAttributes: new { id = "container-body" },
                                alternatingRowStyle: "alt",
                                columns: resultGrid.Columns(
                                    resultGrid.Column("CustomerName", Resources.CustomerName),
                                    resultGrid.Column("MaskedRUT", Resources.RUT),
                                    resultGrid.Column("SalesId", Resources.SalesId),                                    
                                    resultGrid.Column("CardNumber", Resources.CardNumber),                                   
                                    resultGrid.Column("AccountNumber", Resources.AccountNumber),
                                        resultGrid.Column("ProductMemberTypeDesc", Resources.ProductMemberType),
                                    resultGrid.Column("", format: (item) =>
                                    {
                                        return Html.Raw(Html.Raw(Html.ActionLink(Resources.View, "GetCustomerServiceDetails", "CustomerService", new { ACardNumber = item.CardNumber }, null)));
                                    })
                                ))
                    </div>                  
                    @if (Model.SearchResults.Count == 0 && !(string.IsNullOrEmpty(Model.SearchButton)))
                    {
                         @Html.Label(Resources.MsgErrNoRecordsFound,new { @class = "validationMessage"})
                    }
                </div>
            </div>
        </div>
    </div>
</section>


