@using CC_Ingenio.DataTranfer.CustomerServiceInfo;
@using System.Web.Script.Serialization;
@using CC_Ingenio.Web.Helpers;
@using CC_Ingenio_Resources;
@model CardClosureDTO  
@{
    List<SelectListItem> closureReasonList = new List<SelectListItem>();
    foreach (var item in ViewBag.ClosureReasonList)
    {
        closureReasonList.Add(new SelectListItem()
        {
            Text = item.Text,
            Value = item.Value
        });
    }
    List<string> lstPriv = new List<string>();
    if (ViewBag.Privileges != null)
    {

        foreach (var item in ViewBag.Privileges)
        {
            lstPriv.Add(item);
        }
    }
}

<link href="~/Content/PopUpStyle.css" rel="stylesheet" />
    <script src="~/Scripts/PopUpScript.js"></script>  
<script type="text/javascript">

    $("div.close").hover(
					function () {
					    $('span.ecs_tooltip').show();
					},
					function () {
					    $('span.ecs_tooltip').hide();
					}
				);

    $("div.close").click(function () {
        disablePopup();  // function close pop up
    });

    $(this).keyup(function (event) {
        if (event.which == 27) { // 27 is 'Ecs' in the keyboard
            disablePopup();  // function close pop up
        }
    });


    /************** start: functions. **************/
    function loading() {
        $("div.loader").show();
    }
    function closeloading() {
        $("div.loader").fadeOut('normal');
    }

    var popupStatus = 0; // set value

    function loadPopup() {
        if (popupStatus == 0) { // if value is 0, show popup
            closeloading(); // fadeout loading
            $("#divPopup").fadeIn(0500); // fadein popup div
            $("#backgroundPopup").css("opacity", "0.7"); // css opacity, supports IE7, IE8
            $("#backgroundPopup").fadeIn(0001);
            popupStatus = 1; // and set value to 1
        }
    }

    function disablePopup() {
        if (popupStatus == 1) { // if value is 1, close popup
            $("#divPopup").fadeOut("normal");
            $("#backgroundPopup").fadeOut("normal");
            popupStatus = 0;  // and set value to 0
        }
    }

    $(document).ready(function () {

        $('#View').click(function (event) {
           
            var CardNumber = $('#CardNumber').val();
            var CustomerId = $('#CustomerId').val();

            $.ajax({
                url: '/CustomerService/CardClosureSearchList/',
                type: 'GET',
                data: { ACardNumber: CardNumber, ACustomerId: CustomerId },
                dataType: 'html',
                success: function (data) {
                    //alert(data)
                    if (data.length > 0) {
                        $('#HistoryDiv').html(data);
                    }
                }
            });
            loading(); // loading
            setTimeout(function () { // then show popup, deley in .5 second
                loadPopup(); // function show popup
            }, 500); // .5 second
        });

        $("#ClosuredDate").datepicker({
            changeYear: true,
            changeMonth: true,
            yearRange: '2000:2020',
            dateFormat: "@Resources.FormatDateJS",
            numberOfMonths: 1                        
        });

        $('#Save').click(function (e) {
            e.preventDefault();
       
            $.ajax({
                url: '/CustomerService/SaveClosureInitiation/',
                type:'POST',
                data: $('#frmCardClosureInitiation').serialize(),
                cache:false,
                success: function (data) {
                    @*//alert('@Model.IsSaved')*@
                    if (data != 'Undefined')
                    {
                        $('#partialViewDiv').html(data);
                        @*//alert('@Model.IsSaved')*@
                    }
                }
            });
            
        });

        if ('@Model.IsSaved' == 'True') {
            ShowSimpleModalDialog("@Html.Raw(string.Format(Resources.MsgInfoSaveSuccess,""))", "");
            $("#Save").attr('disabled', true);
            $("#Save").removeClass('Greenbutton').addClass('BtnDisabled');
        }     

        $('input[id="New"]').hide();
        $('input[id="Submit"]').hide();
        $('input[id="Delete"]').hide();
       
    });
</script>
<div id="HistoryDiv"></div>
<div class="row">
    <div class="BorderColumn" style="width: 98.6%">
        <div class="CustomerColumnTitle">@Resources.CardClosureInitiation</div>
        @using (Html.BeginForm("", "", FormMethod.Post, new { id = "frmCardClosureInitiation", Name = "frmCardClosureInitiation", @style = "height: 220px;" }))
        {                              
            <div class="row">
                <div class="row">
                    <div class="row">
                        <div class="TwoColumn">
                            <div class="label">@Resources.ClosureReason</div>
                            <div class="Field">
                                @Html.DropDownListFor(x => x.ClosureReasonCode, closureReasonList, new { id = "ClosureReasonCode" })
                                @Html.ValidationMessageFor(x => x.ClosureReasonCode, "", new { id = "Validation_MessageType" })
                            </div>
                        </div>
                        <div class="TwoColumn">
                            <div class="label">@Resources.ClosureDate</div>
                            <div class="Field">
                                @Html.TextBoxFor(x => x.ClosuredDate, new { id = "ClosuredDate", name = "ClosuredDate", @readonly = "readonly" ,Value = Model.ClosuredDate.ToShortDateString()})
                                @Html.ValidationMessageFor(x => x.ClosuredDate)
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="TwoColumn">
                            <div class="label">@Resources.CurrentBalance</div>
                            <div class="Field">
                                @Html.TextBoxFor(x => x.CurrentBalance, String.Format("{0:N0}", Model.CurrentBalance), new { id = "CurrentBalance", name = "CurrentBalance", @readonly = "readonly" })
                            </div>
                        </div>
                        <div class="TwoColumn">
                            <div class="label ">@Resources.Memo</div>
                            <div class="Field">
                                @Html.TextAreaFor(x => x.Remarks, new { id = "Remarks", name = "Remarks", maxlength = 500 })
                                @Html.ValidationMessageFor(x => x.Remarks, "", new { id = "Validation_MessageType" })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="TwoColumn">
                            <div class="label ">@Resources.DocumentsReceived</div>
                            <div>
                                @Html.CheckBoxFor(x => x.IsDocumentReceived, new { id = "IsDocumentReceived", name = "IsDocumentReceived" })
                            </div>
                        </div>
                        <div class="TwoColumn">
                            <div class="label">@Resources.CardReceived</div>
                            <div>
                                @Html.CheckBoxFor(x => x.IsCardReceived, new { id = "IsCardReceived", name = "IsCardReceived" })
                            </div>

                        </div>
                    </div>
                </div>
                <div>
                    @Html.HiddenFor(x => x.CardNumber)
                    @Html.HiddenFor(x => x.CustomerId)
                </div>
            </div>
            
            <div class="row">
                <div class="rowbtn" style="float: right; width: 5%">
                    <input type="button" class="Greenbutton" id="View" value=@Resources.View style="width: 100%" /></div>
                <div style="float: right; width: 92%">@Html.Raw(Html.BasicButtons(lstPriv))</div>
            </div>
        }
    </div>
</div>
<script>
    $(function () {
        if ('@ViewData["FormCall"]' != "ApprovalQueue") {
            DisableBtnAuthorize();
        }

        if ('@Model.IsActive' == 'True') {            
            $("#Save").attr('disabled', true);
            $("#Save").removeClass('Greenbutton').addClass('BtnDisabled');
        }
    })
</script>

