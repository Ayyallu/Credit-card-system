@using CC_Ingenio.DataTranfer.CustomerServiceInfo;
@using CC_Ingenio_Resources; 
@model List<CardClosureHistoryDTO>
@{
    
    var resultGrid = new WebGrid(Model, canPage: true, rowsPerPage: 5, selectionFieldName: "", ajaxUpdateContainerId: "container-body");
    resultGrid.Pager(WebGridPagerModes.All);
}
<script>
    $("div.close").hover(
                  function () {
                      $('span.ecs_tooltip').show();
                  },
                  function () {
                      $('span.ecs_tooltip').hide();
                  }
              );

    $("div.close").click(function () {
        disablePopup();  // function close pop up
    });

    $(this).keyup(function (event) {
        if (event.which == 27) { // 27 is 'Ecs' in the keyboard
            disablePopup();  // function close pop up
        }
    });


    /************** start: functions. **************/
    function loading() {
        $("div.loader").show();
    }
    function closeloading() {
        $("div.loader").fadeOut('normal');
    }

    var popupStatus = 0; // set value

    function loadPopup() {

        if (popupStatus == 0) { // if value is 0, show popup
            closeloading(); // fadeout loading
            $("#divPopup").fadeIn(0500); // fadein popup div
            $("#backgroundPopup").css("opacity", "0.7"); // css opacity, supports IE7, IE8
            $("#backgroundPopup").fadeIn(0001);
            popupStatus = 1; // and set value to 1
        }
    }

    function disablePopup() {

            if (popupStatus == 1) { // if value is 1, close popup
            $("#divPopup").fadeOut("normal");
            $("#backgroundPopup").fadeOut("normal");
            popupStatus = 0;  // and set value to 0           
        }
    }

</script>
  <div id="divApproval">
      
                 <div id="divPopup" class="Popup">
                    <div class="close"></div>
                    <span class="ecs_tooltip">@Resources.PressEsctoclose <span class="arrow"></span></span>
                        <div id="popup_content">
                          
                            <div class="row">
                                <div class="standard-table">

                                    @resultGrid.GetHtml(htmlAttributes: new { id = "container-body" },
                                    alternatingRowStyle: "alt",
                                    columns: resultGrid.Columns(
                                        resultGrid.Column("CardNumber", Resources.CardNumber),
                                        resultGrid.Column("ClosureReasonCode", Resources.ClosureReason),
                                        resultGrid.Column("ClosuredDate", Resources.ClosureDate,format:@<text>@item.ClosuredDate.ToShortDateString()</text>),
                                        resultGrid.Column("Reactivatedon", Resources.ReactivatedDate,format:@<text>@item.Reactivatedon.ToShortDateString()</text>)
                                      //  ,resultGrid.Column("Remarks", "Remarks")
                                    ))
                                      @*resultGrid.Column("RUT", "RUT"),*@
                                </div>
                            </div>
                        </div>
                 </div>
        
                <div class="loader"></div>
                <div id="backgroundPopup"></div>
    </div>
