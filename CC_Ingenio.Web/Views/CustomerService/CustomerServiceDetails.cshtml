@using CC_Ingenio.DataTranfer.CustomerServiceInfo;
@model CustomerServiceDetailsDTO

<script type="text/javascript">

    $(document).ready(function () {
       @* alert('@Model.CreditLimit')*@

        $('.custServiceSubMenu').click(function () {
            
            var obj = $(this);
            $.ajax({
                url: '/CustomerService/CheckIfValidSession/',
                type: 'GET',
                dataType: 'json',
                cache: false,
                success: function (retData) {
                    if (retData) {
                        if (retData.Message) {
                            //If session ended, redirect to login
                            window.location = retData.RedirectUrl;
                        }
                        else {
                            //Partial View loading..
                            $('#partialViewDiv').html('');
                            $.ajax({
                                url: '/CustomerService/LoadPartialView/',
                                type: 'GET',
                                data: { ACardNumber: '@Model.CardNumber', ACustomerId: JSON.stringify(@Model.CustomerId), APartialViewType: obj.attr('id'), ARUT: '@Model.RUT', AAccountNumber: JSON.stringify(@Model.AccountNumber), ACountryCode: '@Model.CountryCode', AContractDesc: '@Model.ContractDescription' },
                                dataType: 'html',
                                cache: false,
                                success: function (retData) {
                                    if (retData.length > 0) {
                                       $('#partialViewDiv').html(retData);
                                    }
                                }
                            });
                        }
                    }
                }
            });
        });

        $('#RUT').mask('000000000-*');

        //if ViewBag.OpenCustAddressForApproval is true, then open AddressChange Partialview for Approval
        if ("@ViewBag.OpenCustAddressForApproval" == "True")
        {
            //$('#addressChange').click();  
            var obj = $(this);
            $('#partialViewDiv').html('');
            $.ajax({
                url: '/CustomerService/FillCustomerAddressAfterApproval/',
                type: 'GET',
                data:{ACustomerId: JSON.stringify(@Model.CustomerId), ACardNumber: JSON.stringify(@Model.CardNumber), ACountryCode: '@Model.CountryCode', AAddressType: "@ViewBag.UpdateAddressType",AApprovalStatus:"@ViewBag.ApprovalStatus" },
                dataType: 'html',
                cache: false,
                success: function (data) {
                    if (data.length > 0) {
                        $('#partialViewDiv').html(data);
                    }
                }
            });
        }

        if ("@ViewBag.OpenCardReactivationForApproval" == "True") {
            //$('#addressChange').click();  
            var obj = $(this);
            $('#partialViewDiv').html('');
            $.ajax({
                url: '/CustomerService/PopulateCardReactivationDetails/',
                type: 'GET',
                data: { ACustomerId: JSON.stringify(@Model.CustomerId), ACardNumber: JSON.stringify(@Model.CardNumber)},
                dataType: 'html',
                cache: false,
                success: function (data) {
                    if (data.length > 0) {
                        $('#partialViewDiv').html(data);
                    }
                }
            });
        }

        if ("@ViewBag.OpenLostStolenCardReissueRequestForApproval" == "True") {
            //$('#addressChange').click();  
            var Id = '@ViewBag.ReIssueReqId'
            var obj = $(this);
            $('#partialViewDiv').html('');
            $.ajax({
                url: '/CustomerService/FillLostStolenCardReissueRequestForApproval/',
                type: 'GET',
                data: { ALostStolenCardReissueRequestId: Id, AContractDesc: '@Model.ContractDescription' },
                dataType: 'html',
                cache: false,
                success: function (data) {
                    if (data.length > 0) {
                        $('#partialViewDiv').html(data);
                    }
                }
            });
        }

        //if ViewBag.BillingCycleChangeApproval is true, then open BillingCycleChange Partialview for Approval
        if ("@ViewBag.BillingCycleChangeApproval" == "True") {
            var obj = $(this);
            $('#partialViewDiv').html('');
            $.ajax({
                url: '/CustomerService/FillBillingCycleOnApproval/',
                type: 'GET',
                data: { ACustomerId: JSON.stringify(@Model.CustomerId), ACardNumber: JSON.stringify(@Model.CardNumber), ABillingCycleCode: "@ViewBag.BillingCycleCode", AApprovalStatus: "@ViewBag.ApprovalStatus" },
                dataType: 'html',
                cache: false,
                success: function (data) {
                    if (data.length > 0) {
                        $('#partialViewDiv').html(data);
                    }
                }
            });
        }

        if ("@ViewBag.ChangeCreditLimitForApproval" == "True") {
            //$('#addressChange').click();  
            var Id = '@ViewBag.ChangeCreditLimitId'
                    var obj = $(this);
                    $('#partialViewDiv').html('');
                    $.ajax({
                        url: '/CustomerService/FillChangeCreditLimitForApproval/',
                        type: 'GET',
                        data: { AId: Id },
                dataType: 'html',
                cache: false,
                success: function (data) {
                    if (data.length > 0) {
                        $('#partialViewDiv').html(data);
                    }
                }
            });
        }

        if ("@ViewBag.SwapProductForApproval" == "True") {
            
            var Id = '@ViewBag.SwapProductId'
             var obj = $(this);
             $('#partialViewDiv').html('');
             $.ajax({
                 url: '/CustomerService/FillSwapProductForApproval/',
                 type: 'GET',
                 data: { AId: Id },
                 dataType: 'html',
                 cache: false,
                 success: function (data) {
                     if (data.length > 0) {
                         $('#partialViewDiv').html(data);
                     }
                 }
             });
         }

    });
</script>


