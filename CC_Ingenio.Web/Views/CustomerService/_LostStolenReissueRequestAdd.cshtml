@using CC_Ingenio.DataTranfer.CustomerServiceInfo
@using System.Web.Script.Serialization;
@using CC_Ingenio.Web.Helpers;
@using CC_Ingenio_Resources;

@model LostStolenReissueRequestDTO
@{    
    List<SelectListItem> newContractList = new List<SelectListItem>();

    foreach (var item in ViewBag.NewContractList)
    {
        newContractList.Add(new SelectListItem { Text = item.Text, Value = item.Value });
    }
    
    List<string> lstPriv = new List<string>();
    if (ViewBag.Privileges != null)
    {

        foreach (var item in ViewBag.Privileges)
        {
            lstPriv.Add(item);
        }
    }
}

<link href="~/Content/PopUpStyle.css" rel="stylesheet" />
<script src="~/Scripts/PopUpScript.js"></script> 


<script type="text/javascript">
    $(document).ready(function () {
        
        $("#ExpiryDate").datepicker({
            changeYear: true,
            changeMonth: true,
            yearRange: '2000:2020',
            dateFormat: "@Resources.FormatDateJS",
            numberOfMonths: 1
        });

        $('#Save').click(function (e) {
            e.preventDefault();

            $.ajax({
                url: '/CustomerService/SaveLostStolenCardReissueRequest/',
                type: 'POST',
                data: $('#frmLostStolenReissue').serialize(),
                cache: false,
                success: function (data) {                   
                    if (data != 'Undefined') {
                        $('#partialViewDiv').html(data);                       
                    }
                }
            });

        });

        if ('@Model.IsSaved' == 'True') {
                $("#Save").attr('disabled', true);
                $("#Save").removeClass('Greenbutton').addClass('BtnDisabled');
                ShowSimpleModalDialog("@Html.Raw(string.Format(Resources.MsgInfoSaveSuccess,""))", "");
            }      
        
        if ('@Model.IsBlocked' == 'False') {
            $("#Save").attr('disabled', true);
            $("#Save").removeClass('Greenbutton').addClass('BtnDisabled');
        }

        $('input[id="New"]').hide();
        $('input[id="Submit"]').hide();
        $('input[id="Delete"]').hide();

    });
        
</script>
 
<style>

    /*input[type="text"][readonly],
    select[readonly]
    {
        background-color:#e8e7e3;
        color:#100c0c;
    }*/

    input[type="text"][disabled],
    select[disabled]
