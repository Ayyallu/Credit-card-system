@using CC_Ingenio_Resources;

@{
    ViewBag.Title = String.Concat(new object[] { Resources.UserGroups, " ", Resources.Search });
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using CC_Ingenio.Web.ViewModel.User

@model UserGroupSearch
@{
    var grid = new WebGrid(Model.SearchResults, canPage: true, rowsPerPage: CC_Ingenio.Common.Utils.Utils.GRD_ROWS_PER_PAGE, selectionFieldName: "", ajaxUpdateContainerId: "container-body");
    grid.Pager(WebGridPagerModes.All);
}


<section class="feature">

    <div class="PageTitle">@ViewBag.Title</div>

    <!-- Tabs
	================================================== -->
    <div class="PageRow">

        <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            <li class="active">@Html.ActionLink(Resources.SearchPageHeading,"UserGroupSearch","User" )</li>
            <li> @Html.ActionLink(Resources.DetailsPageHeading,"UserGroupDetails","User" )</li>
        </ul>

        <!-- Tabs Content -->
        <div class="tabs-container">
            <div class="tab-content" id="tab1">
                <div class="row">
                    @using (Html.BeginForm("UserGroupSearch", "User", FormMethod.Get, new { id = "frmList", name = "frmList" }))
                    {
                        <div class="SearchBox">
                            <div class="row">
                                <div class="row">
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.GroupCode</div>
                                        <div class="Field">
                                                @Html.TextBoxFor(x => x.GroupCode, new { maxlength = 5 })
                                        </div>
                                    </div>
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.GroupName</div>
                                        <div class="Field">
                                            @Html.TextBoxFor(x=>x.GroupName, new { maxlength = 50 })
                                        </div>
                                    </div>
                                </div>
                               
                               <div class="SearchColumnbtn">
                                    <span>
                                        <input id="SearchButton" name="SearchButton" class="Greenbutton" type="submit" value="@Resources.Search" />
                                    </span>

                                    <span>
                                        <input id="ClearButton" name ="ClearButton"  class="Greenbutton"  type="submit" value="@Resources.Clear" />
                                    </span>
                                </div>
                            </div>
                            <div class="clear"></div>

                        </div>
                    }

                </div>
                <div class="row">
                   
                    <div class="standard-table">
                        @grid.GetHtml(columns:grid.Columns(
                                    grid.Column("GroupCode",Resources.GroupCode),
                                    grid.Column("GroupName",Resources.GroupName),                               
                                    grid.Column(Resources.View, format: 
                                        (item) =>
                                            {
                                                return Html.Raw(Html.Raw(Html.ActionLink(Resources.View, "UserGroupDetails", "User", new { id = item.GroupCode }, null)));
                                               
                                            })                                    
                                   ))
                    </div>
                </div>
            </div>
        
        </div>

    </div>

</section>
