@{
    ViewBag.Title = Resources.ChangePassword;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using CC_Ingenio.Web.ViewModel.User;
@using CC_Ingenio_Resources;

@model ChangePassword
@{    
    List<SelectListItem> UserList = new List<SelectListItem>();
    foreach (var item in ViewBag.UserNames)
    {
        UserList.Add(new SelectListItem { Text = item.Username, Value = item.Username });
    }
}


<style>
    input[id="OldPassword"][disabled]
    {
         background:#e9e7e7;    
    }
</style>

<script>
    $(document).ready(function () {


        var selUserName = $("#UserName option:selected").text();

        var loggedUserName = '@ViewData["UserName"]';
                        

        if (loggedUserName == 'Administrator') {
            //$("#UserName").attr('disabled', false  );
            $("#OldPassword").attr('disabled', true);
        }
        else {
            $("#UserName").attr('disabled', true);
            $("#UserName").val(loggedUserName);
            $("#OldPassword").attr('disabled', false);
        };

        //$("#UserName").change(function (evt) {
        //    if ($("#UserName option:selected").text() == 'Administrator') {
        //        $("#OldPassword").attr('disabled', true);
        //    }
        //    else{
        //        $("#OldPassword").attr('disabled', false);
        //    };
        //});
        
        $('#OldPassword').focusin(function () {
            $('#OldPassword_Validate').text("");
        });

        $('#CancelButton').click(function (e) {
            $('#OldPassword_Validate').text("");
            $('#NewPassword_Validate').text("");
        });

     

        $('#UpateButton').click(function (e) {

            //if ($("#UserName option:selected").text() == 'Administrator') {
            if (loggedUserName.toLowerCase() == 'administrator'){
                return true;
            }
            else {
                e.preventDefault();
            };
            
            if (!$("#frmChangePassword").valid())
            {
                return false;
            }
            $.ajax({
                url: '/User/ValidateOldPassword/',
                type: 'POST',
                data: $('#frmChangePassword').serialize(),
                cache: false,
                success: function (data) {
                    if (!data.IsValid) {
                        $('#OldPassword_Validate').text('@Html.Raw(@Resources.MsgErrIncorrectOldPassword)');
                        return false;
                    }
                    else {
                        $('#OldPassword_Validate').text("");
                        $('#frmChangePassword').submit();
                    };
                }
            });

        });

    });

</script>


<section class="feature">

    <div class="PageTitle">@ViewBag.Title</div>

    <div class="PageRow">
        <!-- Tabs Content -->
        <div class="tabs-container">
            <div class="tab-content" id="tab1">
                <div class="row">
                    @using (Html.BeginForm("ChangePasswordSave", "User", FormMethod.Post, new { id = "frmChangePassword" }))
                    {      
                                                
                        <div class="SearchBox">
                            <div class="row">
                                <div class="row">
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.Username</div>
                                        <div class="Field">
                                            @Html.DropDownListFor(x => x.UserName, UserList, new { id = "UserName", name = "UserName"})
                                            @Html.HiddenFor(x => x.UserName)
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.OldPassword</div>
                                        <div class="Field">
                                            @*@Html.TextBoxFor(x => x.OldPassword)*@
                                            @Html.PasswordFor(x => x.OldPassword, new { id = "OldPassword", name = "OldPassword", value = Model.OldPassword })
                                            @Html.ValidationMessageFor(x => x.OldPassword)
                                            <label id="OldPassword_Validate" class="validationMessage"></label>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.NewPassword</div>
                                        <div class="Field">
                                            @*@Html.TextBoxFor(x => x.NewPassword)*@
                                            @Html.PasswordFor(x => x.NewPassword, new { id = "NewPassword", name = "NewPassword", value = Model.NewPassword })
                                            @Html.ValidationMessageFor(x => x.NewPassword)
                                            <label id="NewPassword_Validate" class="validationMessage"></label>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.ConfirmPassword</div>
                                        <div class="Field">
                                            @*@Html.TextBoxFor(x => x.ConfirmPassword)*@
                                            @Html.PasswordFor(x => x.ConfirmPassword, new { id = "ConfirmPassword", name = "ConfirmPassword", value = Model.ConfirmPassword })
                                            @Html.ValidationMessageFor(x => x.ConfirmPassword)
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="SearchColumnbtn">
                                        <span>
                                            <input id="UpateButton" name="ChangeButton" class="Greenbutton" type="submit" value="@Resources.Update" />
                                        </span>
                                        <span>
                                            <input id="CancelButton" name="ChangeButton" class="Greenbutton" type="reset" value="@Resources.Cancel" />
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="clear"></div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
