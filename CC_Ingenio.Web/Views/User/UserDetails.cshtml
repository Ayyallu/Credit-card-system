@using CC_Ingenio.DataTranfer.UserInfo
@using CC_Ingenio.Web.Helpers;
@model UserDTO
@{    
    List<SelectListItem> OrganizationList = new List<SelectListItem>();
    foreach (var item in ViewBag.OrganizationList)
    {
        OrganizationList.Add(new SelectListItem { Text = item.Text, Value = item.Value });
    }

    List<SelectListItem> CultureList = new List<SelectListItem>();
    foreach (var item in ViewBag.CultureList)
    {
        CultureList.Add(new SelectListItem { Text = item.Text, Value = item.Value });
    }

    List<string> lstPriv = new List<string>();

    if (ViewBag.Privileges != null)
    {
        foreach (var item in ViewBag.Privileges)
        {
            lstPriv.Add(item);
        }
    }

    List<SelectListItem> UserGroupList = new List<SelectListItem>();
    if (ViewBag.UserGroups != null)
    {
        foreach (var item in ViewBag.UserGroups)
        {
            UserGroupList.Add(new SelectListItem { Text = item.Text, Value = item.Value });
        }
    }
    List<SelectListItem> SelectedGroups = new List<SelectListItem>();

    List<SelectListItem> BranchList = new List<SelectListItem>();
    if (ViewBag.UserBranches != null)
    {
        foreach (var item in ViewBag.UserBranches)
        {
            if (item.Value != string.Empty)
            {
                BranchList.Add(new SelectListItem { Value = item.Value, Text = item.Text });
            }
        }
    }
    List<string> AllowedBranches = new List<string>();

    if (Model.UserAllowedBranch != null)
    {
        foreach (var item in Model.UserAllowedBranch)
        {
            if (item != null && item.Value != string.Empty)
            {
                AllowedBranches.Add(item.Text);
            }
        }
    }
}


<script type="text/javascript">

    var result = "";

    $(document).ready(function () {


        $('#chkShow').change(function () {
            var isChecked = $(this).prop('checked');
            if (isChecked) {
                $('#ReTypePassword').prop('type', 'text');
            }
            else {
                $('#ReTypePassword').prop('type', 'password');
            }
        });

        //------User Groups-----------------
        var originalUserGroups;
        var selectedUserGroups;

        window.globalVar1 = $("#lstGroups option");
        originalUserGroups = $("#lstGroups option");
        var originalUserGroupsCopy = originalUserGroups;
        resetGroupList();

        function resetGroupList() {
            selectedUserGroups = $("#lstUserGroupMembers option");
            originalUserGroupsCopy = globalVar1.slice();

            for (var i = 0; i < selectedUserGroups.length; i++) {
                removeFromArray(selectedUserGroups[i].value);
            }

            function removeFromArray(arrElem) {
                for (var i = originalUserGroupsCopy.length; i--;) {
                    if (originalUserGroupsCopy[i].value === arrElem) {
                        originalUserGroupsCopy.splice(i, 1);
                        return false;
                    }
                }
            };

            var result = originalUserGroupsCopy;
            var finalArray = result.get();
            $("#lstGroups").html(finalArray);

        }
        //-------Branches------------------     
        var originalBranches;
        var selectedBranches;

        window.globalVar2 = $("#lstBranches option");
        originalBranches = $("#lstBranches option");
        var originalBranchesCopy = originalBranches;
        resetBranchList();

        function resetBranchList() {
            selectedBranches = $("#lstUserAllowedBranches option");
            originalBranchesCopy = globalVar2.slice();

            for (var i = 0; i < selectedBranches.length; i++) {
                removeFromArray(selectedBranches[i].value);
            }

            function removeFromArray(arrElem) {
                for (var i = originalBranchesCopy.length; i--;) {
                    if (originalBranchesCopy[i].value === arrElem.substr(0, arrElem.indexOf('-'))) {
                        originalBranchesCopy.splice(i, 1);
                        return false;
                    }
                }
            };

            var result = originalBranchesCopy;
            var finalArray = result.get();
            $("#lstBranches").html(finalArray);

        }
        //--------User Groups right /left arrow handling-------------          
        $('#btnRight1').click
         (function (e) {
             var selectedGroup = $('#lstGroups option:selected');
             if (selectedGroup.length == 0) {
                 alert("@Resources.MsgInfoNoItemSelected");
                 e.preventDefault;
             }
             else {
                 $("#lstGroups > option:selected").appendTo("#lstUserGroupMembers");
                 $("#lstUserGroupMembers")[0].selectedIndex = -1;
                 $('#UserGroupList_Validate').text("");
                 $("#lstUserGroupMembers option").prop("selected", "selected"); // Select the selected user groups.for making the submit validation wrk properly
             };
         });

        $('#btnLeft1').click(function (e) {
            var selectedGroupLeft = $('#lstUserGroupMembers option:selected');
            if (selectedGroupLeft.length == 0) {
                alert("@Resources.MsgInfoNoItemSelected");
            }
            else {
                $('#lstUserGroupMembers > option:selected').appendTo("#lstGroups");
                $("#lstGroups")[0].selectedIndex = -1;
            }
        });

        //-------Branches right /left arrow handling------------- 
        $('#btnRight2').click
         (function (e) {
             var selectedBranch = $('#lstBranches option:selected');
             if (selectedBranch.length == 0) {
                 alert("@Resources.MsgInfoNoItemSelected");
                 e.preventDefault;
             }
             else {
                 $("#lstBranches > option:selected").appendTo("#lstUserAllowedBranches");
                 $("#lstUserAllowedBranches")[0].selectedIndex = -1;
                 $("#lstUserAllowedBranches option").prop("selected", "selected");
                 $('#UserGroupList_Validate').text("");
             };
         });

        $('#btnLeft2').click(function (e) {
            var selectedBranchesLeft = $('#lstUserAllowedBranches option:selected');
            if (selectedBranchesLeft.length == 0) {
                alert("@Resources.MsgInfoNoItemSelected");
            }
            else {
                $('#lstUserAllowedBranches > option:selected').appendTo("#lstBranches");
                $("#lstBranches")[0].selectedIndex = -1;
            }
        });
        //--------------------------------------------------------

        $('#Password').bind('copy paste cut', function (e) {
            e.preventDefault();
        });

        $('#Password').keyup(function () {
            $('#result').html(checkStrength($('#Password').val()))

            result = $('#result').html();
            if (result == "@Resources.TooShort" || result == "@Resources.Weak") {
                $('#result').attr({ 'style': 'color:#e80c4d; font-weight: bold;' });
            }
            if (result == "@Resources.Good") {
                $('#result').attr({ 'style': 'color:Lime;' });
            }
            if (result == "@Resources.Strong") {
                $('#result').attr({ 'style': 'color:Green;' });
            }

        })


        function checkStrength(password) {

            var strength = 0

            if (password.length < 1) {
                $('#result').removeClass()
                return ''
            }

            if (password.length < 8) {
                $('#result').removeClass()
                $('#result').addClass('short')
                return '@Resources.TooShort'
            }

            if (password.length > 7) strength += 1

            if (password.match(/([a-z].*[A-Z])|([A-Z].*[a-z])/)) strength += 1

            if (password.match(/([a-zA-Z])/) && password.match(/([0-9])/)) strength += 1

            if (password.match(/([!,%,&,@@,#,$,^,*,?,_,~])/)) strength += 1

            if (password.match(/(.*[!,%,&,@@,#,$,^,*,?,_,~].*[!,%,&,@@,#,$,^,*,?,_,~])/)) strength += 1

            if (strength < 2) {
                $('#result').removeClass()
                $('#result').addClass('weak')
                return '@Resources.Weak'
            }
            else if (strength == 2) {
                $('#result').removeClass()
                $('#result').addClass('good')
                return '@Resources.Good'
            }
            else {
                $('#result').removeClass()
                $('#result').addClass('strong')
                return '@Resources.Strong'
            }

        }



        $("#frmUserDetailsAdd").submit(function (e) {
            $("#lstUserGroupMembers option").prop("selected", "selected");
            $("#lstUserAllowedBranches option").prop("selected", "selected");

            if ($('#lstUserGroupMembers option:selected').length == 0) {
                $('#UserGroupList_Validate').text("@Html.Raw(string.Format(Resources.MsgErrPleaseSelect,Resources.UserGroups))");
                e.preventDefault;
                return false;
            }

            result = $('#result').html();

            if (result) {
                if (result == "@Resources.Good" || result == "@Resources.Strong") {
                    return true;
                }
                else {
                    return false;
                }
            }

            

            return true;

        });      

        $('input[id="Save"]').hide();

    });




</script>



