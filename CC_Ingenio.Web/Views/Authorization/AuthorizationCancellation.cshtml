                    <div class="Field">
                        @Html.TextAreaFor(x => x.CancellationRemarks, new { id = "CancellationRemarks" }) 
                        <label id="lblValidateRemark" class="validation" style="color: red ;font-size: .95em;"></label>
                    </div>
                </div>
                </div>

                <div class="rowbtn" style="width:160em">
