@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using CC_Ingenio.DataTranfer.AuthorizationInfo
@using CC_Ingenio.Web.ViewModel.Authorization
@model AuthorizationCancellationDTO
@{
}
<style>
   input[type="text"][readonly],
    textarea[readonly]
    {
        background:#e9e7e7;
    }
</style>
<script type="text/javascript">
    $(document).ready(function () {

        $("#btnCancelAuthorization").click(function (e) {

            e.preventDefault();

            if ($('input:radio[name=IsCancel]:checked').val() == 'True') {
                var amount = $('#CancellationAmount').val();
                var remark = $('#CancellationRemarks').val();

                if (amount != 0 && remark != "") {

                    var param = $('#frmAuthCancel').serialize();
                    $.ajax({
                        url: "/Authorization/CancelAuthorization/",
                        type: "POST",
                        data: param,
                        success: function (returnData) {
                            $("#dialog").text("");
                            $('#dialog').dialog({
                                resizable: false,
                                modal: true,
                                title: '@Resources.ApplicationName',
                                buttons: [{
                                    text: "OK",
                                    style: "font-size: .85em;font-family: 'Segoe UI', Verdana, Helvetica, Sans-Serif;",
                                    width: 50,
                                    click: function () {
                                        $(this).dialog("close");
                                        if (returnData.RedirectUrl.length != 0) {
                                            window.location.href = returnData.RedirectUrl;
                                        }
                                    }
                                }]
                            });
                            $('#dialog').text(returnData.Message);
                        }
                    });
                }
                else {
                    if (amount == 0) {
                        $('#lblValidateAmount').text('Please enter Cancellation Amount');
                    }
                    if (remark == "") {
                        $('#lblValidateRemark').text('Please enter Cancellation Remarks');
                    }
                }
            }
        });

        $("input[name=IsCancel]:radio").change(function () {            
            if ($('input:radio[name=IsCancel]:checked').val()=='False') {
                $('#CancellationAmount').attr('readonly', 'readonly');
                $('#CancellationRemarks').attr('readonly', 'readonly');
                $('#CancellationAmount').val(0);
                $('#CancellationRemarks').val('');
                $('#lblValidateAmount').text('');
                $('#lblValidateRemark').text('');
            }
            else {
                $('#CancellationAmount').removeAttr('readonly');
                $('#CancellationRemarks').removeAttr('readonly');
                $('#CancellationAmount').focus();
            }
        });

        $('#CancellationAmount').focusin(function () {
            $('#lblValidateAmount').text('');
        });
        $('#CancellationRemarks').focusin(function () {
            $('#lblValidateRemark').text('');
        });

        $('#CancellationAmount').focus();
    });
</script>
