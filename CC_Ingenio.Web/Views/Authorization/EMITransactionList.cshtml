@using CC_Ingenio_Resources;
@using CC_Ingenio.Web.ViewModel.Authorization
@{
    ViewBag.Title = String.Concat(new object[] { Resources.EMITransaction, " ", Resources.Search });
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model EMIAuthorizationSearch
@{
    var grid = new WebGrid(Model.SearchResult, canPage: true, rowsPerPage: 5, selectionFieldName: "CardNumber", ajaxUpdateContainerId: "standard-table");
    grid.Pager(WebGridPagerModes.All);

    List<SelectListItem> PlanIdList = new List<SelectListItem>();
    foreach (var item in ViewBag.PlanIdList)
    {
        PlanIdList.Add(new SelectListItem { Text = item.Text, Value = item.Value });
    }
    
    
 }




<section class="featured">

    <div class="PageTitle">@ViewBag.Title</div>

    <!-- Tabs
	================================================== -->

    <div class="PageRow">


        <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            <li> @Html.ActionLink(Resources.DetailsPageHeading,"EMITransactionAdd","Authorization" )</li>
            <li class="active"> @Html.ActionLink(Resources.SearchPageHeading,"EMITransactionList","Authorization" )</li>
        </ul>

        <!-- Tabs Content -->
        <div class="tabs-container">
            <div class="tab-content" id="tab1">
                <div class="row">
                    @using (Html.BeginForm("EMITransactionList", "Authorization", FormMethod.Get, new { id = "frmList", name = "frmList" }))
                    {
                        <div class="SearchBox">
                            <div class="row">

                                <div class="TwoColumn">
                                    <div class="row">
                                <div class="label">@Resources.CardNumber</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.CardNumber, new {@class="number", id = "CardNumber", name="CardNumber" , maxlength = 16 })
                               @*     @Html.ValidationMessageFor(x => x.CardNumber)*@
                                </div>
                            </div>
                            <div class="row">
                                <div class="label">@Resources.PlanID</div>
                                <div class="Field">
                                    @Html.DropDownListFor(x => x.PlanId,PlanIdList)
                                   @*   @Html.ValidationMessageFor(x => x.PlanId)*@
                                </div>
                            </div>
                        </div>

                         <div class="TwoColumn">
                            <div class="row">
                                  <div class="label">@Resources.LoanDate</div>
                                <div class="Field">
                                 @Html.TextBoxFor(x => x.LoanBookedDate,"{0:dd/MM/yyyy}", new { @class ="datepicker", @readonly="true" })
                                    @Html.ValidationMessageFor(x => x.LoanBookedDate)
                                </div>
                            </div>
                             </div>   
                                                             
                          
                                <div class="SearchColumnbtn">
                                    <span>
                                        <input id="SearchButton" name="SearchButton" class="Greenbutton" type="submit" value="@Resources.Search" />
                                    </span>
                                    <span>
                                        <input id="ClearButton" class="Greenbutton" type="reset" value="@Resources.Clear" />
                                    </span>
                                </div>
                                
                            </div>
                            <div class="clear"></div>
                        </div>

                    }

                </div>
                <div class="row">
                   
                   <div class="standard-table">

                        @grid.GetHtml(alternatingRowStyle:"alt", columns:grid.Columns(
                         grid.Column("AuthCode",Resources.AuthorizationCode),
                        grid.Column("CardNumber",Resources.CardNumber),
                                    grid.Column("PlanId", Resources.PlanID),   
                                    grid.Column("LoanBookedDate",Resources.LoanDate,format:@<text> @item.LoanBookedDate.ToShortDateString()</text>)  ,      
                                    grid.Column(Resources.View, format: 
                                        (item) =>
                                            {

                                                return Html.Raw(Html.ActionLink(Resources.Edit, "EMIMasterInstallmentAdd", "Authorization", new { id = item.AuthCode }, null));
                                              
                                            })
                               
                                ))              

                    </div>

               
                </div>
            </div>


        </div>

    </div>

</section>
