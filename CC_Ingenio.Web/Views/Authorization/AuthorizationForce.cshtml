                //  $("#CardNo").attr("disabled", "disabled").css("background-color", 'lightgrey');
                $("#AccountNo").removeAttr("disabled", "").css("background-color", 'white');
                $("#CardNo").removeAttr("disabled", "").css("background-color", 'white');
                $("#BatchNo").removeAttr("disabled", "").css("background-color", 'white');
            }
            else if ($lstType.val() == "ML")
            {
                $("#AccountNo").removeAttr("disabled", "").css("background-color", 'white');
                $("#CardNo").removeAttr("disabled", "").css("background-color", 'white');
                $("#BatchNo").attr("disabled", "disabled").css("background-color", 'lightgrey');
            }
            else
            {
                $("#AccountNo").attr("disabled", "disabled").css("background-color", 'lightgrey');
                $("#CardNo").attr("disabled", "disabled").css("background-color", 'lightgrey');
                $("#BatchNo").attr("disabled", "disabled").css("background-color", 'lightgrey');
            }
        });
    });

