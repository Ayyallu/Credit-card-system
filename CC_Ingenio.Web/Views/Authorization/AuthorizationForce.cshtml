@using CC_Ingenio.Common.Utils;
@model TransactionEntrySearch
@{
        
    var grid = new WebGrid(Model.SearchResults,
                defaultSort: "AccountNo",
                rowsPerPage: 5);

    List<SelectListItem> AuthCodeItems = new List<SelectListItem>();
    AuthCodeItems.Add(new SelectListItem { Text = "Select", Value = String.Empty });
    foreach (var itm in ViewBag.AuthCodeList)
    {
        AuthCodeItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }
    List<SelectListItem> AuthStatusItems = new List<SelectListItem>();
    AuthStatusItems.Add(new SelectListItem { Text = "Select", Value = String.Empty });
    foreach (var itm in ViewBag.AuthStatusList)
    {
        AuthStatusItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }

    List<SelectListItem> TypeItems = new List<SelectListItem>();
    TypeItems.Add(new SelectListItem { Text = "Select", Value = String.Empty });
    TypeItems.Add(new SelectListItem { Text = "Batch", Value = "BT" });
    TypeItems.Add(new SelectListItem { Text = "Manual", Value = "ML" });
    


    


    
}
