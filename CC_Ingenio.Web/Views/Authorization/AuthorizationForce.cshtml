                            //  alert(data);
                        }
                    });
                });
                $("input.select").each(function () {
                    $(this).data('row', index);
                    $(this).click(function () {
                        var type = $lstType.val();
                        var tr = $(this).parents('tr:first');                       
                        var CardNumber = tr.find("#TransactionNo").text();                    
                     
                        var Isprinted = tr.find('#IsCheck').attr('checked') ? "True" : "False";



