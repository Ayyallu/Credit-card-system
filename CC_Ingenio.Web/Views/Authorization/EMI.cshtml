<section class="featured">
    <div class="PageTitle">@Resources.PrePaymentOrPreClosureSettlment</div>
    <div class="PageRow">


        <!-- Tabs Content -->
        <div class="tabs-container">
            @using (Html.BeginForm("EMIAuthorizationAdd", "Authorization", FormMethod.Get, new { id = "frmNew", name = "frmNew" }))
            {
                <div class="tab-content" id="tab1">

                    <div class="row">

                        <fieldset class="double">
                            <legend></legend>
                             <div class="row">
                                <div class="label">@Resources.Criteria</div>
                                <div class="Field">
                                     @Html.DropDownListFor(x => x.Type, TypeItems.AsEnumerable(), new { id="Type", name="Type"})
                                    @Html.ValidationMessageFor(x => x.Type,"Please select Criteria")
                                </div>
                            </div>
                            <div class="row">
                                <div class="label">@Resources.CardNumber</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.CardNumber, new { id = "CardNumber", name = "CardNumber", maxlength = 16 })
                                     @Html.ValidationMessageFor(x => x.CardNumber,string.Format(Resources.MsgErrPleaseSelect,Resources.CardNumber))

                                </div>
                            </div>
                         
                                  <div class="row">

                                         
                                <div class="label">@Resources.Prepayment</div>
                                
                                 @Html.RadioButtonFor(x => x.SettlmentType, "Pre", new { id = "SettlmentType", name = "SettlmentType" })
                                   
                                
                         
                            <div class="row">
                                <div class="label">@Resources.PreClosure </div>
                                
                                    @Html.RadioButtonFor(x => x.SettlmentType,"Clo",new { id = "SettlmentType", name = "SettlmentType" })
                                 @Html.ValidationMessageFor(x => x.SettlmentType,"Please select Settlement Type")
                                  
                                </div>
                            </div>
                         
                          
                  

             


                      
                        </fieldset>

             


                        <div class="rowbtn">
                            <span>
                                <input id="SearchButton" name="SearchButton" value="@Resources.Search" type="submit" class="Greenbutton" /></span>
                            <span>
                                <input id="Reset" type="reset" class="Greenbutton" value="@Resources.Cancel" /></span>
                        </div>
                    </div>


            
                </div>
            }

        </div>

                <div class="row">

            <div class="standard-table">
                 
                         @grid.GetHtml(columns: grid.Columns(
                   grid.Column(columnName: "IsCheck", header: " ", 
                             //@<text><input class="box"  type="checkbox" /></text>), //
                        //(item) => @Html.Raw("<input type='checkbox' class = 'select' id='IsPosted'  " + (((item.Value).IsPosted == true) ? "checked" : "") + " />")),    
                        
                           format: (item) =>
                                            {
                                                if (item.IsClosed)
                                                {
                                                    return Html.Raw("");
                                                }   
                                                else
                                                {

                                                    return @Html.Raw("<input type='checkbox' class = 'select' id='IsChecked'  " + (((item.Value).IsChecked == true) ? "checked" : "") + " />");
                                                }
                                            } )   ,                  


                                  
                                    grid.Column("CardNUmber", Resources.CardNumber),
                                    grid.Column("AccountNo", Resources.AccountNumber),
                                    grid.Column("MerchantCode", Resources.MerchantCode),
                                    grid.Column("TransactionCode", Resources.TransactionCode),
                                    grid.Column("EMIAuthNo", Resources.AuthCode,format: @<text><label id="EMIAuthNo" style="font-size: .95em;grid-column-align :end ; font-family: 'Segoe UI', 'Verdana', 'Helvetica', 'Sans-Serif';">@item.EMIAuthNo</label> </text>),                                   
                                    //grid.Column("SegmentCode", "Segment Code"),
                                    grid.Column("TotalPrincipalAmt", Resources.PrincipalAmount,format: @<text><label id="TotalPrincipalAmt" style="font-size: .95em;  text-align :right ; font-family: 'Segoe UI', 'Verdana', 'Helvetica', 'Sans-Serif';">@item.TotalPrincipalAmt</label> </text>),                                   
                                      grid.Column("TotalInterestAmt", Resources.InterestAmount,format: @<text><label id="TotalInterestAmt" style="font-size: .95em;   text-align :right ; font-family: 'Segoe UI', 'Verdana', 'Helvetica', 'Sans-Serif';">@item.TotalInterestAmt</label> </text>),                                   

                                    grid.Column("LoanBookedDate", Resources.LoanDate, format:@<text> @item.LoanBookedDate.ToShortDateString()</text>)
                                 
                                   // grid.Column("AuthCode", "AuthCode")@*,
                                    //grid.Column("Status", header: "Status", format: @<text>@Html.DropDownList("selection", AuthCodeItems)</text>)*@)
                       ))

            </div>
        </div>

          <div class="rowbtn">
            @using (Html.BeginForm("EMIAuthorizationPost", "Authorization", FormMethod.Post, new { id = "frmAuthPost", name = "frmAuthPost" }))
            {
                <span>
                  @*  <input type="hidden" id="hidData" name="hidData" value="@Html.Raw(new JavaScriptSerializer().Serialize(TempData["Data"]))" />*@
                     <input type="hidden" id="hidData" name="hidData" value =ra />
                    <input id="AuthPost" name="Submit" value=@Resources.AuthPost type="submit" class="Greenbutton" /></span>
            }
        </div>


    </div>
</section>
