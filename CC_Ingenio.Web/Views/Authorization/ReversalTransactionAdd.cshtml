<section class="featured">
    <div class="PageTitle">@ViewBag.Title</div>
    <div class="PageRow">
        <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            <li>@Html.ActionLink(Resources.SearchPageHeading, "ReversalTransactionList", "Authorization")</li>
            <li class="active">@Html.ActionLink(Resources.DetailsPageHeading, "ReversalTransactionSave", "Authorization")</li>
        </ul>

        <div id="RUTCardNumberSearchDiv">
       
        </div>

        <!-- Tabs Content -->
        <div class="tabs-container">
            @using (Html.BeginForm("ReversalTransactionSave", "Authorization", new { Id = Model.AuthCode, Transactioncode = Model.TransactionCode, TransactionSubCode = Model.TransactionSubCode }, FormMethod.Post, new { id = "frmReverseTransactionSave", name = "frmReverseTransactionSave" }))
            {
                <div class="tab-content" id="tab1">
                    <div>
                        <span>
                            @if (!string.IsNullOrWhiteSpace(Model.ApprovalStatus))
                            { 
                                <text> @String.Concat(new object[] { Resources.Status, ":", Model.ApprovalStatusDesc }) </text>
                            }
                        </span>
                    </div>

                    <div class="row">
                        <div class="TwoColumn">
                            <div class="label ">@Resources.CardNumber</div>
                            <div class="Field">                              
                                    @Html.TextBoxFor(x => x.CardNumber, new { id = "CardNumberNew", name = "CardNumber", maxlength = 16, style = "width:85%" ,@onchange = "onchangeevent();" ,@readonly = "readonly"})
                                    <input id="btnSearch" name="Command" value="" class="searchbutton" type="button" style="width:30px;border:none"/>
                                    @Html.ValidationMessageFor(x => x.CardNumber)
                            </div>
                        </div>
                        <div class="TwoColumn">
                            <div class="label ">@Resources.RUT</div>
                            <div class="Field">
                                @Html.TextBoxFor(x => x.RUT, new { id = "RUT", name = "AccountNo", maxlength = 25, @readonly = "readonly" })
                            </div>
                        </div>
                    </div>

                    <div class="row">                      

                        
                         <div class="TwoColumn">
                            <div class="label">@Resources.TransactionType</div>
                            <div class="Field">
                                @Html.DropDownListFor(x => x.IncomingTransType, IncomingTransTypeItems.AsEnumerable(), new { id = "IncomingTransType",@onchange = "onchangeevent();" })
                                @Html.ValidationMessageFor(x => x.IncomingTransType)
                            </div>
                        </div>

                         <div class="TwoColumn">
                            <div class="label ">@Resources.ReferenceNo</div>
                            <div class="Field">
                                @Html.TextBoxFor(x => x.InvoiceNo, new { id = "InvoiceNo", name = "InvoiceNo", maxlength = 25 ,@onchange = "onchangeevent();"})
                                 @Html.ValidationMessageFor(x => x.InvoiceNo)
                                  <label id="lblValidateCustomer" class="validationMessage"></label>
                            </div>
                        </div>

                    </div>
                       @* <div class="TwoColumn">
                            <div class="label ">Auth Code</div>
                            <div class="Field">
                                @Html.TextBoxFor(x => x.AuthCode, new { id = "AuthCode", name = "AuthCode", maxlength = 25, placeholder = "Auto Generated", @readonly = "readonly" })
                            </div>
                        </div>*@

                    <div class="row">
                         <div class="TwoColumn">
                            <div id ="reflabel" class="label ">@Resources.CreditNoteNo / @Resources.ReferenceNo </div>
                            <div class="Field">
                                @Html.TextBoxFor(x => x.CreditNote , new { id = "CreditNote", name = "CreditNote", maxlength = 25 })
                                @Html.ValidationMessageFor(x => x.CreditNote)
                            </div>
                        </div>


                        <div class="TwoColumn">
                            <div class="label">@Resources.TransactionDate</div>
                            <div class="Field">
                                @Html.TextBoxFor(x => x.TxnDate, "{0: dd/MM/yyyy}", new { id = "TxnDate", @readonly = "true" })
                                @Html.ValidationMessageFor(x => x.TxnDate)
                            </div>
                        </div>
                </div>    
                    

              
                       @* <div class="TwoColumn">
                            <div class="label">Transaction Time</div>
                            <div class="Field">
                                @Html.TextBoxFor(x => x.Time, new { id = "Time", name = "Time", maxlength = 8, placeholder = "hh:mm:ss" })
                                @Html.ValidationMessageFor(x => x.Time)
                            </div>
                        </div>*@

                          <div class="row">
                        <div class="TwoColumn">
                            <div class="label fontmandatory">@Resources.Merchant</div>
                            <div class="Field">
                                @Html.DropDownListFor(x => x.MerchantCode, MerchantCodeList)
                                @Html.ValidationMessageFor(x => x.MerchantCode)
                            </div>
                        </div>

                        
                        <div class="TwoColumn">
                            <div class="label fontmandatory">@Resources.MCCCode</div>
                            <div class="Field">
                                @Html.DropDownListFor(x => x.MCCCode, MCCCodeList)
                                @Html.ValidationMessageFor(x => x.MCCCode)
                            </div>
                        </div>
                    </div>




                     <div class="row">
                
                        <div class="TwoColumn">
                            <div class="label fontmandatory">@Resources.SalesId</div>
                            <div class="Field">
                                 @Html.TextBoxFor(x => x.SalesId, new { id = "SalesId", name = "SalesId", maxlength = 25 })
                            </div>
                        </div>

                        
                        <div class="TwoColumn">
                            <div class="label fontmandatory">@Resources.OrderNo</div>
                            <div class="Field">
                                  @Html.TextBoxFor(x => x.OrderNo, new { id = "OrderNo", name = "OrderNo", maxlength = 25 })
                            </div>
                        </div>
                    </div>

                       <div class="row">  
                           
                         <div class="TwoColumn">
                            <div class="label">@Resources.Amount</div>
                            <div class="Field">
                            @*  @Html.TextBoxFor(x => x.Amount, new { id = "Amount", name = "Amount", maxlength = 9, @class = "NumericOnly Number", @style = "text-align: right" })*@
                                 @Html.TextBoxFor(x => x.Amount, String.Format("{0:N0}", Model.Amount), new { @class = "NumericOnly Number", id = "Amount", maxlength = 9, @style = "text-align:right" })
                                @Html.ValidationMessageFor(x => x.Amount)
                            </div>
                        </div>
                        
                              
                        <div class="TwoColumn">
                            <div class="label fontmandatory">@Resources.Remarks</div>
                            <div class="Field">
                                 @Html.TextBoxFor(x => x.Remarks, new { id = "Remarks", name = "Remarks", maxlength = 50 })
                            </div>
                        </div>
                           </div>
                                     <div class="row">     
                        <div class="TwoColumn" id="divReferenceNo">
                            <div class="label">@Resources.ReferenceNo</div>
                            <div class="Field">
                                @Html.TextBoxFor(x => x.ReferenceAuthCode, new { id = "ReferenceNo", name = "ReferenceNo", maxlength = 25, @style = "text-align: right" })
                                @Html.ValidationMessageFor(x => x.ReferenceAuthCode)
                            </div>
                        </div>
                    </div>

                </div>
                @Html.HiddenFor(x => x.SegmentCode)
                @Html.HiddenFor(x => x.CardNumber)
                @Html.Raw(Html.BasicButtons(lstPriv))
            }
        </div>
    </div>
</section>
<script>
    if ($('#IncomingTransType option:selected').text() == 'PYD - Payment Reversal (Debit)') {
        $('#divReferenceNo').show();
    }
    else {
        $('#divReferenceNo').hide();
    }
</script>


