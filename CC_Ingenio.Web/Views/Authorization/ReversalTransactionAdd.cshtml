@using CC_Ingenio.DataTranfer.AuthorizationInfo;
@using CC_Ingenio.Web.Helpers;
@using CC_Ingenio_Resources;

@model ReversalTransactionDTO
@{
    List<SelectListItem> CustomerSegmentCodeList = new List<SelectListItem>();
    List<string> lstPriv = new List<string>();

    foreach (var item in ViewBag.CustomerSegmentCodeList)
    {
        CustomerSegmentCodeList.Add(new SelectListItem { Text = item.Text, Value = item.Value });
    } 

    List<SelectListItem> IncomingTransTypeItems = new List<SelectListItem>();
    foreach (var itm in ViewBag.IncomingTransTypeList)
    {
        IncomingTransTypeItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }
    
    List<SelectListItem> MerchantCodeList = new List<SelectListItem>();
    foreach (var item in ViewBag.MerchantCodeList)
    {
        MerchantCodeList.Add(new SelectListItem { Text = item.Text, Value = item.Value });
    }
    List<SelectListItem> MCCCodeList = new List<SelectListItem>();
    foreach (var item in ViewBag.MCCCodeList)
    {
        MCCCodeList.Add(new SelectListItem { Text = item.Text, Value = item.Value });
    }
    
    if (ViewBag.Privileges != null)
    {

        foreach (var item in ViewBag.Privileges)
        {
            lstPriv.Add(item);
        }
    }    
}

@{
    ViewBag.Title = String.Concat(new object[] { Resources.Add, " ", Resources.TransactionReversal});
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<style>
    input[id="AccountNo"][readonly]
    {
         background:#e9e7e7;    
    }
    input[id="AuthCode"][readonly]
    {
         background:#e9e7e7;    
    }
</style>

<script type="text/javascript">

    function setCalenderDates() {
        var fromDate = $('#TxnDate').val();       
    }
  


    function onchangeevent() {
    
        
        
        var CardNo = $('#CardNumberNew').val();
        var Invoice = $('#InvoiceNo').val();
        var Type = $('#IncomingTransType option:selected').text(); 
        if (Type == "@Resources.SelectOne")
        {
            Type = "CNT - Credit Note";
            $('#TxnDate').datepicker("option", "minDate", null);
        }
       
        if (Invoice == '')
            $('#lblValidateCustomer').text("");
        if (CardNo != '' & Invoice != '' & Type != "CNT - Credit Note") {
            
            $.ajax({
                type: 'GET',
                url: '/Authorization/InvoiceNo',
                data: { ACardNumber: CardNo, AInvoiceNo: Invoice, AMode: Type },
                cache : false,
                success: function (returnData) {
                  

                    if (returnData.InvoiceNo != Invoice) {
                        $('#lblValidateCustomer').text("@Html.Raw(string.Format(Resources.MsgErrInvalid,Resources.ReferenceNo))");                      
                        return true;
                    }
                    else {
                        $('#lblValidateCustomer').text("");                       
                        document.getElementById("MerchantCode").value = returnData.MerchantCode;
                        document.getElementById("OrderNo").value = returnData.OrderNo;
                        document.getElementById("SalesId").value = returnData.SalesId;
                        document.getElementById("Amount").value = returnData.BalanceAmount;                     
                        document.getElementById("MCCCode").value = returnData.MCC;                   
                        document.getElementById("TxnDate").value = returnData.TxnDate;
                        $('#TxnDate').datepicker("option", "minDate", returnData.TxnDate);
                        $('#lblValidateCustomer').text("");
                        return true;
                    }
                }
               


            })

            
        }
    }
    
    $(document).ready(function () {
       

        //$('#frmManualTransactionSave').on('submit', function (e) {
        //    alert('hai');
        //    e.preventDefault();
        //});

        function loading() {
            $("div.loader").show();
        }

        $("#btnSearch").click(function () {
            $.ajax({
                url: "/Billing/RUTCardNumberSearchList",
                type: "POST",
                data: { ARUT: "", ACardnumber: "", ACustomername: "" , Isloading:false},
                contenttype: "application/json ; charset = utf-8",
                success: function (data) {
                    $("#RUTCardNumberSearchDiv").html(data);
                },
                error: function (ts) { alert(ts.responseText) }
            });

            loading(); // loading
            setTimeout(function () { // then show popup, deley in .5 second
                loadPopup(); // function show popup
            }, 2000); // .5 second
        })


        $("#TxnDate").datepicker({
            changeYear: true,
            changeMonth: true,
            yearRange: '2000:2020',
            dateFormat: "@Resources.FormatDateJS",
            onSelect: setCalenderDates               
        });

        $("#IncomingTransType").change(function () {            
           
            //if ($('#IncomingTransType option:selected').text() == 'PYD - Payment Reversal (Debit)') {

            //    $('#divReferenceNo').show();
            //}
            //else {
            //    $('#divReferenceNo').hide();
            //}

            
            
            if ($('#IncomingTransType option:selected').val() == '100')
            {
                if ($('#InvoiceNo').val()=="")               
               //   $('#lblValidateCustomer').text("Please select  reference no.");
                $("#InvoiceNo").attr('disabled', false);
                
            }
            //else if ($('#IncomingTransType option:selected').val() !='100') {
               
            //    $("#InvoiceNo").attr('disabled', true);
            //    $('#lblValidateCustomer').text("");
            //    document.getElementById("InvoiceNo").value = "";

            //}
        });


        $("#Time").blur(function () {
            var txnTime = $(this).val();
            if (txnTime == '__:__:__') {
                $(this).val('');
            }
            else {
                var array = txnTime.split(':');
                var newTxnTime;
                if (array[0] == '__' || array[0] == '') {
                    newTxnTime = '00';
                }
                else {
                    newTxnTime = array[0];
                }
                if (array[1] == '__' || array[1] == '') {
                    newTxnTime = newTxnTime + ':00';
                }
                else {
                    newTxnTime = newTxnTime + array[1];
                }
                if (array[2] == '__' || array[2] == '') {
                    newTxnTime = newTxnTime + ':00';
                }
                else {
                    newTxnTime = newTxnTime + array[2];
                }
                $(this).val(newTxnTime);
            }
        });
     
        $('input[id="Save"]').hide();
        $('input[id="Authorize"]').hide();
        $('input[id="Delete"]').hide();

        $('#Time').mask('99:99:99');

        $('#frmReverseTransactionSave').submit(function (e)
        {          
            
            if ($('#IncomingTransType option:selected').val() == '100') {
                if ($('#InvoiceNo').val() == "")
                    $('#lblValidateCustomer').text("@Html.Raw(string.Format(Resources.MsgErrPleaseEnter2,Resources.ReferenceNo))");                   

            }
            if ($('#lblValidateCustomer').text() != "") {
                e.preventDefault();
            }

        });

    });
    /////////////////////////
    //re = /^(\d{1,2}):(\d{2})([ap]m)?$/;

    //if(form.starttime.value != '') {
