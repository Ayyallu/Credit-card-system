    <div class="PageRow">


        <!-- Tabs Content -->
        <div class="tabs-container">
         
            @using (Html.BeginForm("EMIInstallmentAdd", "Authorization", FormMethod.Get, new { Id = Model.EMIAuthNo, }))
            {
                @*<div class="tab-content" id="tab1">

                    <div class="row">

                        <fieldset class="double">
