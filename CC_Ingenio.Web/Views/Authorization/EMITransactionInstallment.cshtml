@using CC_Ingenio_Resources;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script>
    $(function ()
    {
        
       
        //$("#AccountNo").attr("disabled", "disabled").css("background-color", 'lightgrey');
        //$("#CardNo").attr("disabled", "disabled").css("background-color", 'lightgrey');
        //$("#BatchNo").attr("disabled", "disabled").css("background-color", 'lightgrey');

        $lstType = $('select[id*="Type"]');
        
        $lstType.change(function ()
        {
          
            if ($lstType.val() == "BT")
            {                
             //   $("#AccountNo").attr("disabled", "disabled").css("background-color", 'lightgrey');
                //  $("#CardNo").attr("disabled", "disabled").css("background-color", 'lightgrey');
                $("#AccountNo").removeAttr("disabled", "").css("background-color", 'white');
                $("#CardNo").removeAttr("disabled", "").css("background-color", 'white');
                $("#BatchNo").removeAttr("disabled", "").css("background-color", 'white');
            }
            else if ($lstType.val() == "ML")
            {
                $("#AccountNo").removeAttr("disabled", "").css("background-color", 'white');
                $("#CardNo").removeAttr("disabled", "").css("background-color", 'white');
                $("#BatchNo").attr("disabled", "disabled").css("background-color", 'lightgrey');
            }
            else
            {
                $("#AccountNo").attr("disabled", "disabled").css("background-color", 'lightgrey');
                $("#CardNo").attr("disabled", "disabled").css("background-color", 'lightgrey');
                $("#BatchNo").attr("disabled", "disabled").css("background-color", 'lightgrey');
            }
        });
    });
    var index = 1;
    $(document).ready(function () {
        $("#allBox").click(function () {
            var type = $lstType.val();

            //alert( $(".checkbox").attr("checked", $(this).attr("checked")));
            var all = $(".select").attr("checked") ? true : false;
    
            $(".select").attr("checked", $(this).attr("checked") ? true : false);
            $.ajax({
                url: '/Authorization/UpdatingEMIInstallmentSessionAll/',
                data: { ischecked: all, Type: type },
                type: 'get',
                cache: false,
                contentType: 'application/json; charset=utf-8',
                success: function (data) {
                    //  alert(data);
                }
            });
        });
        $("input.select").each(function () {
            $(this).data('row', index);
            $(this).click(function () {
               // var type = $lstType.val();
                var tr = $(this).parents('tr:first');
                var CardNumber = tr.find("#EMIAuthNo").text();
                var IntallmentNo = tr.find("#InstallmentNo").text();
                var PPA = tr.find("#PPA").val();
                var PIA = tr.find("#PIA").val();
                var Isprinted = tr.find('#IsChecked').attr('checked') ? "True" : "False";
          

                //alert(IntallmentNo);
                $.ajax({
                    url: '/Authorization/UpdatingEMIInstallmentSession/',
                    data: { CardNumber: CardNumber, ischecked: Isprinted, PrincipalAmt: PPA, InterestAmt: PIA, IntallmentNo: IntallmentNo },
                    type: 'get',
                    cache: false,
                    contentType: 'application/json; charset=utf-8',
                    success: function (data) {
                       
                        //  alert(data);
                    }
                });
            });
            index++;
        });
        $("input.PPA").each(function () {
            $(this).data('row', index);
            $(this).change(function () {
                // var type = $lstType.val();
                var tr = $(this).parents('tr:first');
                var CardNumber = tr.find("#EMIAuthNo").text();
                var installmentNo = tr.find("#InstallmentNo").text();
                var PPA = tr.find("#PPA").val();
                var PIA = tr.find("#PIA").val();
                var Isprinted = "True"; //tr.find('#IsChecked').attr('checked') ? "True" : "False";

                $.ajax({
                    url: '/Authorization/UpdatingEMIMasterInstallmentSession/',
                    data: { CardNumber: CardNumber, ischecked: Isprinted, PrincipalAmt: PPA, InterestAmt: PIA, InstallmentNo: installmentNo },
                    type: 'get',
                    cache: false,
                    contentType: 'application/json; charset=utf-8',
                    success: function (data) {

                        //  alert(data);
                    }
                });
            });
            index++;
        });
        $("#SearchButton").click(function () {

            $.ajax({
                type: 'POST',
                url: '/Authorization/DeletingEMIInstallmentData',
                success: function (returnData) {

                    if (returnData.RedirectUrl.length > 0) {

                        window.location.href = returnData.RedirectUrl;
                        return true;
                    }

                }

            });

        });



    })

</script>
