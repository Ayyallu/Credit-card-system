                                    @Html.TextBoxFor(x => x.CardNumber, new { id = "CardNumber", name = "CardNumber", maxlength = 16 })
                                </div>
                            </div>
                            <div class="row">
                                <div class="label">From</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.EMIAuthNo, new  { id = "EMIAuthNo", name = "CardNumber", maxlength = 16 })
                                    @Html.ValidationMessageFor(x => x.EMIAuthNo)
                                </div>
                            </div>
                          
                        </fieldset>                        


                        <div class="rowbtn">
                            <span>
                                <input id="SearchButton" name="SearchButton" value="Search" type="submit" class="Greenbutton" /></span>
                            <span>
                                <input id="Reset" type="reset" class="Greenbutton" value="Cancel" /></span>
                        </div>
                    </div>
                </div>*@
            }

        </div>

        <div class="row">

            <div class="standard-table">
                    @MvcHtmlString.Create(grid.GetHtml(columns: grid.Columns(
                   grid.Column(columnName: "IsCheck", header: "{CheckBoxHeading}", 
                             
                        
                           format: (item) =>
                                            {
                                                if(item.ISPosted )
                                                {
                                                    return Html.Raw("");
                                                }   
                                                else
                                                {

                                                    return @Html.Raw("<input type='checkbox' class = 'select' id='IsChecked'  " + (((item.Value).IsChecked == true) ? "checked" : "") + " />");
                                                }
                                            } )   ,                  

                                  grid.Column("EMIAuthNo", Resources.AuthCode,format: @<text><label id="EMIAuthNo" style="font-size: .95em;font-family: 'Segoe UI', 'Verdana', 'Helvetica', 'Sans-Serif';">@item.EMIAuthNo</label> </text>),                                   
                                     grid.Column("InstallmentNo", Resources.InstallmentNumber,format: @<text><label id="InstallmentNo" style="font-size: .95em;font-family: 'Segoe UI', 'Verdana', 'Helvetica', 'Sans-Serif';">@item.InstallmentNo</label> </text>),                                   
                                    grid.Column("CardNumber", Resources.CardNumber),                                 
                                  
                                    //grid.Column("SegmentCode", "Segment Code"),
                                   grid.Column("TotalPrincipalAmt", Resources.PrincipalAmount,format: @<text><input type="text", id="PPA", class = "PPA", value="@item.TotalPrincipalAmt" style="font-size: .95em; width:100px ; text-align :right ;  font-family: 'Segoe UI', 'Verdana', 'Helvetica', 'Sans-Serif';"></text>)        ,
                                    grid.Column("TotalInterestAmt", Resources.InterestAmount,format: @<text><input type="text", id="PIA", class = "PPA", value="@item.TotalInterestAmt" style="font-size: .95em; width:100px ; text-align :right ;  font-family: 'Segoe UI', 'Verdana', 'Helvetica', 'Sans-Serif';"></text>)        ,
                                    grid.Column("DueDate", Resources.DueDate,format:@<text> @item.DueDate.ToString("dd/MM/yyyy")</text>)                              
                                   // grid.Column("AuthCode", "AuthCode")@*,
                                    //grid.Column("Status", header: "Status", format: @<text>@Html.DropDownList("selection", AuthCodeItems)</text>)*@)
                       )). ToString().Replace("{CheckBoxHeading}", "<input type='checkbox' id='allBox'/>"))

            </div>
        </div>

        <div class="rowbtn">
            @using (Html.BeginForm("EMIInstallmentAddPost", "Authorization", FormMethod.Post, new { id = "frmAuthPost", name = "frmAuthPost" }))
            {
                <span>
                    <input type="hidden" id="hidData" name="hidData" value="@Html.Raw(new JavaScriptSerializer().Serialize(TempData["Data"]))" />
                    <input id="AuthPost" name="AuthPost" value="Post" type="submit" class="Greenbutton" /></span>
            }
        </div>

    </div>
