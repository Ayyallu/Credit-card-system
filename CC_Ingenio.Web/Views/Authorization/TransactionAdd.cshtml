<section class="featured">
     <div class="PageTitle">@ViewBag.Title</div>
     <div class="PageRow">

       
            <!-- Tabs Content -->
            <div class="tabs-container">
                
               @using (Html.BeginForm("Submit", "Authorization", FormMethod.Post, new { id = "frmAdd", name = "frmAdd" }))
                {
                <div class="tab-content" id="tab1">

                    <div class="row">
                            
                        <fieldset class="double">
                            <legend></legend>
                            <div class="row">
                                <div class="label">@Resources.CardNumber</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.CardNo, new { id = "CardNo", name = "CardNo", maxlength = 16 })
                                     @Html.ValidationMessageFor(x => x.CardNo)
                                </div>
                            </div>    
                            <div class="row">
                                <div class="label">@Resources.TransactionDate</div>
                                <div class="Field">
                                  @Html.TextBoxFor(x => x.TxnDate, new { id="txnDate1", @class = "datepicker", @readonly = "true",Value = Model.TxnDate.ToShortDateString()})
                                    @* @Html.TextBoxFor(x => x.TxnDate,  "{0:dd/MM/yyyy}", new { id="txnDate1", @readonly = "true"})*@
                                   @Html.ValidationMessageFor(x => x.TxnDate)
                                </div>
                            </div>
                            <div class="row">
                                <div class="label">@Resources.Amount</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.Amount, new { id = "Amount", name = "Amount" })
                                    @Html.ValidationMessageFor(x => x.Amount)
                                </div>
                            </div>
                            <div class="row">
                                <div class="label">@Resources.AuthCode</div>
                                   <div class="Field">
                                    @Html.DropDownListFor(x => x.AuthCode, AuthCodeItems.AsEnumerable(), new { id = "AuthCode", name = "AuthCode" })
                                    @Html.ValidationMessageFor(x => x.AuthCode)
                                </div>
                            </div>
                            <div class="row">
                                <div class="label">@Resources.SegmentCode</div>
                                <div class="Field">
                                    @Html.DropDownListFor(x => x.SegmentCode, SegmentCodeItems.AsEnumerable(), new { id = "SegmentCode", name = "SegmentCode" })
                                    @Html.ValidationMessageFor(x => x.SegmentCode)
                                </div>
                            </div>       
                                                        
                             <div  class="row" visible ="false">
                                <div class="label">@Resources.TransactionNo</div>
                                <div class="Field">
                                   @Html.TextBoxFor(x => x.TransactionNo, new { id = "TransactionNo", name = "TransactionNo",style="background-color: lightgrey" })
                                   @*// @Html.ValidationMessageFor(x => x.TransactionNo)*@
                                </div>
                            </div>      
                                              
                        </fieldset>
                        
                        <fieldset class="double">
                            <legend></legend>
                            <div class="row">
                                <div class="label">@Resources.AccountNumber</div>
                                <div class="Field" >
                                    @Html.TextBoxFor(x => x.AccountNo, new { id = "AccountNo", name = "AccountNo",style="background-color: lightgrey" })
                                  @*  @Html.ValidationMessageFor(x => x.AccountNo)*@
                                </div>
                            </div>    
                            <div class="row">
                                <div class="label">@Resources.TransactionTime</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.TxnTime, new { id = "TxnTime", name = "TxnTime", placeholder="hh:mm:ss" })
                                    @Html.ValidationMessageFor(x => x.TxnTime)
                                </div>
                            </div>
                            <div class="row">
                                <div class="label">@Resources.ResponseCode</div>
                                <div class="Field">
                                    @Html.DropDownListFor(x => x.ResponseCode, ResponseCodeItems.AsEnumerable(), new { id = "ResponseCode", name = "ResponseCode" })
                                    @Html.ValidationMessageFor(x => x.ResponseCode)
                                </div>
                            </div>        
                            <div class="row">
                                <div class="label">@Resources.MerchantCode</div>
                                <div class="Field">
                                    @Html.DropDownListFor(x => x.MerchantCode, MerchantCodeItems.AsEnumerable(), new { id = "MerchantCode", name = "MerchantCode" })
                                    @Html.ValidationMessageFor(x => x.MerchantCode)
                                </div>
                            </div>       
                             <div class="row">
                                <div class="label">@Resources.MCCCode</div>
                                <div class="Field">
                                    @Html.DropDownListFor(x => x.MCCCode, MCCCodeItems.AsEnumerable(), new { id = "MCCCode", name = "MCCCode" })
                                    @Html.ValidationMessageFor(x => x.MCCCode)
                                </div>
                            </div>         
                        </fieldset>


                        <div class="rowbtn">
                            <span>
                                
                                <input id="Add" class="Greenbutton" name="Command" value="Submit"   type="@Resources.Submit"/></span>
                            <span>
                                <input id="Cancel" class="Greenbutton" type="reset" value="@Resources.Cancel" /></span>
                        </div> 
                    </div>
                </div>
                 }

            </div>
        

    </div>
</section>
