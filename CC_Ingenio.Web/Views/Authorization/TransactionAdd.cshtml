@using System.Web.Script.Serialization;
@using CC_Ingenio.Common.Utils;
@model Transaction
@{
    List<SelectListItem> AuthCodeItems = new List<SelectListItem>();
    
    foreach (var itm in ViewBag.AuthCodeList)
    {
        AuthCodeItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }
    List<SelectListItem> SegmentCodeItems = new List<SelectListItem>();
    
    foreach (var itm in ViewBag.SegmentCodeList)
    {
        SegmentCodeItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }
    List<SelectListItem> ResponseCodeItems = new List<SelectListItem>();
    
    foreach (var itm in ViewBag.ResponseCodeList)
    {
        ResponseCodeItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }
    List<SelectListItem> MerchantCodeItems = new List<SelectListItem>();
    MerchantCodeItems.Add(new SelectListItem { Text = Resources.SelectOne, Value = String.Empty });
    foreach (var itm in ViewBag.MerchantCodeList)
    {
        MerchantCodeItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }

    List<SelectListItem> MCCCodeItems = new List<SelectListItem>();
    MCCCodeItems.Add(new SelectListItem { Text = Resources.SelectOne, Value = String.Empty });
    foreach (var itm in ViewBag.MCCodeList)
    {
        MCCCodeItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }
 }



<script type="text/javascript">
$(function () {
    $("#Add").click(function (e) {
     
        e.preventDefault();
        $("#dialog").dialog({
            resizable: false,
            height: 160,
            modal: true,
            title: '@Resources.ApplicationName',
            buttons: {
                "Yes": function () {

                    $("#dialog").dialog("close");

                    $("#frmAdd").submit();
                    
                },
                "No": function () {
                    $(this).dialog("close");
                }
            }
        });

        $("#dialog").text("@Html.Raw(string.Format(Resources.MsgConfSave))");

        $("#dialog").dialog("open");

    });
});
</script>




