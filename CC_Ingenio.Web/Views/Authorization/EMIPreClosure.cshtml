<script type="text/javascript">
    $(function () {
        $("#AuthPost").click(function (e) {
         //   var data2 = JSON.stringify(@Html.Raw(new JavaScriptSerializer().Serialize(TempData["Data"])));
          //  alert(data2);
            e.preventDefault();
            $("#dialog").dialog({
                resizable: false,
                height: 160,
                width: 'auto',
                modal: true,
                title: '@Resources.ApplicationName',
                buttons: {
                    "Yes": function () {

                        $("#dialog").dialog("close");

                        $("#frmAuthPost").submit();
                     

                    },
                    "No": function () {
                        $(this).dialog("close");
                    }
                }
            });

            $("#dialog").text("@Html.Raw(string.Format(Resources.MsgConfClose,Resources.Transaction))");

            $("#dialog").dialog("open");


        });

        $("#Reset").click(function (e) {

            $("#Type").attr("value", String.Empty);
            $("#Type").attr("Text", "Select");

            $("#AccountNo").attr("value", "");
            $("#CardNo").attr("value", "");
            $("#BatchNo").attr("value", ""); 
            $("#TxnToDate").attr("value", ""); 
            $("#TxnDate").attr("value", "");           
           
           
        });
    });
