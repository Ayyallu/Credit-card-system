@using CC_Ingenio.Web.ViewModel.Authorization
@using CC_Ingenio_Resources;
@model ManualTransactionSearch
@{
    var grid = new WebGrid(Model.SearchResults, canPage: true, rowsPerPage: CC_Ingenio.Common.Utils.Utils.GRD_ROWS_PER_PAGE, selectionFieldName: "", ajaxUpdateContainerId: "standard-table");
    grid.Pager(WebGridPagerModes.All);

    List<SelectListItem> CustomerSegmentCodeList = new List<SelectListItem>();
    foreach (var item in ViewBag.CustomerSegmentCodeList)
    {
        CustomerSegmentCodeList.Add(new SelectListItem { Text = item.Text, Value = item.Value });
    }
    CustomerSegmentCodeList.RemoveAt(0);
    CustomerSegmentCodeList.Insert(0, new SelectListItem { Text = string.Empty, Value = string.Empty });

    List<SelectListItem> TransactionCodeItems = new List<SelectListItem>();
    foreach (var itm in ViewBag.TransactionCodes)
    {
        TransactionCodeItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }
    
    
 }


@{
    ViewBag.Title = String.Concat(new object[] { Resources.TransactionReversal, " ", Resources.Search });
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="featured">

    <div class="PageTitle">@ViewBag.Title</div>

    <!-- Tabs
	================================================== -->

    <div class="PageRow">


        <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            <li class="active"> @Html.ActionLink(Resources.SearchPageHeading,"ReversalTransactionList","Authorization" )</li>
            <li> @Html.ActionLink(Resources.DetailsPageHeading,"ReversalTransactionAdd","Authorization" )</li>
        </ul>

        <!-- Tabs Content -->
        <div class="tabs-container">
            <div class="tab-content" id="tab1">
                <div class="row">
                    @using (Html.BeginForm("ReversalTransactionList", "Authorization", FormMethod.Get, new { id = "frmList", name = "frmList" }))
                    {
                        <div class="SearchBox">
                            <div class="row">

                                <div class="TwoColumn">
                                    <div class="row">
                                <div class="label">@Resources.CardNumber</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.CardNumber, new {@class="NumericOnly", id = "CardNumber", name="CardNumber" , maxlength = 16 })
                                </div>
                            </div>
                            <div class="row">
                                <div class="label">@Resources.RUT</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.RUT, new {@class="NumberHyphen",id = "RUT", name="RUT", maxlength = 16 })
                                </div>
                            </div>
                        </div>

                         <div class="TwoColumn">
                            <div class="row">
                                <div class="label ">@Resources.ReferenceNo</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.InvoiceNo,new { id = "InvoiceNo", name="InvoiceNo", maxlength = 25  })
                                </div>
                            </div>
                                <div class="row">
                                <div class="label ">@Resources.CreditNote</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.CreditNote, new {id="CreditNote", name="CreditNote", maxlength = 25})
                                </div>
                            </div>
                            
                        </div>

@*                                 <div class="TwoColumn">
                           <div class="row">
                                <div class="label ">Merchant Code</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.MerchantCode, new {id="MerchantCode", name="MerchantCode", maxlength = 10})
                                </div>
                            </div>
                                     </div> *@
                                                             
                          
                                <div class="SearchColumnbtn">
                                    <span>
                                        <input id="SearchButton" name="SearchButton" class="Greenbutton" type="submit" value="@Resources.Search" />
                                    </span>
                                    <span>
                                        <input id="Button2" type="submit" name ="ClearButton"  class="Greenbutton" value="@Resources.Clear" />
                                    </span>
                                </div>

                            </div>
                            <div class="clear"></div>
                        </div>

                    }

                </div>
                <div class="row">
                   
                   <div class="standard-table">

                        @grid.GetHtml(alternatingRowStyle:"alt", columns:grid.Columns(
                        grid.Column("CardNumber",Resources.CardNumber),
                                    grid.Column("RUT", Resources.RUT),   
                                    grid.Column("CreditNote",Resources.CreditNoteNo),
                                    grid.Column("MerchantName",Resources.Merchant),
                                    grid.Column("IncomingTransTypeDesc",Resources.TransactionType),
                                    grid.Column("TxnDate",Resources.TransactionDate,format:@<text> @item.TxnDate.ToShortDateString()</text>),
                                    grid.Column("Amount",Resources.TransactionAmount,format:@<text> @String.Format("{0:N0}",item.Amount)</text>, style: "gridAmountRightAlign"),  
                                    grid.Column(Resources.Edit, format: (item) => 
                                             {
                                                if(item.ApprovalStatus.Equals("A"))
                                                {
                                                    return Html.Raw(Html.ActionLink(Resources.View, "ReversalTransactionView", "Authorization", new { id = item.AuthCode, TransactionCode = item.TransactionCode, TransactionSubcode = item.TransactionSubcode, PostedDate = item.PostedDate.ToString("dd-MM-yyyy") }, null));
                                                }
                                                else
                                                {
                                                    return Html.Raw("");
                                                    //return Html.Raw(Html.Raw(Html.ActionLink("View", "ManualTransactionView", "Authorization", new { id = item.AuthCode }, null)));
                                                }
                                             })
                                ))            
                    </div>

                     @*  <div class="standard-table">

                        @grid.GetHtml(columns:grid.Columns(
                                    grid.Column("TransactionNo","Transaction No"),                                   
                                    grid.Column("ApprovalStatusDesc", "Status"),
                                    grid.Column("Edit", format: 
                                        (item) =>
                                            {
                                                if(item.ApprovalStatus.Equals("A"))
                                                {
                                                    return Html.Raw(Html.ActionLink("Edit", "ManualTransactionAdd", "Authorization", new { Id = item.TransactionNo }, null));
                                                }   
                                                else
                                                {
                                                    return Html.Raw(Html.Raw(Html.ActionLink("View", "ManualTransactionView", "Authorization", new { id = item.TransactionNo }, null)));
                                                }
                                            }),
                                    grid.Column("Delete",   format: 
                                        (item) =>
                                            {
                                                if(item.ApprovalStatus.Equals("A"))
                                                {
                                                    return Html.Raw(Html.ActionLink("Delete", "ManualTransactionDelete", "Authorization", new { id = item.TransactionNo }, new { @class = "delete-link" }));
                                                }   
                                                else
                                                {
                                                    return Html.Raw("");
                                                }
                                            })
                                   ))
                    </div>*@
                </div>
            </div>


        </div>

    </div>

</section>
