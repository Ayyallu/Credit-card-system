<style type ="text/css">
    .BoxColumn {

    border: 1px solid #487401;
    padding: .25em;
    float: left;
    width:100%;
    margin-left:0;
    margin-right:0;
    font-size: 1.25em;
    background-color : #fff;
}

.BoxColumnTitle {
    font-size: 1.25em;
    font-family: "Segoe UI", Verdana, Helvetica, Sans-Serif;
    text-transform: uppercase;
    
    padding-bottom : 5px;
    border-bottom: 1px solid #487401;
    text-align:center;
}
    .RightBox 
    {
        margin-top : 1.5em;

        padding-right : 2em;
        /*border: 1px solid #487401;*/
        float:right;
    }
    .CenterAlign {
        text-align:center;
    }
    .TableAmount1 {
        margin-top : .5em;
        float:left;
        width:30%;
        padding-bottom : 1px;
    }
    .TableAmount3 {
        margin-top : .5em;
        float:right;
        width:40%;
        padding-bottom : 1px;
        padding-top : 2em;
        padding-left : 3em;
    }
    .TableAmount4 {
        margin-top : -.85em;
        float:left;
        width:60%;
        /*padding-bottom : 1px;*/
    }
    .TableAmount5 {
        margin-top : .5em;
        width:50%;
        padding-bottom : 1px;
    }
    table {
    border-collapse: collapse;
    fill:none;
}

td, th {
    border: 1px solid black;
    padding: 3px;
    fill:none;
}
    .td 
    {
        border:0px;
        column-width:0px;
        background-color:inherit;
    }
    .td4
    {
        column-width:300px;
    }

</style>

@using System.Web.Script.Serialization;
@using CC_Ingenio.Common.Utils;
@model Transaction
@{
    List<SelectListItem> AuthCodeItems = new List<SelectListItem>();
    AuthCodeItems.Add(new SelectListItem { Text = "Select", Value = String.Empty });
    foreach (var itm in ViewBag.AuthCodeList)
    {
        AuthCodeItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }

    List<SelectListItem> ResponseCodeItems = new List<SelectListItem>();
    ResponseCodeItems.Add(new SelectListItem { Text = "Select", Value = String.Empty });
    foreach (var itm in ViewBag.ResponseCodeList)
    {
        ResponseCodeItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }
    
}


