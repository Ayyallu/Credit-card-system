@using CC_Ingenio_Resources;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Resources.ForceAuthorization;
}
<script>
    $(function ()
    {
        
       
        //$("#AccountNo").attr("disabled", "disabled").css("background-color", 'lightgrey');
        //$("#CardNo").attr("disabled", "disabled").css("background-color", 'lightgrey');
        //$("#BatchNo").attr("disabled", "disabled").css("background-color", 'lightgrey');

        $lstType = $('select[id*="Type"]');
        
        $lstType.change(function ()
        {
          
            if ($lstType.val() == "BT")
            {                
             //   $("#AccountNo").attr("disabled", "disabled").css("background-color", 'lightgrey');
                //  $("#CardNo").attr("disabled", "disabled").css("background-color", 'lightgrey');
                $("#AccountNo").removeAttr("disabled", "").css("background-color", 'white');
                $("#CardNo").removeAttr("disabled", "").css("background-color", 'white');
                $("#BatchNo").removeAttr("disabled", "").css("background-color", 'white');
            }
            else if ($lstType.val() == "ML")
            {
                $("#AccountNo").removeAttr("disabled", "").css("background-color", 'white');
                $("#CardNo").removeAttr("disabled", "").css("background-color", 'white');
                $("#BatchNo").attr("disabled", "disabled").css("background-color", 'lightgrey');
            }
            else
            {
                $("#AccountNo").attr("disabled", "disabled").css("background-color", 'lightgrey');
                $("#CardNo").attr("disabled", "disabled").css("background-color", 'lightgrey');
                $("#BatchNo").attr("disabled", "disabled").css("background-color", 'lightgrey');
            }
        });
    });
    var index = 1;
    $(document).ready(function () {
        $("#allBox").click(function () {
            var type = $lstType.val();

           
            var all = $(".select").attr("checked") ? true : false;
          
            $(".select").attr("checked", $(this).attr("checked") ? true : false);
            $.ajax({
                url: '/Authorization/UpdatingForceSessionAll/',
                data: { ischecked: all, Type: type },
                type: 'get',
                cache: false,
                contentType: 'application/json; charset=utf-8',
                success: function (data) {
                    //  alert(data);
                }
            });
        });
        $("input.select").each(function () {
            $(this).data('row', index);
            $(this).click(function () {
                var type = $lstType.val();
                var tr = $(this).parents('tr:first');
                var CardNumber = tr.find("#lnkAuthCode").text();
        
              

                var Isprinted = tr.find('#IsChecked').attr('checked') ? "True" : "False";


             
                $.ajax({
                    url: '/Authorization/UpdatingForceSession/',
                    data: { CardNumber: CardNumber, ischecked: Isprinted, Type: type },
                    type: 'get',
                    cache: false,
                    contentType: 'application/json; charset=utf-8',
                    success: function (data) {
                       
                        //  alert(data);
                    }
                });
            });
            index++;
        });

        $("#SearchButton").click(function () {

            $.ajax({
                type: 'POST',
                url: '/Authorization/DeletingSessionData',
                success: function (returnData) {

                    if (returnData.RedirectUrl.length > 0) {

                        window.location.href = returnData.RedirectUrl;
                        return true;
                    }

                }

            });

        });



    })

</script>
@using CC_Ingenio.Web.ViewModel.Authorization;
@model ForceAuthorizationSearch
@{
        
    var grid = new WebGrid(Model.SearchResults,
                defaultSort: "AccountNo",//selectionFieldName: "AuthCode",
                rowsPerPage: 5);

    List<SelectListItem> AuthCodeItems = new List<SelectListItem>();
    AuthCodeItems.Add(new SelectListItem { Text = "Select", Value = String.Empty });
    foreach (var itm in ViewBag.AuthCodeList)
    {
        AuthCodeItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }
    List<SelectListItem> AuthStatusItems = new List<SelectListItem>();
    AuthStatusItems.Add(new SelectListItem { Text = "Select", Value = String.Empty });
    foreach (var itm in ViewBag.AuthStatusList)
    {
        AuthStatusItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }

    List<SelectListItem> TypeItems = new List<SelectListItem>();
    TypeItems.Add(new SelectListItem { Text = "Select", Value = String.Empty });
    TypeItems.Add(new SelectListItem { Text = "Batch", Value = "BT" });
    TypeItems.Add(new SelectListItem { Text = "Manual", Value = "ML" });
    


    


    
}
