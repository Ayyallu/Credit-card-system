                            <div class="label ">@Resources.CardNumber</div>
                            <div class="Field">
@*                                @Html.TextBoxFor(x => x.CardNumber, new { @class = "NumericOnly", id = "CardNumber", name = "CardNumber", maxlength = 16, @onchange = "onchangeevent();" })
                                @Html.ValidationMessageFor(x => x.CardNumber)*@
