@using CC_Ingenio.Web.ViewModel.Master;
@using CC_Ingenio_Resources;

@{
    ViewBag.Title = String.Concat(new object[] { Resources.UFRATE_SETTINGS, " ", Resources.Search });
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model UFRateSettingsSearch
@{
    var grid = new WebGrid(Model.SearchResults, canPage: true, rowsPerPage: CC_Ingenio.Common.Utils.Utils.GRD_ROWS_PER_PAGE, selectionFieldName: "", ajaxUpdateContainerId: "container-body");
    grid.Pager(WebGridPagerModes.All);

    List<SelectListItem> MonthItems = new List<SelectListItem>();
    foreach (var itm in ViewBag.Month)
    {
        MonthItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }

    List<SelectListItem> YearItems = new List<SelectListItem>();
    foreach (var itm in ViewBag.Year)
    {
        YearItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }
        
 }


<script>
    $(document).ready(function () {
        $("#SearchButton").click(function (e) {
            if ($('#BillMonth').val() == "" || $('#BillYear').val() == "") {
                $('#SearchFilter_Validate').text("@Html.Raw(@String.Format(Resources.MsgErrPleaseSelect, Resources.SearchCriteria))");
                    e.preventDefault;
                    return false;
            }
        });

        $(function () {
            $("#BillMonth").change(function () {
                $('#SearchFilter_Validate').text("");
            });
        });

        $(function () {
            $("#BillYear").change(function () {
                $('#SearchFilter_Validate').text("");
            });
        });
    })
</script>


<section class="feature">

    <div class="PageTitle">@ViewBag.Title</div>

    <div class="PageRow">
        
        <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            <li class="active">@Html.ActionLink(Resources.SearchPageHeading,"UFRateSettingsList","Master" )</li>
            <li> @Html.ActionLink(Resources.DetailsPageHeading,"UFRateSettingsAdd","Master" )</li>
        </ul>

        <!-- Tabs Content -->
        <div class="tabs-container">
            <div class="tab-content" id="tab1">
                <div class="row">
                    @using (Html.BeginForm("UFRateSettingsList", "Master", FormMethod.Get, new { id = "frmList", name = "frmList" }))
                    {
                        <div class="SearchBox">
                            <div class="row">

                                <div class="row">
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.Month</div>
                                         <div class="Field">
                                             <span>@Html.DropDownListFor(x => x.BillMonth, MonthItems.AsEnumerable(), new {id="BillMonth", @class = "inline", style="width:30%"})</span>
                                             <span><label class="inline" style="font-size:100%; padding:6% 6% 0% 4%"> @Resources.Year </label></span>
                                             <span>@Html.DropDownListFor(x => x.BillYear, YearItems.AsEnumerable(), new {id ="BillYear", @class = "inline", style="width:30%; float:right"})</span>
                                             <label id="SearchFilter_Validate" class="validationMessage"></label>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">                                                          
                                <div class="SearchColumnbtn">
                                    <span>
                                        <input id="SearchButton" name="SearchButton" class="Greenbutton" type="submit" value="@Resources.Search" />
                                    </span>
                                    <span>
                                        <input id="Button2" type="submit" name ="ClearButton"  class="Greenbutton" value="@Resources.Clear" />
                                    </span>
                                </div>
                                </div>
                            </div>
                            <div class="clear"></div>
                        </div>

                    }

                </div>
                <div class="row">
                   
                    <div class="standard-table">

                        @grid.GetHtml(alternatingRowStyle:"alt",columns:grid.Columns(
                                    grid.Column("EffectiveDate", Resources.EffectiveDate,format:@<text> @item.EffectiveDate.ToShortDateString()</text>),  
                                    grid.Column("UFRate",Resources.UFRate, format:@<text>@string.Format("{0:N5}",item.UFRate)</text>, style: "gridAmountRightAlign"),
                                    grid.Column(Resources.Edit, format: 
                                        (item) =>
                                            {
                                                return Html.Raw(Html.ActionLink(Resources.Edit, "UFRateSettingsAdd", "Master", new { Id = item.EffectiveDate.ToString("dd-MM-yyyy") }, null));
                                            })
        
                    ))      

                    </div>
                </div>
            </div>

        </div>

    </div>

</section>
