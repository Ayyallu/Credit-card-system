@{
    ViewBag.Title = String.Concat(new object[] {Resources.Search, " ", Resources.Currency});
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using CC_Ingenio.Web.ViewModel.Master
@using CC_Ingenio_Resources



@model CurrencySearch
@{
    var grid = new WebGrid(Model.SearchResults, canSort: false, canPage: true, rowsPerPage: CC_Ingenio.Common.Utils.Utils.GRD_ROWS_PER_PAGE, selectionFieldName: "", ajaxUpdateContainerId: "container-body");
    grid.Pager(WebGridPagerModes.All);
    List<string> lstPriv = new List<string>();
    if (ViewBag.Privileges != null)
    {

        foreach (var item in ViewBag.Privileges)
        {
            lstPriv.Add(item);
        }
    }
}


<section class="featured">

    <div class="PageTitle">@ViewBag.Title</div>

    <!-- Tabs
	================================================== -->

    <div class="PageRow">


        <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            <li class="active">@Html.ActionLink(Resources.SearchPageHeading,"CurrencyList","Master" )</li>
            <li>@Html.ActionLink(Resources.DetailsPageHeading,"CurrencyAdd","Master" )</li>
        </ul>

        <!-- Tabs Content -->
        <div class="tabs-container">
            <div class="tab-content" id="tab1">
                <div class="row">
                    @using (Html.BeginForm("CurrencyList", "Master", FormMethod.Get, new { id="frmList", name="frmList"}))
                    {
                        <div class="SearchBox">
                            <div class="row">
                                <div class="row">
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.CurrencyCode</div>
                                        <div class="Field">
                                            @Html.TextBoxFor(x => x.CurrencyCode, new { maxlength = 5 })
                                        </div>
                                    </div>
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.CurrencyName</div>
                                        <div class="Field">
                                            @Html.TextBoxFor(x => x.CurrencyName, new { maxlength = 50 })
                                        </div>
                                    </div>

                                </div>

                                <div class="SearchColumnbtn">
                                    <span>
                                        <input id="SearchButton" name="SearchButton" class="Greenbutton" type="submit" value="@Resources.Search"  />
                                    </span>
                                    <span>
                                        <input id="Button2" type="submit" name ="ClearButton"  class="Greenbutton" value="@Resources.Clear" />
                                    </span>
                                </div>
                            </div>
                            <div class="clear"></div>
                        </div>

                    }

                </div>
                <div class="row">

                    <div class="standard-table">


                        @grid.GetHtml(alternatingRowStyle: "alt", columns:grid.Columns(
                        
                                    grid.Column("CurrencyCode", Resources.CurrencyCode), 
                                    grid.Column("CurrencyName", Resources.CurrencyName),
                                    grid.Column("CountryCode", Resources.CountryCode),
                                    grid.Column("ApprovalStatusDesc", Resources.Status),
                                    grid.Column(Resources.Edit, format:
                                        (item) =>
                                        {
                                            if (item.ApprovalStatus.Equals("D") || item.ApprovalStatus.Equals("R"))
                                            {
                                                return Html.Raw(Html.Raw(Html.ActionLink(Resources.Edit, "CurrencyAdd", "Master", new { ACurrencyCode = item.CurrencyCode, AOrganizationCode = item.OrganizationCode }, null)));
                                               
                                            }
                                            else
                                            {
                                                return Html.Raw(Html.ActionLink(Resources.View, "CurrencyView", "Master", new { ACurrencyCode = item.CurrencyCode, AOrganizationCode = item.OrganizationCode }, null)); 
                                            }
                                        }),
                                    grid.Column(Resources.Delete, format:
                                        (item) =>
                                                 {
                                                     if (lstPriv.Contains("Delete"))
                                                     {
                                                         if (item.ApprovalStatus.Equals("D") || item.ApprovalStatus.Equals("R") || item.ApprovalStatus.Equals("A"))
                                                         {
                                                             return Html.Raw(Html.ActionLink(Resources.Delete, "CurrencyDelete", "Master", new { ACurrencyCode = item.CurrencyCode, AOrganizationCode = item.OrganizationCode }, new { @class = "delete-link" }));
                                                         }
                                                         else
                                                         {
                                                             return Html.Raw("");
                                                         }
                                                     }
                                                     else
                                                     {
                                                         return Html.Raw("");
                                                     }
                                        })
                        ))

                        @if (grid.HasSelection)
                    {
                        var ct = (CC_Ingenio.DataTranfer.MasterInfo.CurrencyDTO)grid.Rows[grid.SelectedIndex].Value;
                            <b>First Name </b> @ct.CurrencyCode <br />
                            <b>Last Name </b> @ct.CurrencyName <br />
                            <b>Mobile </b> @ct.CountryCode<br />
                    
                    }

                    </div>
                </div>
            </div>


        </div>

    </div>

</section>
