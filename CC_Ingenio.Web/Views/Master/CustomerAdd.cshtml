<script type="text/javascript">   

function ValidateRUT(){
    var objRUT = $(this); 
        
    if((objRUT[0]['CompanyRUT'] != "" && 
        objRUT[0]['CompanyRUT'] != "________-_"/*For IE*/) && (objRUT[0]['CompanyRUT']._latestValue != "" && 
        objRUT[0]['CompanyRUT']._latestValue != "________-_"/*For IE*/))
    {
        $.ajax({
            type: 'POST',
            url:'/CardBooking/CheckIfValidCard',
            data: { Id: objRUT[0]['CompanyRUT'] },
            success: function(returnData){
                if(!returnData.Isvalid){                       
                    alert('Invalid RUT');
                    $('#CompanyRUT').focus();
                }
            }
        })
    }
};

    function ValidateCustomerDesignation () {
        var objOccupation = $(this);
        var designationCode = objOccupation[0]['Post']._latestValue;
        if(designationCode!="")
        {
            $.ajax({
                type: 'POST',
                url: '/Master/ValidateCustomerDesignationForHRP',
                data: { ADesignationCode: designationCode },
                success: function (returnData) {
                    ShowSimpleModalDialog(returnData.Message, "");
                }
            });
        }
    };

    function ConctractOnChange (){
        if('@Model.CustomerId' != 0)
         {
             if ($('#Contract').val() == '') {
                 $('#lblValidateContract').text('Please select Contract');
             }
             else {
                 $('#lblValidateContract').text('');
             }
         }
    };

    function CommunaOnChange (){
        if('@Model.CustomerId' != 0){
            var objCommunaList = $('[id = Communa]');
            var objValidationList = $('[id = lblValidateCommuna]');
            $.each(objCommunaList,function(index){
                if(CustomerValue.CustomerAddressDTO[index]){
                    if ($(this).val() == '') {
                        $(objValidationList[index]).text('Please select Communa');                    
                    }
                    else {
                        if($(objValidationList[index]).text().length > 0)
                        {
                            $(objValidationList[index]).text('');                        
                        }
                    }
                }
            });
        }
    };

    function RegionOnChange (){
        if('@Model.CustomerId' != 0)
        {
            var objRegionList = $('[id = Region]');
            var objValidationList = $('[id = lblValidateRegion]');
            $.each(objRegionList,function(index){
                if(CustomerValue.CustomerAddressDTO[index]){
                    if ($(this).val() == '') {
                        $(objValidationList[index]).text('Please select Region');                    
                    }
                    else {
                        if($(objValidationList[index]).text().length > 0)
                        {
                            $(objValidationList[index]).text('');                        
                        }
                    }
                }
            });
         }
     };
   
    $(document).ready(function(){

        $('.RUTNumber').blur(function(){
            var objRUT = $(this);
            if(objRUT.val() != "")
            {
                $.ajax({
                    type: 'POST',
                    url:'/CardBooking/CheckIfValidCard',
                    data: { Id: objRUT.val() },
                    success: function(returnData){
                        if(!returnData.Isvalid){
                            //ShowSimpleModalDialog("Invalid RUT","");
                            alert('Invalid RUT');
                            objRUT.focus();
                        }
                    }
                })
            }
        });

        $('#Product').change(function(){
            if('@Model.CustomerId' != 0)
            {
                var productCode = $('#Product').val();
                if(productCode == ''){
                    $('#lblValidateProduct').text('Please select Product');
                    $('#Contract').empty();
                    $('#Contract').append($('<option/>',
                       {
                           value: 0,
                           text: "@Resources.SelectOne"
                       }));
                }
                else{
                    $('#lblValidateProduct').text('');
                    PopulateDropDownViaAjax("#Contract", "/Master/GetContractByProductCode?AProductCode=" + productCode);
                    if($('#Contract').length == 0){
                        $('#Contract').append($('<option/>',
                        {
                            value: 0,
                            text: "@Resources.SelectOne"
                        }));
                    }
                }
            }

        });
       
        /*To restrict cut/copy/paste*/
        $('.restrictCutCopyPaste').bind('copy paste cut', function (e) {
            e.preventDefault();
        });
    }); 
</script>

