@using CC_Ingenio_Resources;
@using CC_Ingenio.DataTranfer.MasterInfo;
@using CC_Ingenio.Web.Helpers;

@model CreditSegmentDTO

@{
    ViewBag.Title = String.Concat(new object[] { Resources.Add, " ", Resources.CreditSegment });
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    List<SelectListItem> legalEntityList = new List<SelectListItem>();
    List<string> lstPriv = new List<string>();
    
    foreach (var item in ViewBag.LegalEntity)
    {
        legalEntityList.Add(new SelectListItem { Text = item.Text, Value = item.Value });
    }

    if (ViewBag.Privileges != null)
    {

        foreach (var item in ViewBag.Privileges)
        {
            lstPriv.Add(item);
        }
    }
}

<style type="text/css">
    .label {
    width:26% !important;
    }
</style>
<script type="text/javascript">

    function setCalenderDates() {

        var fromDate = $('#FromDate').val();
        var toDate = $('#ToDate').val();

        $('#FromDate').datepicker("option", "maxDate", toDate);
        $('#ToDate').datepicker("option", "minDate", fromDate);       

    }

    $(document).ready(function () {
        $('#FromDate').datepicker("option", "onSelect", setCalenderDates);
        $('#ToDate').datepicker("option", "onSelect", setCalenderDates);
    });

    $(document).ready(function () {

        $("#frmCreditSegment").submit(function (e) {

            if ($('#CardSegmentCode').val().trim() <= parseFloat(0)) {
                $('#CardSegmentCode_Validate').text("@Html.Raw(String.Format(Resources.MsgErrValueNotZero, Resources.CreditSegmentCode))");
                e.preventDefault();
            }
        })

        $('#CardSegmentCode').focusin(function () {
            $('#CardSegmentCode_Validate').text("");
        });

    });
</script>

@section featured{}


<section class ="featured">
     <div class="PageTitle">@ViewBag.Title</div>
    <div class="PageRow">

        <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            @if (ViewData["FormCall"] != "ApprovalQueue")
            {
                <li> @Html.ActionLink(Resources.SearchPageHeading,"CreditSegmentList","Master" )</li>
            }
            <li class="active"><a href="#tab1">@Resources.DetailsPageHeading</a></li>
        </ul>
       
            <!-- Tabs Content -->
            <div class="tabs-container">
                 @using (Html.BeginForm("CreditSegmentSave", "Master", new { ACardSegmentCode = Model.CardSegmentCode, AOrganizationCode = Model.OrganizationCode }, FormMethod.Post, new { id = "frmCreditSegment", name = "frmCreditSegment" }))
                 {
                <div class="tab-content" id="tab1">
                    <div>
                        <span>
                            @if (!string.IsNullOrWhiteSpace(Model.ApprovalStatus))
                            { 
                                <text> @String.Concat(new object[] { Resources.Status, ":", Model.ApprovalStatusDesc }) </text>
                            }
                        </span>
                    </div>
                    <div class="row">
                       

                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label">@Resources.CreditSegmentCode</div>
                                <div class="Field">
                                    @if (!string.IsNullOrWhiteSpace(Model.CardSegmentCode))
                                    { 
                                        @Html.TextBoxFor(x => x.CardSegmentCode, new { id = "CardSegmentCode", name = "CardSegmentCode", maxlength = 5, @readonly = "readonly" })
                                    }
                                    else
                                    {
                                        @Html.TextBoxFor(x => x.CardSegmentCode, new { id = "CardSegmentCode", name = "CardSegmentCode", maxlength = 5 })
                                    }
                                    @Html.ValidationMessageFor(x => x.CardSegmentCode)
                                     <label id="CardSegmentCode_Validate" class="validationMessage"></label>
                                </div>
                            </div>
                            <div class="TwoColumn">
                                <div class="label">@Resources.CreditSegmentName</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.CardSegmentName, new { id = "CardSegmentName", name = "CardSegmentName", maxlength = 50 })
                                    @Html.ValidationMessageFor(x => x.CardSegmentName)
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label fontmandatory">@Resources.EffectiveFromDate</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.EffectiveFromDate, new {id = "FromDate", @class ="datepicker", @readonly="true", Value = Model.EffectiveFromDate.ToShortDateString() })
                                    @Html.ValidationMessageFor(x => x.EffectiveFromDate)
                                </div>
                            </div>
                            <div class="TwoColumn">
                                <div class="label fontmandatory">@Resources.EffectiveToDate</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.EffectiveToDate, new { id = "ToDate", @class ="datepicker", @readonly="true", Value = Model.EffectiveToDate.ToShortDateString() })
                                    @Html.ValidationMessageFor(x => x.EffectiveToDate)
                                </div>
                            </div>
                        </div>
                                                                    
                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label fontmandatory">@Resources.LegalEntity</div>
                                <div class="Field">
                                    @Html.DropDownListFor(x => x.LegalEntityCode, legalEntityList)
                                    @Html.ValidationMessageFor(x => x.LegalEntityCode)
                                </div>
                            </div>
                            <div class="TwoColumn">
                                <div class="label fontmandatory">@Resources.OTBReplenishment</div>
                                <div>
                                    @Html.CheckBoxFor(x => x.IsOTBReplenishment)
                                    @Html.ValidationMessageFor(x => x.IsOTBReplenishment)
                                </div>
                            </div>
                        </div>


                    @Html.Raw(Html.BasicButtons(lstPriv))

                    </div>
                </div>
                 }

            </div>
        

    </div>

</section>
<script>
    $(function () {
        setCalenderDates();

        if ('@ViewData["FormCall"]' != "ApprovalQueue") {
            DisableBtnAuthorize();
        }
    })
</script>