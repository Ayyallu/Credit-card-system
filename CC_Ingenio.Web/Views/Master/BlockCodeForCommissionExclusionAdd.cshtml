@using CC_Ingenio.DataTranfer.MasterInfo;
@using CC_Ingenio.Web.Helpers;
@using CC_Ingenio_Resources;
@model BlockCodeForCommissionExclusionDTO

@{
    ViewBag.Title = String.Concat(new object[] { Resources.Add, " ", Resources.BlockCodeForCommissionExclusion  });
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    List<SelectListItem> blockCodeList = new List<SelectListItem>();
    List<string> lstPriv = new List<string>();
    
    foreach (SelectListItem item in ViewBag.BlockCodeList) 
    {
        blockCodeList.Add(new SelectListItem() { Text = item.Text, Value = item.Value });
    }

    List<SelectListItem> commissionList = new List<SelectListItem>();
    foreach (SelectListItem item in ViewBag.CommissionList)
    {
        commissionList.Add(new SelectListItem() { Text = item.Text, Value = item.Value });
    }
    
    if (ViewBag.Privileges != null)
    {

        foreach (var item in ViewBag.Privileges)
        {
            lstPriv.Add(item);
        }
    }
}
@section featured{}

<section class ="featured">
     <div class="PageTitle">@ViewBag.Title</div>
    <div class="PageRow">

        <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            @if (ViewData["FormCall"] != "ApprovalQueue")
            {
                <li> @Html.ActionLink(Resources.SearchPageHeading,"BlockCodeForCommissionExclusionList","Master" )</li>
            }
            <li class="active">@Html.ActionLink(Resources.DetailsPageHeading,"BlockCodeForCommissionExclusionAdd","Master" )</li>
        </ul>
       
            <!-- Tabs Content -->
            <div class="tabs-container">
                 @using (Html.BeginForm("BlockCodeForCommissionExclusionSave", "Master", new { Id = Model.BlockCodeForCommissionExclusionId, }, FormMethod.Post))
                {
                <div class="tab-content" id="tab1">
                    <div>
                        <span>
                            @if (!string.IsNullOrWhiteSpace(Model.ApprovalStatusDesc))
                            { 
                                <text>@String.Concat(new object[] { Resources.Status, ":", Model.ApprovalStatusDesc })</text>
                            }
                        </span>
                    </div>
                    <div class="row">

                      
                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label">@Resources.BlockCode</div>
                                <div class="Field">
                                    @Html.DropDownListFor(x => x.BlockCode, blockCodeList)
                                    @Html.ValidationMessageFor(x => x.BlockCode)
                                </div>
                            </div>
                           <div class="TwoColumn">
                                <div class="label">@Resources.Commission</div>
                                <div class="Field">
                                    @Html.DropDownListFor(x => x.CommissionCode, commissionList)
                                    @Html.ValidationMessageFor(x => x.CommissionCode)
                                </div>
                            </div>
                        </div>

                        <div class="row">
                             <div class="TwoColumn">
                                <div class="label">@Resources.InclusionOfCharges</div>
                                <div>
                                    @Html.CheckBoxFor(x => x.IsIncludeCharges)
                                    @Html.ValidationMessageFor(x => x.IsIncludeCharges)
                                </div>
                            </div>
                        </div>

                        @Html.Raw(Html.BasicButtons(lstPriv))

                    </div>
                </div>
                 }

            </div>
        

    </div>

</section>
<script>
    $(function () {
        if ('@ViewData["FormCall"]' != "ApprovalQueue") {
            DisableBtnAuthorize();
        }
    })
</script>
