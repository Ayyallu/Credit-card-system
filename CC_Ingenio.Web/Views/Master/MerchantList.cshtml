
@using CC_Ingenio.Web.ViewModel.Master;
@using CC_Ingenio_Resources;

@{
    ViewBag.Title = String.Concat(new object[] { Resources.Merchant, " ", Resources.Search });
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model MerchantSearch
@{
    
    var grid = new WebGrid(Model.SearchResults, canPage: true, rowsPerPage: CC_Ingenio.Common.Utils.Utils.GRD_ROWS_PER_PAGE, selectionFieldName: "", ajaxUpdateContainerId: "container-body");
    grid.Pager(WebGridPagerModes.All);

    List<SelectListItem> CountryItems = new List<SelectListItem>();
    foreach (var itm in ViewBag.Countries)
    {
        CountryItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }
    CountryItems.RemoveAt(0);
    CountryItems.Insert(0, new SelectListItem { Text = string.Empty, Value = string.Empty }); List<string> lstPriv = new List<string>();
    if (ViewBag.Privileges != null)
    {

        foreach (var item in ViewBag.Privileges)
        {
            lstPriv.Add(item);
        }
    }
}

