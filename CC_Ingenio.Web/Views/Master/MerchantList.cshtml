<section class="feature">
    <div class="PageTitle">@ViewBag.Title</div>
    <div class="PageRow">
          <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            <li class="active">@Html.ActionLink(Resources.SearchPageHeading,"MerchantList","Master" )</li>
            <li> @Html.ActionLink(Resources.DetailsPageHeading,"MerchantsAdd","Master" )</li>
            
        </ul>


              <!-- Tabs Content -->
        <div class="tabs-container">
            <div class="tab-content" id="tab1">
                <div class="row">
                      @using (Html.BeginForm("MerchantList", "Master", FormMethod.Get, new { id = "frmList", name = "frmList" }))
                    {
                        <div class="SearchBox">
                            <div class="row">
                                <div class="row">
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.MerchantCode</div>
                                        <div class="Field">
                                                @Html.TextBoxFor(x => x.MerchantCode, new { maxlength = 11 })
                                        </div>
                                    </div>
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.MerchantName</div>
                                        <div class="Field">
                                            @Html.TextBoxFor(x=>x.MerchantName, new { maxlength = 50 })
                                        </div>
                                    </div>
                                </div>
                                <div class="row">                                   
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.Country</div>
                                        <div class="Field">
                                            @Html.DropDownListFor(x=>x.CountryCode,CountryItems)
                                        </div>
                                    </div>
                                     <div class="TwoColumn">
                                        <div class="label">&nbsp;</div>
                                        <div class="Field">&nbsp;</div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="SearchColumnbtn">
                                        <span>
                                            <input id="SearchButton" name="SearchButton" class="Greenbutton" type="submit" value="@Resources.Search" />
                                        </span>

                                        <span>
                                            <input id="Button2" type="submit" name="ClearButton" class="Greenbutton" value="@Resources.Clear" />
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="clear"></div>

                        </div>
                    }

                    </div>

                  <div class="row">
                   
                    <div class="standard-table">
                        @grid.GetHtml(columns:grid.Columns(
                                    grid.Column("MerchantCode",Resources.MerchantCode),
                                    grid.Column("MerchantName",Resources.MerchantName),
                                    grid.Column("CountryDesc",Resources.Country),
                                    //grid.Column("RegionDesc", Resources.Region),
                                    //grid.Column("CityDesc", Resources.City),
                                    //grid.Column("CommunaDesc",Resources.Communa),
                                    grid.Column("ApprovalStatusDesc", Resources.Status),                                    
                                    grid.Column(Resources.Edit, format: 
                                        (item) =>
                                            {
                                                if (item.ApprovalStatus.Equals("D") || item.ApprovalStatus.Equals("R"))
                                                {
                                                    return Html.Raw(Html.ActionLink(Resources.Edit, "MerchantsAdd", "Master", new { id = item.MerchantCode }, null));
                                                   
                                                }   
                                                else
                                                {
                                                    return Html.Raw(Html.Raw(Html.ActionLink(Resources.View, "MerchantView", "Master", new { id = item.MerchantCode }, null))); 
                                                }
                                            }),
                                    grid.Column(Resources.Delete,   format: 
                                        (item) =>
                                                 {
                                                     if (lstPriv.Contains("Delete"))
                                                     {
                                                         if (item.ApprovalStatus.Equals("D") || item.ApprovalStatus.Equals("R") || item.ApprovalStatus.Equals("A") || item.ApprovalStatus.Equals("EXP"))
                                                         {
                                                             return Html.Raw(Html.ActionLink(Resources.Delete, "MerchantDelete", "Master", new { id = item.MerchantCode }, new { @class = "delete-link" }));
                                                         }
                                                         else
                                                         {
                                                             return Html.Raw("");
                                                         }
                                                     }
                                                     else
                                                     {
                                                         return Html.Raw("");
                                                     }
                                            })
                                   ))
                    </div>
                </div>

                </div>
            </div>

        </div>
    </section>