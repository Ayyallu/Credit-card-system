@{
    ViewBag.Title = String.Concat(new object[] { Resources.Add, " ", Resources.TransactionSubCode });
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using CC_Ingenio.DataTranfer.MasterInfo;
@using CC_Ingenio.Common.Utils;
@using CC_Ingenio.Web.Helpers;
@using CC_Ingenio_Resources;

@model TransactionSubCodeDTO
@{
    List<string> lstPriv = new List<string>();
    if (ViewBag.Privileges != null)
    {

        foreach (var item in ViewBag.Privileges)
        {
            lstPriv.Add(item);
        }
    }
    
    List<SelectListItem> CreditSubSegmentCodeList = new List<SelectListItem>();
    foreach (var item in ViewBag.CreditSubSegmentCodeList)
    {
        CreditSubSegmentCodeList.Add(new SelectListItem { Text = item.Text, Value = item.Value });
    }
    List<SelectListItem> TransactionCodeItems = new List<SelectListItem>();
    foreach (var itm in ViewBag.TransactionCodes)
    {
        TransactionCodeItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }
    
    List<SelectListItem> TransTypeItems = new List<SelectListItem>();
    foreach (var itm in CC_Ingenio.Common.Utils.Utils.GetDebitOrCredit())
    {
        TransTypeItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }

    List<SelectListItem> IncomingTransTypeItems = new List<SelectListItem>();
    foreach (var itm in ViewBag.IncomingTransTypeList)
    {
        //TransTypeItems.RemoveAt(0);
        //TransTypeItems.Insert(0, new SelectListItem { Text = string.Empty, Value = "0" });
        IncomingTransTypeItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }

    List<SelectListItem> FeeTypesItems = new List<SelectListItem>();
    foreach (var itm in ViewBag.FeeTypesList)
    {
        FeeTypesItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }

    List<SelectListItem> SysParamTranSubCodeItems = new List<SelectListItem>();
    foreach (var itm in ViewBag.SysParamTransactionCodes)
    {
        SysParamTranSubCodeItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }
     
 }


<script type="text/javascript">

    $(document).ready(function () {
        
        $("#frmTransactionSubcodes").submit(function (e) {
            if (parseFloat($('#SubCode').val().trim()) <= parseFloat(0)) {
                $('#TransactionSubCode_Validate').text("@Html.Raw(string.Format(Resources.MsgErrValueShouldBeBetween,Resources.TransactionSubCode,"001","999"))");
                e.preventDefault();
            }
        })

        $('#SubCode').focusin(function () {
            $('#TransactionSubCode_Validate').text("");
        });

    });
</script>

<section class="featured">
    <div class="PageTitle">@ViewBag.Title</div>
    <div class="PageRow">

        <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            @if (ViewData["FormCall"] != "ApprovalQueue")
            {
                <li>@Html.ActionLink(Resources.SearchPageHeading, "TransactionSubCodeList", "Master")</li>
            }
            <li class="active"><a href="#tab1">@Resources.DetailsPageHeading</a></li>
        </ul>

        <!-- Tabs Content -->
        <div class="tabs-container">
            @using (Html.BeginForm("TransactionSubCodeSave", "Master", new { Id = Model.TransactionSubCodeId, }, FormMethod.Post, new { id = "frmTransactionSubcodes", name = "frmTransactionSubcodes" }))
            {
                <div class="tab-content" id="tab1">
                    <div>
                        <span>
                            @if (!string.IsNullOrWhiteSpace(Model.ApprovalStatus))
                            { 
                                <text>@String.Concat(new object[] { Resources.Status, ":", Model.ApprovalStatusDesc }) </text>
                            }
                        </span>
                    </div>
                    <div class="row">

                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label">@Resources.TransactionCode</div>
                                <div class="Field">
                                    @if (!string.IsNullOrWhiteSpace(Model.TransactionCode))
                                    {
                                        @Html.DropDownListFor(x => x.TransactionCode, TransactionCodeItems.AsEnumerable(), new { id = "TransactionCode", name = "TransactionCode", maxlength = "3", @disabled = "disabled" })
                                    }
                                    else
                                    {
                                        @Html.DropDownListFor(x => x.TransactionCode, TransactionCodeItems.AsEnumerable(), new { id = "TransactionCode", name = "TransactionCode", maxlength = "3" })
                                    }
                                    @Html.ValidationMessageFor(x => x.TransactionCode)
                                    @Html.HiddenFor(x => x.TransactionCode)
                                </div>
                            </div>
                            <div class="TwoColumn">
                                <div class="label ">@Resources.TransactionSubCode</div>
                                <div class="Field">
                                    @if (!string.IsNullOrWhiteSpace(Model.SubCode))
                                    {
                                        @Html.DropDownListFor(x => x.SubCode, SysParamTranSubCodeItems.AsEnumerable(), new { id = "SubCode", name = "SubCode", maxlength = "3", @disabled = "disabled" })
                                    }
                                    else
                                    {
                                        @Html.DropDownListFor(x => x.SubCode, SysParamTranSubCodeItems.AsEnumerable(), new { id = "SubCode", name = "SubCode", maxlength = "3" })
                                    }
                                    @Html.ValidationMessageFor(x => x.SubCode)
                                    @Html.HiddenFor(x => x.SubCode)
                                    <label id="TransactionSubCode_Validate" class="validationMessage"></label>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label">@Resources.TransactionSubCodeDescription</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.Description, new { id = "Description", name = "Description", maxlength = 50 })
                                    @Html.ValidationMessageFor(x => x.Description)
                                </div>
                            </div>
                            <div class="TwoColumn">
                                <div class="label">@Resources.CreditSubSegment</div>
                                <div class="Field">
                                    @Html.DropDownListFor(x => x.CreditSubSegmentCode, CreditSubSegmentCodeList)
                                    @Html.ValidationMessageFor(x => x.CreditSubSegmentCode)
                                </div>
                            </div>
                        </div>
 
                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label">@Resources.MinimumDuePercentage</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.MinDuePercentage, String.Format("{0:0.00}",Model.MinDuePercentage), new { id = "MinDuePercentage", maxlength = 6, @class = "NumericWithDecimalPlace" })
                                    @*@Html.TextBoxFor(x => x.MinDuePercentage, new { id = "MinDuePercentage", name="MinDuePercentage", maxlength=6, @style="text-align:right" })*@
                                    @Html.ValidationMessageFor(x => x.MinDuePercentage)
                                </div>
                            </div>

                              <div class="TwoColumn">
                                <div class="label">@Resources.DebitCredit</div>
                                <div class="Field">
                                    @Html.DropDownListFor(x => x.IsDebitOrCredit, TransTypeItems.AsEnumerable())
                                    @Html.ValidationMessageFor(x => x.IsDebitOrCredit)
                                </div>
                            </div>
                                         
                        </div>

                        <div class="row">
                     
                            <div class="TwoColumn">
                                <div class="label  fontmandatory">@Resources.IVARequired</div>
                                <div>
                                    @Html.CheckBoxFor(x => x.IsIVARequired)
                                    @Html.ValidationMessageFor(x => x.IsIVARequired)
                                </div>
                            </div>
                               <div class="TwoColumn">
                                <div class="label  fontmandatory">@Resources.LegacyTransactionType</div>
                                <div class="Field">
                                    @Html.DropDownListFor(x => x.IncomingTransType, IncomingTransTypeItems.AsEnumerable())
                                    @Html.ValidationMessageFor(x => x.IncomingTransType)
                                    @Html.HiddenFor(x=>x.IncomingTransType) 
                                </div>
                            </div>
                        </div>                      
                          <div class="row">
                            <div class="TwoColumn">
                                <div class="label  fontmandatory">@Resources.FeeType</div>
                                <div class="Field">
                                    @Html.DropDownListFor(x => x.FeeType, FeeTypesItems.AsEnumerable())
                                    @Html.ValidationMessageFor(x => x.FeeType)
                                </div>
                            </div>
                       
                        </div>
                        @Html.Raw(Html.BasicButtons(lstPriv))

                    </div>
                </div>
            }

        </div>


    </div>
</section>
<script>
    $(function () {
        if ('@ViewData["FormCall"]' != "ApprovalQueue") {
            DisableBtnAuthorize();
        }
    })
</script>
