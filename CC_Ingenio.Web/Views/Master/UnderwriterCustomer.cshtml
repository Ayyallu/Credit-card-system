                insertMessages: true,
                messagesOnModified: false
            });
           
            ko.applyBindings(viewModel);
            
            $("[id=Region]").append($('<option/>',
            {
                value: "",
                text: "@Resources.SelectOne"
            }));
            $("[id=Communa]").append($('<option/>',
            {
                value: "",
                text:"@Resources.SelectOne"
            }));           
            $("[id=Contract]").append($('<option/>',
            {
               value: "",
               text:"@Resources.SelectOne"
            }));
            if (customerId["ACustomerId"] && customerId["ACustomerId"] != 0){
               
                PopulateCascadeDropDownLists("Region",CustomerValue,viewModel);
                PopulateCascadeDropDownLists("Communa",CustomerValue,viewModel);               
            }
            PopulateCascadeDropDownLists("Contract",CustomerValue,viewModel);
            if( viewModel.Customer.RUT._latestValue.length == 6)
            {          
                $('#RUT').mask('99999-*');
            }
            else  if( viewModel.Customer.RUT._latestValue.length == 7)
            { 
                $('#RUT').mask('999999-*');
            }
            else  if( viewModel.Customer.RUT._latestValue.length == 8)
            { 
                $('#RUT').mask('9999999-*');
            }
            else  if( viewModel.Customer.RUT._latestValue.length == 9)
            { 
                $('#RUT').mask('99999999-*');
            }
            else  if( viewModel.Customer.RUT._latestValue.length == 10)
            { 
                $('#RUT').mask('999999999-*');
            }         
      
            
            var errors = ko.validation.group(viewModel.Customer, { deep: true });
            errors.showAllMessages(false);
        });       
       
    </script>
</section>




