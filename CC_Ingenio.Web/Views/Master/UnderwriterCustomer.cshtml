<script type="text/javascript">   
   
    function ConctractOnChange (){
        if('@Model.CustomerId' != 0)
         {
             if ($('#Contract').val() == '') {
                 $('#lblValidateContract').text('Please select Contract');
             }
             else {
                 $('#lblValidateContract').text('');
             }
         }
    };

    function CommunaOnChange (){
        if('@Model.CustomerId' != 0){
            var objCommunaList = $('[id = Communa]');
            var objValidationList = $('[id = lblValidateCommuna]');
            $.each(objCommunaList,function(index){
                if(CustomerValue.CustomerAddressDTO[index]){
                    if ($(this).val() == '') {
                        $(objValidationList[index]).text("@Html.Raw(string.Format(Resources.MsgErrPleaseSelect,Resources.Communa))");                    
                    }
                    else {
                        if($(objValidationList[index]).text().length > 0)
                        {
                            $(objValidationList[index]).text('');                        
                        }
                    }
                }
            });
        }
    };

    function RegionOnChange (){
        if('@Model.CustomerId' != 0)
        {
            var objRegionList = $('[id = Region]');
            var objValidationList = $('[id = lblValidateRegion]');
            $.each(objRegionList,function(index){
                if(CustomerValue.CustomerAddressDTO[index]){
                    if ($(this).val() == '') {
                        $(objValidationList[index]).text("@Html.Raw(string.Format(Resources.MsgErrPleaseSelect,Resources.Region))");                    
                    }
                    else {
                        if($(objValidationList[index]).text().length > 0)
                        {
                            $(objValidationList[index]).text('');                        
                        }
                    }
                }
            });
         }
    };
   
    $(document).ready(function(){         
      
        //$('#CorporateRUT').mask('999999999-*');

        $('#CreditScore').focusout(function(){
            if($('#CreditScore').val() > 0){
                $('#lblValidateCreditScore').text('');
            }
        });

        $('#CreditLimit').focusout(function(){
            if($('#CreditLimit').val() > 0){
                $('#lblValidateCreditLimit').text('');
            }
        });

        $('#Remarks').focusout(function(){
            if($('#Remarks').val()){
                $('#lblValidateRemarks').text('');
            }
        });
    });
</script>

