@using CC_Ingenio.Web.ViewModel.Master;
@using CC_Ingenio_Resources;

@{
    ViewBag.Title = String.Concat(new object[] { Resources.DiscountPercentage, " ", Resources.Search });
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@model DiscountPercentageSearch
@{
    var grid = new WebGrid(Model.SearchResults, canPage: true, rowsPerPage: CC_Ingenio.Common.Utils.Utils.GRD_ROWS_PER_PAGE, selectionFieldName: "ADiscountPercentageId", ajaxUpdateContainerId: "container-body");
    grid.Pager(WebGridPagerModes.All);

    List<SelectListItem> ProductListItems = new List<SelectListItem>();

    foreach (var itm in ViewBag.ProductList)
    {
        ProductListItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }
    ProductListItems.RemoveAt(0);
    ProductListItems.Insert(0, new SelectListItem { Text = string.Empty, Value = string.Empty });

    List<SelectListItem> CustomerSegmentListItems = new List<SelectListItem>();
    foreach (var itm in ViewBag.CustomerSegmentList)
    {
        CustomerSegmentListItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }
    CustomerSegmentListItems.RemoveAt(0);
    CustomerSegmentListItems.Insert(0, new SelectListItem { Text = string.Empty, Value = string.Empty });

    List<SelectListItem> CustomerSubSegmentListItems = new List<SelectListItem>();
    foreach (var itm in ViewBag.CustomerSubSegmentList)
    {
        CustomerSubSegmentListItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }
    CustomerSubSegmentListItems.RemoveAt(0);
    CustomerSubSegmentListItems.Insert(0, new SelectListItem { Text = string.Empty, Value = string.Empty });
    List<string> lstPriv = new List<string>();
    if (ViewBag.Privileges != null)
    {

        foreach (var item in ViewBag.Privileges)
        {
            lstPriv.Add(item);
        }
    }
    
}


<section class="feature">

    <div class="PageTitle">@ViewBag.Title</div>

    <!-- Tabs
	================================================== -->

    <div class="PageRow">

        <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            <li class="active">@Html.ActionLink(Resources.SearchPageHeading,"DiscountPercentageList","Master" )</li>
            <li> @Html.ActionLink(Resources.DetailsPageHeading,"DiscountPercentageAdd","Master" )</li>
        </ul>

        <!-- Tabs Content -->
        <div class="tabs-container">
            <div class="tab-content" id="tab1">
                <div class="row">
                    @using (Html.BeginForm("DiscountPercentageList", "Master", FormMethod.Get, new { id = "frmList", name = "frmList" }))
                    {
                        <div class="SearchBox">
                            <div class="row">
                                <div class="row">
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.Product</div>
                                        <div class="Field" style="padding-left:5px">
                                            @Html.DropDownListFor(x=>x.ProductCode, ProductListItems)
                                        </div>
                                    </div>
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.CustomerSegment</div>
                                        <div class="Field">
                                            @Html.DropDownListFor(x=>x.CustomerSegmentCode, CustomerSegmentListItems)
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.CustomerSubSegment</div>
                                        <div class="Field" style="padding-left:5px">
                                            @Html.DropDownListFor(x=>x.CustomerSubSegmentCode, CustomerSubSegmentListItems)
                                        </div>
                                    </div>
                                </div>

                                <div class="SearchColumnbtn">
                                    <div class="row">
                                        <span>
                                            <input id="SearchButton" name="SearchButton" class="Greenbutton" type="submit" value="@Resources.Search" />
                                        </span>
                                        <span>
                                            <input id="Button2" type="submit" name ="ClearButton"  class="Greenbutton" value="@Resources.Clear" />
                                        </span>
                                    </div>
                                </div>                                
                            </div>
                            <div class="clear"></div>
                        </div>
                    }

                </div>
                <div class="row">
                   
                    <div class="standard-table">

                        @grid.GetHtml(columns:grid.Columns(
                                    grid.Column("ProductName",Resources.Product),
                                    grid.Column("SegmentName",Resources.CustomerSegment),
                                    grid.Column("SubSegmentName",Resources.CustomerSubSegment),
                                    grid.Column("ValidFrom",Resources.ValidFrom,format:@<text> @item.ValidFrom.ToShortDateString()</text>),
                                    grid.Column("ValidTo",Resources.ValidTo,format:@<text> @item.ValidTo.ToShortDateString()</text>),
                                    grid.Column("ApprovalStatusDesc", Resources.Status),
                                    grid.Column(Resources.Edit, format: 
                                        (item) =>
                                            {
                                                if (item.ApprovalStatus.Equals("D") || item.ApprovalStatus.Equals("R"))
                                                {
                                                    return Html.Raw(Html.ActionLink(Resources.Edit, "DiscountPercentageAdd", "Master", new { ADiscountPercentageId = item.DiscountPercentageId }, null));
                                                }   
                                                else
                                                {
                                                    return Html.Raw(Html.Raw(Html.ActionLink(Resources.View, "DiscountPercentageView", "Master", new { ADiscountPercentageId = item.DiscountPercentageId }, null)));  
                                                }
                                            }),
                                    grid.Column(Resources.Delete,   format: 
                                        (item) =>
                                                             {
                                                                 if (lstPriv.Contains("Delete"))
                                                                 {
                                                                     if (item.ApprovalStatus.Equals("D") || item.ApprovalStatus.Equals("R") || item.ApprovalStatus.Equals("A"))
                                                                     {
                                                                         return Html.Raw(Html.ActionLink(Resources.Delete, "DiscountPercentageDelete", "Master", new { ADiscountPercentageId = item.DiscountPercentageId, ASearchGridClick = true }, new { @class = "delete-link" }));
                                                                     }
                                                                     else
                                                                     {
                                                                         return Html.Raw("");
                                                                     }
                                                                 }
                                                                 else
                                                                 {
                                                                     return Html.Raw("");
                                                                 }
                                            })
                    ))

                    </div>
                </div>
            </div>


        </div>

    </div>

</section>


