@{
    ViewBag.Title = String.Concat(new object[] { Resources.Add, " ", Resources.Calendar }); ;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using CC_Ingenio_Resources;
@using CC_Ingenio.DataTranfer.MasterInfo;
@using CC_Ingenio.Web.Helpers;

@model CalendarDateMaintenanceDTO
@{
    List<string> lstPriv = new List<string>();
    
    List<SelectListItem> TypeItems = new List<SelectListItem>();
    foreach (var itm in ViewBag.TypeList)
    {
        TypeItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }

    if (ViewBag.Privileges != null)
    {

        foreach (var item in ViewBag.Privileges)
        {
            lstPriv.Add(item);
        }
    }
    
    
}

@section featured {
}

<section class="featured">
    <div class="PageTitle">@ViewBag.Title </div>
    <div class="PageRow">


        <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            @if (ViewData["FormCall"] != "ApprovalQueue")
            {
                <li> @Html.ActionLink(Resources.SearchPageHeading,"CalendarDateMaintenanceList","Master" )</li>
            }
            <li class="active">@Html.ActionLink(Resources.DetailsPageHeading,"CalendarDateMaintenanceAdd","Master" )</li>
        </ul>
       
            <!-- Tabs Content -->
            <div class="tabs-container">
                 @using (Html.BeginForm("CalendarDateMaintenanceSave", "Master", new { Id = Convert.ToString(Model.Id), }, FormMethod.Post))
                {
                <div class="tab-content" id="tab1">
                    <div>
                        <span>
                            @if (!string.IsNullOrWhiteSpace(Model.ApprovalStatus))
                            { 
                                <text>@String.Concat(new object[] { Resources.Status, ":", Model.ApprovalStatusDesc }) </text>
                            }
                        </span>
                    </div>
                    <div class="row">
                        
                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label">@Resources.Type</div>
                                <div class="Field">
                                    @Html.DropDownListFor(x => x.Type, TypeItems.AsEnumerable(), new { id = "Type", name = "Type" })
                                    @Html.ValidationMessageFor(x => x.Type)
                                </div>
                            </div>
                            <div class="TwoColumn">
                                <div class="label">@Resources.Date</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.Date, new {id = "Date", @class ="datepicker", @readonly="true", Value = Model.Date.ToShortDateString() })
                                    @Html.ValidationMessageFor(x => x.Date)
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label">@Resources.Description</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.Description,new { id = "Description", name="Description", maxlength = "50"  })
                                    @Html.ValidationMessageFor(x => x.Description)
                                </div>
                            </div>
                            <div class="TwoColumn">
                                <div class="label">&nbsp;</div>
                                <div class="Field">&nbsp;</div>
                            </div>
                        </div>         

                        @Html.Raw(Html.BasicButtons(lstPriv))

                    </div>
                </div>
                 }

            </div>
    </div>
</section>
<script>
    $(function () {
        if ('@ViewData["FormCall"]' != "ApprovalQueue") {
            DisableBtnAuthorize();
        }
    })
</script>
