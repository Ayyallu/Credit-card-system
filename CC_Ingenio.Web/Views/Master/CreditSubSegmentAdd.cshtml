@using CC_Ingenio.DataTranfer.MasterInfo;
@using CC_Ingenio.Web.Helpers;
@using CC_Ingenio_Resources;

@model CreditSubSegmentDTO
@{
    List<SelectListItem> CreditSegmentCodeList = new List<SelectListItem>();
    List<string> lstPriv = new List<string>();

    foreach (var item in ViewBag.CreditSegmentCodeList)
    {
        CreditSegmentCodeList.Add(new SelectListItem { Text = item.Text, Value = item.Value });
    }

    List<SelectListItem> CreditSubSegmentCodeList = new List<SelectListItem>();

    foreach (var item in ViewBag.CreditSubSegmentCodeList)
    {
        CreditSubSegmentCodeList.Add(new SelectListItem { Text = item.Text, Value = item.Value });
    }
    
    if (ViewBag.Privileges != null)
    {

        foreach (var item in ViewBag.Privileges)
        {
            lstPriv.Add(item);
        }
    }
    
}

@{
    ViewBag.Title = String.Concat(new object[] { Resources.Add, " ", Resources.CreditSubSegment });
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@section featured
    {
    
    }

<section class="featured">
     <div class="PageTitle">@ViewBag.Title </div>
     <div class="PageRow">


        <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            @if (ViewData["FormCall"] != "ApprovalQueue")
            {
                <li> @Html.ActionLink(Resources.SearchPageHeading,"CreditSubSegmentList","Master" )</li>
            }
            <li class="active"><a href="#tab1">@Resources.DetailsPageHeading</a></li>
        </ul>
       
            <!-- Tabs Content -->
            <div class="tabs-container">
                 @using (Html.BeginForm("CreditSubSegmentSave", "Master", new {ACreditSegmentCode = Model.CreditSegmentCode, ACreditSubSegmentCode = Model.CreditSubSegmentCode }, FormMethod.Post))
                {
                <div class="tab-content" id="tab1">
                    <div>
                        <span>
                            @if (!string.IsNullOrWhiteSpace(Model.ApprovalStatus))
                            { 
                                <text> @String.Concat(new object[] { Resources.Status, ":", Model.ApprovalStatusDesc }) </text>
                            }
                        </span>
                    </div>
                    <div class="row">
                      
                         <div class="TwoColumn">                           
                                <div class="label">@Resources.CreditSegment</div>
                                <div class="Field">
                                    @if (!string.IsNullOrWhiteSpace(Model.CreditSegmentCode))
                                    {
                                         @Html.DropDownListFor(x => x.CreditSegmentCode, CreditSegmentCodeList, new { @disabled = "disabled" })
                                    }
                                    else
                                    {
                                         @Html.DropDownListFor(x => x.CreditSegmentCode,CreditSegmentCodeList)
                                    }                                    
                                    @Html.ValidationMessageFor(x => x.CreditSegmentCode)
                                    @Html.HiddenFor(x => x.CreditSegmentCode)
                                </div>
                            </div>
                                                  
                            <div class="TwoColumn">
                                <div class="label">@Resources.CreditSubSegment</div>
                                <div class="Field">
                                    @if (!string.IsNullOrWhiteSpace(Model.CreditSegmentCode))
                                    {
                                          @Html.DropDownListFor(x => x.CreditSubSegmentCode,CreditSubSegmentCodeList, new { @disabled = "disabled" })
                                    }
                                    else
                                    {
                                         @Html.DropDownListFor(x => x.CreditSubSegmentCode,CreditSubSegmentCodeList)
                                    }    
                                    @Html.ValidationMessageFor(x => x.CreditSubSegmentCode)
                                    @Html.HiddenFor(x => x.CreditSubSegmentCode)
                                </div>
                            </div>
                        </div>
                        
                            
                            <div class="row">
                           <div class="TwoColumn">
                                <div class="label">@Resources.Description</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.Description, new { id = "Description", name="Description" , maxlength = 50 })
                                    @Html.ValidationMessageFor(x => x.Description)
                                </div>
                            </div>
                        </div>
             
                        @Html.Raw(Html.BasicButtons(lstPriv))

                    </div>
                     
                     
                 }

            </div>
        </div>
</section>
<script>
    $(function () {
        if ('@ViewData["FormCall"]' != "ApprovalQueue") {
            DisableBtnAuthorize();
        }
    })
</script>
