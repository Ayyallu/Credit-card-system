@using CC_Ingenio.Web.ViewModel.Master;
@using CC_Ingenio_Resources;

@{
    ViewBag.Title = String.Concat(new object[] { Resources.InterestMaster, " ", Resources.Search });
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@model InterestMasterSearch
@{
    var grid = new WebGrid(Model.SearchResults, canSort: false, canPage: true, rowsPerPage: CC_Ingenio.Common.Utils.Utils.GRD_ROWS_PER_PAGE, selectionFieldName: "", ajaxUpdateContainerId: "container-body");
    grid.Pager(WebGridPagerModes.All);

    List<SelectListItem> ProductListItems = new List<SelectListItem>();
    foreach (var itm in ViewBag.ProductList)
    {
        ProductListItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }
    ProductListItems.RemoveAt(0);
    ProductListItems.Insert(0, new SelectListItem { Text = string.Empty, Value = string.Empty });

    List<SelectListItem> CustomerSegmentItems = new List<SelectListItem>();
    foreach (var item in ViewBag.CustomerSegment)
    {
        CustomerSegmentItems.Add(new SelectListItem { Text = item.Text, Value = item.Value });
    }
    CustomerSegmentItems.RemoveAt(0);
    CustomerSegmentItems.Insert(0, new SelectListItem { Text = string.Empty, Value = string.Empty });

    List<SelectListItem> CustomerSubSegmentItems = new List<SelectListItem>();
    foreach (var item in ViewBag.CustomerSubSegment)
    {
        CustomerSubSegmentItems.Add(new SelectListItem { Text = item.Text, Value = item.Value });
    }
    CustomerSubSegmentItems.RemoveAt(0);
    CustomerSubSegmentItems.Insert(0, new SelectListItem { Text = string.Empty, Value = string.Empty });
    List<string> lstPriv = new List<string>();
    if (ViewBag.Privileges != null)
    {

        foreach (var item in ViewBag.Privileges)
        {
            lstPriv.Add(item);
        }
    }
    }

<section class="featured">

    <div class="PageTitle">@ViewBag.Title</div>

    <!-- Tabs
	================================================== -->

    <div class="PageRow">


        <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            <li class="active">@Html.ActionLink(Resources.SearchPageHeading,"InterestMasterlist","Master" )</li>
            <li> @Html.ActionLink(Resources.DetailsPageHeading,"InterestMasterAdd","Master" )</li>
        </ul>

        <!-- Tabs Content -->
        <div class="tabs-container">
            <div class="tab-content" id="tab1">
                <div class="row">
                    @using (Html.BeginForm("InterestMasterList", "Master", FormMethod.Get, new { id = "frmList", name = "frmList" }))
                    {
                        <div class="SearchBox">
                            <div class="row">
                                <div class="row">
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.Product</div>
                                        <div class="Field">
                                            @Html.DropDownListFor(x=>x.ProductCode,ProductListItems)
                                        </div>
                                    </div>
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.CustomerSegment</div>
                                        <div class="Field">
                                            @Html.DropDownListFor(x=>x.CustomerSegmentCode,CustomerSegmentItems)
                                        </div>
                                    </div>
                                    </div>
                                <div class="row">
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.CustomerSubSegment</div>
                                        <div class="Field">
                                            @Html.DropDownListFor(x=>x.CustomerSubSegmentCode,CustomerSubSegmentItems)
                                        </div>
                                    </div>
                                </div>

                                <div class="SearchColumnbtn">
                                    <div class="row">
                                        <span>
                                            <input id="SearchButton" name="SearchButton" class="Greenbutton" type="submit" value="@Resources.Search" />
                                        </span>
                                        <span>
                                            <input id="Button2" type="submit" name ="ClearButton"  class="Greenbutton" value="@Resources.Clear" />
                                        </span>
                                    </div>
                                </div>


                            </div>
                            <div class="clear"></div>

                        </div>

                    }

                </div>
                <div class="row">
                   
                    <div class="standard-table">
                        @grid.GetHtml(alternatingRowStyle: "alt", columns:grid.Columns(
                                    grid.Column("ProductName",Resources.Product),
                                    grid.Column("CustomerSegmentDesc",Resources.CustomerSegment), 
                                    grid.Column("CustomerSubSegmentDesc",Resources.CustomerSubSegment), 
                                    grid.Column("EffectiveDate",Resources.EffectiveDate, format:@<text> @item.EffectiveDate.ToShortDateString()</text>), 
                                     grid.Column("ApprovalStatusDesc", Resources.Status),
                                    grid.Column(Resources.Edit, format: 
                                        (item) =>
                                            {
                                                if (item.ApprovalStatus.Equals("D") || item.ApprovalStatus.Equals("R"))
                                                {
                                                    return Html.Raw(Html.ActionLink(Resources.Edit, "InterestMasterAdd", "Master", new { AInterestMasterId = Convert.ToString(item.InterestMasterId) }, null));
                                                }   
                                                else
                                                {
                                                    return Html.Raw(Html.Raw(Html.ActionLink(Resources.View, "InterestMasterView", "Master", new { AInterestMasterId = item.InterestMasterId }, null))); 
                                                }
                                            }),
                                    grid.Column(Resources.Delete,   format: 
                                        (item) =>
                                                             {
                                                                 if (lstPriv.Contains("Delete"))
                                                                 {
                                                                     if (item.ApprovalStatus.Equals("D") || item.ApprovalStatus.Equals("R") || item.ApprovalStatus.Equals("A") || item.ApprovalStatus.Equals("EXP"))
                                                                     {
                                                                         return Html.Raw(Html.ActionLink(Resources.Delete, "InterestMasterDelete", "Master", new { AInterestMasterId = item.InterestMasterId, ASearchGridClick = true }, new { @class = "delete-link" }));
                                                                     }
                                                                     else
                                                                     {
                                                                         return Html.Raw("");
                                                                     }
                                                                 }
                                                                 else
                                                                 {
                                                                     return Html.Raw("");
                                                                 }
                                            })
                                  ))
                    </div>
                </div>
            </div>


        </div>

    </div>

</section>
