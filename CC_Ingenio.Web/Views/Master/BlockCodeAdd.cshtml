@{
    ViewBag.Title = String.Concat(new object[] { Resources.Add, " ", Resources.BlockCode });
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using CC_Ingenio_Resources;
@using CC_Ingenio.DataTranfer.MasterInfo;
@using CC_Ingenio.Web.Helpers;

@model BlockCodeDTO
@{
    List<string> lstPriv = new List<string>();
    
    if (ViewBag.Privileges != null)
    {

        foreach (var item in ViewBag.Privileges)
        {
            lstPriv.Add(item);
        }
    }
    }

@section featured {
}


<script type="text/javascript">

    $(document).ready(function () {
        
        $("#frmBlockCodeSave").submit(function (e) {

            if (parseFloat($('#Code').val().trim()) < parseFloat(0)) {
                $('#BlockCode_Validate').text("@Html.Raw(string.Format(Resources.MsgErrValueNotZero,Resources.BlockCode))");
                e.preventDefault();
            }
        })

        $('#Code').focusin(function () {
            $('#BlockCode_Validate').text("");
        });

    });
</script>


<section class="featured">
     <div class="PageTitle">@ViewBag.Title</div>
     <div class="PageRow">


        <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            @if (ViewData["FormCall"] != "ApprovalQueue")
            {
                <li> @Html.ActionLink(Resources.SearchPageHeading,"BlockCodeList","Master" )</li>
            }
            <li class="active">@Html.ActionLink(Resources.DetailsPageHeading,"BlockCodeAdd","Master" )</li>
        </ul>
       
            <!-- Tabs Content -->
            <div class="tabs-container">
                 @using (Html.BeginForm("BlockCodeSave", "Master", new { Id = Model.Code, }, FormMethod.Post, new { id = "frmBlockCodeSave", name = "frmBlockCodeSave" }))
                {
                <div class="tab-content" id="tab1">
                    <div>
                        <span>
                            @if (!string.IsNullOrWhiteSpace(Model.ApprovalStatus))
                            { 
                                <text>@String.Concat(new object[] { Resources.Status, ":", Model.ApprovalStatusDesc }) </text>
                            }
                        </span>
                    </div>
                    <div class="row">
                       
                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label">@Resources.BlockCode</div>
                                <div class="Field">
                                    @if (!string.IsNullOrWhiteSpace(Model.Code))
                                    {
                                        @Html.TextBoxFor(x => x.Code, new { id = "Code", name="Code", maxlength = "5", @readonly = "readonly"  })
                                    }
                                    else
                                    { 
                                        @Html.TextBoxFor(x => x.Code, new { id = "Code", name="Code", maxlength = "5" })
                                    }
                                    
                                    @Html.ValidationMessageFor(x => x.Code)
                                    <label id="BlockCode_Validate" class="validationMessage"></label>
                                </div>
                            </div>
                            <div class="TwoColumn">
                                <div class="label">@Resources.Description</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.Description, new { id = "Description", name="Description", maxlength = "100"})
                                    @Html.ValidationMessageFor(x => x.Description)
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label fontmandatory">@Resources.ShortDescription</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.ShortDescription, new { id = "ShortDescription", name="ShortDescription", maxlength = "50"})
                                    @Html.ValidationMessageFor(x => x.ShortDescription)
                                </div>
                            </div>
                            <div class="TwoColumn">
                                <div class="label fontmandatory">@Resources.AccountBlocked</div>
                                <div>
                                    @Html.CheckBoxFor(x => x.IsAccountBlocked)
                                    @Html.ValidationMessageFor(x => x.IsAccountBlocked)
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label fontmandatory">@Resources.AccountBlockedFinancial</div>
                                <div>
                                    @Html.CheckBoxFor(x => x.IsAccountBlockedForFinancialReasons)
                                    @Html.ValidationMessageFor(x => x.IsAccountBlockedForFinancialReasons)
                                </div>
                            </div>
                            <div class="TwoColumn">
                                <div class="label fontmandatory">@Resources.FinancialHierarchy</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.FinancialHierarchy, new { @class="NumericOnly Number", id = "FinancialHierarchy", name="FinancialHierarchy", maxlength = "2" })
                                    @Html.ValidationMessageFor(x => x.FinancialHierarchy)
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label fontmandatory">@Resources.AccountBlockedNonFinancial</div>
                                <div>
                                    @Html.CheckBoxFor(x => x.IsAccountBlockedForNonFinancialReasons)
                                    @Html.ValidationMessageFor(x => x.IsAccountBlockedForNonFinancialReasons)
                                </div>
                            </div>
                            <div class="TwoColumn">
                                <div class="label fontmandatory">@Resources.NonFinancialHierarchy</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.NonFinancialHierarchy, new { @class="NumericOnly Number", id = "NonFinancialHierarchy", name="NonFinancialHierarchy", maxlength = "2"  })
                                    @Html.ValidationMessageFor(x => x.NonFinancialHierarchy)
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label fontmandatory">@Resources.CardBlocked</div>
                                <div>
                                    @Html.CheckBoxFor(x => x.IsCardBlocked)
                                    @Html.ValidationMessageFor(x => x.IsCardBlocked)
                            </div>
                                </div>
                            <div class="TwoColumn">
                                <div class="label fontmandatory">@Resources.CardBlockHierarchy</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.CardBlockHierarchy, new { @class="NumericOnly Number", id = "CardBlockHierarchy", name="CardBlockHierarchy", maxlength = "2"  })
                                    @Html.ValidationMessageFor(x => x.CardBlockHierarchy)
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label fontmandatory">@Resources.PermanentTerminalBlock</div>
                                <div>
                                    @Html.CheckBoxFor(x => x.IsPermanantBlock)
                                    @Html.ValidationMessageFor(x => x.IsPermanantBlock)
                                </div>
                            </div>
                            <div class="TwoColumn">
                                <div class="label fontmandatory">@Resources.PlasticRecoveryNeeded</div>
                                <div>
                                    @Html.CheckBoxFor(x => x.PlasticRecoveryNeeded)
                                    @Html.ValidationMessageFor(x => x.PlasticRecoveryNeeded)
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label fontmandatory">@Resources.InstallmentClose</div>
                                <div>
                                    @Html.CheckBoxFor(x => x.InstallmentClose)
                                    @Html.ValidationMessageFor(x => x.InstallmentClose)
                                </div>
                            </div>
                            <div class="TwoColumn">
                                <div class="label fontmandatory">@Resources.Unblock</div>
                                <div>
                                    @Html.CheckBoxFor(x => x.Unblock)
                                    @Html.ValidationMessageFor(x => x.Unblock)
                                </div>
                            </div>
                        </div>

                        @Html.Raw(Html.BasicButtons(lstPriv))

                    </div>
                </div>
                 }

            </div>
        

    </div>
</section>
<script>
    $(function () {
        if ('@ViewData["FormCall"]' != "ApprovalQueue") {
            DisableBtnAuthorize();
        }
    })
</script>