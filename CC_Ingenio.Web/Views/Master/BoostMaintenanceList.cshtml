@using CC_Ingenio.Web.ViewModel.Master;
@using CC_Ingenio_Resources;
@model BoostMaintenanceSearch

@{
    var grid = new WebGrid(Model.SearchResults, canPage: true, rowsPerPage: CC_Ingenio.Common.Utils.Utils.GRD_ROWS_PER_PAGE, selectionFieldName: "BoostId", ajaxUpdateContainerId: "container-body");
    grid.Pager(WebGridPagerModes.All);

    List<SelectListItem> productList = new List<SelectListItem>();

    foreach (var itm in ViewBag.ProductList)
    {
        productList.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }
    productList.RemoveAt(0);
    productList.Insert(0, new SelectListItem { Text = string.Empty, Value = string.Empty });

    List<SelectListItem> transactionList = new List<SelectListItem>();

    foreach (var itm in ViewBag.TransactionList)
    {
        transactionList.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }
    transactionList.RemoveAt(0);
    transactionList.Insert(0, new SelectListItem { Text = string.Empty, Value = string.Empty });
    List<string> lstPriv = new List<string>();
    if (ViewBag.Privileges != null)
    {

        foreach (var item in ViewBag.Privileges)
        {
            lstPriv.Add(item);
        }
    }
 }

@{
    ViewBag.Title = String.Concat(new object[] { Resources.MT_BOOST_MAINTENANCE, " ", Resources.Search });
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="feature">

    <div class="PageTitle">Boost Factor Search</div>

    <!-- Tabs
	================================================== -->

    <div class="PageRow">


        <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            <li class="active">@Html.ActionLink(Resources.SearchPageHeading,"BoostMaintenanceList","Master" )</li>
            <li> @Html.ActionLink(Resources.DetailsPageHeading,"BoostMaintenanceAdd","Master" )</li>
        </ul>

        <!-- Tabs Content -->
        <div class="tabs-container">
            <div class="tab-content" id="tab1">
                <div class="row">
                    @using (Html.BeginForm("BoostMaintenanceList", "Master", FormMethod.Get, new { id = "frmList", name = "frmList" }))
                    {
                        <div class="SearchBox">
                            <div class="row">
    
                                <div class="row">
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.Product</div>
                                        <div class="Field">
                                            @Html.DropDownListFor(x=>x.ProductCode,productList)
                                        </div>
                                    </div>
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.Transaction</div>
                                        <div class="Field">
                                            @Html.DropDownListFor(x=>x.TransactionCode,transactionList)
                                        </div>
                                    </div>
                                </div>                                                      
                                <div class="SearchColumnbtn">
                                    <div class="row">
                                        <span>
                                            <input id="SearchButton" name="SearchButton" class="Greenbutton" type="submit" value="@Resources.Search" />
                                        </span>
                                        <span>
                                            <input id="Button2" type="submit" name ="ClearButton"  class="Greenbutton" value="@Resources.Clear" />
                                        </span>
                                    </div>
                                </div>

                            </div>
                            <div class="clear"></div>
                        </div>

                    }

                </div>
                <div class="row">
                   
                    <div class="standard-table">

                        @grid.GetHtml(alternatingRowStyle:"alt",columns:grid.Columns(
                                    grid.Column("ProductName", Resources.Product),     
                                    grid.Column("TransactionDesc",Resources.Transaction),  
                                    grid.Column("Percentage",Resources.Percentage),  
                                    grid.Column("ApprovalStatusDesc", Resources.Status),
                                    grid.Column(Resources.Edit, format: 
                                        (item) =>
                                            {
                                                if (item.ApprovalStatus.Equals("D") || item.ApprovalStatus.Equals("R"))
                                                {
                                                    return Html.Raw(Html.ActionLink(Resources.Edit, "BoostMaintenanceAdd", "Master", new { Id = Convert.ToString(item.BoostId) }, null));
                                                   
                                                }   
                                                else
                                                {
                                                    return Html.Raw(Html.Raw(Html.ActionLink(Resources.View, "BoostMaintenanceView", "Master", new { Id = item.BoostId }, null))); 
                                                }
                                            }),
                                    grid.Column(Resources.Delete,   format: 
                                        (item) =>
                                                 {
                                                     if (lstPriv.Contains("Delete"))
                                                     {
                                                         if (item.ApprovalStatus.Equals("D") || item.ApprovalStatus.Equals("R") || item.ApprovalStatus.Equals("A"))
                                                         {
                                                             return Html.Raw(Html.ActionLink(Resources.Delete, "BoostMaintenanceDelete", "Master", new { Id = item.BoostId }, new { @class = "delete-link" }));
                                                         }
                                                         else
                                                         {
                                                             return Html.Raw("");
                                                         }
                                                     }
                                                     else
                                                     {
                                                         return Html.Raw("");
                                                     }
                                            })
                    ))               

                    </div>
                </div>
            </div>


        </div>

    </div>

</section>
