@using CC_Ingenio.DataTranfer.MasterInfo;
@using CC_Ingenio.Web.Helpers;
@using System.Web.Script.Serialization;
@using CC_Ingenio_Resources;
    
    
  @{        
      ViewBag.Title = String.Concat(new object[] { Resources.Add, " ", Resources.DiscountPercentage });       
      Layout = "~/Views/Shared/_Layout.cshtml";
    }


<script src="/Scripts/Master/DiscountPercentage.js"></script>

@model DiscountPercentageDTO
@{
    List<SelectListItem> ProductListItems = new List<SelectListItem>();
    List<string> lstPriv = new List<string>();

    foreach (var itm in ViewBag.ProductList)
    {
        ProductListItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }

    List<SelectListItem> CustomerSegmentListItems = new List<SelectListItem>();
    foreach (var itm in ViewBag.CustomerSegmentList)
    {
        CustomerSegmentListItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }

    List<SelectListItem> CustomerSubSegmentListItems = new List<SelectListItem>();
    foreach (var itm in ViewBag.CustomerSubSegmentList)
    {
        CustomerSubSegmentListItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }
    
    if (ViewBag.Privileges != null)
    {

        foreach (var item in ViewBag.Privileges)
        {
            lstPriv.Add(item);
        }
    }
}


    

<script type="text/javascript">

    var productListDDL =  @Html.Raw(new JavaScriptSerializer().Serialize(ProductListItems));
    var customerSegmentListDDL =  @Html.Raw(new JavaScriptSerializer().Serialize(CustomerSegmentListItems));
    var customerSubSegmentListDDL =  @Html.Raw(new JavaScriptSerializer().Serialize(CustomerSubSegmentListItems));
    
    var discountpercentages =  @Html.Raw(ViewBag.DiscountPercentages);
    
    $(function () {
        $("input#Delete").on('click', function (e) {
            e.preventDefault();
        })
    });

</script>


<section class="featured">
    <div class="PageTitle">@ViewBag.Title</div>
    <div class="PageRow">


        <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            @if (ViewData["FormCall"] != "ApprovalQueue")
            {
                <li> @Html.ActionLink(Resources.SearchPageHeading, "DiscountPercentageList", "Master")</li>
            }
            <li class="active">@Html.ActionLink(Resources.DetailsPageHeading, "DiscountPercentageAdd", "Master")</li>
        </ul>
       
            <!-- Tabs Content -->
            <div class="tabs-container">
                 @using (Html.BeginForm("DiscountPercentageSave", "Master", new { Id = Convert.ToString(Model.DiscountPercentageId), }, FormMethod.Post, new { id = "frmDiscountPercentageSave", name = "frmDiscountPercentageSave" }))
                 {
                <div class="tab-content" id="tab1">
                       <div>
                        <span>
                            @if (!string.IsNullOrWhiteSpace(Model.ApprovalStatus))
                            { 
                                <text> @String.Concat(new object[] { Resources.Status, ":", Model.ApprovalStatusDesc }) </text>
                            }
                        </span>
                    </div>

                    <div class="row">

                        <div class="row">
                            <div class="row">
                                <div class="TwoColumn">
                                    <div class="label">@Resources.Product</div>
                                    <div class="Field">
                                        <select data-bind="options: productListDDL,
                                            optionsText: 'Text',
                                            optionsValue: 'Value',
                                            value: DiscountPercentage.ProductCode">
                                        </select>
                                    </div>
                                </div>
                                <div class="TwoColumn">
                                    <div class="label">@Resources.CustomerSegment</div>
                                    <div class="Field">
                                        <select data-bind="options: customerSegmentListDDL,
                                            optionsText: 'Text',
                                            optionsValue: 'Value',
                                            value: DiscountPercentage.SegmentCode">
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="TwoColumn">
                                    <div class="label">@Resources.CustomerSubSegment</div>
                                    <div class="Field">
                                        <select data-bind="options: customerSubSegmentListDDL,
                                            optionsText: 'Text',
                                            optionsValue: 'Value',
                                            value: DiscountPercentage.SubSegmentCode">
                                        </select>
                                    </div>
                                </div>
                                <div class="TwoColumn">
                                    <div class="label">@Resources.ValidFrom</div>
                                    <div class="Field">
                                        <input type="text" id="ValidFrom" class="datepicker" readonly="true" data-bind="value: DiscountPercentage.ValidFrom" />
                                    </div>
                                </div>

                            </div>
                            <div class="row">
                                <div class="TwoColumn">
                                    <div class="label">@Resources.ValidTo</div>
                                    <div class="Field">
                                        <input type="text" id="ValidTo" class="datepicker" readonly="true" data-bind="value: DiscountPercentage.ValidTo" />
                                    </div>
                                </div>
                                <div class="TwoColumn">
                                    <div class="label">&nbsp;</div>
                                    <div class="Field">&nbsp;</div>
                                </div>
                            </div>

                        </div>
                          
                            <div class="row">
                                 <script id="DiscountPercentageDetailsTemplate" type="text/html">
                                <tr>
                                    <td>
                                        <input id="PurchaseAmountFrom" data-bind="value: PurchaseAmountFrom" maxlength="11", onkeypress = "return AllowOnlyAmountWithoutDot(event)", class = "gridfield", style="text-align:right; width:80%", onblur = "FormatOnBlur(event)" />
                                    </td>
                                    <td>
                                        <input id="PurchaseAmountTo" data-bind="value: PurchaseAmountTo" maxlength="11", onkeypress = "return AllowOnlyAmountWithoutDot(event)", class = "gridfield", style="text-align:right; width:80%", onblur = "FormatOnBlur(event)" />
                                    </td>
                                    <td>
                                        <input id="DPDDaysFrom" data-bind="value: DPDDaysFrom" maxlength="3", onkeypress = "return AllowOnlyAmountWithoutDot(event)" class = "gridfield", style="text-align:right; width:100%" />
                                    </td>
                                    <td>
                                        <input id="DPDDaysTo" data-bind="value: DPDDaysTo" maxlength="3", onkeypress = "return AllowOnlyAmountWithoutDot(event)" class = "gridfield", style="text-align:right; width:100%" />
                                    </td>
                                    <td>
                                        <input id="DiscountPercentage" data-bind="value: DiscountPercentage" maxlength="5", onkeypress="return validateFloatKeyPress(this,event);", class = "gridfield", style="text-align:right; width:80%" />
                                    </td>
                                    <td><a href='#' data-bind='click: $root.remove'>@Resources.Delete</a></td>
                                </tr>
                            </script>
                            <div class="standard-table">
                               <table>
                                    <thead>
                                        <tr>
                                            <th>@Resources.PurchaseAmountFrom</th>
                                            <th>@Resources.PurchaseAmountTo</th>
                                            <th>@Resources.DPDDaysFrom</th>
                                            <th>@Resources.DPDDaysTo</th>
                                            <th>@Resources.DiscountPercentage</th>
                                            <th>@Resources.Action</th>
                                        </tr>
                                    </thead>
                                    <tbody data-bind="template: { name: 'DiscountPercentageDetailsTemplate', foreach: DiscountPercentage.DiscountPercentageDetailsData }"></tbody>
                              </table>

                                    <span><button class="Greenbutton" data-bind='click: AddItem'>@Resources.AddNew</button></span>

                            </div>
                        </div>
                                                     
                        <div class="rowbtn">
                            @Html.Raw(Html.KnockoutButtons(lstPriv, true))
                        </div>

                    </div>
                </div>
                 }

            </div>
        

    </div>

    
        <script>
            $(function () {
                $("input#New").on('click', function () {
                    window.location.href = "/Master/DiscountPercentageAdd";
                })
            });
            var url = window.location.pathname;
            var DiscountPercentageId = GetQueryStrings();
            var viewModel;
        
            if (DiscountPercentageId["ADiscountPercentageId"] && DiscountPercentageId["ADiscountPercentageId"] != 0)
            {
                viewModel = new DiscountPercentageVM(discountpercentages);
            }
            else
            {
                viewModel = new DiscountPercentageVM();
            }
            $(function ()
            {
                ko.validation.configure({
                    registerExtenders: true,
                    insertMessages: true,
                    messagesOnModified: false
                });
                ko.applyBindings(viewModel);
                $('#ValidFrom').datepicker("option", "minDate", viewModel.DiscountPercentage.ValidFrom._latestValue);
                $('#ValidTo').datepicker("option", "minDate", viewModel.DiscountPercentage.ValidFrom._latestValue);
            
            });
    </script>


</section>
<script>
    $(function () {
        if ('@ViewData["FormCall"]' != "ApprovalQueue") {
            DisableBtnAuthorize();
        }
    })
</script>