
@using CC_Ingenio.Web.ViewModel.Master;
@using CC_Ingenio_Resources;

@{
    ViewBag.Title = String.Concat(new object[] { Resources.TransactionSubCode, " ", Resources.Search });
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model TransactionSubCodeSearch
@{
    var grid = new WebGrid(Model.SearchResults, canPage: true, rowsPerPage: CC_Ingenio.Common.Utils.Utils.GRD_ROWS_PER_PAGE, selectionFieldName: "", ajaxUpdateContainerId: "container-body");
    grid.Pager(WebGridPagerModes.All);


    List<SelectListItem> TransactionCodeItems = new List<SelectListItem>();
    foreach (var item in ViewBag.TransactionCodes)
    {
        TransactionCodeItems.Add(new SelectListItem { Text = item.Text, Value = item.Value });
    }
    TransactionCodeItems.RemoveAt(0);
    TransactionCodeItems.Insert(0, new SelectListItem { Text = string.Empty, Value = string.Empty });

    List<SelectListItem> TransTypeItems = new List<SelectListItem>();
    foreach (var itm in CC_Ingenio.Common.Utils.Utils.GetDebitOrCredit())
    {
        TransTypeItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }
    TransTypeItems.RemoveAt(0);
    TransTypeItems.Insert(0, new SelectListItem { Text = string.Empty, Value = string.Empty });

    List<SelectListItem> SysParamTranSubCodeItems = new List<SelectListItem>();
    foreach (var itm in ViewBag.SysParamTransactionCodes)
    {
        SysParamTranSubCodeItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }
    SysParamTranSubCodeItems.RemoveAt(0);
    SysParamTranSubCodeItems.Insert(0, new SelectListItem { Text = string.Empty, Value = string.Empty });
    List<string> lstPriv = new List<string>();
    if (ViewBag.Privileges != null)
    {

        foreach (var item in ViewBag.Privileges)
        {
            lstPriv.Add(item);
        }
    }
    
 }

<section class="feature">

    <div class="PageTitle">@ViewBag.Title</div>

    <!-- Tabs
	================================================== -->

    <div class="PageRow">


        <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            <li class="active">@Html.ActionLink(Resources.SearchPageHeading,"TransactionSubCodeList","Master" )</li>
            <li> @Html.ActionLink(Resources.DetailsPageHeading,"TransactionSubCodeAdd","Master" )</li>
        </ul>

        <!-- Tabs Content -->
        <div class="tabs-container">
            <div class="tab-content" id="tab1">
                <div class="row">
                    @using (Html.BeginForm("TransactionSubCodeList", "Master", FormMethod.Get, new { id = "frmList", name = "frmList" }))
                    {
                        <div class="SearchBox">
                            <div class="row">
                                <div class="row">
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.TransactionCode</div>
                                        <div class="Field">
                                            @Html.DropDownListFor(x=>x.TransactionCode,TransactionCodeItems)
                                        </div>                                       
                                    </div>
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.TransactionSubCode</div>
                                        <div class="Field">
                                            @Html.DropDownListFor(x=>x.SubCode,SysParamTranSubCodeItems)
                                        </div>                                       
                                    </div>
                                </div>          
                                <div class="row">
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.TransactionSubCodeDescription</div>
                                        <div class="Field">
                                            @Html.TextBoxFor(x=>x.Description, new { maxlength = 50})
                                        </div>
                                    </div>
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.DebitCredit</div>
                                        <div class="Field">
                                            @Html.DropDownListFor(x=>x.IsDebitOrCredit,TransTypeItems)
                                        </div>
                                    </div>
                                </div>   
                                <div class="row">                                                                             
                                <div class="SearchColumnbtn">
                                    <span>
                                        <input id="SearchButton" name="SearchButton" class="Greenbutton" type="submit" value="@Resources.Search" />
                                    </span>
                                    <span>
                                        <input id="Button2" type="submit" name ="ClearButton"  class="Greenbutton" value="@Resources.Clear" />
                                    </span>
                                </div>
                                </div>
                            </div>
                            <div class="clear"></div>
                        </div>

                    }

                </div>
                <div class="row">
                   
                    <div class="standard-table">

                        @grid.GetHtml(columns:grid.Columns(
                                    grid.Column("TransactionDesc",Resources.TransactionCode),
                                    grid.Column("SubCode", Resources.TransactionSubCode), 
                                    grid.Column("Description",Resources.TransactionSubCodeDescription),
                                    grid.Column("DebitOrCreditDesc", Resources.DebitCredit),
                                    grid.Column("ApprovalStatusDesc", Resources.Status),
                                    grid.Column(Resources.Edit, format: 
                                        (item) =>
                                            {
                                                if (item.ApprovalStatus.Equals("D") || item.ApprovalStatus.Equals("R"))
                                                {
                                                    return Html.Raw(Html.ActionLink(Resources.Edit, "TransactionSubCodeAdd", "Master", new { Id = Convert.ToString(item.TransactionSubCodeId) }, null));
                                                    
                                                }   
                                                else
                                                {
                                                    return Html.Raw(Html.Raw(Html.ActionLink(Resources.View, "TransactionSubCodeView", "Master", new { id = item.TransactionSubCodeId }, null))); 
                                                }
                                            }),
                                    grid.Column(Resources.Delete,   format: 
                                        (item) =>
                                                 {
                                                     if (lstPriv.Contains("Delete"))
                                                     {
                                                         if (item.ApprovalStatus.Equals("D") || item.ApprovalStatus.Equals("R") || item.ApprovalStatus.Equals("A"))
                                                         {
                                                             return Html.Raw(Html.ActionLink(Resources.Delete, "TransactionSubCodeDelete", "Master", new { id = item.TransactionSubCodeId }, new { @class = "delete-link" }));
                                                         }
                                                         else
                                                         {
                                                             return Html.Raw("");
                                                         }
                                                     }
                                                     else
                                                     {
                                                         return Html.Raw("");
                                                     }
                                            })
                    ))
                                

                    </div>
                </div>
            </div>


        </div>

    </div>

</section>


