@using CC_Ingenio.DataTranfer.MasterInfo;
@using CC_Ingenio.Web.Helpers;
@using CC_Ingenio_Resources;

@{
    ViewBag.Title = String.Concat(new object[] { Resources.Add, " ", Resources.MT_BOOST_MAINTENANCE });
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@model BoostMaintenanceDTO
@{
    List<SelectListItem> productList = new List<SelectListItem>();
    List<string> lstPriv = new List<string>();
    
    foreach (var item in ViewBag.ProductList)
    {
        productList.Add(new SelectListItem { Text = item.Text, Value = item.Value });
    }

    List<SelectListItem> transactionList = new List<SelectListItem>();
    foreach(var item in ViewBag.TransactionList)     
    {
        transactionList.Add(new SelectListItem { Text = item.Text, Value = item.Value });
    }

    if (ViewBag.Privileges != null)
    {

        foreach (var item in ViewBag.Privileges)
        {
            lstPriv.Add(item);
        }
    }
}

<section class ="featured">
     <div class="PageTitle">@ViewBag.Title</div>
    <div class="PageRow">

        <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            @if (ViewData["FormCall"] != "ApprovalQueue")
            {
                <li> @Html.ActionLink(Resources.SearchPageHeading,"BoostMaintenanceList","Master" )</li>
            }
            <li class="active">@Html.ActionLink(Resources.DetailsPageHeading,"BoostMaintenanceAdd","Master" )</li>
         </ul>
       
            <!-- Tabs Content -->
            <div class="tabs-container">
                 @using (Html.BeginForm("BoostMaintenanceSave", "Master", new { Id = Convert.ToString(Model.BoostId), },  FormMethod.Post))
                {
                <div class="tab-content" id="tab1">
                    <div>
                        <span>
                            @if (!string.IsNullOrWhiteSpace(Model.ApprovalStatus))
                            { 
                                <text> @String.Concat(new object[] { Resources.Status, ":", Model.ApprovalStatusDesc }) </text>
                            }
                        </span>
                    </div>
                    <div class="row">

                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label">@Resources.Product</div>
                                <div class="Field">
                                    @Html.DropDownListFor(x => x.ProductCode, productList)
                                    @Html.ValidationMessageFor(x => x.ProductCode)
                                </div>
                            </div>
                            <div class="TwoColumn">
                                <div class="label">@Resources.Transaction</div>
                                <div class="Field">
                                    @Html.DropDownListFor(x => x.TransactionCode, transactionList )
                                    @Html.ValidationMessageFor(x => x.TransactionCode)
                                </div>
                                </div>
                        </div>

                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label">@Resources.Percentage</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.Percentage, new { id = "Percentage", name="Percentage", maxlength=6, @style="text-align:right" })
                                    @Html.ValidationMessageFor(x => x.Percentage)
                                </div>
                            </div>
                                <div class="TwoColumn">
                                <div class="label" style="visibility:hidden">Dummy Label for space filling</div>
                                <div class="Field" style="visibility:hidden">
                                    <label>Dummy Label for space filling</label><br>
                                    <label>Dummy Label for space filling</label>
                                </div>
                            </div>
                        </div>

                        @Html.Raw(Html.BasicButtons(lstPriv))

                    </div>
                </div>
                 }

            </div>
        

    </div>

</section>
<script>
    $(function () {
        if ('@ViewData["FormCall"]' != "ApprovalQueue") {
            DisableBtnAuthorize();
        }
    })
</script>