@using System.Web.Script.Serialization;
@using CC_Ingenio.Web.Helpers;
@using CC_Ingenio.DataTranfer.MasterInfo;
@using CC_Ingenio_Resources;

@{
    ViewBag.Title = String.Concat(new object[] { Resources.CommissionCharge, " ", Resources.Add });
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="/Scripts/Master/Commission.js"></script>

@model CommissionChargeDTO
@{
    Model.CommissionChargeId = 0;

    List<SelectListItem> ProductListItems = new List<SelectListItem>();
    foreach (var itm in ViewBag.ProductList)
    {
        ProductListItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }

    List<SelectListItem> CommissionItems = new List<SelectListItem>();
    foreach (var itm in ViewBag.Commission)
    {
        CommissionItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }

    List<SelectListItem> CurrencyItems = new List<SelectListItem>();
    foreach (var itm in ViewBag.Currency)
    {
        CurrencyItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }
    
    List<string> lstPrivilege = new List<string>();
    if (ViewBag.Privileges != null)
    {
        foreach (var item in ViewBag.Privileges)
        {
            lstPrivilege.Add(item);
        }
    }
    
}


<script type="text/javascript">

    var productListDDL =  @Html.Raw(new JavaScriptSerializer().Serialize(ProductListItems));
    var contractListDDL =  @Html.Raw(new JavaScriptSerializer().Serialize(""));
    var commissionDDL =  @Html.Raw(new JavaScriptSerializer().Serialize(CommissionItems));    
    var currencyListDDL =  @Html.Raw(new JavaScriptSerializer().Serialize(CurrencyItems));   
    var CommissionCharges =  @Html.Raw(ViewBag.CommissionCharge);
    
    function setProductCurrency(productCode) {
        $.getJSON("/Master/GetProductCurrency?AProductCode=" + $('#Product').val(),
            function (modeldata) {
                $("#Currency option[value=" + modeldata.currencyCode + "]").prop("selected","selected");
                $("#Currency").change();
                $.ajaxSetup({ cache: false });
            });
    };
    
    function setCurrencyPrecision() {
        $.getJSON("/Master/GetCurrencyPrecision?ACurrencyCode=" + $('#Currency').val(),
        function (modeldata) {
            $.ajaxSetup({ cache: false });
            precision = parseInt(modeldata.precision);
        });
    };

    $(document).ready(function(){

        $('#Contract').change(function(){
            if(CommissionCharges["CommissionChargeId"] != 0)
            {
                var contractCode = $('#Contract').val();
                if(contractCode == ''){
                    $('#lblValidateContract').text("@Html.Raw(string.Format(Resources.MsgErrPleaseSelect,Resources.Contract))");
                }
                else{
                    $('#lblValidateContract').text('');
                }
            }
        });

        $('#Product').change(function(){
            if($('#Product').val() != ''){
                setProductCurrency($('#Product').val());
            }        
        });
        
        $('#Currency').change(function(e){
            setCurrencyPrecision();
        });

    });
    
</script>

<section class="featured">
    <div class="PageTitle">@ViewBag.Title</div>
    <div class="PageRow">
        <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            @if (ViewData["FormCall"] != "ApprovalQueue")
            {
                <li>@Html.ActionLink(Resources.SearchPageHeading, "CommissionChargeList", "Master")</li>
            }
            <li class="active"><a href="#tab1">@Resources.DetailsPageHeading</a></li>
        </ul>

        <div class="tabs-container">
            @using (Html.BeginForm())
            {
                <div class="tab-content" id="tab1">

                    <div>
                        <span>
                            @if (!string.IsNullOrWhiteSpace(Model.ApprovalStatus))
                            { 
                                <text> @String.Concat(new object[] { Resources.Status, ":", Model.ApprovalStatusDesc }) </text>
                            }
                        </span>
                    </div> 

                    <div class ="row">

                        <div class="row">
                            <div class="TwoColumn"> 
                            <div class="label">@Resources.Product</div>
                                <div class="Field">
                                    <select id ="Product", data-bind="options: productListDDL, optionsText: 'Text', optionsValue: 'Value', value: CommissionCharge.ProductCode"></select>
                                </div>
                            </div>
                            <div class="TwoColumn">
                                <div class="label">@Resources.Contract</div>
                                <div class="Field">
                                    <select id = "Contract", data-bind="options: contractListDDL, optionsText: 'Text', optionsValue: 'Value', value: CommissionCharge.ContractCode"></select>
                                    <label id="lblValidateContract" class="validationMessage" ></label>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label">@Resources.Currency</div>
                                <div class="Field">
                                    <select id = "Currency", data-bind="options: currencyListDDL, optionsText: 'Text', optionsValue: 'Value', value: CommissionCharge.CurrencyCode"></select>
                                </div>
                            </div>
                        </div>


                        <div class="row">
                        <div class="standard-table">
                                <script id="CommissionChargeDetailsTemplate" type="text/html">
                            <tr>
                                <td>
                                    <select class = "gridfield" style="width:80%" 
                                        ID = "CommissionCode" 
                                        data-bind = "options: commissionDDL, 
                                        optionsText: 'Text', optionsValue: 'Value', 
                                        value: CommissionCode ">
                                    </select>
                                </td>
                                <td>
                                    <input id="CommissionDtlsAmount" data-bind="value: CommissionAmount" maxlength="17", onkeypress = "return AllowOnlyAmountByCurrencyPrecision(this,event, precision);", class = "gridfield", style="text-align:right; width:80%"; onblur = "FormatOnBlurWithDecimal(event)" />
                                    @*<input id="CommissionDtlsAmount" data-bind=" with: CommissionCode, value: CommissionAmount, valueUpdate: 'afterkeydown' " maxlength="9", onkeypress = "return AllowOnlyAmountWithoutDot(event)" class = "gridfield", style="text-align:right; width:80%" />*@
                                </td>
@*                                  <td>
                                    <input id="ConvertedCommissionAmount" data-bind="value: ConvertedCommissionAmount" maxlength="9" class = "gridfield", style="text-align:right; width:100%" />
                                </td>*@                                  
                                <td><a href='#' data-bind='click: $root.remove'>@Resources.Delete</a></td>
                            </tr>
                        </script>
                        <div class="standard-table">
                            <table id="tblCommission">
                                <thead>
                                    <tr>
                                        <th>@Resources.CommissionCode</th>
                                        <th>@Resources.CommissionAmount</th>
@*                                        <th>@Resources.RateUFtoCLP</th>*@
                                        <th>@Resources.Action</th>
                                    </tr>
                                </thead>
                                <tbody data-bind="template: { name:'CommissionChargeDetailsTemplate', foreach:CommissionCharge.CommissionChargeDetailsData }"></tbody>
                            </table>
     
                            <span><button class="Greenbutton" data-bind='click: AddItem'>@Resources.AddNew</button></span>

                        </div>
                        </div>
                    </div>
                        
                    <div class="rowbtn">
                        @Html.Raw(Html.KnockoutButtons(lstPrivilege, true))
                    </div>

                    </div>
                </div>                
            }
        </div>

    </div>

    <script>
        $(function () {
            $("input#New").on('click', function () {
                window.location.href = "/Master/CommissionChargeAdd";
            })
        });
        var url = window.location.pathname;
        var commissionChargeId = GetQueryStrings();
        var viewModel;
        
        if (commissionChargeId["ACommissionChargeId"] && commissionChargeId["ACommissionChargeId"] != 0)
        {
            viewModel = new CommissionChargeVM(CommissionCharges);
        }
        else
        {
            viewModel = new CommissionChargeVM();
        }
        $(function ()
        {
            var commissionChargeQueryString = GetQueryStrings();
            ko.applyBindings(viewModel);
            setCurrencyPrecision();

           $("[id=Contract]").append($('<option/>',
           {
               value: "",
               text:"@Resources.SelectOne"
           }));
           if (commissionChargeQueryString["ACommissionChargeId"] && commissionChargeQueryString["ACommissionChargeId"] != 0){
                PopulateContractCascadeDDL(CommissionCharges,viewModel);
            }

            var errors = ko.validation.group(viewModel.CommissionCharge, { deep: true });
            errors.showAllMessages(false);
        });
    </script>

</section>
<script>
    $(function () {
        if ('@ViewData["FormCall"]' != "ApprovalQueue") {
            DisableBtnAuthorize();
        }
    })
</script>

