                                            <div class="label fontmandatory" style="width: 40%"> @string.Format(Resources.RenewalFee,1)</div>
                                            <div class="Field" style="width: 50%">
                                                <input maxlength="11" onkeypress = "return AllowOnlyAmountWithoutDot(event)" style="text-align:right" data-bind='value: RenwalFee1', onblur = "FormatOnBlur(event)"  />
                                            </div>
                                        </div>
                                        <div class="TwoColumn" style="width: 28%; float: left">
                                            <div class="label fontmandatory" style="width: 40%"> @string.Format(Resources.RenewalFee,2)</div>
                                            <div class="Field" style="width: 50%">
                                                <input maxlength="11" onkeypress = "return AllowOnlyAmountWithoutDot(event)" style="text-align:right" data-bind='value: RenwalFee2', onblur = "FormatOnBlur(event)"  />
                                            </div>
                                        </div>
                                        <div class="TwoColumn" style="width: 28%; float: left">
                                            <div class="label fontmandatory" style="width: 40%"> @string.Format(Resources.RenewalFee,3)</div>
                                            <div class="Field" style="width: 50%">
                                                <input maxlength="11" onkeypress = "return AllowOnlyAmountWithoutDot(event)" style="text-align:right" data-bind='value: RenwalFee3', onblur = "FormatOnBlur(event)"  />
