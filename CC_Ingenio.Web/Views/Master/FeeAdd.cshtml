@using CC_Ingenio_Resources;
@using System.Web.Script.Serialization;
@using CC_Ingenio.Web.Helpers;
@using CC_Ingenio.DataTranfer.MasterInfo;


@{
    ViewBag.Title = String.Concat(new object[] { Resources.Add, " ", Resources.Fee });
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<script src="/Scripts/Master/FeeType.js"></script>

@model FeeDTO
@{    
    List<SelectListItem> FinActivityItems = new List<SelectListItem>();
    List<SelectListItem> CustomerSubSegmentItems = new List<SelectListItem>();
    List<SelectListItem> CustomerSegmentItems = new List<SelectListItem>();
    List<SelectListItem> ProductItems = new List<SelectListItem>();
    List<SelectListItem> FeeTypeItems = new List<SelectListItem>();
    List<SelectListItem> CurrencyItems = new List<SelectListItem>();
   
    foreach (var itm in ViewBag.ProductList)
    {
        ProductItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }
    foreach (var itm in ViewBag.CustomerSegmentList)
    {
        CustomerSegmentItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }
    foreach (var itm in ViewBag.CustomerSubSegmentList)
    {
        CustomerSubSegmentItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }
    foreach (var itm in ViewBag.FinActivityList)
    {
        FinActivityItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }
    foreach (var itm in ViewBag.FeeTypeList)
    {
        FeeTypeItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }
        
    foreach (var itm in ViewBag.CurrencyList)
    {
        CurrencyItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }
         
    List<string> lstPrivilege = new List<string>();
    if (ViewBag.Privileges != null)
    {
        foreach (var item in ViewBag.Privileges)
        {
            lstPrivilege.Add(item);
        }
    }
   
}



<script type="text/javascript">
        

    var productDDL =  @Html.Raw(new JavaScriptSerializer().Serialize(ProductItems));    
    var customerSegmentDDL =  @Html.Raw(new JavaScriptSerializer().Serialize(CustomerSegmentItems));
    var customerSubSegmentDDL =  @Html.Raw(new JavaScriptSerializer().Serialize(CustomerSubSegmentItems));
    var finActivityItemsDDL =  @Html.Raw(new JavaScriptSerializer().Serialize(FinActivityItems));
    var contractItemsDDL =  @Html.Raw(new JavaScriptSerializer().Serialize(""));
    var feeTypeDDL =  @Html.Raw(new JavaScriptSerializer().Serialize(FeeTypeItems));
    var productMemberTypeDDL = @Html.Raw(new JavaScriptSerializer().Serialize(""));
    var currencyListDDL =  @Html.Raw(new JavaScriptSerializer().Serialize(CurrencyItems));  
    var Fees =  @Html.Raw(ViewBag.Fee);  

    
    function setProductCurrency(productCode) {
        $.getJSON("/Master/GetProductCurrency?AProductCode=" + $('#Product').val(),
            function (modeldata) {

                //var select = $("[id = Currency]");
                //select.val(modeldata);

                $("#Currency option[value=" + modeldata.currencyCode + "]").prop("selected","selected");
                $("#Currency").change();

                //$.ajaxSetup({ cache: true });
            });
    };

    $(document).ready(function(){


        $('#FeeCode').blur(function(){
            if(parseFloat($('#FeeCode').val().trim()) > parseFloat(0))
            {
                if($('#FeeCode_Validate').text().length > 0)
                {
                    $('#FeeCode_Validate').text("");
                }
            }
        });

  
                  
        $('#Product').change(function(){
            if($('#Product').val() != ''){
                setProductCurrency($('#Product').val());
            }        
        });

    });

</script>


<style type="text/css">
    
    fieldset.tri-row
    {
	    width: 25%;
	    float: left;
	    border: 0;
    }

</style>

<section class="featured">
