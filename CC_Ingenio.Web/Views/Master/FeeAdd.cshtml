                        </div>

                        @Html.Raw(Html.KnockoutButtons(lstPrivilege, true))

                    </div>
                </div>
            }
        </div>
        
    </div>
    <script>
        
        var url = window.location.pathname;
        var feeQueryString = GetQueryStrings();
        var viewModel;
        
        if (feeQueryString["AFeeCode"] && feeQueryString["AFeeCode"] != 0)
        {
            viewModel = new FeeVM(Fees);
        }
        else
        {
            viewModel = new FeeVM();
        }
        $(function ()
        {
            var feeQueryString = GetQueryStrings();
            ko.validation.configure({
                registerExtenders: true,
                insertMessages: true,
                messagesOnModified: false
            });

            ko.applyBindings(viewModel);
            //$('#EffectiveFromDate').datepicker("option", "maxDate", viewModel.Fee.EffectiveToDate._latestValue);
            //$('#EffectiveToDate').datepicker("option", "minDate", viewModel.Fee.EffectiveFromDate._latestValue);

            $("[id=ProductMemberType]").append($('<option/>',
            {
               value: "",
               text:"@Resources.SelectOne"
            }));
            if (feeQueryString["AFeeCode"] && feeQueryString["AFeeCode"] != 0){
                PopulateProductMemberTypeCascadeDDL(Fees,viewModel);
            }

            $("[id=Contract]").append($('<option/>',
            {
                value: "",
                text:"@Resources.SelectOne"
            }));
            if (feeQueryString["AFeeCode"] && feeQueryString["AFeeCode"] != 0){
                PopulateContractCascadeDDL(Fees,viewModel);
            }

            var errors = ko.validation.group(viewModel.Fee, { deep: true });
            errors.showAllMessages(false);


        });
       
    </script>

</section>
<script>
    $(function () {
        if ('@ViewData["FormCall"]' != "ApprovalQueue") {
            DisableBtnAuthorize();
        }
    })
</script>