                                    </div>                                            
                                </div>
                                <div class="row" style="height: 2em">
                                    <div style="width: 8%; float: right; padding: 0 2.2em 0 2em">
                                        <button class="Greenbutton" style="width: 100%; font-size: .8em" data-bind='click: $parent.RemoveFeeType'>@Resources.Remove</button>
                                    </div>
