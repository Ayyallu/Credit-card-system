                                            </div>
                                        </div>
                                        <div class="TwoColumn" style="width: 28%; float: left">
                                            <div class="label fontmandatory" style="width: 40%"> @string.Format(Resources.RenewalFee,5)</div>
                                            <div class="Field" style="width: 50%">
                                                <input maxlength="11" onkeypress = "return AllowOnlyAmountWithoutDot(event)" style="text-align:right" data-bind='value: RenwalFee5', onblur = "FormatOnBlur(event)"  />
                                            </div>
                                        </div>
                                        <div class="TwoColumn" style="width: 28%; float: left">
                                            <div class="label fontmandatory" style="width: 40%"> @string.Format(Resources.RenewalFee,6)</div>
                                            <div class="Field" style="width: 50%">
