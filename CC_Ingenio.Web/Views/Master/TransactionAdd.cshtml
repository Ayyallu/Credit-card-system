@using CC_Ingenio.DataTranfer.MasterInfo;
@using CC_Ingenio.Web.Helpers;
@using CC_Ingenio_Resources;

@{
    ViewBag.Title = String.Concat(new object[] { Resources.Add, " ", Resources.TransactionCode });
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@model TransactionDTO
@{
    List<SelectListItem> CreditSegmentCodeList = new List<SelectListItem>();

    List<string> lstPriv = new List<string>();

    foreach (var item in ViewBag.CreditSegmentCodeList)
    {
        CreditSegmentCodeList.Add(new SelectListItem { Text = item.Text, Value = item.Value });
    }

   
    
    if (ViewBag.Privileges != null)
    {

        foreach (var item in ViewBag.Privileges)
        {
            lstPriv.Add(item);
        }
    }
}


<script type="text/javascript">

    $(document).ready(function () {
        
        $("#frmTransactioncodes").submit(function (e) {

            if (parseFloat($('#TransactionCode').val().trim()) <= parseFloat(0)) {
                $('#TransactionCode_Validate').text("@Html.Raw(string.Format(Resources.MsgErrValueShouldBeBetween,Resources.TransactionCode,"001","999"))");
                e.preventDefault();
            }
        })

        $('#TransactionCode').focusin(function () {
            $('#TransactionCode_Validate').text("");
        });

    });
</script>

@section featured {
}
<section class="featured">
     <div class="PageTitle">@ViewBag.Title</div>
    <div class="PageRow">


        <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            @if (ViewData["FormCall"] != "ApprovalQueue")
            {
                <li> @Html.ActionLink(Resources.SearchPageHeading,"TransactionList","Master" )</li>
            }
            <li class="active"><a href="#tab1">@Resources.DetailsPageHeading</a></li>
        </ul>
       
            <!-- Tabs Content -->
            <div class="tabs-container">
                 @using (Html.BeginForm("TransactionSave", "Master", new { Id = Model.TransactionCode }, FormMethod.Post, new { id = "frmTransactioncodes", name = "frmTransactioncodes" }))
                 {
                <div class="tab-content" id="tab1">
                    <div>
                        <span>
                            @if (!string.IsNullOrWhiteSpace(Model.ApprovalStatus))
                            { 
                                <text> @String.Concat(new object[] { Resources.Status, ":", Model.ApprovalStatusDesc }) </text>
                            }
                        </span>
                    </div>
                    <div class="row">

                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label">@Resources.TransactionCode</div>
                                <div class="Field">
                                    @if (!string.IsNullOrWhiteSpace(Model.TransactionCode))
                                    {
                                        @Html.TextBoxFor(x => x.TransactionCode, new { id = "TransactionCode", name = "TransactionCode", maxlength = "3", @readonly = "readonly", @class = "NumericOnly" })
                                    }
                                    else
                                    {
                                        @Html.TextBoxFor(x => x.TransactionCode, new { id = "TransactionCode", name = "TransactionCode", maxlength = "3", @class = "NumericOnly" })
                                    }
                                    @Html.ValidationMessageFor(x => x.TransactionCode)
                                    <label id="TransactionCode_Validate" class="validationMessage"></label>
                                </div>
                            </div>
                            <div class="TwoColumn">
                                <div class="label">@Resources.Description</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.Description, new { maxlength = "50" })
                                    @Html.ValidationMessageFor(x => x.Description)
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label">@Resources.CreditSegment</div>
                                <div class="Field">
                                    @Html.DropDownListFor(x => x.CreditSegment, CreditSegmentCodeList)
                                    @Html.ValidationMessageFor(x => x.CreditSegment)
                                </div>
                            </div>
                            <div class="TwoColumn">
                                <div class="label">@Resources.InstallmentRequired</div>
                                   @Html.CheckBoxFor(x => x.InstallmentRequired)
                                    @Html.ValidationMessageFor(x => x.InstallmentRequired)
                            </div>
                        </div>
                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label">@Resources.WithInterest</div>
                                    @Html.CheckBoxFor(x => x.InterestWith)
                                    @Html.ValidationMessageFor(x => x.InterestWith)
                            </div>
                            <div class="TwoColumn">
                                <div class="label">@Resources.DeferredPayment</div>
                                   @Html.CheckBoxFor(x => x.DeferredPayment)
                                    @Html.ValidationMessageFor(x => x.DeferredPayment)
                            </div>
                        </div>
                        
                         <div class="row">
                            <div class="TwoColumn">
                                <div class="label">@Resources.FeesRequired</div>
                                    @Html.CheckBoxFor(x => x.FeesRequired)
                                    @Html.ValidationMessageFor(x => x.FeesRequired)
                            </div>
                            <div class="TwoColumn">
                                <div class="label">@Resources.TaxesRequired</div>
                                   @Html.CheckBoxFor(x => x.TaxesRequired)
                                    @Html.ValidationMessageFor(x => x.TaxesRequired)
                            </div>
                         </div>
                         
                       @* <div class="row">
                            <div class="TwoColumn">
                                <div class="label">@Resources.Installments</div>
                                    @Html.CheckBoxFor(x => x.InstallmentRelated)
                                    @Html.ValidationMessageFor(x => x.InstallmentRelated)
                            </div>
                            <div class="TwoColumn">
                                <div class="label">@Resources.CapitalizeInterest</div>
                                   @Html.CheckBoxFor(x => x.CapitalizeInterest)
                                    @Html.ValidationMessageFor(x => x.CapitalizeInterest)
                            </div>
                        </div>*@
                        @Html.HiddenFor(x => x.ApprovalStatus)

                        @Html.Raw(Html.BasicButtons(lstPriv))

                    </div>
                
                 </div>
                 }
            </div>
        
                 
    </div>
</section>
<script>
    $(function () {
        if ('@ViewData["FormCall"]' != "ApprovalQueue") {
            DisableBtnAuthorize();
        }
    })
</script>