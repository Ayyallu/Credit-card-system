
@using CC_Ingenio.DataTranfer.MasterInfo;
@using CC_Ingenio.Web.Helpers;
@using CC_Ingenio_Resources;

@{
    ViewBag.Title = String.Concat(new object[] { Resources.Add, " ", Resources.Franchise});
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@model FranchiseDTO
@{
    List<string> lstPriv = new List<string>();
    List<SelectListItem> OrganizationItems = new List<SelectListItem>();
    foreach (var itm in ViewBag.Organizations)
    {
        OrganizationItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }

    if (ViewBag.Privileges != null)
    {

        foreach (var item in ViewBag.Privileges)
        {
            lstPriv.Add(item);
        }
    }
}

<script type="text/javascript">

    function setCalenderDates() {

        var fromDate = $('#FromDate').val();
        var toDate = $('#ToDate').val();

        $('#FromDate').datepicker("option", "maxDate", toDate);
        $('#ToDate').datepicker("option", "minDate", fromDate);
    }

    $(document).ready(function () {

        $('#FromDate').datepicker("option", "onSelect", setCalenderDates);
        $('#ToDate').datepicker("option", "onSelect", setCalenderDates);

        $("#frmFranchise").submit(function (e) {

            if ($('#FranchiseCode').val().trim() <= parseFloat(0)) {
                $('#FranchiseCode_Validate').text("@Html.Raw(string.Format(Resources.MsgErrValueNotZero,Resources.FranchiseCode))");
                e.preventDefault();
            }
        })

        $('#FranchiseCode').focusin(function () {
            $('#FranchiseCode_Validate').text("");
        });

    });
</script>

<section class="featured">
    <div class="PageTitle">@ViewBag.Title</div>
    <div class="PageRow">

        <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            @if (ViewData["FormCall"] != "ApprovalQueue")
            {
                <li> @Html.ActionLink(Resources.SearchPageHeading,"FranchiseList","Master" )</li>
            }
            <li class="active"> @Html.ActionLink(Resources.DetailsPageHeading,"FranchiseAdd","Master" )</li>
        </ul>
       
            <!-- Tabs Content -->
            <div class="tabs-container">
                 @using (Html.BeginForm("FranchiseSave", "Master", new { AFranchiseCode = Model.FranchiseCode,AOrganizationCode = Model.OrganizationCode  }, FormMethod.Post, new { id = "frmFranchise", name = "frmFranchise" }))
                 {
                <div class="tab-content" id="tab1">
                    <div>
                        <span>
                            @if (!string.IsNullOrWhiteSpace(Model.ApprovalStatus))
                            { 
                                <text> @String.Concat(new object[] { Resources.Status, ":", Model.ApprovalStatusDesc }) </text>
                            }
                        </span>
                    </div>
                    <div class="row">
   
                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label">@Resources.FranchiseCode</div>
                                <div class="Field">

                                     @if (!string.IsNullOrWhiteSpace(Model.FranchiseCode))
                                    {
                                        @Html.TextBoxFor(x => x.FranchiseCode, new { id = "FranchiseCode", name = "FranchiseCode", maxlength = "5", @readonly = "readonly" })
                                    }
                                    else
                                    { 
                                        @Html.TextBoxFor(x => x.FranchiseCode, new { id = "FranchiseCode", name = "FranchiseCode", maxlength = "5" })
                                    }
                                    @Html.ValidationMessageFor(x => x.FranchiseCode)
                                    <label id="FranchiseCode_Validate" class="validationMessage"></label>                                  
                                </div>
                            </div>
                            <div class="TwoColumn">
                                <div class="label">@Resources.FranchiseName</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.FranchiseName, new { id = "FranchiseName", name = "FranchiseName", maxlength = 50  })
                                    @Html.ValidationMessageFor(x => x.FranchiseName)
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label">@Resources.Organization</div>
                                <div class="Field">
                                    @Html.DropDownListFor(x => x.OrganizationCode, OrganizationItems.AsEnumerable(), new { @disabled = "disabled"})
                                    @Html.HiddenFor(x => x.OrganizationCode)
                                    @Html.ValidationMessageFor(x => x.OrganizationCode)
                                </div>
                            </div>
                            <div class="TwoColumn">
                                <div class="label fontmandatory">@Resources.FranchiseAllocation</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.Allocation, new { id = "Allocation", name = "Allocation", maxlength = 5 })
                                    @Html.ValidationMessageFor(x => x.Allocation)
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label">@Resources.EffectiveFromDate</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.EffectiveFromDate, new {id = "FromDate", @class ="datepicker", @readonly="true", Value = Model.EffectiveFromDate.ToShortDateString() })
                                    @Html.ValidationMessageFor(x => x.EffectiveFromDate)
                                </div>
                            </div>
                            <div class="TwoColumn">
                                <div class="label">@Resources.EffectiveToDate</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.EffectiveToDate, new { id = "ToDate", @class ="datepicker", @readonly="true", Value = Model.EffectiveToDate.ToShortDateString() })
                                    @Html.ValidationMessageFor(x => x.EffectiveToDate)
                                </div>
                            </div>
                        </div>

                        @Html.Raw(Html.BasicButtons(lstPriv))

                    </div>
                </div>
                 }

            </div>
        

    </div>
</section>
<script>
    $(function () {
        setCalenderDates();

        if ('@ViewData["FormCall"]' != "ApprovalQueue") {
            DisableBtnAuthorize();
        }
    })
</script>
