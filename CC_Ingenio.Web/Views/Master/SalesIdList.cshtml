@using CC_Ingenio.Web.ViewModel.Master;
@using CC_Ingenio_Resources;

@{
    ViewBag.Title = String.Concat(new object[] { Resources.SalesId, " ", Resources.Search });
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model SalesIdSearch
@{
    var grid = new WebGrid(Model.SearchResults, canPage: true, rowsPerPage: CC_Ingenio.Common.Utils.Utils.GRD_ROWS_PER_PAGE, selectionFieldName: "", ajaxUpdateContainerId: "container-body");
    grid.Pager(WebGridPagerModes.All);
    List<string> lstPriv = new List<string>();
    if (ViewBag.Privileges != null)
    {

        foreach (var item in ViewBag.Privileges)
        {
            lstPriv.Add(item);
        }
    }
 }


<section class="feature">

    <div class="PageTitle">@ViewBag.Title</div>

    <!-- Tabs
	================================================== -->

    <div class="PageRow">

                <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            <li class="active">@Html.ActionLink(Resources.SearchPageHeading, "SalesIdList", "Master" )</li>
            <li> @Html.ActionLink(Resources.DetailsPageHeading,"SalesIdAdd","Master" )</li>
        </ul>

        <!-- Tabs Content -->
        <div class="tabs-container">
            <div class="tab-content" id="tab1">
                <div class="row">
                    @using (Html.BeginForm("SalesIdList", "Master", FormMethod.Get, new { id = "frmList", name = "frmList" }))
                    {
                        <div class="SearchBox">
                            <div class="row">
                                <div class="row">
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.SalesId</div>
                                        <div class="Field" style="padding-left:10px">
                                            @Html.TextBoxFor(x => x.SalesId, new { id = "SalesId", name="SalesId", maxlength = 8})
                                        </div>                                       
                                    </div>
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.RUT</div>
                                        <div class="Field" style="padding-left:10px">
                                            @Html.TextBoxFor(x=>x.RUT, new { id = "RUT", name="RUT", maxlength = 12 })
                                        </div>
                                    </div>
                                </div>      
                                <div class="row">
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.BranchCode</div>
                                        <div class="Field" style="padding-left:10px">
                                            @Html.TextBoxFor(x=>x.BranchCode, new { id = "BranchCode", name="BranchCode", maxlength = 3})
                                        </div>                                       
                                    </div>    
                                    <div class="TwoColumn">
                                        <div class="label">&nbsp;</div>
                                        <div class="Field">&nbsp;</div>                                       
                                    </div>                                   
                                </div>
                                <div class="row">
                                    <div class="SearchColumnbtn">
                                        <span>
                                            <input id="SearchButton" name="SearchButton" class="Greenbutton" type="submit" value="@Resources.Search" />
                                        </span>
                                        <span>
                                            <input id="Button2" type="submit" name ="ClearButton"  class="Greenbutton" value="@Resources.Clear" />
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="clear"></div>
                        </div>
                    }
                </div>
                <div class="row">
                   
                    <div class="standard-table">

                        @grid.GetHtml(alternatingRowStyle:"alt",columns:grid.Columns(
                                    grid.Column("SalesId",Resources.SalesId),                                    
                                      grid.Column("RUT",Resources.RUT ),
                                    grid.Column("BranchCode", Resources.BranchCode),  
                                    grid.Column("ApprovalStatusDesc", Resources.Status),
                                    grid.Column(Resources.Edit, format: 
                                        (item) =>
                                            {
                                                if (item.ApprovalStatus.Equals("D") || item.ApprovalStatus.Equals("R"))
                                                {
                                                    return Html.Raw(Html.ActionLink(Resources.Edit, "SalesIdAdd", "Master", new { ASalesId = item.salesid,ARUT = item.RUT, AOrganizationCode = item.OrganizationCode }, null));
                                                    
                                                }   
                                                else
                                                {
                                                    return Html.Raw(Html.Raw(Html.ActionLink(Resources.View, "SalesIdView", "Master", new { ASalesId = item.salesid, ARUT = item.RUT, AOrganizationCode = item.OrganizationCode }, null))); 
                                                }
                                            }),
                                    grid.Column(Resources.Delete,   format: 
                                        (item) =>
                                                 {
                                                     if (lstPriv.Contains("Delete"))
                                                     {
                                                         if (item.ApprovalStatus.Equals("D") || item.ApprovalStatus.Equals("R") || item.ApprovalStatus.Equals("A"))
                                                         {
                                                             return Html.Raw(Html.ActionLink(Resources.Delete, "SalesDelete", "Master", new { ASalesId = item.salesid, ARUT = item.RUT, AOrganizationCode = item.OrganizationCode }, new { @class = "delete-link" }));
                                                         }
                                                         else
                                                         {
                                                             return Html.Raw("");
                                                         }
                                                     }
                                                     else
                                                     {
                                                         return Html.Raw("");
                                                     }
                                            })
                    ))                

                    </div>
                </div>
            </div>


        </div>

    </div>

</section>
