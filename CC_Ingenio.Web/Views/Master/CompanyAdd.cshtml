@using CC_Ingenio.DataTranfer.MasterInfo;
@using CC_Ingenio.Web.Helpers;
@using CC_Ingenio_Resources;

@model CompanyDTO
@{
    List<SelectListItem> companyCategoryList = new List<SelectListItem>();
    List<string> lstPriv = new List<string>();
    
    foreach (var item in ViewBag.CompanyCategory)
    {
        companyCategoryList.Add(new SelectListItem { Text = item.Text, Value = item.Value });
    }

    List<SelectListItem> productCategoryList = new List<SelectListItem>();
    foreach(var item in ViewBag.ProductCategoryList)
    {
        productCategoryList.Add(new SelectListItem { Text = item.Text, Value = item.Value });
    }

    if (ViewBag.Privileges != null)
    {

        foreach (var item in ViewBag.Privileges)
        {
            lstPriv.Add(item);
        }
    }
    
}

@{
    ViewBag.Title = String.Concat(new object[] { Resources.Add, " ", Resources.Corporate });
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script type="text/javascript">


    function setCalenderDates() {
        var fromDate = $('#FromDate').val();
        var toDate = $('#ToDate').val();

        $('#FromDate').datepicker("option", "maxDate", toDate);
        $('#ToDate').datepicker("option", "minDate", fromDate);
    }

   $(document).ready(function () {

        $('#FromDate').datepicker("option", "onSelect", setCalenderDates);
        $('#ToDate').datepicker("option", "onSelect", setCalenderDates);

        $("#frmCompany").submit(function (e) {

            if ($('#CompanyCode').val().trim() <= parseFloat(0)) {
                $('#CompanyCode_Validate').text("@Html.Raw(string.Format(Resources.MsgErrValueNotZero,Resources.CorporateCode))");
                e.preventDefault();
            }
        })

        $('#CompanyCode').focusin(function () {
            $('#CompanyCode_Validate').text("");
        });

    });
    
</script>

@section featured
    {
    
    }

<section class="featured">
    <div class="PageTitle">@ViewBag.Title</div>
    <div class="PageRow">


        <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            @if (ViewData["FormCall"] != "ApprovalQueue")
            {
                <li>@Html.ActionLink(Resources.SearchPageHeading, "CompanyList", "Master")</li>
            }
            <li class="active"><a href="#tab1">@Resources.DetailsPageHeading</a></li>
        </ul>

        <!-- Tabs Content -->
        <div class="tabs-container">
            @using (Html.BeginForm("CompanySave", "Master", new { ACompanyCode = Model.CompanyCode, AOrganizationCode = Model.OrganizationCode }, FormMethod.Post, new { id = "frmCompany", name = "frmCompany" }))
            {
                <div class="tab-content" id="tab1">
                    <div>
                        <span>
                            @if (!string.IsNullOrWhiteSpace(Model.ApprovalStatus))
                            { 
                                <text> @String.Concat(new object[] { Resources.Status, ":", Model.ApprovalStatusDesc }) </text>
                            }
                        </span>
                    </div>
                    <div class="row">

                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label">@Resources.CorporateCode</div>
                                <div class="Field">
                                    @if (!string.IsNullOrWhiteSpace(Model.CompanyCode))
                                    {
                                        @Html.TextBoxFor(x => x.CompanyCode, new { id = "CompanyCode", name = "CompanyCode", maxlength = 5, @readonly = "readonly" });
                                    }
                                    else
                                    {
                                        @Html.TextBoxFor(x => x.CompanyCode, new { id = "CompanyCode", name = "CompanyCode", maxlength = 5 });
                                    }
                                    @Html.ValidationMessageFor(x => x.CompanyCode)
                                    <label id="CompanyCode_Validate" class="validationMessage"></label>
                                </div>
                            </div>
                            <div class="TwoColumn">
                                <div class="label">@Resources.CorporateName</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.CompanyName, new { id = "CompanyName", name = "CompanyName", maxlength = 50 })
                                    @Html.ValidationMessageFor(x => x.CompanyName)
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label fontmandatory">@Resources.CorporateCategory</div>
                                <div class="Field">
                                    @Html.DropDownListFor(x => x.CompanyCategoryCode, companyCategoryList)
                                    @Html.ValidationMessageFor(x => x.CompanyCategoryCode)
                                </div>
                            </div>
                            <div class="TwoColumn">
                                <div class="label fontmandatory">@Resources.BlackListed</div>

                                @Html.CheckBoxFor(x => x.IsBlackListed)
                                @Html.ValidationMessageFor(x => x.IsBlackListed)


                            </div>
                        </div>
                        <div class="row">
                            <div class="TwoColumn">

                                <div class="label">@Resources.EffectiveFromDate</div>
                                <div class="Field">
                                     @Html.TextBoxFor(x => x.EffectiveFromDate, new {id = "FromDate", @class ="datepicker", @readonly="true", Value = Model.EffectiveFromDate.ToShortDateString() })
                                    @Html.ValidationMessageFor(x => x.EffectiveFromDate)
                                </div>
                            </div>
                            <div class="TwoColumn">
                                <div class="label">@Resources.EffectiveToDate</div>
                                <div class="Field">
                                      @Html.TextBoxFor(x => x.EffectiveToDate, new { id = "ToDate", @class ="datepicker", @readonly="true", Value = Model.EffectiveToDate.ToShortDateString() })
                                    @Html.ValidationMessageFor(x => x.EffectiveToDate)
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="TwoColumn">

                                <div class="label fontmandatory">@Resources.PricingAmount</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.PricingAmount, @String.Format("{0:n0}", Model.PricingAmount), new { @class = "NumberCommaDot", id = "PricingAmount", maxlength = 11, @style = "text-align:right", onblur = "FormatOnBlur(event)" })
                                    @Html.ValidationMessageFor(x => x.PricingAmount)
                                </div>
                            </div>
                            <div class="TwoColumn">

                                <div class="label ">@Resources.ProductCategory</div>
                                <div class="Field">
                                    @Html.DropDownListFor(x => x.ProductCategoryCode, productCategoryList)
                                    @Html.ValidationMessageFor(x => x.ProductCategoryCode)
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label fontmandatory">@Resources.AffinityFlag</div>
                                @Html.CheckBoxFor(x => x.IsAffinity)
                                @Html.ValidationMessageFor(x => x.IsAffinity)
                            </div>
                        </div>
                        <div class="TwoColumn">
                            <div class="label fontmandatory">&nbsp</div>
                            <div>&nbsp;</div>
                        </div>

                        @Html.Raw(Html.BasicButtons(lstPriv))

                    </div>                    
                </div>
                 }
        </div>
    </div>
</section>
<script>
    $(function () {
        setCalenderDates();

        if ('@ViewData["FormCall"]' != "ApprovalQueue") {
            DisableBtnAuthorize();
        }
    })
</script>





