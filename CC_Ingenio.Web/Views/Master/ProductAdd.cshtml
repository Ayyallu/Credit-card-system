<script>
    $(function () {
        if ('@ViewData["FormCall"]' != "ApprovalQueue") {
            DisableBtnAuthorize();

            if ('@ViewData["FormStatus"]' == "A") {

                if ($("#Submit").length) { $("#Submit").removeClass('BtnDisabled').addClass('Greenbutton'); }
                $("#Submit").attr('disabled', false);


                if ($("#Delete").length) { $("#Delete").removeClass('Greenbutton').addClass('BtnDisabled'); }
                $("#Delete").attr('disabled', true);
            }
        }
    })
</script>