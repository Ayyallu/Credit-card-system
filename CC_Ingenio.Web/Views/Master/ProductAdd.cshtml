<script type="text/javascript">

    $(document).ready(function () {
        

        $('#New').click(function () {
            document.location.href = "ProductAdd";
        });
        
        $('#frmProductSave').on('submit', function (e) {
            
            $("#lstSelectedPaymentAllocSeq option").prop("selected", "selected");
            $("#lstSelectedMemberTypeSeq option").prop("selected", "selected");
            
            if (Globalize(resourceProvider.ResourceCulture).parseFloat($('#ProductCode').val().trim()) <= parseFloat(0)) {
                $('#ProductCode_Validate').text("@Html.Raw(String.Format(Resources.MsgErrValueShouldBeBetween, Resources.ProductCode,  "'00001'", "'99999'"))");
                e.preventDefault();
            }
            if (Globalize(resourceProvider.ResourceCulture).parseFloat($('#CombinedScore').val().trim()) == parseFloat(0)) {
                $('#CombinedScore_Validate').text("@Html.Raw(String.Format(Resources.MsgErrValueGreaterThanZero, Resources.CombinedScore))");
                e.preventDefault();
            }
            if (Globalize(resourceProvider.ResourceCulture).parseFloat($('#MinimumCardAdvance').val().trim()) > Globalize(resourceProvider.ResourceCulture).parseFloat($('#MaximumCardAdvance').val().trim())) {
                $('#MaximumCardAdvance_Validate').text("@Html.Raw(String.Format(Resources.MsgErrValueShouldBeLessThan, Resources.MinimumCardAdvance,  Resources.MaximumCardAdvance))");
                e.preventDefault();
            }
            if (Globalize(resourceProvider.ResourceCulture).parseFloat($('#MinimumCreditLine').val().trim()) > Globalize(resourceProvider.ResourceCulture).parseFloat($('#MaximumCreditLine').val().trim())) {
                $('#MaximumCreditLine_Validate').text("@Html.Raw(String.Format(Resources.MsgErrValueShouldBeLessThan, Resources.MinimumCreditLine,  Resources.MaximumCreditLine))");
                e.preventDefault();
            }
            if (Globalize(resourceProvider.ResourceCulture).parseFloat($('#MaximumCreditLine').val().trim()) == parseFloat(0)) {
                $('#MaximumCreditLine_Validate').text("@Html.Raw(String.Format(Resources.MsgErrValueGreaterThanZero, Resources.MaximumCreditLine))");
                e.preventDefault();
            }
            else {
                $("#lstSelectedPaymentAllocSeq option").prop("selected", "selected");
                $("#lstSelectedMemberTypeSeq option").prop("selected", "selected");
            }

            if ($('#lstSelectedPaymentAllocSeq option:selected').length == 0) {
                $('#AssignedList_Validate').text("@Html.Raw(String.Format(Resources.MsgErrPleaseEnter2, Resources.PaymentAllocationType))");
                e.preventDefault;
                //return false;
            }

            if ($('#lstSelectedMemberTypeSeq option:selected').length == 0) {
                $('#PaymentAllocAssignList_Validate').text("@Html.Raw(String.Format(Resources.MsgErrPleaseEnter2, Resources.ProductMemberType))");
                e.preventDefault;
                return false;
            }
            
        });
        

        $('#MinimumCardAdvance').focusin(function () {
            $('#MaximumCardAdvance_Validate').text("");
        });

        $('#MaximumCardAdvance').focusin(function () {-
            $('#MaximumCardAdvance_Validate').text("");
        });

        $('#MinimumCreditLine').focusin(function () {
            $('#MaximumCreditLine_Validate').text("");
        });

        $('#MaximumCreditLine').focusin(function () {
            $('#MaximumCreditLine_Validate').text("");
        });

        $('#ProductCode').focusin(function () {
            $('#ProductCode_Validate').text("");
        });

        $('#CombinedScore').focusin(function () {
            $('#CombinedScore_Validate').text("");
        });

        $('#ProductCode').blur(function () {
            if ($('#ProductCode').valid() && $('#BinValue').val() != "") {
                var val = $('#ProductCode').val();
                var BinVal = $('#BinValue').val();
                $('#BinValue').val(val.substring(0, 1) + BinVal.substring(1, BinVal.length));
            }
        });

        $('#BinValue').blur(function () {
            if ($('#BinValue').valid() && $('#ProductCode').val() != "") {
                var val = $('#ProductCode').val();
                var BinVal = $('#BinValue').val();
                $('#BinValue').val(val.substring(0, 1) + BinVal.substring(1, BinVal.length));
            }
        });

        

        var originalItems;
        var selectedItems;

        window.globalVar = $("#lstPaymentAllocSeq option");
        originalItems = $("#lstPaymentAllocSeq option");
        var originalItemsCopy = originalItems;
        $("#btnMoveUp").click(moveUp);
        $("#btnMoveDown").click(moveDown);
        resetList();

        $('#btnRight').click
            (function (e) {
                var selectedItem = $('#lstPaymentAllocSeq option:selected');
                if (selectedItem.length == 0) {
                    alert('@Resources.MsgInfoNoItemSelected');
                    e.preventDefault;
                }
                else {
                    $("#lstPaymentAllocSeq > option:selected").appendTo("#lstSelectedPaymentAllocSeq");
                    $("#lstSelectedPaymentAllocSeq")[0].selectedIndex = -1;
                    //$("#lstSelectedPaymentAllocSeq").change();
                    $('#AssignedList_Validate').text("");
                };
            });

        $('#btnLeft').click(function (e) {
            var selectedItemLeft = $('#lstSelectedPaymentAllocSeq option:selected');
            if (selectedItemLeft.length == 0) {
                alert('@Resources.MsgInfoNoItemSelected');
            }
            else {
                $('#lstSelectedPaymentAllocSeq > option:selected').appendTo("#lstPaymentAllocSeq");
                resetList();
                $("#lstPaymentAllocSeq")[0].selectedIndex = -1;
            }
        });

        function moveUp() {
            $("#lstSelectedPaymentAllocSeq option:selected").each(function () {
                var listItem = $(this);
                var listItemPosition = $("#lstSelectedPaymentAllocSeq option").index(listItem) + 1;

                if (listItemPosition == 1) return false;

                listItem.insertBefore(listItem.prev());
            });
        }

        function moveDown() {

            var itemsCount = $("#lstSelectedPaymentAllocSeq option").length;

            $($("#lstSelectedPaymentAllocSeq option:selected").get().reverse()).each(function () {
                var listItem = $(this);
                var listItemPosition = $("#lstSelectedPaymentAllocSeq option").index(listItem) + 1;

                if (listItemPosition == itemsCount) return false;

                listItem.insertAfter(listItem.next());
            });
        }

        function resetList() {

            selectedItems = $("#lstSelectedPaymentAllocSeq option");

            originalItemsCopy = globalVar.slice();

            for (var i = 0; i < selectedItems.length; i++) {
                removeFromArray(selectedItems[i].value);
            }

            function removeFromArray(arrElem) {
                for (var i = originalItemsCopy.length; i--;) {
                    if (originalItemsCopy[i].value === arrElem) {
                        originalItemsCopy.splice(i, 1);
                        return false;
                    }
                }
            };

            var result = originalItemsCopy;
            var finalArray = result.get();
            $("#lstPaymentAllocSeq").html(finalArray);

        }
        
        
        $("#frmPaymentAllocationTypeSave").submit(function (e) {
            $("#lstSelectedPaymentAllocSeq option").prop("selected", "selected");
            $("#lstSelectedMemberTypeSeq option").prop("selected", "selected");
        });

        $("#lstSelectedPaymentAllocSeq")[0].selectedIndex = -1;


        //Member Type multiselect List

        var originalMemberTypeItems;
        var selectedMemberTypeItems;

        window.globalVar2 = $("#lstAllMemberTypeSeq option");
        originalMemberTypeItems = $("#lstAllMemberTypeSeq option");
        var originalMemberTypeItemsCopy = originalMemberTypeItems;
        
        $('#btnRight1').click
            (function (e) {
                var selectedItem = $('#lstAllMemberTypeSeq option:selected');
                if (selectedItem.length == 0) {
                    alert('@Resources.MsgInfoNoItemSelected');
                    e.preventDefault;
                }
                else {
                    $("#lstAllMemberTypeSeq > option:selected").appendTo("#lstSelectedMemberTypeSeq");
                    $("#lstSelectedMemberTypeSeq")[0].selectedIndex = -1;
                    $('#PaymentAllocAssignList_Validate').text("");
                };
            });

                
        $("#lstSelectedMemberTypeSeq")[0].selectedIndex = -1;

        $('#btnLeft1').click(function (e) {
            var selectedItemLeft = $('#lstSelectedMemberTypeSeq option:selected');
            if (selectedItemLeft.length == 0) {
                alert('@Resources.MsgInfoNoItemSelected');
            }
            else {
                $('#lstSelectedMemberTypeSeq > option:selected').appendTo("#lstAllMemberTypeSeq");
                resetList();
                $("#lstAllMemberTypeSeq")[0].selectedIndex = -1;
            }
        });

        resetList2();

        window.globalVar2 = $("#lstAllMemberTypeSeq option");
        function resetList2() {

            var selectedMemberTypeItems = $("#lstSelectedMemberTypeSeq option");

            var memberTypeItemsCopy = globalVar2.slice();

            for (var i = 0; i < selectedMemberTypeItems.length; i++) {
                removeFromArray(selectedMemberTypeItems[i].value);
            }

            function removeFromArray(arrElem) {
                for (var i = 0; i < memberTypeItemsCopy.length; i++) {
                    if (memberTypeItemsCopy[i].value === arrElem) {
                        memberTypeItemsCopy.splice(i, 1);
                    } 
                }
            };

            var result = memberTypeItemsCopy;
            var finalArray = result.get();
            $("#lstAllMemberTypeSeq").html(finalArray);

        }

    });
</script>


