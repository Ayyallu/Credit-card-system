@using CC_Ingenio.DataTranfer.MasterInfo;
@using CC_Ingenio.Web.Helpers;
@using CC_Ingenio_Resources;

@{
    ViewBag.Title = String.Concat(new object[] { Resources.Add, " ", Resources.Sourcing });
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model SourcingDTO
@{
    List<string> lstPriv = new List<string>();
    if (ViewBag.Privileges != null)
    {

        foreach (var item in ViewBag.Privileges)
        {
            lstPriv.Add(item);
        }
    }
    
    }
@section featured {
}

<script type="text/javascript">
$(document).ready(function () {
    
    $("#frmSourceChannel").submit(function (e) {

        if ($('#SourcingChannelCode').val().trim() <= parseFloat(0)) {
            $('#SourcingChannelCode_Validate').text("@Html.Raw(string.Format(Resources.MsgErrValueNotZero,Resources.SourcingChannelCode))");
                e.preventDefault();
            }
        })

    $('#SourcingChannelCode').focusin(function () {
        $('#SourcingChannelCode_Validate').text("");
        });

});
    </script>

<section class="featured">
     <div class="PageTitle">@ViewBag.Title </div>
     <div class="PageRow">


        <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            @if (ViewData["FormCall"] != "ApprovalQueue")
            {
                <li> @Html.ActionLink(Resources.SearchPageHeading,"SourcingList","Master" )</li>
            }
            <li class="active"> @Html.ActionLink(Resources.DetailsPageHeading,"SourcingAdd","Master" )</li>
        </ul>
       
            <!-- Tabs Content -->
            <div class="tabs-container">
                 @using (Html.BeginForm("SourcingSave", "Master", new { ASourcingChannelCode = Model.SourcingChannelCode, AOrganizationCode = Model.OrganizationCode }, FormMethod.Post, new { id = "frmSourceChannel", name = "frmSourceChannel" }))
                 {
                <div class="tab-content" id="tab1">
                    <div>
                        <span>
                            @if (!string.IsNullOrWhiteSpace(Model.ApprovalStatus))
                            { 
                                <text> @String.Concat(new object[] { Resources.Status, ":", Model.ApprovalStatusDesc }) </text>
                            }
                        </span>
                    </div>
                    <div class="row">
                    
                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label">@Resources.SourcingChannelCode </div>
                                <div class="Field">
                                    @if (!string.IsNullOrWhiteSpace(Model.SourcingChannelCode))
                                    {
                                        @Html.TextBoxFor(x => x.SourcingChannelCode, new { id = "SourcingChannelCode", name = "SourcingChannelCode", maxlength = "5", @readonly = "readonly" })
                                    }
                                    else
                                    { 
                                        @Html.TextBoxFor(x => x.SourcingChannelCode, new { id = "SourcingChannelCode", name = "SourcingChannelCode", maxlength = "5" })
                                    }
                                    @Html.ValidationMessageFor(x => x.SourcingChannelCode)
                                    <label id="SourcingChannelCode_Validate" class="validationMessage"></label>
                                </div>
                            </div>
                            <div class="TwoColumn">
                                <div class="label">@Resources.SourcingChannelName </div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.SourcingChannelName, new { maxlength = "50" })
                                    @Html.ValidationMessageFor(x => x.SourcingChannelName)
                                </div>
                            </div>
                        </div>
                                                
                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label fontmandatory">@Resources.FloorLimit</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.FloorLimit, @String.Format("{0:N0}", Model.FloorLimit), new { @class = "NumberCommaDot", id = "FloorLimit", maxlength = 11, @style = "text-align:right", onblur = "FormatOnBlur(event)" })
                                    @Html.ValidationMessageFor(x => x.FloorLimit)
                                </div>
                            </div>
                            <div class="TwoColumn">
                                <div class="label fontmandatory">@Resources.CeilingLimit</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.CeilingLimit, @String.Format("{0:N0}", Model.CeilingLimit), new { @class = "NumberCommaDot", id = "CeilingLimit", maxlength = 11, @style = "text-align:right", onblur = "FormatOnBlur(event)" })
                                    @Html.ValidationMessageFor(x => x.CeilingLimit)
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label fontmandatory">@Resources.LetterGenerationDelayDays</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.LetterGenerationDelayDays, new { @class = "Number", id = "LetterGenerationDelayDays", maxlength = 2 })
                                    @Html.ValidationMessageFor(x => x.LetterGenerationDelayDays)
                                </div>
                            </div>
                                <div class="TwoColumn">
                                    <div class="label">&nbsp;</div>
                                    <div class="Field">
                                        &nbsp;
                                        <div class="row">
                                            &nbsp;
                                        </div>
                                    </div>
                                </div>
                        </div>

                        @Html.Raw(Html.BasicButtons(lstPriv))

                    </div>
                </div>
                 }

            </div>
        

    </div>
</section>
<script>
    $(function () {
        if ('@ViewData["FormCall"]' != "ApprovalQueue") {
            DisableBtnAuthorize();
        }
    })
</script>