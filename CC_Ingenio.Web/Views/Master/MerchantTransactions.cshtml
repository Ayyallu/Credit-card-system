@using CC_Ingenio.Web.ViewModel.Master
@using CC_Ingenio_Resources;

@{
    ViewBag.Title = String.Concat(new object[] { Resources.MT_MERCHANTTRANSACTION, " ", Resources.Search });
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model MerchantTransactions
@{
    
    var grid = new WebGrid(Model.SearchResults, canPage: true, rowsPerPage: CC_Ingenio.Common.Utils.Utils.GRD_ROWS_PER_PAGE, ajaxUpdateContainerId: "container-body");
    grid.Pager(WebGridPagerModes.All);

    List<string> lstPriv = new List<string>();
    if (ViewBag.Privileges != null)
    {
        foreach (var item in ViewBag.Privileges)
        {
            lstPriv.Add(item);
        }
    }
}

<script type="text/javascript">

    function setCalenderDates() {

        var fromDate = $('#FromDate').val();
        var toDate = $('#ToDate').val();

        if (toDate == "") {
            $("#ToDate").datepicker("setDate", fromDate);
        }

        if (fromDate == "") {
            $("#FromDate").datepicker("setDate", toDate);
        }

        fromDate = $('#FromDate').val();
        $('#ToDate').datepicker("option", "minDate", fromDate);

    }

    $(document).ready(function () {
        $('#FromDate').datepicker("option", "onSelect", setCalenderDates);
        $('#ToDate').datepicker("option", "onSelect", setCalenderDates);
        setCalenderDates();


        $('#ClearButton').click(function () {
            $('#txtMerchantCode').val('');
            $('#txtMerchantName').val('');
            $("#FromDate").datepicker("setDate", "");
            $("#ToDate").datepicker("setDate", "");
        });
    });

</script>

<section class="feature">
    <div class="PageTitle">@ViewBag.Title</div>
    <div class="tabs-container">
        <div class="tab-content" id="tab1">
            <div class="row">
                @using (Html.BeginForm("MerchantTransactions", "Master", FormMethod.Get, new { id = "frmTrans", name = "frmTrans" }))
                {
                    <div class="SearchBox">
                        <div class="row">
                            <div class="row">
                                <div class="TwoColumn">
                                    <div class="label">@Resources.MerchantCode</div>
                                    <div class="Field">
                                        @Html.TextBoxFor(x => x.MerchantCode, new { id = "txtMerchantCode", maxlength = 11 })
                                    </div>
                                </div>
                                <div class="TwoColumn">
                                    <div class="label">@Resources.MerchantName</div>
                                    <div class="Field">
                                        @Html.TextBoxFor(x => x.MerchantName, new { id = "txtMerchantName", maxlength = 50 })
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="TwoColumn">
                                    <div class="label">@Resources.FromDate</div>
                                    <div class="Field">
                                        @Html.TextBoxFor(x => x.TxnFromDate, new { @class = "datepicker", id = "FromDate", @readonly = "readonly", Value = Model.TxnFromDate.ToShortDateString() })
                                    </div>
                                </div>
                                <div class="TwoColumn">
                                    <div class="label">@Resources.ToDate</div>
                                    <div class="Field">
                                        @Html.TextBoxFor(x => x.TxnToDate, new { @class = "datepicker", id = "ToDate", @readonly = "readonly", Value = Model.TxnToDate.ToShortDateString() })
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="SearchColumnbtn">
                                    <span>
                                        <input id="SearchButton" name="SearchButton" class="Greenbutton" type="submit" value="@Resources.Search" />
                                    </span>

                                    <span>
                                        <input id="ClearButton" type="button" name="ClearButton" class="Greenbutton" value="@Resources.Clear" />
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                }

            </div>
            <div class="row">
                <div class="standard-table">
                    @grid.GetHtml(columns: grid.Columns(
                                    grid.Column("MerchantCode", Resources.MerchantCode),
                                    grid.Column("MerchantName", Resources.MerchantName),
                                    grid.Column("CardNumber", Resources.CardNumber),
                                    grid.Column("AccountNo", Resources.AccountNumber),
                                    grid.Column("TxnDate", Resources.TransactionDate, format: @<text> @item.TxnDate.ToShortDateString()</text>),
                                    grid.Column("Amount", Resources.Amount,format: (item) => string.Format("{0:N0}", item.Amount), style: "gridAmountRightAlign"),
                                    grid.Column("Description", Resources.Description),
                                    grid.Column("CommissionAmt", Resources.CommissionAmount,format: (item) => string.Format("{0:N0}", item.CommissionAmt), style: "gridAmountRightAlign")
                         ))
                    @if (Model.SearchResults.Count == 0 && !(string.IsNullOrEmpty(Model.SearchButton)))
                    {
                        @Html.Label(Resources.MsgErrNoRecordsFound, new { @class = "validationMessage" })
                    }
                </div>

            </div>
        </div>

    </div>
</section>
