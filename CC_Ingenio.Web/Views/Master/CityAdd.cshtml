@using CC_Ingenio_Resources;
@using CC_Ingenio.DataTranfer.MasterInfo;
@using CC_Ingenio.Web.Helpers;

@{
    ViewBag.Title = String.Concat(new object[] { Resources.Add, " ", Resources.City });
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@model CityDTO
@{
    
    List<SelectListItem> CountryItems = new List<SelectListItem>();
    List<string> lstPriv = new List<string>();

    foreach (var itm in ViewBag.Countries)
    {
        CountryItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }

    List<SelectListItem> CityCategoryItems = new List<SelectListItem>();
    foreach (var itm in ViewBag.CityCategories)
    {
        CityCategoryItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }

    List<SelectListItem> RegionItems = new List<SelectListItem>();
    foreach (var itm in ViewBag.Regions)
    {
        RegionItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }
    
    List<SelectListItem> HubItems = new List<SelectListItem>();
    foreach (var itm in ViewBag.Hubs)
    {
        HubItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }
    
    List<SelectListItem> SpokeItems = new List<SelectListItem>();
    foreach (var itm in ViewBag.Spokes)
    {
        SpokeItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }
    List<SelectListItem> CommunaItems = new List<SelectListItem>();
    foreach (var itm in ViewBag.Communas)
    {
        CommunaItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }
    
    if (ViewBag.Privileges != null)
    {

        foreach (var item in ViewBag.Privileges)
        {
            lstPriv.Add(item);
        }
    }
    
}



<script type="text/javascript">
    $(document).ready(function () {
        var control = "#CountryCode";
        $("#CountryCode").change(function () {
            var countryCode = $(this).val();
            PopulateDropDownViaAjax("#RegionCode", "/Master/GetRegions?Id=" + countryCode);
            PopulateDropDownViaAjax("#HubCode", "/Master/GetHubs?Id=" + countryCode);
            PopulateDropDownViaAjax("#SpokeCode", "/Master/GetSpokes?Id=" + countryCode);
            PopulateDropDownViaAjax("#CommunaCode", "/Master/GetCommunas?Id=" + countryCode);
        });
    });


    function bindRegionValue(selectedValue){

        var countryCode =  $("#CountryCode").val();        
        if (selectedValue != "") {
            $.getJSON("/Master/GetRegions?Id=" + countryCode,
                function (modeldata) {
                    var select = $("[id = RegionCode]");
                    select.empty();
                    $.each(modeldata, function (index, itemData) {
                        select.append($('<option/>', {
                            value: itemData.Value,
                            text: itemData.Text
                        }));
                    });
                    select.val(selectedValue);
                });
        }

    };

    function bindHubValue(selectedValue){

        var countryCode =  $("#CountryCode").val();        
        if (selectedValue != "") {
            $.getJSON("/Master/GetHubs?Id=" + countryCode,
                function (modeldata) {
                    var select = $("[id = HubCode]");
                    select.empty();
                    $.each(modeldata, function (index, itemData) {
                        select.append($('<option/>', {
                            value: itemData.Value,
                            text: itemData.Text
                        }));
                    });
                    select.val(selectedValue);
                });
        }

    };

    function bindSpokeValue(selectedValue){

        var countryCode =  $("#CountryCode").val();        
        if (selectedValue != "") {
            $.getJSON("/Master/GetSpokes?Id=" + countryCode,
                function (modeldata) {
                    var select = $("[id = SpokeCode]");
                    select.empty();
                    $.each(modeldata, function (index, itemData) {
                        select.append($('<option/>', {
                            value: itemData.Value,
                            text: itemData.Text
                        }));
                    });
                    select.val(selectedValue);
                });
        }

    };

    function bindCommunaValue(selectedValue){

        var countryCode =  $("#CountryCode").val();        
        if (selectedValue != "") {
            $.getJSON("/Master/GetCommunas?Id=" + countryCode,
                function (modeldata) {
                    var select = $("[id = CommunaCode]");
                    select.empty();
                    $.each(modeldata, function (index, itemData) {
                        select.append($('<option/>', {
                            value: itemData.Value,
                            text: itemData.Text
                        }));
                    });
                    select.val(selectedValue);
                });
        }

    };

    $(function () {
        $('#Reset').click(function () {
            window.location.reload();
        //var path = window.location.pathname;
        //document.location.href = path;
    });})
    
  

    $(document).ready(function () {
        
        $("#frmAdd").submit(function (e) {

            if ($('#CityCode').val().trim() <= parseFloat(0)) {
                $('#CityCode_Validate').text("@Html.Raw(string.Format(Resources.MsgErrValueNotZero,Resources.CityCode))");
                e.preventDefault();
            }
        })

        $('#CityCode').focusin(function () {
            $('#CityCode_Validate').text("");
        });

    });
</script>

<section class="featured">
    <div class="PageTitle">@ViewBag.Title</div>
    <div class="PageRow">

        <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            @if (ViewData["FormCall"] != "ApprovalQueue")
            {
                <li>@Html.ActionLink(Resources.SearchPageHeading, "CityList", "Master")</li>                
            }
            <li class="active">@Html.ActionLink(Resources.DetailsPageHeading, "CityAdd", "Master")</li>
        </ul>

        <!-- Tabs Content -->
        <div class="tabs-container">
            @using (Html.BeginForm("CitySave", "Master", new { ACityCode = Model.CityCode, AOrganizationCode = Model.OrganizationCode, }, FormMethod.Post, new { id = "frmAdd", name = "frmAdd" }))
            {
                <div class="tab-content" id="tab1">

                    <div>
                        <span>
                            @if (!string.IsNullOrWhiteSpace(Model.ApprovalStatus))
                            { 
                                <text> @String.Concat(new object[] { Resources.Status, ":", Model.ApprovalStatusDesc }) </text>
                            }
                        </span>
                    </div>


                    <div class="row">
                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label">@Resources.CityCode</div>
                                <div class="Field">
                                    @if (!string.IsNullOrWhiteSpace(Model.CityCode))
                                    {
                                        @Html.TextBoxFor(x => x.CityCode, new { id = "CityCode", name = "CityCode", maxlength = 5, @readonly = "readonly"})
                                    }
                                    else
                                    { 
                                        @Html.TextBoxFor(x => x.CityCode, new { id = "CityCode", name = "CityCode", maxlength = 5
                                        })
                                    }
                                    @Html.ValidationMessageFor(x => x.CityCode)
                                    <label id="CityCode_Validate" class="validationMessage"></label>
                                </div>
                            </div>
                            <div class="TwoColumn">
                                <div class="label">@Resources.CityName</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.CityName, new { id = "CityName", name = "CityName", maxlength = 50 })
                                    @Html.ValidationMessageFor(x => x.CityName)

                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label fontmandatory">@Resources.Country</div>
                                <div class="Field">
                                    @Html.DropDownListFor(x => x.CountryCode, CountryItems.AsEnumerable(), new { id = "CountryCode", name = "CountryCode" })
                                    @Html.ValidationMessageFor(x => x.CountryCode)
                                    
                                </div>
                            </div>
                            <div class="TwoColumn">
                                <div class="label fontmandatory">@Resources.Region</div>
                                <div class="Field">
                                    @Html.DropDownListFor(x => x.RegionCode, RegionItems.AsEnumerable(), new { id = "RegionCode", name = "RegionCode" })
                                    @Html.ValidationMessageFor(x => x.RegionCode)
                                    
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label fontmandatory">@Resources.CityCategory</div>
                                <div class="Field">
                                    @Html.DropDownListFor(x => x.CityCategoryCode, CityCategoryItems.AsEnumerable(), new { id = "CityCategoryCode", name = "CityCategoryCode" })
                                    @Html.ValidationMessageFor(x => x.CityCategoryCode)
                                </div>
                            </div>
                            <div class="TwoColumn">
                                <div class="label fontmandatory">@Resources.Hub</div>
                                <div class="Field">
                                    @Html.DropDownListFor(x => x.HubCode, HubItems.AsEnumerable(), new { id = "HubCode", name = "HubCode" })
                                    @Html.ValidationMessageFor(x => x.HubCode)
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label fontmandatory">@Resources.Spoke</div>
                                <div class="Field">
                                    @Html.DropDownListFor(x => x.SpokeCode, SpokeItems.AsEnumerable(), new { id = "SpokeCode", name = "SpokeCode" })
                                    @Html.ValidationMessageFor(x => x.SpokeCode)
                                </div>
                            </div>
                            <div class="TwoColumn">
                                <div class="label fontmandatory">@Resources.Communa</div>
                                <div class="Field">
                                    @Html.DropDownListFor(x => x.CommunaCode, CommunaItems.AsEnumerable(), new { id = "CommunaCode", name = "CommunaCode" })
                                    @Html.ValidationMessageFor(x => x.CommunaCode)
                                </div>
                            </div>
                        </div>


                        @Html.Raw(Html.BasicButtons(lstPriv))

                    </div>
                </div>
            }

        </div>


    </div>

    <script>

        var model = @Html.Raw(Json.Encode(Model)) 
        
        bindRegionValue(model.RegionCode);
        bindHubValue(model.HubCode);
        bindSpokeValue(model.SpokeCode);
        bindCommunaValue(model.CommunaCode);

    </script>


</section>
<script>
    $(function () {
        if ('@ViewData["FormCall"]' != "ApprovalQueue") {
            DisableBtnAuthorize();
        }
    })
</script>