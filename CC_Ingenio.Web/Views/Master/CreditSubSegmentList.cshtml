@{
    ViewBag.Title = String.Concat(new object[] { Resources.CreditSubSegment, " ", Resources.Search });
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using CC_Ingenio.Web.ViewModel.Master;
@using CC_Ingenio_Resources;

@model CreditSubSegmentSearch
@{
    var grid = new WebGrid(Model.SearchResults, canSort: false, canPage: true, rowsPerPage: CC_Ingenio.Common.Utils.Utils.GRD_ROWS_PER_PAGE, selectionFieldName: "", ajaxUpdateContainerId: "container-body");
    grid.Pager(WebGridPagerModes.All);

    List<SelectListItem> CreditSegmentCodeList = new List<SelectListItem>();
    List<string> lstPriv = new List<string>();

    foreach (var item in ViewBag.CreditSegmentCodeList)
    {
        CreditSegmentCodeList.Add(new SelectListItem { Text = item.Text, Value = item.Value });
    }
    CreditSegmentCodeList.RemoveAt(0);
    CreditSegmentCodeList.Insert(0, new SelectListItem { Text = string.Empty, Value = string.Empty });
     
    
    List<SelectListItem> CreditSubSegmentCodeList = new List<SelectListItem>();

    foreach (var item in ViewBag.CreditSubSegmentCodeList)
    {
        CreditSubSegmentCodeList.Add(new SelectListItem { Text = item.Text, Value = item.Value });
    }
    CreditSubSegmentCodeList.RemoveAt(0);
    CreditSubSegmentCodeList.Insert(0, new SelectListItem { Text = string.Empty, Value = string.Empty });
     
    }

<section class="featured">

    <div class="PageTitle">@ViewBag.Title</div>

    <!-- Tabs
	================================================== -->

    <div class="PageRow">


        <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            <li class="active">@Html.ActionLink(Resources.Search,"CreditSubSegmentList","Master" )</li>
            <li> @Html.ActionLink(Resources.DetailsPageHeading,"CreditSubSegmentAdd","Master" )</li>
        </ul>

        <!-- Tabs Content -->
        <div class="tabs-container">
            <div class="tab-content" id="tab1">
                <div class="row">
                    @using (Html.BeginForm("CreditSubSegmentList", "Master", FormMethod.Get, new { id = "frmList", name = "frmList" }))
                    {
                        <div class="SearchBox">
                            <div class="row">
                                <div class="row">
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.CreditSegment</div>
                                        <div class="Field">
                                            @Html.DropDownListFor(x=>x.CreditSegmentCode,CreditSegmentCodeList)
                                        </div>
                                    </div>
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.CreditSubSegment</div>
                                        <div class="Field">
                                            @Html.DropDownListFor(x=>x.CreditSubSegmentCode,CreditSubSegmentCodeList)
                                        </div>
                                    </div>

                                </div>
                                <div class="SearchColumnbtn">
                                    <span>
                                        <input id="SearchButton" name="SearchButton" class="Greenbutton" type="submit" value="@Resources.Search" />
                                    </span>

                                    <span>
                                        <input id="ClearButton" type="submit" name ="ClearButton"  class="Greenbutton" value="@Resources.Clear" />
                                    </span>
                                </div>


                            </div>
                            <div class="clear"></div>
                        </div>

                    }

                </div>
                <div class="row">
                   
                    <div class="standard-table">
                        @grid.GetHtml(alternatingRowStyle: "alt", columns:grid.Columns(
                                    grid.Column("CreditSegmentName",Resources.CreditSegment), 
                                    grid.Column("CreditSubSegmentName", Resources.CreditSubSegment),
                                    grid.Column("Description", Resources.Description),
                                    grid.Column("ApprovalStatusDesc", Resources.Status),
                                    grid.Column(Resources.Edit, format: 
                                        (item) =>
                                            {
                                                if (item.ApprovalStatus.Equals("D") || item.ApprovalStatus.Equals("R"))
                                                {
                                                    return Html.Raw(Html.ActionLink(Resources.Edit, "CreditSubSegmentAdd", "Master", new { ACreditSegmentCode = item.CreditSegmentCode, ACreditSubSegmentCode = item.CreditSubSegmentCode }, null)); 
                                                }   
                                                else
                                                {
                                                    return Html.Raw(Html.Raw(Html.ActionLink(Resources.View, "CreditSubSegmentView", "Master", new { ACreditSegmentCode = item.CreditSegmentCode, ACreditSubSegmentCode = item.CreditSubSegmentCode }, null)));                                                    
                                                }
                                            }),
                                    grid.Column(Resources.Delete,   format: 
                                        (item) =>
                                                 {
                                                     if (lstPriv.Contains("Delete"))
                                                     {
                                                         if (item.ApprovalStatus.Equals("D") || item.ApprovalStatus.Equals("R") || item.ApprovalStatus.Equals("A"))
                                                         {
                                                             return Html.Raw(Html.ActionLink(Resources.Delete, "CreditSubSegmentDelete", "Master", new { ACreditSegmentCode = item.CreditSegmentCode, ACreditSubSegmentCode = item.CreditSubSegmentCode }, new { @class = "delete-link" }));
                                                         }
                                                         else
                                                         {
                                                             return Html.Raw("");
                                                         }
                                                     }
                                                     else
                                                     {
                                                         return Html.Raw("");
                                                     }
                                            })
                                  ))
                    </div>
                </div>
            </div>


        </div>

    </div>

</section>
