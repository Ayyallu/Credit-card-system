@using CC_Ingenio_Resources;
@{
    ViewBag.Title = String.Concat(new object[] { Resources.DiscountOnManagementCommission, " ", Resources.Search });
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using CC_Ingenio.Web.ViewModel.Master
@model DiscountOnMgmtCollectionSearch
@{
    var grid = new WebGrid(Model.SearchResults, canPage: true, rowsPerPage: CC_Ingenio.Common.Utils.Utils.GRD_ROWS_PER_PAGE, selectionFieldName: "", ajaxUpdateContainerId: "container-body");
    grid.Pager(WebGridPagerModes.All);

    List<SelectListItem> ProductListItems = new List<SelectListItem>();

    foreach (var itm in ViewBag.ProductList)
    {
        ProductListItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }
    ProductListItems.RemoveAt(0);
    ProductListItems.Insert(0, new SelectListItem { Text = string.Empty, Value = string.Empty });

    List<SelectListItem> ContractItems = new List<SelectListItem>();

    foreach (var itm in ViewBag.ContractList)
    {
        ContractItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }
    ContractItems.RemoveAt(0);
    ContractItems.Insert(0, new SelectListItem { Text = string.Empty, Value = string.Empty });

    List<SelectListItem> CommissionItems = new List<SelectListItem>();

    foreach (var itm in ViewBag.Commission)
    {
        CommissionItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }
    CommissionItems.RemoveAt(0);
    CommissionItems.Insert(0, new SelectListItem { Text = string.Empty, Value = string.Empty });
    List<string> lstPriv = new List<string>();
    if (ViewBag.Privileges != null)
    {

        foreach (var item in ViewBag.Privileges)
        {
            lstPriv.Add(item);
        }
    }
}


<section class="feature">

    <div class="PageTitle">@ViewBag.Title</div>

    <!-- Tabs
	================================================== -->

    <div class="PageRow">

        <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            <li class="active"><a href="#tab2">@Resources.SearchPageHeading</a></li>
            <li> @Html.ActionLink(Resources.DetailsPageHeading,"DiscountOnMgmtCollectionAdd","Master" )</li>
        </ul>

        <!-- Tabs Content -->
        <div class="tabs-container">
            <div class="tab-content" id="tab1">
                <div class="row">
                    @using (Html.BeginForm("DiscountOnMgmtCollectionList", "Master", FormMethod.Get, new { id = "frmList", name = "frmList" }))
                    {
                        <div class="SearchBox">
                            <div class="row">
                                <div class="row">
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.Product</div>
                                        <div class="Field">
                                            @Html.DropDownListFor(x=>x.ProductCode, ProductListItems)
                                        </div>
                                    </div>
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.Contract</div>
                                        <div class="Field">
                                            @Html.DropDownListFor(x=>x.ContractCode,ContractItems)
                                        </div>
                                    </div>
                                    </div>
                                <div class="row">
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.Commission</div>
                                        <div class="Field">
                                            @Html.DropDownListFor(x=>x.CommissionCode,CommissionItems)
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="row">
                                <div class="SearchColumnbtn">
                                        <span>
                                            <input id="SearchButton" name="SearchButton" class="Greenbutton" type="submit" value="@Resources.Search" />
                                        </span>
                                        <span>
                                            <input id="Button2" type="submit" name ="ClearButton"  class="Greenbutton" value="@Resources.Clear" />
                                        </span>
                                </div>  
                                </div>
                                                                  
                            </div>
                            <div class="clear"></div>
                        </div>
                    }

                </div>
                <div class="row">
                   
                    <div class="standard-table">

                        @grid.GetHtml(columns:grid.Columns(
                                    grid.Column("ProductName",Resources.Product),
                                    grid.Column("ContractDesc",Resources.Contract),
                                    grid.Column("CommissionCodeDesc",Resources.Commission),
                                    grid.Column("ApprovalStatusDesc", Resources.Status),
                                    grid.Column(Resources.Edit, format: 
                                        (item) =>
                                            {
                                                if (item.ApprovalStatus.Equals("D") || item.ApprovalStatus.Equals("R"))
                                                {
                                                    return Html.Raw(Html.ActionLink(Resources.Edit, "DiscountOnMgmtCollectionAdd", "Master", new { ADiscountOnMgmtCollectionId = item.DiscountOnMgmtCollectionId }, null));
                                                   
                                                }   
                                                else
                                                {
                                                    return Html.Raw(Html.Raw(Html.ActionLink(Resources.View, "DiscountOnMgmtCollectionView", "Master", new { ADiscountOnMgmtCollectionId = item.DiscountOnMgmtCollectionId }, null))); 
                                                }
                                            }),
                                    grid.Column(Resources.Delete,   format: 
                                        (item) =>
                                                 {
                                                     if (lstPriv.Contains("Delete"))
                                                     {
                                                         if (item.ApprovalStatus.Equals("D") || item.ApprovalStatus.Equals("R") || item.ApprovalStatus.Equals("A"))
                                                         {
                                                             return Html.Raw(Html.ActionLink(Resources.Delete, "DiscountOnMgmtCollectionDelete", "Master", new { ADiscountOnMgmtCollectionId = item.DiscountOnMgmtCollectionId, ASearchGridClick = true }, new { @class = "delete-link" }));
                                                         }
                                                         else
                                                         {
                                                             return Html.Raw("");
                                                         }
                                                     }
                                                     else
                                                     {
                                                         return Html.Raw("");
                                                     }
                                            })
                    ))

                    </div>
                </div>
            </div>


        </div>

    </div>

</section>


