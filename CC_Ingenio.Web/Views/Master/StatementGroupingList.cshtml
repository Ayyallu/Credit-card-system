@using CC_Ingenio_Resources;


@{
    ViewBag.Title = String.Concat(new object[] { Resources.StatementGrouping, " ", Resources.Search });
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@using CC_Ingenio.Web.ViewModel.Master
@model StatementGroupingSearch
@{
    var grid = new WebGrid(Model.SearchResults, canPage: true, rowsPerPage: CC_Ingenio.Common.Utils.Utils.GRD_ROWS_PER_PAGE, selectionFieldName: "StatementGroupingId", ajaxUpdateContainerId: "container-body");
    grid.Pager(WebGridPagerModes.All);

    List<SelectListItem> ProductItems = new List<SelectListItem>();
    foreach (var item in ViewBag.ProductList)
    {
        ProductItems.Add(new SelectListItem { Text = item.Text, Value = item.Value });
    }
    ProductItems.RemoveAt(0);
    ProductItems.Insert(0, new SelectListItem { Text = string.Empty, Value = string.Empty });

    List<SelectListItem> NetworkItems = new List<SelectListItem>();
    foreach (var item in ViewBag.NetworkList)
    {
        NetworkItems.Add(new SelectListItem { Text = item.Text, Value = item.Value });
    }
    NetworkItems.RemoveAt(0);
    NetworkItems.Insert(0, new SelectListItem { Text = string.Empty, Value = string.Empty });

    List<SelectListItem> TransactionItems = new List<SelectListItem>();
    foreach (var item in ViewBag.TransactionList)
    {
        TransactionItems.Add(new SelectListItem { Text = item.Text, Value = item.Value });
    }
    TransactionItems.RemoveAt(0);
    TransactionItems.Insert(0, new SelectListItem { Text = string.Empty, Value = string.Empty });
    List<string> lstPriv = new List<string>();
    if (ViewBag.Privileges != null)
    {

        foreach (var item in ViewBag.Privileges)
        {
            lstPriv.Add(item);
        }
    }
}


<section class="feature">

    <div class="PageTitle">@ViewBag.Title</div>

    <!-- Tabs
	================================================== -->

    <div class="PageRow">

        <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            <li class="active">@Html.ActionLink(Resources.SearchPageHeading,"StatementGroupingList","Master" )</li>
            <li> @Html.ActionLink(Resources.DetailsPageHeading,"StatementGroupingAdd","Master" )</li>
        </ul>

        <!-- Tabs Content -->
        <div class="tabs-container">
            <div class="tab-content" id="tab1">
                <div class="row">
                    @using (Html.BeginForm("StatementGroupingList", "Master", FormMethod.Get, new { id = "frmList", name = "frmList" }))
                    {
                        
                        
                        <div class="SearchBox">
                            <div class="row">

                                <div class="row">
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.Product</div>
                                        <div class="Field">
                                            @Html.DropDownListFor(x=>x.ProductCode,ProductItems)
                                        </div>
                                    </div>
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.Network</div>
                                        <div class="Field">
                                            @Html.DropDownListFor(x=>x.NetworkCode,NetworkItems)
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.Transaction</div>
                                        <div class="Field">
                                            @Html.DropDownListFor(x=>x.TransactionCode,TransactionItems)
                                        </div>
                                    </div>
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.GroupCode</div>
                                        <div class="Field">
                                            @Html.TextBoxFor(x=>x.GroupCode, new { maxlength = 5, @class = "NumericOnly" })
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="row">
                                    <div  class="TwoColumn">
                                        <div class="label">@Resources.GroupCodeDescription</div>
                                        <div class="Field">
                                                   @Html.TextBoxFor(x=>x.GroupCodeDescription, new { maxlength = 50 })
                                        </div>
                                    </div>
                                </div>


                                <div class="SearchColumnbtn">
                                    <div class="row">
                                    <span>
                                        <input id="SearchButton" name="SearchButton" class="Greenbutton" type="submit" value="@Resources.Search" />
                                    </span>
                                    <span>
                                        <input id="Button2" type="submit" name ="ClearButton"  class="Greenbutton" value="@Resources.Clear" />
                                    </span>
                                        </div>
                                </div>
                            </div>
                            <div class="clear"></div>
                        </div>
                        
                        
                    }

                </div>
                <div class="row">
                   
                    <div class="standard-table">

                        @grid.GetHtml(columns:grid.Columns(
                                    grid.Column("ProductDesc",Resources.Product),
                                    grid.Column("NetworkDesc",Resources.Network),
                                    grid.Column("TransactionDesc",Resources.Transaction),
                                    grid.Column("GroupCode",Resources.GroupCode),
                                    grid.Column("GroupCodeDescription", Resources.GroupCodeDescription),
                                    grid.Column("ApprovalStatusDesc", Resources.Status),
                                    grid.Column(Resources.Edit, format: 
                                        (item) =>
                                            {
                                                if (item.ApprovalStatus.Equals("D") || item.ApprovalStatus.Equals("R"))
                                                {
                                                    return Html.Raw(Html.ActionLink(Resources.Edit, "StatementGroupingAdd", "Master", new { Id = item.StatementGroupingId }, null));
                                                    
                                                }   
                                                else
                                                {
                                                    return Html.Raw(Html.Raw(Html.ActionLink(Resources.View, "StatementGroupingView", "Master", new { id = item.StatementGroupingId }, null))); 
                                                }
                                            }),
                                    grid.Column(Resources.Delete,   format: 
                                        (item) =>
                                                 {
                                                     if (lstPriv.Contains("Delete"))
                                                     {
                                                         if (item.ApprovalStatus.Equals("D") || item.ApprovalStatus.Equals("R") || item.ApprovalStatus.Equals("A"))
                                                         {
                                                             return Html.Raw(Html.ActionLink(Resources.Delete, "StatementGroupingDelete", "Master", new { id = item.StatementGroupingId }, new { @class = "delete-link" }));
                                                         }
                                                         else
                                                         {
                                                             return Html.Raw("");
                                                         }
                                                     }
                                                     else
                                                     {
                                                         return Html.Raw("");
                                                     }
                                            })
                    ))

                    </div>
                </div>
            </div>


        </div>

    </div>

</section>


