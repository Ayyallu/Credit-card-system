@{
    ViewBag.Title = String.Concat(new object[] { Resources.Search, " ", Resources.Calendar });
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using CC_Ingenio_Resources;
@using CC_Ingenio.Web.ViewModel.Master
@model CalendarDateMaintenanceSearch
@{
    var grid = new WebGrid(Model.SearchResults, canPage: true, rowsPerPage: CC_Ingenio.Common.Utils.Utils.GRD_ROWS_PER_PAGE, selectionFieldName: "Id", ajaxUpdateContainerId: "container-body");
    grid.Pager(WebGridPagerModes.All);

    List<SelectListItem> TypeItems = new List<SelectListItem>();

    foreach (var itm in ViewBag.TypeList)
    {
        TypeItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }
    TypeItems.RemoveAt(0);
    TypeItems.Insert(0, new SelectListItem { Text = string.Empty, Value = string.Empty });
    List<string> lstPriv = new List<string>();
    if (ViewBag.Privileges != null)
    {

        foreach (var item in ViewBag.Privileges)
        {
            lstPriv.Add(item);
        }
    }
 }

<section class="feature">

    <div class="PageTitle">@ViewBag.Title</div>

    <!-- Tabs
	================================================== -->

    <div class="PageRow">


        <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            <li class="active">@Html.ActionLink(Resources.SearchPageHeading,"CalendarDateMaintenanceList","Master" )</li>
            <li> @Html.ActionLink(Resources.DetailsPageHeading,"CalendarDateMaintenanceAdd","Master" )</li>
        </ul>

        <!-- Tabs Content -->
        <div class="tabs-container">
            <div class="tab-content" id="tab1">
                <div class="row">
                    @using (Html.BeginForm("CalendarDateMaintenanceList", "Master", FormMethod.Get, new { id = "frmList", name = "frmList" }))
                    {
                        <div class="SearchBox">
                            <div class="row">
                                <div class="row">
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.Type</div>
                                        <div class="Field">
                                            @Html.DropDownListFor(x=>x.Type,TypeItems)
                                        </div>                                       
                                    </div>
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.Description</div>
                                        <div class="Field">
                                            @Html.TextBoxFor(x=>x.Description, new { maxlength = 50})
                                        </div>
                                    </div>
                                </div>     
                                                                                                     
                                <div class="SearchColumnbtn">
                                    <span>
                                        <input id="SearchButton" name="SearchButton" class="Greenbutton" type="submit" value = "@Resources.Search" />
                                    </span>
                                    <span>
                                        <input id="Button2" type="submit" name ="ClearButton"  class="Greenbutton" value = "@Resources.Clear" />
                                    </span>
                                </div>
                            </div>
                            <div class="clear"></div>
                        </div>

                    }

                </div>
                <div class="row">
                   
                    <div class="standard-table">

                        @grid.GetHtml(alternatingRowStyle:"alt",columns:grid.Columns(
                                    grid.Column("TypeDesc",Resources.Type),
                                    grid.Column("Date", Resources.Date,format:@<text> @item.Date.ToShortDateString()</text>),
                                    grid.Column("Description", Resources.Description),                                    
                                    grid.Column("ApprovalStatusDesc", Resources.Status),
                                    grid.Column(Resources.Edit, format: 
                                        (item) =>
                                            {
                                                if (item.ApprovalStatus.Equals("D") || item.ApprovalStatus.Equals("R"))
                                                {
                                                    return Html.Raw(Html.ActionLink(Resources.Edit, "CalendarDateMaintenanceAdd", "Master", new { Id = Convert.ToString(item.Id) }, null));
                                                    
                                                }   
                                                else
                                                {
                                                    return Html.Raw(Html.Raw(Html.ActionLink(Resources.View, "CalendarDateMaintenanceView", "Master", new { id = item.Id }, null))); 
                                                }
                                            }),
                                    grid.Column(Resources.Delete,   format: 
                                        (item) =>
                                                             {
                                                                 if (lstPriv.Contains("Delete"))
                                                                 {
                                                                     if (item.ApprovalStatus.Equals("D") || item.ApprovalStatus.Equals("R") || item.ApprovalStatus.Equals("A"))
                                                                     {
                                                                         return Html.Raw(Html.ActionLink(Resources.Delete, "CalendarDateMaintenanceDelete", "Master", new { id = item.Id }, new { @class = "delete-link" }));
                                                                     }
                                                                     else
                                                                     {
                                                                         return Html.Raw("");
                                                                     }
                                                                 }
                                                                 else
                                                                 {
                                                                     return Html.Raw("");
                                                                 }
                                            })
                    ))                

                    </div>
                </div>
            </div>

        </div>

    </div>

</section>
