                                           }                                        
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="TwoColumn">
                                    <div class="label fontmandatory">@Resources.CreditBureauScore</div>
                                    <div class="Field">
                                         <input type="text" id="CreditBureauScore" style="text-align:right;" onkeypress="return OnlyNumeric(event);" data-bind="value: IndustrialCustomer.CreditBureauScore" maxlength="3" />
                                    </div>
                                </div>
                                <div class="TwoColumn">
                                    <div class="label">&nbsp;</div>
                                    <div class="Field">&nbsp;</div>
                                </div>
                            </div>
                        </div>
                       <h3>@Resources.DecisionDetails</h3>
                        <div class="row">
                            <script id="IndustrialCustomerDecisionTemplate" type="text/html">                             
                                <div class="row">                                  
                                    <div class="row">
                                        <div class="TwoColumn">
                                            <div class="label">@Resources.Decision</div>
                                            <div class="Field">
                                                 @if (Model.ParentCustomerId != 0 || Model.IsCustomerForUnderWriting == true)
                                                 {
                                                     <select id="Decision" data-bind="options: decisionDDL,optionsText: 'Text',optionsValue: 'Value',value:DecisionCode, event:{ change: DecisionOnChange }" disabled="disabled"></select>
                                                     <input type="hidden" data-bind="value:DecisionCode" disabled="disabled"/>
                                                 }
                                                 else
                                                 { 
                                                    <select id="Decision" data-bind="options: decisionDDL,optionsText: 'Text',optionsValue: 'Value',value:DecisionCode, event:{ change: DecisionOnChange }"></select>
                                                 }
                                                 <label id="lblValidateDecision" class="validationMessage"></label>
                                            </div>
                                        </div>
                                        <div class="TwoColumn">
                                            <div class="label">@Resources.Reason</div>
                                            <div class="Field">
                                                 @if (Model.ParentCustomerId != 0 || Model.IsCustomerForUnderWriting == true)
                                                 {
                                                      <select id="Reason" data-bind="options:decisionReasonDDL, optionsText:'Text', optionsValue:'Value', value:ReasonCode, event:{ change: ReasonOnChange }" disabled ="disabled"></select>
                                                      <input type="hidden" id="ReasonCode" name ="ReasonCode" data-bind="value:ReasonCode"/>
                                                 }
                                                 else
                                                 {
                                                    <select id="Reason" data-bind="options:decisionReasonDDL, optionsText:'Text', optionsValue:'Value', value:ReasonCode, event:{ change: ReasonOnChange }" ></select>
                                                 }
                                                 <label id="lblValidateReason" class="validationMessage"></label>
                                            </div>
                                        </div>
                                    </div>
                                    @*<----->*@
                                    <div class="row">
                                        <div class="TwoColumn">
                                            <div class="label">@Resources.Contract</div>
                                            <div class="Field">
                                                @if (Model.ParentCustomerId != 0 || Model.IsCustomerForUnderWriting == true)
                                                {                                                    
                                                    <select id="Contract" data-bind="options:contractDDL,optionsText:'Text',optionsValue:'Value',value:ContractCode" disabled="disabled"></select>
                                                    <input type="hidden" id="hidContractCode" data-bind="value: ContractCode" />                                                    
                                                }
                                                else
                                                {
                                                    <select id="Contract" data-bind="options:contractDDL,optionsText:'Text',optionsValue:'Value',value:ContractCode, event:{ change: ContractOnChange }"></select>
                                                }
                                                <label id="lblValidateContract" class="validationMessage"></label>
                                            </div>
                                        </div>

                                        <div class="TwoColumn">
                                            <div class="label">@Resources.BillCycleCode</div>
                                            <div class="Field">
                                                @if (Model.ParentCustomerId != 0 || Model.IsCustomerForUnderWriting == true)
                                                {
                                                    <select id="BillCycle" data-bind="options:billingCycleCodesDDL, optionsText:'Text', optionsValue:'Value', value: BillCycleSysParamId" disabled="disabled"></select>
                                                    <input type="hidden" id="BillCycleSysParamId" name="BillCycleSysParamId" data-bind="value: BillCycleSysParamId" />
                                                }
                                                else
                                                {
                                                    <select id="BillCycle" data-bind="options:billingCycleCodesDDL, optionsText:'Text', optionsValue:'Value', value: BillCycleSysParamId, event:{ change: BillingCycleOnChange }"></select>
                                                }
                                                <label id="lblValidateBillCycle" class="validationMessage"></label>
                                            </div>
                                        </div>                                        
                                    </div>
                                    <div class="row">
                                        <div class="TwoColumn">
                                            <div class="label">@Resources.CreditLimit</div>
                                            <div class="Field">
                                                @if (Model.ParentCustomerId != 0)
                                                     { 
                                                        <input type="text" id="CreditLimit" onkeypress="return AllowOnlyAmountWithoutDot(event)" data-bind="value: CreditLimit, event:{ blur: ValidateCreditLimit }" style="text-align: right;" maxlength="11" disabled="disabled" />
                                                     }
                                                     else
                                                     {
                                                        <input type="text" id="CreditLimit" onkeypress="return AllowOnlyAmountWithoutDot(event)" data-bind="value: CreditLimit, event:{ blur: ValidateCreditLimit }" style="text-align: right;" maxlength="11" />
                                                     }
                                                    <label id="lblValidateCreditLimit" class="validationMessage"></label>
                                                    <input type="hidden" id="hidMaxCreditLimitOfProduct" name="MaxCreditLimitOfProduct"/>
                                            </div>
                                        </div>
                                        <div class="TwoColumn">
                                            <div class="label">@Resources.Remarks</div>
                                            <div class="Field">
                                                @if (Model.ParentCustomerId != 0)
                                                     {
                                                        <textarea id="Remarks" name="Remarks" maxlength="500" data-bind="value:Remarks, event:{ blur: RemarksOnBlur } " disabled="disabled" />
                                                     }
                                                     else
                                                     {
                                                        <textarea id="Remarks" name="Remarks" maxlength="500" data-bind="value:Remarks, event:{ blur: RemarksOnBlur }" />
                                                     }
                                                <label id="lblValidateRemarks" class="validationMessage"></label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="TwoColumn">
                                            <div class="label fontmandatory">@Resources.Unemployment</div>
                                            <div class="Field">
                                                @if (Model.ParentCustomerId != 0 || Model.IsCustomerForUnderWriting == true)
                                                       { 
                                                            <select data-bind="options:unemploymentDDL,optionsText:'Text',optionsValue:'Value',value:Unemployment" disabled="disabled"></select>
                                                            <input type="hidden" id="Unemployment" name="Unemployment" data-bind="value:Unemployment" />
                                                       }
                                                       else
                                                       { 
                                                            <select data-bind="options:unemploymentDDL,optionsText:'Text',optionsValue:'Value',value:Unemployment"></select>
                                                       }
                                            </div>
                                        </div>
                                        <div class="TwoColumn">
                                            <div class="label fontmandatory">@Resources.ContractAcceptedByCustomer</div>
                                            <div>
                                                @if (Model.ParentCustomerId != 0 || Model.IsCustomerForUnderWriting == true)
                                                       {
                                                    <input type="checkbox" id="IsContractAcceptedByCustomer" data-bind="checked: IsContractAcceptedByCustomer" disabled="disabled" />
                                                       }
                                                       else
                                                       {
                                                    <input type="checkbox" id="IsContractAcceptedByCustomer" data-bind="checked: IsContractAcceptedByCustomer" />
                                                       }
                                            </div>
                                        </div>
                                    </div>
                                    @*<----->*@

                                </div>
                            </script>
                            <div id="DivDecisionDet" data-bind="template:{ name:'IndustrialCustomerDecisionTemplate', foreach: IndustrialCustomer.IndustrialCustomerDecisionDet }"></div>
                          
                        </div>
                    </div>
                    <!--Accoredion Ends-->
                    @if (Model.IsCustomerForUnderWriting == true)
                    { 
                         @Html.Raw(Html.OptionalKnockoutButtons(lstPrivilege, false, true, true, false, "UnderwriterAuthorize", "click: UnderwriterAuthorize"))   
                    }
                    else
                    {
                         @Html.Raw(Html.KnockoutButtons(lstPrivilege, false))
                    }                        
                </div>
            }
        </div>
    </div>
</section>
<script>
    var url = window.location.pathname;
    var customerUrl = GetQueryStrings();
    var viewModel;

    if (customerUrl["ACustomerId"] && customerUrl["ACustomerId"] != 0) {

        viewModel = new IndustrialCustomerVM(IndustrialCustomerValue);
    }
    else {
        if('@Model.ParentCustomerId' !=  0 ){
            viewModel = new IndustrialCustomerVM(IndustrialCustomerValue);
        }
        else{
            viewModel = new IndustrialCustomerVM();
        }
    }

    $(function () {

        viewModel.IndustrialCustomer.OrganizationCode = ko.observable(IndustrialCustomerValue["OrganizationCode"]);
        viewModel.IndustrialCustomer.IsCustomerForUnderWriting = ko.observable(IndustrialCustomerValue["IsCustomerForUnderWriting"]);
        viewModel.IndustrialCustomer.ProductMemberTypeCode = ko.observable(IndustrialCustomerValue["ProductMemberTypeCode"]);
        viewModel.IndustrialCustomer.DSACode = ko.observable(IndustrialCustomerValue["DSACode"]);
        viewModel.IndustrialCustomer.DSAName = ko.observable(IndustrialCustomerValue["DSAName"]);  
       // viewModel.IndustrialCustomer.SalesId = ko.observable(IndustrialCustomerValue["SalesId"]);  
        viewModel.IndustrialCustomer.UEN = ko.observable(IndustrialCustomerValue["UEN"]);
        viewModel.IndustrialCustomer.DSARUT = ko.observable(IndustrialCustomerValue["DSARUT"]);
       // viewModel.IndustrialCustomer.BranchCode = ko.observable(IndustrialCustomerValue["BranchCode"]);
        viewModel.IndustrialCustomer.BillCycleSysParamId = ko.observable(IndustrialCustomerValue["BillCycleSysParamId"]);

        if(customerUrl["ARUT"] && customerUrl["ARUT"]!="")
        {
            $("#CustomerRUT").attr("value", customerUrl["ARUT"]);       
            viewModel.IndustrialCustomer.RUT = ko.observable(customerUrl["ARUT"]);
        }    
        ko.validation.configure({
            registerExtenders: true,
            insertMessages: true,
            messagesOnModified: false
        });

        ko.applyBindings(viewModel);

        $("[id=Communa]").append($('<option/>',
        {
           value: "",
           text:"@Resources.SelectOne"
        }));
        $("[id=ParticularAddrCommuna]").append($('<option/>',
        {
            value: "",
            text:"@Resources.SelectOne"
        }));
        $("[id=StatementAddrCommuna]").append($('<option/>',
        {
            value: "",
            text:"@Resources.SelectOne"
        }));
        $("[id=City]").append($('<option/>',
      {
          value: "",
          text:"@Resources.SelectOne"
      }));
        $("[id=ParticularAddrCity]").append($('<option/>',
        {
            value: "",
            text:"@Resources.SelectOne"
        }));
        $("[id=StatementAddrCity]").append($('<option/>',
        {
            value: "",
            text:"@Resources.SelectOne"
        }));
        $("[id=Product]").append($('<option/>',
        {
            value: "",
            text:"@Resources.SelectOne"
        }));
        $("[id=Contract]").append($('<option/>',
           {
               value: "",
               text:"@Resources.SelectOne"
           }));

        if (customerUrl["ACustomerId"] && customerUrl["ACustomerId"] != 0){             
            PopulateCascadeDropDownLists("Communa",IndustrialCustomerValue,viewModel);
            PopulateCascadeDropDownLists("ParticularAddrCommuna",IndustrialCustomerValue,viewModel);
            PopulateCascadeDropDownLists("StatementAddrCommuna",IndustrialCustomerValue,viewModel);
            PopulateCascadeDropDownLists("City",IndustrialCustomerValue,viewModel);
            PopulateCascadeDropDownLists("ParticularAddrCity",IndustrialCustomerValue,viewModel);
            PopulateCascadeDropDownLists("StatementAddrCity",IndustrialCustomerValue,viewModel);
            if('@Model.ParentCustomerId' == 0)
            {
                PopulateCascadeDropDownLists("Product",IndustrialCustomerValue,viewModel);
                PopulateCascadeDropDownLists("Contract",IndustrialCustomerValue,viewModel);
            }
        }
        if('@Model.ParentCustomerId' != 0){
            PopulateCascadeDropDownLists("Contract",IndustrialCustomerValue,viewModel);
        }

        var errors = ko.validation.group(viewModel.IndustrialCustomer, { deep: true });
        errors.showAllMessages(false);

        if($('#CustomerType').val() == 'C'){
            $('#divFlag').hide();
            $('#divAge').hide();
        }
        else if($('#CustomerType').val() == 'I'){
            $('#divFlag').show();
            $('#divAge').show();          
        }
        if(viewModel.IndustrialCustomer.DSARUT() != null){

            if( viewModel.IndustrialCustomer.DSARUT().length == 6)
            {          
                $('#DSARUT').mask('99999-*');
            }
            else  if( viewModel.IndustrialCustomer.DSARUT().length == 7)
            { 
                $('#DSARUT').mask('999999-*');
            }
            else  if( viewModel.IndustrialCustomer.DSARUT().length == 8)
            { 
                $('#DSARUT').mask('9999999-*');
            }
            else  if( viewModel.IndustrialCustomer.DSARUT().length == 9)
            { 
                $('#DSARUT').mask('99999999-*');
            }
            else  if( viewModel.IndustrialCustomer.DSARUT().length == 10)
            { 
                $('#DSARUT').mask('999999999-*');
            }
        }

        if( viewModel.IndustrialCustomer.RUT().length == 6)
        {          
            $('#CustomerRUT').mask('99999-*');
        }
        else  if( viewModel.IndustrialCustomer.RUT().length == 7)
        { 
            $('#CustomerRUT').mask('999999-*');
        }
        else  if( viewModel.IndustrialCustomer.RUT().length == 8)
        { 
            $('#CustomerRUT').mask('9999999-*');
        }
        else  if( viewModel.IndustrialCustomer.RUT().length == 9)
        { 
            $('#CustomerRUT').mask('99999999-*');
        }
        else  if( viewModel.IndustrialCustomer.RUT().length == 10)
        { 
            $('#CustomerRUT').mask('999999999-*');
        }

        if('@ViewData["MaxCreditLimitOfProduct"]' != null){
            $('#hidMaxCreditLimitOfProduct').val(Globalize(resourceProvider.ResourceCulture).parseFloat('@Convert.ToDecimal(ViewData["MaxCreditLimitOfProduct"])'));
         }
    });



</script>
