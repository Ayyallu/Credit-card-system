@using CC_Ingenio.DataTranfer.MasterInfo;
@using CC_Ingenio.Web.Helpers;
@using System.Web.Script.Serialization;
@using CC_Ingenio_Resources;

@model IndustrialCustomerDTO
@{
    List<string> lstPrivilege = new List<string>();
    List<SelectListItem> branchList = new List<SelectListItem>();
    List<SelectListItem> customerTypeList = new List<SelectListItem>();   
    List<SelectListItem> bankList = new List<SelectListItem>();
    List<SelectListItem> residenceTypeList = new List<SelectListItem>();
    List<SelectListItem> addressTypeList = new List<SelectListItem>();
    List<SelectListItem> productCategoryList = new List<SelectListItem>();
    List<SelectListItem> nationalityList = new List<SelectListItem>();
    List<SelectListItem> productList = new List<SelectListItem>();
    List<SelectListItem> decisionList = new List<SelectListItem>();
    List<SelectListItem> decisionReasonList = new List<SelectListItem>();
    List<SelectListItem> unemploymentList = new List<SelectListItem>();
    List<SelectListItem> billingCyclesList = new List<SelectListItem>();

    if (ViewBag.Privileges != null)
    {
        foreach (var item in ViewBag.Privileges)
        {
            lstPrivilege.Add(item);
        }
    }

    foreach (var item in ViewBag.BranchList)
    {
        branchList.Add(new SelectListItem { Text = item.Text, Value = item.Value });
    }

    foreach (var item in ViewBag.CustomerTypeList)
    {
        customerTypeList.Add(new SelectListItem { Text = item.Text, Value = item.Value });
    } 

    foreach (var item in ViewBag.BankList)
    {
        bankList.Add(new SelectListItem { Text = item.Text, Value = item.Value });
    }

    foreach (var item in ViewBag.ResidenceTypeList)
    {
        residenceTypeList.Add(new SelectListItem { Text = item.Text, Value = item.Value });
    }

    foreach (var item in ViewBag.AddressTypeList)
    {
        addressTypeList.Add(new SelectListItem { Text = item.Text, Value = item.Value });
    }

    foreach (var item in ViewBag.ProductCategoryList)
    {
        productCategoryList.Add(new SelectListItem { Text = item.Text, Value = item.Value });
    }

    foreach (var item in ViewBag.NationalityList)
    {
        nationalityList.Add(new SelectListItem { Text = item.Text, Value = item.Value });
    }
    if (Model.ParentCustomerId != 0)
    {
        foreach (var item in ViewBag.ProductList)
        {
            productList.Add(new SelectListItem { Text = item.Text, Value = item.Value });
        }
    }

    foreach (var item in ViewBag.DecisionList)
    {
        decisionList.Add(new SelectListItem { Text = item.Text, Value = item.Value });
    }
    foreach (var item in ViewBag.DecisionReasonList)
    {
        decisionReasonList.Add(new SelectListItem { Text = item.Text, Value = item.Value });
    }

    foreach (var item in ViewBag.UnemploymentList)
    {
        unemploymentList.Add(new SelectListItem { Text = item.Text, Value = item.Value });
    }

    foreach (var item in ViewBag.billingCycleCodes)
    {
        billingCyclesList.Add(new SelectListItem { Text = item.Text, Value = item.Value });
    } 
       
}

<script type="text/javascript">
    var branchDDL = @Html.Raw(new JavaScriptSerializer().Serialize(branchList));
    var customerTypeDDL = @Html.Raw(new JavaScriptSerializer().Serialize(customerTypeList));      
    var bankDDL = @Html.Raw(new JavaScriptSerializer().Serialize(bankList));
    var residenceTypeDDL = @Html.Raw(new JavaScriptSerializer().Serialize(residenceTypeList));
    var addressTypeDDL = @Html.Raw(new JavaScriptSerializer().Serialize(addressTypeList));
    var ProductCategoryDDL = @Html.Raw(new JavaScriptSerializer().Serialize(productCategoryList));
    var NationalityDDL = @Html.Raw(new JavaScriptSerializer().Serialize(nationalityList));
    var decisionDDL = @Html.Raw(new JavaScriptSerializer().Serialize(decisionList));
    var decisionReasonDDL = @Html.Raw(new JavaScriptSerializer().Serialize(decisionReasonList));
    var contractDDL = @Html.Raw(new JavaScriptSerializer().Serialize(""));
    var unemploymentDDL = @Html.Raw(new JavaScriptSerializer().Serialize(unemploymentList));
    var cityDDL = @Html.Raw(new JavaScriptSerializer().Serialize(""));
    var billingCycleCodesDDL = @Html.Raw(new JavaScriptSerializer().Serialize(billingCyclesList));

    var ProductDDL;
    if('@Model.ParentCustomerId' != 0){
        ProductDDL = @Html.Raw(new JavaScriptSerializer().Serialize(productList));
    }
    else{
        ProductDDL = @Html.Raw(new JavaScriptSerializer().Serialize(""));
    }
    
    var CommunaDDL = @Html.Raw(new JavaScriptSerializer().Serialize(""));

    var IndustrialCustomerValue = @Html.Raw(ViewBag.IndustrialCustomerValue);

    function CustomerTypeOnChange(){
        if($('#CustomerType').val() == 'C'){
            $('#divFlag').hide();
            $('#divAge').hide();
        }
        else if($('#CustomerType').val() == 'I'){
            $('#divFlag').show();
            $('#divAge').show();
        }
    };

    function OnChangeBranchFillDSA(){
        if( $('#CommercialBranch').val() != 0)
        {
            $.getJSON('/Master/GetDSAforBranch?ABranchCode=' + $('#CommercialBranch').val(),
                function (returnData) {
                    if (returnData) {                
                        viewModel.IndustrialCustomer.DSACode = ko.observable(returnData.DSACode);
                        $('#DSACode').val(viewModel.IndustrialCustomer.DSACode());
                        viewModel.IndustrialCustomer.DSAName = ko.observable(returnData.DSAName);
                        $('#DSAName').val(viewModel.IndustrialCustomer.DSAName());
                        viewModel.IndustrialCustomer.UEN = ko.observable(returnData.UEN);
                        $('#UEN').val(viewModel.IndustrialCustomer.UEN());
                        viewModel.IndustrialCustomer.DSARUT = ko.observable(returnData.RUT);  
                        $('#DSARUT').val(viewModel.IndustrialCustomer.DSARUT());
                    }
                });
        }
    }

    function OnChangeSendStatementTo(){
        if($('#SendStatementTo').val() == ''){
            $('#StatementAddrOther').val('');
            $('#StatementAddrAddress').val('');
            $('#StatementAddrVillage').val('');
            $('#StatementAddrCommuna').val('');
            $('#StatementAddrCity').val('');
            $('#StatementAddrLandPhone').val('');
            $('#StatementAddrMobile').val('');
            $('#StatementAddrEmail').val('');             
        }
        else if($('#SendStatementTo').val() == 'C'){        
            $('#StatementAddrOther').val('');
            $('#StatementAddrAddress').val($('#CommercialAddress').val());
            $('#StatementAddrVillage').val($('#Village').val());
            $('#StatementAddrCommuna').val($('#Communa').val()).change();          
            $('#StatementAddrLandPhone').val($('#LandPhone').val());
            $('#StatementAddrMobile').val($('#Mobile').val());
            $('#StatementAddrEmail').val($('#Email').val());  
            $('#lblValidateSendStatementTo').text('');
            $('#lblValidateStatementAddrAddress').text('');          
        }
        else if($('#SendStatementTo').val() == 'PR'){           
            $('#StatementAddrAddress').val($('#ParticularAddress').val());
            $('#StatementAddrVillage').val($('#ParticularAddrVillage').val());
            $('#StatementAddrCommuna').val($('#ParticularAddrCommuna').val()).change();            
            $('#StatementAddrLandPhone').val($('#ParticularAddrLandPhone').val());
            $('#StatementAddrMobile').val($('#ParticularAddrMobile').val());
            $('#StatementAddrEmail').val($('#ParticularAddrEmail').val()); 
            $('#lblValidateSendStatementTo').text('');
            $('#lblValidateStatementAddrAddress').text('');          
        }

        if (viewModel.IndustrialCustomer.StatementAddressDet()[0]) {
            viewModel.IndustrialCustomer.StatementAddressDet()[0].AddressType = ko.observable($('#StatementAddrOther').val());
            viewModel.IndustrialCustomer.StatementAddressDet()[0].AddressDesc = ko.observable($('#StatementAddrAddress').val());
            viewModel.IndustrialCustomer.StatementAddressDet()[0].Village = ko.observable($('#StatementAddrVillage').val());
            viewModel.IndustrialCustomer.StatementAddressDet()[0].CommunaCode = ko.observable($('#StatementAddrCommuna').val());
            viewModel.IndustrialCustomer.StatementAddressDet()[0].CityCode = ko.observable($('#StatementAddrCity').val());
            viewModel.IndustrialCustomer.StatementAddressDet()[0].Phone = ko.observable($('#StatementAddrLandPhone').val());
            viewModel.IndustrialCustomer.StatementAddressDet()[0].Mobile = ko.observable($('#StatementAddrMobile').val());
            viewModel.IndustrialCustomer.StatementAddressDet()[0].EmailID = ko.observable($('#StatementAddrEmail').val());
        }
    };




    function CommunaOnChange (dropDownListId){
        var objCommunaList = $('[id = ' + dropDownListId + ']');        
       
        if(dropDownListId == "Communa"){
            $('#lblValidateCommuna').text('');                   
        }
        else if(dropDownListId == "ParticularAddrCommuna"){
            $('#lblValidateParticularAddrCommuna').text('');
        }
        else if(dropDownListId == "StatementAddrCommuna"){
            $('#lblValidateStatementAddrCommuna').text('');
        }            

        var cityDropDownListId;
        if(dropDownListId == "Communa"){
            cityDropDownListId = "City";
        }
        else if(dropDownListId == "ParticularAddrCommuna"){
            cityDropDownListId = "ParticularAddrCity";
        }
        else if(dropDownListId == "StatementAddrCommuna"){
            cityDropDownListId = "StatementAddrCity";
        }
        if(objCommunaList.val() != '' && (objCommunaList.val())){           
            SetCityDropDownWithValue(cityDropDownListId,"/Master/GetCityByCommuna?ACommunaCode=" + objCommunaList.val());           
        }        
        else{
            RefreshDropDown(cityDropDownListId);
        }      
    };  

    function SetCityDropDownWithValue(cityDropDownId,url){
        $.ajaxSetup({ cache: false });
        $.getJSON(url,
            function (modelData) {
                var select = $('#'+ cityDropDownId);
                select.empty();
                $.each(modelData.cityCodes, function (index, itemData) {
                    select.append($('<option/>',
                    {
                        value: itemData.Value,
                        text: itemData.Text
                    }));
                });
                select.val(modelData.CityCode);
                if(cityDropDownId == "City"){
                    viewModel.IndustrialCustomer.CommercialAddressDet()[0].CityCode = ko.observable($('#City').val());
                    $('#lblValidateCity').text(''); 
                }
                else if(cityDropDownId == "ParticularAddrCity"){
                    viewModel.IndustrialCustomer.ParticularAddressDet()[0].CityCode = ko.observable($('#ParticularAddrCity').val());
                    $('#lblValidateParticularAddrCity').text('');
                }
                else if(cityDropDownId == "StatementAddrCity"){
                    viewModel.IndustrialCustomer.StatementAddressDet()[0].CityCode = ko.observable($('#StatementAddrCity').val());
                    $('#lblValidateStatementAddrCity').text('');
                }
            });
    }

    function AddressOnBlur(elementId){           
        if($(elementId).val() != ''){
            if(elementId == "#CommercialAddress"){
                $('#lblValidateCommercialAddress').text('');                   
            }
            else if(elementId == "#ParticularAddress"){
                $('#lblValidateParticularAddress').text('');
            }
            else if(elementId == "#StatementAddrAddress"){
                $('#lblValidateStatementAddrAddress').text('');
            }           
        }
    };

    function ContractOnChange(){
        if($('#Contract').val() != ''){
            if ($('#lblValidateContract').text().length > 0) {
                $('#lblValidateContract').text('');
            }
        }
    }

    function DecisionOnChange(){
        if($('#Decision').val() != ''){
            if ($('#lblValidateDecision').text().length > 0) {
                $('#lblValidateDecision').text('');
            }
        }
    };

    function ReasonOnChange (){
        if($('#Reason').val() != ''){
            if ($('#lblValidateReason').text().length > 0) {
                $('#lblValidateReason').text('');
            }
        }
    };

    function BillingCycleOnChange (){
        if($('#BillCycle').val() != ''){
            if ($('#lblValidateBillCycle').text().length > 0) {
                $('#lblValidateBillCycle').text('');
            }
        }            
    };

    function RemarksOnBlur (){ 
        if($('#Remarks').val() != ''){ 
            if($('#lblValidateRemarks').text().length > 0){ 
                $('#lblValidateRemarks').text(''); 
            }
        }
    };

    function ValidateCreditLimit(){

        if($('#lblValidateCreditLimit').text().length > 0){ 
            $('#lblValidateCreditLimit').text(''); 
        }
        if(Globalize(resourceProvider.ResourceCulture).parseFloat($('#CreditLimit').val().trim()) > parseFloat(0)){ 
            FormatOnBlur(event);
            if( $('input#hidMaxCreditLimitOfProduct').val() != null && 
            Globalize(resourceProvider.ResourceCulture).parseFloat($('input#hidMaxCreditLimitOfProduct').val().trim()) > parseFloat(0) &&
            Globalize(resourceProvider.ResourceCulture).parseFloat($('input#hidMaxCreditLimitOfProduct').val()) > parseFloat(0) &&
            Globalize(resourceProvider.ResourceCulture).parseFloat($('#CreditLimit').val().trim()) > parseFloat($('input#hidMaxCreditLimitOfProduct').val())){
                $('#lblValidateCreditLimit').text(String.format(resourceProvider.MsgErrValueShouldBeLessThanCreditLimitofProduct,Globalize(resourceProvider.ResourceCulture).format(Globalize(resourceProvider.ResourceCulture).parseFloat($('input#hidMaxCreditLimitOfProduct').val()), resourceProvider.FormatAmountJSn0)));                    
            }
        }    
    };

    function SelectProductProperties(ProductCode, objViewModel, callFromPage) {
        $.getJSON("/Master/SelectProductProperties?AProductCode=" + ProductCode,
            function (returnData) {
                if (returnData) {
                    if (callFromPage == true) {
                        objViewModel.IndustrialCustomer.IndustrialCustomerDecisionDet()[0].CreditLimit = ko.observable(returnData.MaxCreditLimit);
                        objViewModel.IndustrialCustomer.IndustrialCustomerDecisionDet()[0].BillCycleSysParamId = ko.observable(returnData.BillCycleSysParamId);
                        objViewModel.IndustrialCustomer.IndustrialCustomerDecisionDet()[0].BillingCycleCode = ko.observable(returnData.BillingCycleCode);
                        $('#CreditLimit').val(Globalize(resourceProvider.ResourceCulture).format(returnData.MaxCreditLimit, resourceProvider.FormatAmountJSn0));
                        $('#BillCycle').val(returnData.BillCycleSysParamId);
                        $('#hidMaxCreditLimitOfProduct').val(returnData.MaxCreditLimit);
                    }
                    else {
                        objViewModel.IndustrialCustomerDecisionDet()[0].CreditLimit = ko.observable(returnData.MaxCreditLimit);
                        objViewModel.IndustrialCustomerDecisionDet()[0].BillCycleSysParamId = ko.observable(returnData.BillCycleSysParamId);
                        objViewModel.IndustrialCustomerDecisionDet()[0].BillingCycleCode = ko.observable(returnData.BillingCycleCode);
                        $('#CreditLimit').val(Globalize(resourceProvider.ResourceCulture).format(returnData.MaxCreditLimit, resourceProvider.FormatAmountJSn0));
                        $('#BillCycle').val(returnData.BillCycleSysParamId);
                        $('#hidMaxCreditLimitOfProduct').val(returnData.MaxCreditLimit);
                    }                
                }
            });
    }

    $(document).ready(function(){

        $('#Product').change(function(){
            if($('#lblValidateCreditLimit').text().length > 0){ 
                $('#lblValidateCreditLimit').text(''); 
            }
            if ($('#lblValidateBillCycle').text().length > 0) {
                $('#lblValidateBillCycle').text('');
            }
            if('@Model.CustomerId' != 0)
            {
                if('@Model.ParentCustomerId' == 0){
                    var productCode = $('#Product').val();
                    viewModel.IndustrialCustomer.ProductCode = ko.observable(productCode);                
                    if(productCode == '' && viewModel.IndustrialCustomer.ProductCode() == ''){
                        $('#lblValidateProduct').text('@Html.Raw(string.Format(Resources.MsgErrPleaseSelect, Resources.Product))');
                        $('#Contract').empty();
                        $('#Contract').append($('<option/>',
                           {
                               value: "",
                               text: "@Resources.SelectOne"
                           }));
                        $('#BillCycle').val("");
                    }
                    else{
                        $('#lblValidateProduct').text('');
                        PopulateDropDownViaAjax("#Contract", "/Master/GetContractByProductCode?AProductCode=" + productCode);
                        if(productCode){                        
                            GetAutoApprovalOfSelectedProduct(productCode, viewModel, true);
                            SelectProductProperties(productCode, viewModel, true);                           
                        }
                        if($('#Contract').length == 0){
                            $('#Contract').append($('<option/>',
                            {
                                value: "",
                                text:"@Resources.SelectOne"
                            }));
                        }
                    }
                }
            }
        });

        $('#Nationality').change(function(){
            if($('#Nationality').val() != ''){
                $('#lblValidateNationality').text('');
            }
        });
       
        $('#SubmitKO').click(function (event){
            viewModel.IndustrialCustomer.IsSubmit = true;
        });       
    });
</script>
<script src="/Scripts/Master/IndustrialCustomerWithoutSalesId.js"></script>

<section class="featured">
    <div class="PageTitle">@ViewBag.Title</div>
    <div class="PageRow">


        <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            @if (ViewData["FormCall"] != "ApprovalQueue")
            {
                if (ViewBag.FromSearchPage == true)
                {
                <li>@Html.ActionLink(Resources.SearchPageHeading, "CustomerList", "Master")</li>
                }
            }
            <li class="active">@Html.ActionLink(CC_Ingenio_Resources.Resources.DetailsPageHeading, "IndustrialCustomerAdd", "Master")</li>
        </ul>
        <div id="UnderWriterAuthorizeDiv1"></div>
        <!-- Tabs Content -->

        <div class="tabs-container">
            @using (Html.BeginForm())
            {
                <div class="tab-content" id="tab1">
                    <div class="row" style="height:15px">
                        <span>
                            @if (!string.IsNullOrWhiteSpace(Model.ApprovalStatusDesc))
                            { 
                                <text>@String.Concat(new object[] { Resources.Status, ":", Model.ApprovalStatusDesc })</text>
                            }
                            @if (!string.IsNullOrEmpty(Model.ParentCustomerName))
                            { 
                                @Html.Label("Add On of customer : " + Model.ParentCustomerName, new { style = "color:white; background-color:#62a31a; font-weight:bold; float:right" })           
                            }
                            @if (Model.ParentCustomerId == 0)
                            {
                                if (ViewData["CreditScoreViolated"] != null)
                                {
                                    @Html.Label(ViewData["CreditScoreViolated"].ToString() == "True" ? "Credit Score Violated" : "", new { @class = "validationMessage", style = "float:right" })           
                                }
                            }
                        </span>
                    </div>
                    <div id="accordion">
                        <h3>@Resources.DSAIdentification</h3>                        
                        <div class="row">
                             <div class="row">
                                <div class="TwoColumn">
                                    <div class="label">@Resources.CommercialBranch</div>
                                    <div class="Field">
                                         @if (Convert.ToInt32(Model.ParentCustomerId) != 0 || Model.IsCustomerForUnderWriting == true)
                                         { 
                                            <select id="CommercialBranch" data-bind="options: branchDDL, optionsText: 'Text', optionsValue: 'Value', value: IndustrialCustomer.BranchCode, event: { change: OnChangeBranchFillDSA }" disabled="disabled" ></select>
                                            <input type="hidden" id="hidBranchCode" data-bind="value: IndustrialCustomer.BranchCode" />
                                         }
                                        else
                                        {
                                            <select id="CommercialBranch" data-bind="options: branchDDL, optionsText: 'Text', optionsValue: 'Value', value: IndustrialCustomer.BranchCode, event: { change: OnChangeBranchFillDSA }" ></select>
                                        }                                        
                                    </div>
                                </div>
                                <div class="TwoColumn">
                                    <div class="label">&nbsp;</div>
                                    <div class="Field">&nbsp;</div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="TwoColumn">
                                    <div class="label fontmandatory">@Resources.Name</div>
                                    <div class="Field">                                        
                                        <input type="text" id="DSAName" data-bind="value: IndustrialCustomer.DSAName" maxlength="50" readonly="readonly" />
                                    </div>
                                </div>
                                <div class="TwoColumn">
                                    <div class="label fontmandatory">@Resources.UEN</div>
                                    <div class="Field">
                                        <input type="text" id="UEN" data-bind="value: IndustrialCustomer.UEN" maxlength="50" readonly="readonly" />
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="TwoColumn">
                                    <div class="label fontmandatory">@Resources.RUT</div>
                                    <div class="Field">
                                        <input type="text" id="DSARUT" data-bind="value: IndustrialCustomer.DSARUT" maxlength="13" readonly="readonly" />
                                    </div>
                                </div>
                                <div class="TwoColumn">
                                    <div class="label fontmandatory">@Resources.DSACode</div>
                                    <div class="Field">
                                        <input type="text" id="DSACode" data-bind="value: IndustrialCustomer.DSACode" readonly="readonly" />
                                    </div>
                                </div>
                            </div>                           
                        </div>
                        <h3>@Resources.CustomerIdentification</h3>
                        <div class="row">

                            <div class="row">
                                <div class="TwoColumn">
                                    <div class="label">@Resources.CustomerType</div>
                                    <div class="Field">
                                        @if (Model.IsCustomerForUnderWriting == true)
                                        { 
                                            <select id="CustomerType" data-bind="options: customerTypeDDL, optionsText: 'Text', optionsValue: 'Value', value: IndustrialCustomer.CustomerType, event: { change: CustomerTypeOnChange }" disabled="disabled"></select>
                                            <input type="hidden" id="hidCustomerType" data-bind="value: IndustrialCustomer.CustomerType" />
                                        }
                                        else
                                        {
                                            <select id="CustomerType" data-bind="options: customerTypeDDL, optionsText: 'Text', optionsValue: 'Value', value: IndustrialCustomer.CustomerType, event: { change: CustomerTypeOnChange }"></select>
                                        }
                                    </div>
                                </div>
                                <div class="TwoColumn">
                                    <div class="label">@Resources.Name</div>
                                    <div class="Field">
                                         @if (Model.IsCustomerForUnderWriting == true)
                                         {
                                             <input type="text" id="Name" data-bind="value: IndustrialCustomer.Name" maxlength="50" readonly ="readonly" />
                                         }
                                         else
                                         {
                                            <input type="text" id="Name" data-bind="value: IndustrialCustomer.Name" maxlength="50" />
                                         }
                                    </div>
                                </div>
                            </div>
                            <div class="row" id="divSirnames">
                                <div class="TwoColumn">
                                    <div class="label fontmandatory">@Resources.PaternalSurname</div>
                                    <div class="Field">
                                         @if (Model.IsCustomerForUnderWriting == true)
                                         {
                                             <input type="text" id="PaternalSurname" data-bind="value: IndustrialCustomer.PaternalSurname" maxlength="50" readonly ="readonly" />
                                         }
                                         else
                                         {
                                            <input type="text" id="PaternalSurname" data-bind="value: IndustrialCustomer.PaternalSurname" maxlength="50" />
                                         }
                                    </div>
                                </div>
                                <div class="TwoColumn">
                                    <div class="label fontmandatory">@Resources.MaternalSurname</div>
                                    <div class="Field">
                                         @if (Model.IsCustomerForUnderWriting == true)
                                         {
                                             <input type="text" id="MaternalSurname" data-bind="value: IndustrialCustomer.MaternalSurname" maxlength="50" readonly ="readonly" />
                                         }
                                         else
                                         { 
                                            <input type="text" id="MaternalSurname" data-bind="value: IndustrialCustomer.MaternalSurname" maxlength="50" />
                                         }
                                        
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="TwoColumn">
                                    <div class="label">@Resources.RUT</div>
                                    <div class="Field">
                                        <input type="text" id="CustomerRUT" data-bind="value: IndustrialCustomer.RUT" maxlength="13" readonly="readonly" />
                                    </div>
                                </div>                              
                            </div>
                            <div class="row">
                                <div class="TwoColumn">
                                    <div class="label">@Resources.ProductCategory</div>
                                    <div class="Field">                                        
                                        @if (Convert.ToInt32(Model.ParentCustomerId) != 0 || Model.IsCustomerForUnderWriting == true)
                                        { 
                                            <select data-bind="options: ProductCategoryDDL, optionsText: 'Text', optionsValue: 'Value', value: IndustrialCustomer.ProductCategoryCode" disabled="disabled" ></select>
                                            <input type="hidden" id="hidProductCategoryCode" data-bind="value: IndustrialCustomer.ProductCategoryCode" />
                                        }
                                        else
                                        {
                                            <select data-bind="options: ProductCategoryDDL, optionsText: 'Text', optionsValue: 'Value', value: IndustrialCustomer.ProductCategoryCode" ></select>
                                        }
                                    </div>
                                </div>
                                <div class="TwoColumn">
                                    <div class="label">@Resources.Product</div>
                                    <div class="Field">                                        
                                        @if (Convert.ToInt32(Model.ParentCustomerId) != 0 || Model.IsCustomerForUnderWriting == true)
                                        { 
                                            <select id="Product" data-bind="options: ProductDDL, optionsText: 'Text', optionsValue: 'Value', value: IndustrialCustomer.ProductCode" disabled="disabled"></select>
                                            <input type="hidden" id="hidProductCode" data-bind="value: IndustrialCustomer.ProductCode" />
                                        }
                                        else
                                        {
                                            <select id="Product" data-bind="options: ProductDDL, optionsText: 'Text', optionsValue: 'Value', value: IndustrialCustomer.ProductCode" ></select>
                                        }
                                        <label id="lblValidateProduct" class="validationMessage" ></label>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="TwoColumn">
                                    <div class="label">@Resources.Nationality</div>
                                    <div class="Field">
                                         @if (Model.IsCustomerForUnderWriting == true)
                                         {
                                             <select id="Nationality" data-bind="options: NationalityDDL, optionsText: 'Text', optionsValue: 'Value', value: IndustrialCustomer.Nationality" disabled ="disabled"></select>
                                              <input type="hidden" id="hidNationality" data-bind="value: IndustrialCustomer.Nationality" />
                                         }
                                         else
                                         {
                                            <select id="Nationality" data-bind="options: NationalityDDL, optionsText: 'Text', optionsValue: 'Value', value: IndustrialCustomer.Nationality"></select>
                                         }
                                        <label id="lblValidateNationality" class="validationMessage" ></label>
                                    </div>
