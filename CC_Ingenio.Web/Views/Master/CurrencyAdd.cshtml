
@using CC_Ingenio_Resources
@using CC_Ingenio.DataTranfer.MasterInfo;
@using CC_Ingenio.Web.Helpers;

@{
    ViewBag.Title = String.Concat(new object[] {Resources.Add, " ", Resources.Currency });
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model CurrencyDTO
@{
    List<SelectListItem> CountryItems = new List<SelectListItem>();
    List<string> lstPriv = new List<string>();

    foreach (var itm in ViewBag.Countries)
    {
        CountryItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }

    if (ViewBag.Privileges != null)
    {
        foreach (var item in ViewBag.Privileges)
        {
            lstPriv.Add(item);
        }
    }
}

<script type="text/javascript">



   $(document).ready(function () {


       $("#frmCurrencySave").submit(function (e) {

           if ($('#CurrencyCode').val().trim() <= parseFloat(0)) {
               var text = "@Html.Raw(String.Format(@CC_Ingenio_Resources.Resources.MsgErrValueGreaterThanZero, @CC_Ingenio_Resources.Resources.CurrencyCode))";
               
               $('#CurrencyCode_Validate').text(text);
                e.preventDefault();
            }
        })

       $('#CurrencyCode').focusin(function () {
           $('#CurrencyCode_Validate').text("");
        });

    });

</script>
<section class="featured">
    <div class="PageTitle">@ViewBag.Title</div>
    <div class="PageRow">


        <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            @if (ViewData["FormCall"] != "ApprovalQueue")
            {
                <li>@Html.ActionLink(CC_Ingenio_Resources.Resources.SearchPageHeading, "CurrencyList", "Master")</li>
            }
            <li class="active">@Html.ActionLink(@CC_Ingenio_Resources.Resources.DetailsPageHeading, "CurrencyAdd", "Master")</li>
        </ul>

        <!-- Tabs Content -->

        <div class="tabs-container">
            @using (Html.BeginForm("CurrencySave", "Master", new { ACurrencyCode = Model.CurrencyCode,AOrganizationCode = Model.OrganizationCode  }, FormMethod.Post, new { id = "frmCurrencySave", name = "frmCurrencySave" }))
            {
                <div class="tab-content" id="tab1">
                    <div>
                        <span>
                            @if (!string.IsNullOrWhiteSpace(Model.ApprovalStatusDesc))
                            { 
                                <text>@String.Concat(new object[] { Resources.Status, ":", Model.ApprovalStatusDesc })</text>
                            }
                        </span>
                    </div>
                    <div class="row">
                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label">@Resources.CurrencyCode</div>
                                <div class="Field">
                                    @if (!string.IsNullOrWhiteSpace(Model.CurrencyCode))
                                    {
                                        @Html.TextBoxFor(x => x.CurrencyCode, new { id = "CurrencyCode", name = "CurrencyCode", maxlength = 5, @readonly = "readonly" })
                                    }
                                    else
                                    { 
                                        @Html.TextBoxFor(x => x.CurrencyCode, new { id = "CurrencyCode", name = "CurrencyCode", maxlength = 5})
                                    }
                                    @Html.ValidationMessageFor(x => x.CurrencyCode)
                                     <label id="CurrencyCode_Validate" class="validationMessage"></label>
                                </div>
                            </div>
                            <div class="TwoColumn">
                                <div class="label">@Resources.CurrencyName</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.CurrencyName, new { id = "CurrencyName", name = "CurrencyName", maxlength = 50 })
                                    @Html.ValidationMessageFor(x => x.CurrencyName)
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label">@Resources.Precision</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.Precision, @String.Format("{0:N0}", Model.Precision), new { @class = "NumericOnly", id = "Precision", maxlength = 1, @style = "text-align:right", onblur = "FormatOnBlur(event)" })
                                    @Html.ValidationMessageFor(x => x.Precision)
                                    
                                </div>
                            </div>
                            <div class="TwoColumn">
                                <div class="label">@Resources.CountryCode</div>
                                <div class="Field">
                                    
                                    @Html.DropDownListFor(x => x.CountryCode, CountryItems.AsEnumerable())
                                    @Html.ValidationMessageFor(x => x.CountryCode)
                                </div>
                            </div>
                        </div>
                        
                        <div id="UFRate">
                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label">@Resources.RateUFtoCLP</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.UFCLPRate, String.Format("{0:N5}", Model.UFCLPRate), new {id = "SBIFInterest", @class = "NumericWithDecimalPlace", maxlength="9"})
                                </div>
                            </div>
                        </div>
                        </div>

                        @Html.Raw(Html.BasicButtons(lstPriv))
                    </div>
                </div>
            }

        </div>


    </div>
</section>
<script>
    $(function () {

        if ($('#CurrencyCode').val() != 'UF') {
            $('#UFRate').hide();
        }

        if ('@ViewData["FormCall"]' != "ApprovalQueue") {
            DisableBtnAuthorize();
        }
    })
</script>
