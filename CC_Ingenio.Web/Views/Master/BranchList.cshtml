@using CC_Ingenio.Web.ViewModel.Master;
@using CC_Ingenio_Resources;

@{
    ViewBag.Title = String.Concat(new object[] { Resources.Branch, " ", Resources.Search });
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model BranchSearch
@{
    var grid = new WebGrid(Model.SearchResults, canPage: true, rowsPerPage: CC_Ingenio.Common.Utils.Utils.GRD_ROWS_PER_PAGE, selectionFieldName: "", ajaxUpdateContainerId: "container-body");
    grid.Pager(WebGridPagerModes.All);
    List<string> lstPriv = new List<string>();
    if (ViewBag.Privileges != null)
    {

        foreach (var item in ViewBag.Privileges)
        {
            lstPriv.Add(item);
        }
    }
        
 }


<section class="feature">

    <div class="PageTitle">@ViewBag.Title</div>

    <!-- Tabs
	================================================== -->

    <div class="PageRow">

                <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            <li class="active">@Html.ActionLink(Resources.SearchPageHeading, "BranchList", "Master" )</li>
            <li> @Html.ActionLink(Resources.DetailsPageHeading,"BranchAdd","Master" )</li>
        </ul>

        <!-- Tabs Content -->
        <div class="tabs-container">
            <div class="tab-content" id="tab1">
                <div class="row">
                    @using (Html.BeginForm("BranchList", "Master", FormMethod.Get, new { id = "frmList", name = "frmList" }))
                    {
                        <div class="SearchBox">
                            <div class="row">
                                <div class="row">
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.BranchCode</div>
                                        <div class="Field" style="padding-left:10px">
                                            @Html.TextBoxFor(x=>x.BranchCode, new { id = "v", name="BranchCode", maxlength = 3})
                                        </div>                                       
                                    </div>
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.BranchName</div>
                                        <div class="Field" style="padding-left:10px">
                                            @Html.TextBoxFor(x=>x.BranchName, new { id = "BranchName", name="BranchName", maxlength = 50 })
                                        </div>
                                    </div>
                                </div>                                                          
                                <div class="SearchColumnbtn">
                                    <span>
                                        <input id="SearchButton" name="SearchButton" class="Greenbutton" type="submit" value="@Resources.Search" />
                                    </span>
                                    <span>
                                        <input id="Button2" type="submit" name ="ClearButton"  class="Greenbutton" value="@Resources.Clear" />
                                    </span>
                                </div>
                            </div>
                            <div class="clear"></div>
                        </div>

                    }

                </div>
                <div class="row">
                   
                    <div class="standard-table">

                        @grid.GetHtml(alternatingRowStyle:"alt",columns:grid.Columns(
                                    grid.Column("BranchCode",Resources.BranchCode),
                                    grid.Column("BranchName", Resources.BranchName),  
                                    grid.Column("ApprovalStatusDesc", Resources.Status),
                                    grid.Column(Resources.Edit, format: 
                                        (item) =>
                                            {
                                                if (item.ApprovalStatus.Equals("D") || item.ApprovalStatus.Equals("R"))
                                                {
                                                    return Html.Raw(Html.ActionLink(Resources.Edit, "BranchAdd", "Master", new { ABranchCode = item.BranchCode, AOrganizationCode = item.OrganizationCode }, null));
                                                    
                                                }   
                                                else
                                                {
                                                    return Html.Raw(Html.Raw(Html.ActionLink(Resources.View, "BranchView", "Master", new { ABranchCode = item.BranchCode, AOrganizationCode = item.OrganizationCode }, null))); 
                                                }
                                            }),
                                    grid.Column(Resources.Delete,   format: 
                                        (item) =>
                                                 {
                                                     if (lstPriv.Contains("Delete"))
                                                     {
                                                         if (item.ApprovalStatus.Equals("D") || item.ApprovalStatus.Equals("R") || item.ApprovalStatus.Equals("A"))
                                                         {
                                                             return Html.Raw(Html.ActionLink(Resources.Delete, "BranchDelete", "Master", new { ABranchCode = item.BranchCode, AOrganizationCode = item.OrganizationCode }, new { @class = "delete-link" }));
                                                         }
                                                         else
                                                         {
                                                             return Html.Raw("");
                                                         }
                                                     }
                                                     else
                                                     {
                                                         return Html.Raw("");
                                                     }
                                            })
                    ))                

                    </div>
                </div>
            </div>


        </div>

    </div>

</section>
