@using CC_Ingenio_Resources;
@using CC_Ingenio.Web.ViewModel.Master;

@{
    ViewBag.Title = String.Concat(new object[] { Resources.MT_ADJUSTMENT_FINANCIAL_ACCOUNT, " ", Resources.Search });
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@model AdjustmentFinancialAccountSearch
@{
    var grid = new WebGrid(Model.SearchResults, canSort: false, canPage: true, rowsPerPage: CC_Ingenio.Common.Utils.Utils.GRD_ROWS_PER_PAGE, selectionFieldName: "", ajaxUpdateContainerId: "container-body");
    grid.Pager(WebGridPagerModes.All);

    List<SelectListItem> ProductItems = new List<SelectListItem>();

    foreach (var itm in ViewBag.ProductList)
    {
        ProductItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }
    ProductItems.Add(new SelectListItem { Text = "ALL", Value = "ALL" });
    ProductItems.RemoveAt(0);
    ProductItems.Insert(0, new SelectListItem { Text = string.Empty, Value = string.Empty });

    List<SelectListItem> BranchItems = new List<SelectListItem>();

    foreach (var itm in ViewBag.Branch)
    {
        BranchItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }
    BranchItems.Add(new SelectListItem { Text = "ALL", Value = "ALL" });
    BranchItems.RemoveAt(0);
    BranchItems.Insert(0, new SelectListItem { Text = string.Empty, Value = string.Empty });

    List<SelectListItem> FinancialActivityItems = new List<SelectListItem>();

    foreach (var itm in ViewBag.FinancialActivity)
    {
        FinancialActivityItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }
    FinancialActivityItems.RemoveAt(0);
    FinancialActivityItems.Insert(0, new SelectListItem { Text = string.Empty, Value = string.Empty });
    List<string> lstPriv = new List<string>();
    if (ViewBag.Privileges != null)
    {

        foreach (var item in ViewBag.Privileges)
        {
            lstPriv.Add(item);
        }
    }
    }

<section class="featured">

    <div class="PageTitle">@ViewBag.Title</div>

    <!-- Tabs
	================================================== -->

    <div class="PageRow">


        <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            <li class="active"><a href="#tab2">@Resources.SearchPageHeading</a></li>
            <li> @Html.ActionLink(Resources.DetailsPageHeading,"AdjustmentFinancialAccountAdd","Master" )</li>
        </ul>

        <!-- Tabs Content -->
        <div class="tabs-container">
            <div class="tab-content" id="tab1">
                <div class="row">
                    @using (Html.BeginForm("AdjustmentFinancialAccountList", "Master", FormMethod.Get, new { id = "frmList", name = "frmList" }))
                    {
                        <div class="SearchBox">
                            <div class="row">
                                <div class="row">
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.Branch</div>
                                        <div class="Field">
                                            @Html.DropDownListFor(x=>x.BranchCode,BranchItems)
                                        </div>
                                    </div>
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.ModuleName</div>
                                        <div class="Field">
                                            @Html.TextBoxFor(x => x.ModuleName, new { maxlength = 50})
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="row">
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.Product</div>
                                        <div class="Field">
                                            @Html.DropDownListFor(x=>x.ProductCode,ProductItems)
                                        </div>
                                    </div>
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.FinancialActivity</div>
                                        <div class="Field">
                                            @Html.DropDownListFor(x=>x.TransactionSubCodeId,FinancialActivityItems)
                                        </div>
                                    </div>
                                </div>

                                <div class="SearchColumnbtn">

                                    <span>
                                        <input id="SearchButton" name="SearchButton" class="Greenbutton" type="submit" value="@Resources.Search" />
                                    </span>

                                    <span>
                                        <input id="Button2" type="submit" name ="ClearButton"  class="Greenbutton" value="@Resources.Clear" />
                                    </span>
                                </div>
                            </div>
                            <div class="clear"></div>
                        </div>
                    }

                </div>
                <div class="row">
                   
                    <div class="standard-table">
                        @grid.GetHtml(alternatingRowStyle: "alt", columns:grid.Columns(
                                    grid.Column("BranchDesc",Resources.BranchCode), 
                                    grid.Column("ModuleName", Resources.ModuleName),
                                    grid.Column("ProductName", Resources.Product),
                                    grid.Column("FinancialActivityDesc", Resources.FinancialActivity),
                                    grid.Column("ApprovalStatusDesc", Resources.Status),
                                    grid.Column(Resources.Edit, format: 
                                        (item) =>
                                            {
                                                if (item.ApprovalStatus.Equals("D") || item.ApprovalStatus.Equals("R"))
                                                {
                                                    return Html.Raw(Html.ActionLink(Resources.Edit, "AdjustmentFinancialAccountAdd", "Master", new { Id = Convert.ToString(item.AdjustmentFinancialAccountId) }, null));
                                                }   
                                                else
                                                {
                                                    return Html.Raw(Html.Raw(Html.ActionLink(Resources.View, "AdjustmentFinancialAccountView", "Master", new { id = item.AdjustmentFinancialAccountId }, null))); 
                                                }
                                            }),
                                    grid.Column(Resources.Delete,   format: 
                                        (item) =>
                                                 {
                                                     if (lstPriv.Contains("Delete"))
                                                     {
                                                         if (item.ApprovalStatus.Equals("D") || item.ApprovalStatus.Equals("R") || item.ApprovalStatus.Equals("A"))
                                                         {
                                                             return Html.Raw(Html.ActionLink(Resources.Delete, "AdjustmentFinancialAccountDelete", "Master", new { id = item.AdjustmentFinancialAccountId }, new { @class = "delete-link" }));
                                                         }
                                                         else
                                                         {
                                                             return Html.Raw("");
                                                         }
                                                     }
                                                     else
                                                     {
                                                         return Html.Raw("");
                                                     }
                                            })
                                  ))
                    </div>
                </div>
            </div>


        </div>

    </div>

</section>
