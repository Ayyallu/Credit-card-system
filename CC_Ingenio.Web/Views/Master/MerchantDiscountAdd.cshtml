@{
    ViewBag.Title = String.Concat(new object[] { Resources.Add, " ", Resources.MerchantDiscount });
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using CC_Ingenio.DataTranfer.MasterInfo;
@using CC_Ingenio.Web.Helpers;
@using CC_Ingenio_Resources;

@model MerchantDiscountDTO
@{
    List<SelectListItem> MerchantList = new List<SelectListItem>();
    List<SelectListItem> TransactionCheckFrequencyList = new List<SelectListItem>();
    List<string> lstPriv = new List<string>();

    foreach (var itm in ViewBag.Merchants)
    {
        MerchantList.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }

    foreach (var itm in ViewBag.TransactionCheckFrequency)
    {
        TransactionCheckFrequencyList.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }
        
    if (ViewBag.Privileges != null)
    {
        foreach (var item in ViewBag.Privileges)
        {
            lstPriv.Add(item);
        }
    }
}
