<section class="featured">
    <div class="PageTitle">@ViewBag.Title </div>
    <div class="PageRow">

        <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            @if (ViewData["FormCall"] != "ApprovalQueue")
            {
                <li>@Html.ActionLink(Resources.SearchPageHeading, "MerchantDiscountList", "Master")</li>                
            }
            <li class="active">@Html.ActionLink(Resources.DetailsPageHeading, "MerchantDiscountAdd", "Master")</li>
        </ul>
        <!-- Tabs Content -->
        <div class="tabs-container">
            @using (Html.BeginForm("MerchantDiscountSave", "Master", new { Id = Model.MerchantDiscountId, }, FormMethod.Post, new { id = "frmMerchantDiscountAdd", name = "frmMerchantDiscountAdd" }))
            {
                <div class="tab-content" id="tab1">
                    <div>
                        <span>
                            @if (!string.IsNullOrWhiteSpace(Model.ApprovalStatus))
                            { 
                                <text> @String.Concat(new object[] { Resources.Status, ":", Model.ApprovalStatusDesc }) </text>
                            }
                        </span>
                    </div>
                    <div class="row">
                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label">@Resources.Merchant</div>
                                <div class="Field">
                                    @if (Model.MerchantDiscountId != 0)
                                    {
                                        @Html.DropDownListFor(x => x.MerchantCode, MerchantList, new { id = "MerchantCode", name = "MerchantCode", @disabled = "disabled" })
                                        @Html.HiddenFor(x => x.MerchantCode, new { id = "MerchantCode", name = "MerchantCode" })
                                    }
                                    else
                                    { 
                                        @Html.DropDownListFor(x => x.MerchantCode, MerchantList, new { id = "MerchantCode", name = "MerchantCode" })
                                    }
                                    @Html.ValidationMessageFor(x => x.MerchantCode)
                                    @Html.HiddenFor(x => x.MerchantDiscountId)
                                </div>
                            </div>
                            <div class="TwoColumn">
                                <div class="label">@Resources.DiscountRatePercent</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.DiscountRate, new { id = "DiscountRate", @class = "NumericWithDecimalPlace", maxlength = 6, @style = "text-align:right" })
                                    @Html.ValidationMessageFor(x => x.DiscountRate)
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label">@Resources.EffectiveFromDate</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.EffectiveFromDate, new { id = "EffectiveFromDate", @class = "datepicker", @readonly = "true", Value = Model.EffectiveFromDate.ToShortDateString() })
                                    @Html.ValidationMessageFor(x => x.EffectiveFromDate)
                                </div>
                            </div>                                                   
                            <div class="TwoColumn">
                                <div class="label">@Resources.TransactionCheckFrequency</div>
                                <div class="Field">
                                    @Html.DropDownListFor(x => x.TransactionCheckFrequencyCode, TransactionCheckFrequencyList, new { id = "TransactionCheckFrequencyCode", name = "TransactionCheckFrequencyCode" })
                                    @Html.ValidationMessageFor(x => x.TransactionCheckFrequencyCode)
                                </div>
                            </div>
                        </div>
                        @Html.Raw(Html.BasicButtons(lstPriv))
                    </div>
                </div>
            }
        </div>
    </div>
</section>
<script>
    $(function () {      

        if ('@ViewData["FormCall"]' != "ApprovalQueue") {
            DisableBtnAuthorize();
        }
    })
</script>
