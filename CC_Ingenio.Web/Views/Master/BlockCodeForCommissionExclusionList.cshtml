@using CC_Ingenio_Resources;

@{
    ViewBag.Title = String.Concat(new object[] { Resources.BlockCodeForCommissionExclusion , " ", Resources.Search });
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using CC_Ingenio.Web.ViewModel.Master
@model BlockCodeForCommissionExclusionSearch
@{
    var grid = new WebGrid(Model.SearchResults, canPage: true, rowsPerPage: CC_Ingenio.Common.Utils.Utils.GRD_ROWS_PER_PAGE, selectionFieldName: "BlockCodeForCommissionExclusionId", ajaxUpdateContainerId: "container-body");
    grid.Pager(WebGridPagerModes.All);
        
}
@{
    List<SelectListItem> blockCodeList = new List<SelectListItem>();
    foreach (SelectListItem item in ViewBag.BlockCodeList) 
    {
        blockCodeList.Add(new SelectListItem() { Text = item.Text, Value = item.Value });
    }
    blockCodeList.RemoveAt(0);
    blockCodeList.Insert(0, new SelectListItem() { Text = string.Empty, Value = string.Empty });

    List<SelectListItem> commissionList = new List<SelectListItem>();
    foreach (SelectListItem item in ViewBag.CommissionList)
    {
        commissionList.Add(new SelectListItem() { Text = item.Text, Value = item.Value });
    }
    commissionList.RemoveAt(0);
    commissionList.Insert(0, new SelectListItem() { Text = string.Empty, Value = string.Empty });
    List<string> lstPriv = new List<string>();
    if (ViewBag.Privileges != null)
    {

        foreach (var item in ViewBag.Privileges)
        {
            lstPriv.Add(item);
        }
    }
}
<section class="featured">

    <div class="PageTitle">@ViewBag.Title</div>

    <!-- Tabs
	================================================== -->

    <div class="PageRow">


        <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            <li class="active"><a href="#tab2">@Resources.SearchPageHeading</a></li>
            <li> @Html.ActionLink(Resources.DetailsPageHeading,"BlockCodeForCommissionExclusionAdd","Master" )</li>
        </ul>

        <!-- Tabs Content -->
        <div class="tabs-container">
            <div class="tab-content" id="tab1">
                <div class="row">
                    @using (Html.BeginForm("BlockCodeForCommissionExclusionList", "Master", FormMethod.Get, new { id = "frmList", name = "frmList" }))
                    {
                        <div class="SearchBox">
                            <div class="row">
                                <div class="row">
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.BlockCode</div>
                                        <div class="Field">
                                            @Html.DropDownListFor(x=>x.BlockCode, blockCodeList)
                                           @* @Html.TextBoxFor(x=>x.BlockCode, new { maxlength = 5})*@
                                        </div>                                       
                                    </div>
                                     <div class="TwoColumn">
                                        <div class="label">@Resources.Commission</div>
                                        <div class="Field">
                                            @Html.DropDownListFor(x=>x.CommissionCode, commissionList)
                                         @*   @Html.TextBoxFor(x=>x.CommissionCode, new { maxlength = 5})*@
                                        </div>
                                    </div>
                                </div>    
                                <div class="SearchColumnbtn">
                                    <span>
                                        <input id="SearchButton" name="SearchButton" class="Greenbutton" type="submit" value="@Resources.Search" />
                                    </span>
                                    <span>
                                        <input id="Button2" type="submit" name ="ClearButton"  class="Greenbutton" value="@Resources.Clear" />
                                    </span>
                                </div>
                            </div>
                            <div class="clear"></div>   
                        </div>
                    }
                </div>
                <div class="row">
                   
                    <div class="standard-table">

                        @grid.GetHtml(alternatingRowStyle:"alt",columns:grid.Columns(
                                    grid.Column("BlockCodeDesc",Resources.BlockCode),
                                    grid.Column("CommissionCodeDesc", Resources.Commission),
                                    grid.Column("IsIncludeCharges",Resources.InclusionOfCharges),
                                    grid.Column("ApprovalStatusDesc", Resources.Status),
                                    grid.Column(Resources.Edit, format: 
                                        (item) =>
                                            {
                                                if (item.ApprovalStatus.Equals("D") || item.ApprovalStatus.Equals("R"))
                                                {
                                                    return Html.Raw(Html.ActionLink(Resources.Edit, "BlockCodeForCommissionExclusionAdd", "Master", new { Id = item.BlockCodeForCommissionExclusionId }, null));
                                                }   
                                                else
                                                {
                                                    return Html.Raw(Html.Raw(Html.ActionLink(Resources.View, "BlockCodeForCommissionExclusionView", "Master", new { id = item.BlockCodeForCommissionExclusionId }, null))); 
                                                }
                                            }),
                                    grid.Column(Resources.Delete,   format: 
                                        (item) =>
                                                 {
                                                     if (lstPriv.Contains("Delete"))
                                                     {
                                                         if (item.ApprovalStatus.Equals("D") || item.ApprovalStatus.Equals("R") || item.ApprovalStatus.Equals("A"))
                                                         {
                                                             return Html.Raw(Html.ActionLink(Resources.Delete, "BlockCodeForCommissionExclusionDelete", "Master", new { id = item.BlockCodeForCommissionExclusionId }, new { @class = "delete-link" }));
                                                         }
                                                         else
                                                         {
                                                             return Html.Raw("");
                                                         }
                                                     }
                                                     else
                                                     {
                                                         return Html.Raw("");
                                                     }
                                            })
                    ))                

                    </div>
                </div>
            </div>

        </div>

    </div>

</section>
