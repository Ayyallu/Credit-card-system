@using CC_Ingenio.DataTranfer.MasterInfo;
@using CC_Ingenio.Web.Helpers;
@using CC_Ingenio_Resources;

@{
    ViewBag.Title = String.Concat(new object[] { Resources.Add, " ", Resources.ProductType });
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model ProductTypeDTO
@{
    List<string> lstPriv = new List<string>();
    if (ViewBag.Privileges != null)
    {

        foreach (var item in ViewBag.Privileges)
        {
            lstPriv.Add(item);
        }
    }
    
    }
@section featured {
}

<script type="text/javascript">
   $(document).ready(function () {

       $("#frmProductTypeCode").submit(function (e) {

           if ($('#ProductTypeCode').val().trim() <= parseFloat(0)) {
               $('#ProductTypeCode_Validate').text("@Html.Raw(string.Format(Resources.MsgErrValueNotZero,Resources.ProductCode))");
                e.preventDefault();
            }
        })

       $('#ProductTypeCode').focusin(function () {
           $('#ProductTypeCode_Validate').text("");
        });

    });

</script>
<section class="featured">
     <div class="PageTitle">@ViewBag.Title </div>
     <div class="PageRow">


        <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            @if (ViewData["FormCall"] != "ApprovalQueue")
            {
                <li> @Html.ActionLink(Resources.SearchPageHeading,"ProductTypeList","Master" )</li>
            }
            <li class="active">@Html.ActionLink(Resources.DetailsPageHeading,"ProductTypeAdd","Master" )</li>
        </ul>
       
            <!-- Tabs Content -->
            <div class="tabs-container">
                 @using (Html.BeginForm("ProductTypeSave", "Master", new { AProductTypeCode = Model.ProductTypeCode, AOrganizationCode = Model.OrganizationCode }, FormMethod.Post, new { Id = "frmProductTypeCode", name = "frmProductTypeCode" }))
                 {
                <div class="tab-content" id="tab1">
                    <div>
                        <span>
                            @if (!string.IsNullOrWhiteSpace(Model.ApprovalStatus))
                            { 
                                <text> @String.Concat(new object[] { Resources.Status, ":", Model.ApprovalStatusDesc }) </text>
                            }
                        </span>
                    </div>
                    <div class="row">

                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label">@Resources.ProductTypeCode</div>
                                <div class="Field">
                                    @if (!string.IsNullOrWhiteSpace(Model.ProductTypeCode))
                                    {
                                        @Html.TextBoxFor(x => x.ProductTypeCode, new { id = "ProductTypeCode", name = "ProductTypeCode", maxlength = "5", @readonly = "readonly" })
                                    }
                                    else
                                    { 
                                        @Html.TextBoxFor(x => x.ProductTypeCode, new { id = "ProductTypeCode", name = "ProductTypeCode", maxlength = "5" })
                                    }
                                    @Html.ValidationMessageFor(x => x.ProductTypeCode)
                                     <label id="ProductTypeCode_Validate" class="validationMessage"></label>
                                </div>
                            </div>
                            <div class="TwoColumn">
                                <div class="label">@Resources.Description</div>
                                <div  class="Field">
                                    @Html.TextBoxFor(x => x.Description, new { maxlength = "50" })
                                    @Html.ValidationMessageFor(x => x.Description)
                                </div>
                            </div>
                        </div>

                        @Html.Raw(Html.BasicButtons(lstPriv))

                    </div>
                </div>
                 }

            </div>
        

    </div>
</section>
<script>
    $(function () {
        if ('@ViewData["FormCall"]' != "ApprovalQueue") {
            DisableBtnAuthorize();
        }
    })
</script>