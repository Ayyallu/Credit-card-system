@{
    ViewBag.Title = String.Concat(new object[] { Resources.Search, " ", Resources.Product });
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using CC_Ingenio.Web.ViewModel.Master
@using CC_Ingenio_Resources;

@model ProductSearch
@{
    var grid = new WebGrid(Model.SearchResults, canPage: true, rowsPerPage: CC_Ingenio.Common.Utils.Utils.GRD_ROWS_PER_PAGE, selectionFieldName: "", ajaxUpdateContainerId: "container-body");
    grid.Pager(WebGridPagerModes.All);

    List<SelectListItem> productCategoryList = new List<SelectListItem>();
    foreach (var item in ViewBag.ProductCategory)
    {
        productCategoryList.Add(new SelectListItem { Text = item.Text, Value = item.Value });
    }
    productCategoryList.RemoveAt(0);
    productCategoryList.Insert(0, new SelectListItem { Text = string.Empty, Value = string.Empty });

    List<SelectListItem> productSubCategoryList = new List<SelectListItem>();
    foreach (var item in ViewBag.ProductSubCategory)
    {
        productSubCategoryList.Add(new SelectListItem { Text = item.Text, Value = item.Value });
    }
    productSubCategoryList.RemoveAt(0);
    productSubCategoryList.Insert(0, new SelectListItem { Text = string.Empty, Value = string.Empty });

    List<string> lstPriv = new List<string>();
    if (ViewBag.Privileges != null)
    {

        foreach (var item in ViewBag.Privileges)
        {
            lstPriv.Add(item);
        }
    }
 }

<section class="feature">

    <div class="PageTitle">@ViewBag.Title</div>

    <!-- Tabs
	================================================== -->

    <div class="PageRow">


        <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            <li class="active">@Html.ActionLink(Resources.SearchPageHeading,"ProductList","Master" )</li>
            <li> @Html.ActionLink(Resources.DetailsPageHeading,"ProductAdd","Master" )</li>
        </ul>

        <!-- Tabs Content -->
        <div class="tabs-container">
            <div class="tab-content" id="tab1">
                <div class="row">
                    @using (Html.BeginForm("ProductList", "Master", FormMethod.Get, new { id = "frmList", name = "frmList" }))
                    {
                        <div class="SearchBox">
                            <div class="row">

                                <div class="row">
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.ProductCode</div>
                                        <div class="Field">
                                            @Html.TextBoxFor(x=>x.ProductCode, new { id = "ProductCode", name="ProductCode", maxlength = "5"  })
                                        </div>
                                    </div>
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.Product Name</div>
                                        <div class="Field">
                                            @Html.TextBoxFor(x=>x.ProductName, new { id = "ProductName", name="ProductName", maxlength = "50"  })
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.ProductCategory</div>
                                        <div class="Field">
                                            @Html.DropDownListFor(x=>x.ProductCategoryCode,productCategoryList)
                                        </div>
                                    </div>
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.ProductSubCategory</div>
                                        <div class="Field">
                                            @Html.DropDownListFor(x=>x.ProductSubCategoryCode,productSubCategoryList)
                                        </div>
                                    </div>
                                </div>

                                                                                     
                                <div class="SearchColumnbtn">
                                    <span>
                                        <input id="SearchButton" name="SearchButton" class="Greenbutton" type="submit" value="@Resources.Search" />
                                    </span>

                                    <span>
                                        <input id="Button2" type="submit" name ="ClearButton"  class="Greenbutton" value="@Resources.Clear" />
                                    </span>
                                </div>

                            </div>
                            <div class="clear"></div>
                        </div>

                    }

                </div>
                <div class="row">
                   
                    <div class="standard-table">

                        @grid.GetHtml(alternatingRowStyle:"alt",columns:grid.Columns(
                                    grid.Column("ProductCode",Resources.ProductCode),
                                    grid.Column("ProductName", Resources.ProductName),                                    
                                    grid.Column("ProductCategoryDesc", Resources.ProductCategory),
                                    grid.Column("ProductSubCategoryDesc", Resources.ProductSubCategory),
                                    grid.Column("ProductStatusDesc", Resources.ProductStatus),
                                    grid.Column("ApprovalStatusDesc", Resources.Status),
                                    grid.Column(Resources.Edit, format: 
                                        (item) =>
                                            {
                                                if (item.ApprovalStatus.Equals("D") || item.ApprovalStatus.Equals("R"))
                                                {
                                                    return Html.Raw(Html.ActionLink(Resources.Edit, "ProductAdd", "Master", new { AProductCode = item.ProductCode, AOrganizationCode = item.OrganizationCode }, null));
                                                }   
                                                else
                                                {
                                                    return Html.Raw(Html.Raw(Html.ActionLink(Resources.View, "ProductView", "Master", new { AProductCode = item.ProductCode, AOrganizationCode = item.OrganizationCode }, null))); 
                                                }
                                            }),
                                    grid.Column(Resources.Delete,   format: 
                                        (item) =>
                                                 {
                                                     if (lstPriv.Contains("Delete"))
                                                     {
                                                         if (item.ApprovalStatus.Equals("D") || item.ApprovalStatus.Equals("R") || item.ApprovalStatus.Equals("A"))
                                                         {
                                                             return Html.Raw(Html.ActionLink(Resources.Delete, "ProductDelete", "Master", new { AProductCode = item.ProductCode, AOrganizationCode = item.OrganizationCode }, new { @class = "delete-link" }));
                                                         }
                                                         else
                                                         {
                                                             return Html.Raw("");
                                                         }
                                                     }
                                                     else
                                                     {
                                                         return Html.Raw("");
                                                     }
                                            })
                    ))                 

                    </div>
                </div>
            </div>

        </div>

    </div>

</section>
