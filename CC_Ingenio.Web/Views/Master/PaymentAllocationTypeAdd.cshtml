<script type="text/javascript">

    $(document).ready(function () {
        

        $("#frmPaymentAllocationTypeSave").submit(function (e) {

            $("#lstSelectedPaymentAllocSeq option").prop("selected", "selected");
            if ($('#lstSelectedPaymentAllocSeq option:selected').length == 0) {
                $('#AssignedList_Validate').text("@Html.Raw(String.Format(Resources.MsgErrPleaseEnter2, Resources.PaymentAllocationSequence))");
                e.preventDefault;
            }
        });

        $("#lstSelectedPaymentAllocSeq").change(function () {
            $('#AssignedList_Validate').text("");
        });

        var originalItems;
        var selectedItems;

        window.globalVar = $("#lstPaymentAllocSeq option");
        originalItems = $("#lstPaymentAllocSeq option");
        var originalItemsCopy = originalItems;
        $("#btnMoveUp").click(moveUp);
        $("#btnMoveDown").click(moveDown);
        resetList();

        $('#btnRight').click
            (function (e) {
                var selectedItem = $('#lstPaymentAllocSeq option:selected');
                if (selectedItem.length == 0) {
                    alert("No Item selected.");
                    e.preventDefault;
                }
                else {
                    $("#lstPaymentAllocSeq > option:selected").appendTo("#lstSelectedPaymentAllocSeq");
                    $("#lstSelectedPaymentAllocSeq")[0].selectedIndex = -1;
                    $("#lstSelectedPaymentAllocSeq").change();
                };
            });

        $('#btnLeft').click(function (e) {
            var selectedItemLeft = $('#lstSelectedPaymentAllocSeq option:selected');
            if (selectedItemLeft.length == 0) {
                alert("No Item selected.");
            }
            else {
                $('#lstSelectedPaymentAllocSeq > option:selected').appendTo("#lstPaymentAllocSeq");
                resetList();
                $("#lstPaymentAllocSeq")[0].selectedIndex = -1;
            }
        });

        function moveUp() {
            $("#lstSelectedPaymentAllocSeq option:selected").each(function () {
                var listItem = $(this);
                var listItemPosition = $("#lstSelectedPaymentAllocSeq option").index(listItem) + 1;

                if (listItemPosition == 1) return false;

                listItem.insertBefore(listItem.prev());
            });
        }

        function moveDown() {

            var itemsCount = $("#lstSelectedPaymentAllocSeq option").length;

            $($("#lstSelectedPaymentAllocSeq option:selected").get().reverse()).each(function () {
                var listItem = $(this);
                var listItemPosition = $("#lstSelectedPaymentAllocSeq option").index(listItem) + 1;

                if (listItemPosition == itemsCount) return false;

                listItem.insertAfter(listItem.next());
            });
        }

        function resetList() {

            selectedItems = $("#lstSelectedPaymentAllocSeq option");

            originalItemsCopy = globalVar.slice();

            for (var i = 0; i < selectedItems.length; i++) {
                removeFromArray(selectedItems[i].value);
            }

            function removeFromArray(arrElem) {
                for (var i = originalItemsCopy.length; i--;) {
                    if (originalItemsCopy[i].value === arrElem) {
                        originalItemsCopy.splice(i, 1);
                        return false;
                    }
                }
            };

            var result = originalItemsCopy;
            var finalArray = result.get();
            $("#lstPaymentAllocSeq").html(finalArray);

        }


    })

</script>


