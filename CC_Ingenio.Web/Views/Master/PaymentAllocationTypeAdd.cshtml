@using CC_Ingenio_Resources;


@{
    ViewBag.Title = String.Concat(new object[] { Resources.Add, " ", Resources.PaymentAllocationType });
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using CC_Ingenio.DataTranfer.MasterInfo;
@using CC_Ingenio.Web.Helpers;
@model PaymentAllocationTypeDTO
@{
    List<SelectListItem> PaymentAllocationTypeItems = new List<SelectListItem>();
    foreach (var itm in ViewBag.PaymentAllocationTypeList)
    {
        PaymentAllocationTypeItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }

    List<SelectListItem> PaymentAllocationSequenceItems = new List<SelectListItem>();
    foreach (var itm in ViewBag.PaymentAllocationSequenceList)
    {
        PaymentAllocationSequenceItems.Add(new SelectListItem { Text = itm.Value, Value = itm.Value });
    }
    PaymentAllocationSequenceItems.RemoveAt(0);
    
    List<string> lstPriv = new List<string>();

    if (ViewBag.Privileges != null)
    {

        foreach (var item in ViewBag.Privileges)
        {
            lstPriv.Add(item);
        }
    }
    
}
    
