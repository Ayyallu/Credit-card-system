@using CC_Ingenio.Web.ViewModel.Master;
@using CC_Ingenio_Resources;

@{
    ViewBag.Title = String.Concat(new object[] { Resources.SBIFInterest, " ", Resources.Search });
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@model SBIFInterestSearch
@{
    var grid = new WebGrid(Model.SearchResults, canSort: false, canPage: true, rowsPerPage: CC_Ingenio.Common.Utils.Utils.GRD_ROWS_PER_PAGE, selectionFieldName: "", ajaxUpdateContainerId: "container-body");
    grid.Pager(WebGridPagerModes.All);

    List<SelectListItem> InterestDefinitionItems = new List<SelectListItem>();

    foreach (var itm in ViewBag.InterestDefinition)
    {
        InterestDefinitionItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }
    InterestDefinitionItems.RemoveAt(0);
    InterestDefinitionItems.Insert(0, new SelectListItem { Text = string.Empty, Value = string.Empty });

    List<SelectListItem> MonthItems = new List<SelectListItem>();

    foreach (var itm in ViewBag.Month)
    {
        MonthItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }
    MonthItems.RemoveAt(0);
    MonthItems.Insert(0, new SelectListItem { Text = string.Empty, Value = string.Empty });

    List<string> lstPriv = new List<string>();
    if (ViewBag.Privileges != null)
    {

        foreach (var item in ViewBag.Privileges)
        {
            lstPriv.Add(item);
        }
    }
    }

<section class="featured">

    <div class="PageTitle">@ViewBag.Title</div>

    <!-- Tabs
	================================================== -->

    <div class="PageRow">


        <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            <li class="active">@Html.ActionLink(Resources.SearchPageHeading,"SBIFInterestList","Master" )</li>
            <li> @Html.ActionLink(Resources.DetailsPageHeading,"SBIFInterestAdd","Master" )</li>
        </ul>

        <!-- Tabs Content -->
        <div class="tabs-container">
            <div class="tab-content" id="tab1">
                <div class="row">
                    @using (Html.BeginForm("SBIFInterestList", "Master", FormMethod.Get, new { id = "frmList", name = "frmList" }))
                    {
                        <div class="SearchBox">
                            <div class="row">
                                <div class="row">
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.InterestDefinition</div>
                                        <div class="Field">
                                            @Html.DropDownListFor(x=>x.MaxInterestDefinitionFor,InterestDefinitionItems)
                                        </div>
                                    </div>
                                    </div>

                                <div class="SearchColumnbtn">
                                    <div class="row">
                                        <span>
                                            <input id="SearchButton" name="SearchButton" class="Greenbutton" type="submit" value="@Resources.Search" />
                                        </span>
                                        <span>
                                            <input id="Button2" type="submit" name ="ClearButton"  class="Greenbutton" value="@Resources.Clear" />
                                        </span>
                                    </div>
                                </div>

                            </div>
                            <div class="clear"></div>
                        </div>

                    }

                </div>
                <div class="row">
                   
                    <div class="standard-table">
                        @grid.GetHtml(alternatingRowStyle: "alt", columns:grid.Columns(
                                    grid.Column("MaxInterestDefinitionForDesc",Resources.InterestDefinition), 
                                    grid.Column("EffectiveDate",Resources.EffectiveDate, format:@<text> @item.EffectiveDate.ToShortDateString()</text>), 
                                    grid.Column("ApprovalStatusDesc", Resources.Status),
                                    grid.Column(Resources.Edit, format: 
                                        (item) =>
                                            {
                                                if (item.ApprovalStatus.Equals("D") || item.ApprovalStatus.Equals("R"))
                                                {
                                                    return Html.Raw(Html.ActionLink(Resources.Edit, "SBIFInterestAdd", "Master", new { ASBIFInterestId = Convert.ToString(item.SBIFInterestId) }, null));
                                                    
                                                }   
                                                else
                                                {
                                                    return Html.Raw(Html.Raw(Html.ActionLink(Resources.View, "SBIFInterestView", "Master", new { ASBIFInterestId = item.SBIFInterestId }, null))); 
                                                }
                                            }),
                                    grid.Column(Resources.Delete,   format: 
                                        (item) =>
                                                             {
                                                                 if (lstPriv.Contains("Delete"))
                                                                 {
                                                                     if (item.ApprovalStatus.Equals("D") || item.ApprovalStatus.Equals("R") || item.ApprovalStatus.Equals("A") || item.ApprovalStatus.Equals("EXP"))
                                                                     {
                                                                         return Html.Raw(Html.ActionLink(Resources.Delete, "SBIFInterestDelete", "Master", new { ASBIFInterestId = item.SBIFInterestId, ASearchGridClick = true }, new { @class = "delete-link" }));
                                                                     }
                                                                     else
                                                                     {
                                                                         return Html.Raw("");
                                                                     }
                                                                 }
                                                                 else
                                                                 {
                                                                     return Html.Raw("");
                                                                 }
                                            })
                                  ))
                    </div>
                </div>
            </div>


        </div>

    </div>

</section>
