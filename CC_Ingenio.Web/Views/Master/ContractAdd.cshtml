@using CC_Ingenio_Resources
@using CC_Ingenio.DataTranfer.MasterInfo;
@using CC_Ingenio.Web.Helpers;

@{
    ViewBag.Title = String.Concat(new object[] { Resources.Add, " ", Resources.Contract });
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@model ContractDTO
@{
    List<SelectListItem> contractTemplateList = new List<SelectListItem>();
    List<string> lstPriv = new List<string>();
    
    foreach (var item in ViewBag.ContractTemplateList)
    {
        contractTemplateList.Add(new SelectListItem { Text = item.Text,Value = item.Value  });
    }

    List<SelectListItem> productList = new List<SelectListItem>();
    foreach(var item in ViewBag.ProductList)       
    {
        productList.Add(new SelectListItem { Text = item.Text, Value = item.Value });
    }

    if (ViewBag.Privileges != null)
    {

        foreach (var item in ViewBag.Privileges)
        {
            lstPriv.Add(item);
        }
    }
}

<script type="text/javascript">

    function setCalenderDates() {

        var fromDate = $('#FromDate').val();
        var toDate = $('#ToDate').val();

        $('#FromDate').datepicker("option", "maxDate", toDate);
        $('#ToDate').datepicker("option", "minDate", fromDate);
    }

  
    $(document).ready(function () {

        $('#FromDate').datepicker("option", "onSelect", setCalenderDates);
        $('#ToDate').datepicker("option", "onSelect", setCalenderDates);

        $("#frmContract").submit(function (e) {

            if ($('#ContractCode').val().trim() <= parseFloat(0)) {
                $('#ContractCode_Validate').text("@Html.Raw(string.Format(Resources.MsgErrValueNotZero,Resources.ContractCode))");
                e.preventDefault();
            }
        })

        $('#ContractCode').focusin(function () {
            $('#ContractCode_Validate').text("");
        });

    });

    
</script>
<section class ="featured">
     <div class="PageTitle">@ViewBag.Title</div>
    <div class="PageRow">

        <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            @if (ViewData["FormCall"] != "ApprovalQueue")
            {
                <li> @Html.ActionLink(Resources.SearchPageHeading,"ContractList","Master" )</li>
            }
            <li class="active"><a href="#tab1">@Resources.DetailsPageHeading</a></li>
        </ul>
       
            <!-- Tabs Content -->
            <div class="tabs-container">

                 @using (Html.BeginForm("ContractSave", "Master", new { AContractCode = Model.ContractCode, AOrganizationCode = Model.OrganizationCode }, FormMethod.Post, new { id = "frmContract", name = "frmContract" }))
                 {
                <div class="tab-content" id="tab1">
                    <div>
                        <span>
                            @if (!string.IsNullOrWhiteSpace(Model.ApprovalStatus))
                            { 
                                <text> @String.Concat(new object[] { Resources.Status, ":", Model.ApprovalStatusDesc })</text>
                            }
                        </span>
                    </div>
                    <div class="row">

                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label">@Resources.ContractCode</div>
                                <div class="Field">
                                    @if (!string.IsNullOrWhiteSpace(Model.ContractCode))
                                    {
                                        @Html.TextBoxFor(x => x.ContractCode, new { id = "ContractCode", name = "ContractCode", maxlength = 5, @readonly = "readonly" })
                                    }
                                    else
                                    { 
                                        @Html.TextBoxFor(x => x.ContractCode, new { id = "ContractCode", name = "ContractCode", maxlength = 5})
                                    }
                                    @Html.ValidationMessageFor(x => x.ContractCode)
                                     <label id="ContractCode_Validate" class="validationMessage"></label>
                                </div>
                            </div>
                            <div class="TwoColumn">
                                <div class="label">@Resources.ContractDescription</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.ContractDescription, new { id = "ContractDescription", name = "ContractDescription", maxlength = 50 })
                                    @Html.ValidationMessageFor(x => x.ContractDescription)
                                </div>
                            </div>
                        </div>

                           <div class="row">
                            <div class="TwoColumn">
                                <div class="label">@Resources.EffectiveFromDate</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.EffectiveFromDate, new {id = "FromDate", @class ="datepicker", @readonly="true", Value = Model.EffectiveFromDate.ToShortDateString() })
                                    @Html.ValidationMessageFor(x => x.EffectiveFromDate)
                                </div>
                            </div>
                            <div class="TwoColumn">
                                <div class="label">@Resources.EffectiveToDate</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.EffectiveToDate, new { id = "ToDate", @class ="datepicker", @readonly="true", Value = Model.EffectiveToDate.ToShortDateString() })
                                    @Html.ValidationMessageFor(x => x.EffectiveToDate)
                                </div>
                            </div>
                        </div>

                        <div class="row">
                           @* <div class="TwoColumn">
                                <div class="label">Product</div>
                                <div class="Field">
                                    @Html.DropDownListFor(x => x.ProductCode, productList)
                                    @Html.ValidationMessageFor(x => x.ProductCode)
                                </div>
                            </div>*@
                            <div class="TwoColumn">
                                <div class="label">@Resources.ContractTemplate</div>
                                <div class="Field">
                                    @Html.DropDownListFor(x => x.ContractTemplateCode, contractTemplateList)
                                    @Html.ValidationMessageFor(x => x.ContractTemplateCode)
                                </div>
                            </div>
                              <div class="TwoColumn">
                                <div class="label fontmandatory">@Resources.NotaryName</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.NotaryName, new { id = "NotaryName", name = "NotaryName", maxlength = 50 })
                                    @Html.ValidationMessageFor(x => x.NotaryName)
                                </div>
                            </div>
                        </div>
                        <div class="row">                          
                            <div class="TwoColumn">
                                <div class="label fontmandatory">@Resources.NotarySignDate</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.NotarySignDate, new { @class ="datepicker", @readonly="true", Value = Model.NotarySignDate.ToShortDateString() })
                                    @Html.ValidationMessageFor(x => x.NotarySignDate)
                                </div>
                            </div>
                             <div class="TwoColumn">
                                <div class="label fontmandatory">@Resources.Repertoire</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.Repertoire, new { id = "Repertoire", name = "Repertoire", maxlength = 50 })
                                    @Html.ValidationMessageFor(x => x.Repertoire)
                                </div>
                            </div>
                        </div>

                        @Html.Raw(Html.BasicButtons(lstPriv))

                    </div>
                </div>
                 }

            </div>
        

    </div>

</section>
<script>
    $(function () {
        setCalenderDates();

        if ('@ViewData["FormCall"]' != "ApprovalQueue") {
            DisableBtnAuthorize();
        }
    })
</script>
