@{
    ViewBag.Title = String.Concat(new object[] { Resources.General, " ", Resources.Search });
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using CC_Ingenio.Web.ViewModel.Master;
@using CC_Ingenio_Resources;
@model GeneralSearch
@{
    var grid = new WebGrid(Model.SearchResults, canPage: true, rowsPerPage: CC_Ingenio.Common.Utils.Utils.GRD_ROWS_PER_PAGE, selectionFieldName: "", ajaxUpdateContainerId: "container-body");
    grid.Pager(WebGridPagerModes.All);
    List<string> lstPriv = new List<string>();
    if (ViewBag.Privileges != null)
    {

        foreach (var item in ViewBag.Privileges)
        {
            lstPriv.Add(item);
        }
    }
}


<section class="feature">

    <div class="PageTitle">@ViewBag.Title</div>

    <!-- Tabs
	================================================== -->

    <div class="PageRow">

        <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            <li class="active">@Html.ActionLink(Resources.SearchPageHeading,"GeneralList","Master" )</li>
            <li> @Html.ActionLink(Resources.DetailsPageHeading,"GeneralAdd","Master" )</li>
        </ul>

        <!-- Tabs Content -->
        <div class="tabs-container">
            <div class="tab-content" id="tab1">
                <div class="row">
                    @using (Html.BeginForm("GeneralList", "Master", FormMethod.Get, new { id = "frmList", name = "frmList" }))
                    {
                        <div class="SearchBox">
                            <div class="row">
                                <div class="row">
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.KeyCode</div>
                                        <div class="Field">
                                            @Html.TextBoxFor(x=>x.KeyName, new { id = "KeyName", name="KeyName", maxlength = 5})
                                        </div>
                                    </div>
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.Value1</div>
                                        <div class="Field">
                                            @Html.TextBoxFor(x=>x.Value1, new { id = "Value1", name="Value1", maxlength = 50 })
                                        </div>
                                    </div>
                                    </div>
                                <div class="row">
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.Value2</div>
                                        <div class="Field">
                                            @Html.TextBoxFor(x=>x.Value2, new { id = "Value2", name="Value2", maxlength = 50 })
                                        </div>
                                    </div>

                                 </div>
                           <div class="row">
                                <div class="SearchColumnbtn">
                                        <span>
                                            <input id="SearchButton" name="SearchButton" class="Greenbutton" type="submit" value="@Resources.Search" />
                                        </span>
                                        <span>
                                            <input id="Button2" type="submit" name ="ClearButton"  class="Greenbutton" value="@Resources.Clear" />
                                        </span>
                                </div>                                
                            </div>
                            <div class="clear"></div>
                           </div>
                        </div>
                    }

                </div>
                <div class="row">
                   
                    <div class="standard-table">

                        @grid.GetHtml(columns:grid.Columns(
                                    grid.Column("KeyName",Resources.KeyCode),
                                    grid.Column("Value1",Resources.Value1),
                                    grid.Column("Value2", Resources.Value2),
                                    grid.Column("EffectiveFromDate", Resources.EffectiveFromDate,format:@<text> @item.EffectiveFromDate.ToShortDateString()</text>),  
                                    grid.Column("EffectiveToDate", Resources.EffectiveToDate,format:@<text> @item.EffectiveToDate.ToShortDateString()</text>),   
                                    grid.Column("ApprovalStatusDesc", Resources.Status),
                                    grid.Column(Resources.Edit, format: 
                                        (item) =>
                                            {
                                                if (item.ApprovalStatus.Equals("D") || item.ApprovalStatus.Equals("R"))
                                                {
                                                    return Html.Raw(Html.ActionLink(Resources.Edit, "GeneralAdd", "Master", new { AKeyName = item.KeyName, AOrganizationCode = item.OrganizationCode }, null));
                                                }   
                                                else
                                                {
                                                    return Html.Raw(Html.Raw(Html.ActionLink(Resources.View, "GeneralView", "Master", new { AKeyName = item.KeyName, AOrganizationCode = item.OrganizationCode }, null))); 
                                                }
                                            }),
                                    grid.Column(Resources.Delete,   format: 
                                        (item) =>
                                                             {
                                                                 if (lstPriv.Contains("Delete"))
                                                                 {
                                                                     if (item.ApprovalStatus.Equals("D") || item.ApprovalStatus.Equals("R") || item.ApprovalStatus.Equals("A"))
                                                                     {
                                                                         return Html.Raw(Html.ActionLink(Resources.Delete, "GeneralDelete", "Master", new { AKeyName = item.KeyName, AOrganizationCode = item.OrganizationCode }, new { @class = "delete-link" }));
                                                                     }
                                                                     else
                                                                     {
                                                                         return Html.Raw("");
                                                                     }
                                                                 }
                                                                 else
                                                                 {
                                                                     return Html.Raw("");
                                                                 }
                                            })
                    ))
                   
                    </div>
                </div>
            </div>


        </div>

    </div>

</section>

