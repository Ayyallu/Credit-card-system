@using CC_Ingenio_Resources;
 @{
    ViewBag.Title = String.Concat(new object[] { Resources.Add, " ", Resources.CustomerSubSegment});
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@using CC_Ingenio.DataTranfer.MasterInfo;
@using CC_Ingenio.Web.Helpers;

@model CustomerSubSegmentDTO
@{
    List<string> lstPriv = new List<string>();
    if (ViewBag.Privileges != null)
    {

        foreach (var item in ViewBag.Privileges)
        {
            lstPriv.Add(item);
        }
    }
    }


@section featured{}



<script type="text/javascript">

    $(document).ready(function () {
        
        $('#New').click(function () {
            document.location.href = "CustomerSubSegmentAdd";
        });

        $("#frmCustomerSubSegmentSave").submit(function (e) {

            if (parseFloat($('#SubSegmentCode').val().trim()) <= parseFloat(0)) {
                $('#SubSegmentCode_Validate').text("@Html.Raw(string.Format(Resources.MsgErrValueNotZero,Resources.SubSegmentCode))");
                e.preventDefault();
            }
@*            else {
                if ($('#frmCustomerSubSegmentSave').valid()) {
                    if ($('#IsDefault').attr('checked')) {
                        e.preventDefault();
                        $.ajax({
                            type: 'POST',
                            chache: false,
                            url: '/Master/CheckIfDefaultCustomerSubSegmentExists/',
                            data: {ACustomerSubSegmentCode:'@Model.SubSegmentCode'},
                            success:function(returnData){
                                if (returnData.Message) {
                                    ShowSimpleModalDialog(returnData.Message);
                                }
                                else {
                                    $('#frmCustomerSubSegmentSave').submit();
                                }
                            }
                        });
                    }
                }
            }*@
        })

        $('#SubSegmentCode').focusin(function () {
            $('#SubSegmentCode_Validate').text("");
        });

        $('#IsDefault').focusin(function () {
            $('#IsDefault_Validate').text("");
        });

    });
</script>



<section class ="featured">
     <div class="PageTitle">@ViewBag.Title</div>
    <div class="PageRow">

        <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            @if (ViewData["FormCall"] != "ApprovalQueue")
            {
                <li> @Html.ActionLink(Resources.SearchPageHeading,"CustomerSubSegmentList","Master" )</li>
            }
            <li class="active">@Html.ActionLink(Resources.DetailsPageHeading,"CustomerSubSegmentAdd","Master" )</li>
        </ul>
       
            <!-- Tabs Content -->
            <div class="tabs-container">
                 @using (Html.BeginForm("CustomerSubSegmentSave", "Master", new { ASubSegmentCode = Model.SubSegmentCode, AOrganizationCode = Model.OrganizationCode }, FormMethod.Post, new { id = "frmCustomerSubSegmentSave", name = "frmCustomerSubSegmentSave" }))
                 {
                <div class="tab-content" id="tab1">
                    <div>
                        <span>
                            @if (!string.IsNullOrWhiteSpace(Model.ApprovalStatus))
                            { 
                                <text> @String.Concat(new object[] { Resources.Status, ":", Model.ApprovalStatusDesc }) </text>
                            }
                        </span>
                    </div>
                    <div class="row">
 
                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label">@Resources.SubSegmentCode</div>
                                <div class="Field">
                                    @if (!string.IsNullOrWhiteSpace(Model.SubSegmentCode) && !string.IsNullOrWhiteSpace(Model.ApprovalStatusDesc))
                                    {
                                        @Html.TextBoxFor(x => x.SubSegmentCode, new { id = "SubSegmentCode", name = "SubSegmentCode", maxlength = 5, @readonly = "readonly" })
                                    }
                                    else
                                    { 
                                        @Html.TextBoxFor(x => x.SubSegmentCode, new { id = "SubSegmentCode", name = "SubSegmentCode", maxlength = 5 })
                                    }
                                    @Html.ValidationMessageFor(x => x.SubSegmentCode)
                                    <label id="SubSegmentCode_Validate" class="validationMessage"></label>
                                </div>
                            </div>
                            <div class="TwoColumn">
                                <div class="label">@Resources.SubSegmentName</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.SubSegmentName, new { id = "SubSegmentName", name = "SubSegmentName", maxlength = 50 })
                                    @Html.ValidationMessageFor(x => x.SubSegmentName)
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label fontmandatory">@Resources.Description</div>
                                <div class="Field">
                                    @Html.TextAreaFor(x => x.SubSegmentDesc, new { id = "SubSegmentDesc", name = "SubSegmentDesc", maxlength = 100, onKeyPress = "return (this.value.length < 100)" })
                                    @Html.ValidationMessageFor(x => x.SubSegmentDesc)
                                </div>
                            </div>
                            <div class="TwoColumn">
                                <div class="label">@Resources.DefaultFlag</div>
                                <div>
                                    @Html.CheckBoxFor(x => x.IsDefault)
                                    @Html.ValidationMessageFor(x => x.IsDefault, "", new { id = "IsDefault_Validate", @class = "validationMessage", @style="padding-left:11.5em;"})
                                </div>
                            </div>
                        </div>

                        @Html.Raw(Html.BasicButtons(lstPriv))

                    </div>
                </div>
                 }

            </div>
        

    </div>

</section>
<script>
    $(function () {
        if ('@ViewData["FormCall"]' != "ApprovalQueue") {
            DisableBtnAuthorize();
        }
    })
</script>

