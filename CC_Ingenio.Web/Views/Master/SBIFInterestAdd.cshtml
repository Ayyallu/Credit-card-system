@using CC_Ingenio.DataTranfer.MasterInfo;
@using CC_Ingenio.Web.Helpers;
@using System.Web.Script.Serialization;
@using CC_Ingenio_Resources;

@{
    ViewBag.Title = String.Concat(new object[] { Resources.Add, " ", Resources.SBIFInterest });
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<script src="/Scripts/Master/SBIFInterest.js"></script>

@model SBIFInterestDTO
@{
    List<SelectListItem> InterestDefinitionItems = new List<SelectListItem>();
    List<string> lstPriv = new List<string>();
    
    foreach (var itm in ViewBag.InterestDefinition)
    {
        InterestDefinitionItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }

    
    if (ViewBag.Privileges != null)
    {

        foreach (var item in ViewBag.Privileges)
        {
            lstPriv.Add(item);
        }
    }
    
}



<script type="text/javascript">

    function setCurrencyPrecision() {
        $.getJSON("/Master/GetCurrencyPrecision?ACurrencyCode=" + "UF",
        function (modeldata) {
            $.ajaxSetup({ cache: false });
            precision = parseInt(modeldata.precision);
        });
    };


    $(document).ready(function () {
        
        setCurrencyPrecision();

        $("#frmSBIFInterestSave").submit(function (e) {
            if (parseFloat($('#CreditLimitFrom').val().trim()) > parseFloat($('#CreditLimitTo').val().trim())) {
                $('#CreditLimitTo_Validate').text("@Html.Raw(string.Format(Resources.MsgErrValueShouldBeLessThan,Resources.CreditLimitFrom,Resources.CreditLimitTo))");
                e.preventDefault();
            }
        });

        $('#CreditLimitFrom').focusin(function () {
            $('#CreditLimitTo_Validate').text("");
        });

        $('#CreditLimitTo').focusin(function () {
            $('#CreditLimitTo_Validate').text("");
        });
        

    });
</script> 
    


<script type="text/javascript">

    var intDefinitionDDL =  @Html.Raw(new JavaScriptSerializer().Serialize(InterestDefinitionItems));
    
    var SBIFInterests =  @Html.Raw(ViewBag.SBIFInterest);
    
</script>





<section class="featured">
    <div class="PageTitle">@ViewBag.Title</div>
    <div class="PageRow">
        <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            @if (ViewData["FormCall"] != "ApprovalQueue")
            {
                <li>@Html.ActionLink(Resources.SearchPageHeading, "SBIFInterestList", "Master")</li>
            }
            <li class="active"><a href="#tab1">@Resources.DetailsPageHeading</a></li>
        </ul>

        <div class="tabs-container">
            @using (Html.BeginForm())
            {
                <div class="tab-content" id="tab1">

                    <div>
                        <span>
                            @if (!string.IsNullOrWhiteSpace(Model.ApprovalStatus))
                            { 
                                <text> @Html.Raw(String.Concat(new object[] { Resources.Status, ":", Model.ApprovalStatusDesc })) </text>
                            }
                        </span>
                    </div> 


                    <div class ="row">
                        
@*                        <div class="SearchBox">*@
                            <div class="row">
                                <div class="TwoColumn"> 
                                <div class="label">@Resources.MaxInterestDefinitionFor</div>
                                    <div class="Field"  style="padding-top : 4px">
                                        <select data-bind="options: intDefinitionDDL, 
                                            optionsText: 'Text', 
                                            optionsValue: 'Value', 
                                            value: SBIFInterest.MaxInterestDefinitionFor">
                                        </select>
                                    </div>
                                </div>
                                <div class="TwoColumn">
                                    <div class="label">@Resources.EffectiveDate</div>
                                    <div class="Field">
                                        <input type="text" id="DateOfBirth" class="datepicker" readonly="true" data-bind="value: SBIFInterest.EffectiveDate" />
                                    </div>
                                </div>
                            </div>
@*                          </div>*@

                            <div class="row">
                                 <script id="SBIFInterestDetailsTemplate" type="text/html">
                                <tr>
                                    <td>
                                        <input id="CreditLimitFrom" data-bind="value: CreditLimitFrom" maxlength="17", onkeypress = "return AllowOnlyAmountByCurrencyPrecision(this,event, precision);", class = "gridfield", style="text-align:right; width:80%", onblur = "FormatOnBlurWithDecimal(event)" />
                                        @*<input id="CreditLimitFrom" data-bind="value: CreditLimitFrom" maxlength="11", onkeypress = "return AllowOnlyAmountWithoutDot(event)", class = "gridfield", style="text-align:right; width:80%", onblur = "FormatOnBlur(event)" />*@
                                    </td>
                                    <td>
                                        <input id="CreditLimitTo" data-bind="value: CreditLimitTo" maxlength="17", onkeypress = "return AllowOnlyAmountByCurrencyPrecision(this,event, precision);", class = "gridfield", style="text-align:right; width:80%", onblur = "FormatOnBlurWithDecimal(event)" />
@*                                        <input id="CreditLimitTo" data-bind="value: CreditLimitTo" maxlength="11", onkeypress = "return AllowOnlyAmountWithoutDot(event)", class = "gridfield", style="text-align:right; width:80%", onblur = "FormatOnBlur(event)" />*@
                                    </td>
                                    <td>
                                        <input id="SBIFInterestRate" data-bind="value: SBIFInterestRate" maxlength="6", onkeypress="return validateFloatKeyPress(this,event);", class = "gridfield", style="text-align:right; width:80%" />
                                    </td>
                                    
                                    <td><a href='#' data-bind='click: $root.remove'>@Resources.Delete</a></td>
                                </tr>
                            </script>
                            <div class="standard-table">
                               <table>
                                    <thead>
                                        <tr>
                                            <th>@Resources.CreditLimitFromUF</th>
                                            <th>@Resources.CreditLimitToUF</th>
                                            <th>@Resources.SBIFInterestRatePercentage</th>
                                            <th>@Resources.Action</th>
                                        </tr>
                                    </thead>
                                    <tbody data-bind="template: { name:'SBIFInterestDetailsTemplate', foreach:SBIFInterest.SBIFInterestDetailsData }"></tbody>
                              </table>

                                    <span><button class="Greenbutton" data-bind='click: AddItem' style="width:8%">@Resources.AddNew</button></span>

                            </div>
                        </div>

                        
                        <div class="rowbtn">
                            @Html.Raw(Html.KnockoutButtons(lstPriv, true))
                        </div>

                    </div>



                </div>                
            }
        </div>

    </div>
    <script>
        $(function () {
            $("input#New").on('click', function () {
                window.location.href = "/Master/SBIFInterestAdd";
            })
        });
        var url = window.location.pathname;
        var SBIFInterestId = GetQueryStrings();
        var viewModel;
        
        if (SBIFInterestId["ASBIFInterestId"] && SBIFInterestId["ASBIFInterestId"] != 0)
        {
            viewModel = new SBIFInterestVM(SBIFInterests);
        }
        else
        {
            viewModel = new SBIFInterestVM();
        }
        $(function ()
        {
            ko.applyBindings(viewModel);
              
        });
    </script>

</section>
<script>
    $(function () {
        if ('@ViewData["FormCall"]' != "ApprovalQueue") {
            DisableBtnAuthorize();
        }
    })
</script>