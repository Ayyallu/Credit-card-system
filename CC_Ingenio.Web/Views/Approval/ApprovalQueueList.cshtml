@using CC_Ingenio_Resources;
@{
    ViewBag.Title = Resources.ApprovalQueue;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using CC_Ingenio.Web.ViewModel.ApprovalQueue
@model ApprovalQueueSearch
@{
    
    var grid = new WebGrid(Model.SearchResults, canPage: true, rowsPerPage: CC_Ingenio.Common.Utils.Utils.GRD_ROWS_PER_PAGE);//, selectionFieldName: "RequestId", ajaxUpdateContainerId: "container-body");
    grid.Pager(mode: WebGridPagerModes.All);

    List<SelectListItem> ContextCodeList = new List<SelectListItem>();

    foreach (var item in ViewBag.ContextCodes)
    {
        ContextCodeList.Add(new SelectListItem { Text = item.Text, Value = item.Value });
    }


    if (TempData.ContainsKey("RecCount"))
    {
        TempData["RecCount"] = ((List<CC_Ingenio.DataTranfer.ApprovalQueueInfo.ApprovalQueueDTO>)Session["ApprovalQueueList"]).Where(x => x.IsChecked == true).ToList().Count;
    }
    else
    {
        TempData.Add("RecCount", ((List<CC_Ingenio.DataTranfer.ApprovalQueueInfo.ApprovalQueueDTO>)Session["ApprovalQueueList"]).Where(x => x.IsChecked == true).ToList().Count);
    }
    
    
}


<script type="text/javascript">


    var index = 1;

    $(document).ready(function () {
        
        document.getElementById('allBox').setAttribute('style', 'padding-left : 3px;');

        $("#ContextCode").change(function (evt) {
            if ($("#ContextCode option:selected").text() != null) {
                $('#ContextCode_Validate').text("");
                $('#SearchButton').click();
            }
        });
        
        $("#AuthorizeApprovalQueue").click(function (e) {

            if ($('#AuthorizeApprovalQueue').is(':disabled') == true) { return false; };
                  
            var RecCount = $('input:hidden[name="Count"]').val();
            if (!RecCount)
                RecCount = '@TempData["RecCount"]';

            if (!RecCount || RecCount == 0) {
                $('#SelectedCount_Validate').text("@Html.Raw(string.Format(Resources.MsgErrPleaseSelect,Resources.AtleastOneRecord))");
                return false;
            };
 
                   
            var distinctContext = false;
            var canApprove = false;
            var contextCode = "";
            var hasPrivilege = false;

            $.ajax({
                url: "/Approval/CheckDistinctContextSelected",
                cache: false,
                contenttype: "application/json ; charset = utf-8",
                success: function (data) {
                    distinctContext = data.IsDistinct;
                    contextCode = data.Context;
                    canApprove = data.CanApproveAll;
                    hasPrivilege = data.HasApprovePriv;

                    if (distinctContext == false) {
                        ShowSimpleModalDialog(data.Message1, "");
                        return false;
                    }
                    else if (canApprove == false) {
                        ShowSimpleModalDialog(data.Message2, "");
                        return false;
                    }
                    else if (hasPrivilege == false) {
                        ShowSimpleModalDialog(data.Message3, "");
                        return false;
                    }
                    else {
                        $.ajax({
                            url: "/Approval/LoadApprovalQueueAuthorizeAllPopup",
                            //data: { AContextCode: $("#ContextCode option:selected").val() },
                            data: { AContextCode: contextCode },
                            cache: false,
                            contenttype: "application/json ; charset = utf-8",
                            success: function (data) {
                                $("#ApprovalQueueAuthorizeAll").html(data);

                            },
                            error: function (ts) { alert(ts.responseText) }
                        });

                        loading(); // loading
                        setTimeout(function () { // then show popup, deley in .5 second
                            loadPopup(); // function show popup
                        }, 500); // .5 second

                    }
                },
                error: function (ts) { alert(ts.responseText) }
            });

            
            
            /************** start: functions. **************/
            function loading() {
                $("div.loader").show();
            }
            function closeloading() {
                $("div.loader").fadeOut('normal');
            }

            var popupStatus = 0; // set value

            function loadPopup() {
                if (popupStatus == 0) { // if value is 0, show popup
                    closeloading(); // fadeout loading
                    $("#toPopupAuthorizeAll").fadeIn(0500); // fadein popup div
                    $("#backgroundPopup").css("opacity", "0.7"); // css opacity, supports IE7, IE8
                    $("#backgroundPopup").fadeIn(0001);
                    popupStatus = 1; // and set value to 1
                }
            }

            function disablePopup() {
                if (popupStatus == 1) { // if value is 1, close popup
                    $("#toPopupAuthorizeAll").fadeOut("normal");
                    $("#backgroundPopup").fadeOut("normal");
                    popupStatus = 0;  // and set value to 0
                    $('#ContextDesc_validate2').text("");
                    $('#ReasonCode_validate2').text("");
                }
            }

        });

        $("#allBox").click(function () {
                           
            var pageno = $("#page").val() == "" ? 0 : $("#page").val();

            var all = $("#allBox").attr("checked") ? true : false;
            $(".select").attr("checked", $(this).attr("checked") ? true : false);

            $.ajax({
                url: '/Approval/UpdateAllInApprovalQueueSession/',
                data: { isChecked: all, Apage: pageno },
                type: 'get',
                cache: false,
                contentType: 'application/json; charset=utf-8',
                success: function (data) {
                    $('input:hidden[name="Count"]').val(data.Count);
                    $('#SelectedCount_Validate').text("");
                }
            });
        });

        $("input.select").each(function () {
            
            $(this).data('row', index);
            $(this).click(function () {

                var tr = $(this).parents('tr:first');

                var RequestId = tr.find("#IsChecked").val();
                var IsChecked = tr.find('#IsChecked').attr('checked') ? "True" : "False";

                //if (IsChecked == "True")
                //    tr.find("#Link").attr('disabled', true);
                //else
                //    tr.find("#Link").attr('disabled', false);

                $.ajax({
                    url: '/Approval/UpdateApprovalQueueSession/',
                    data: { ARequestId: RequestId, IsChecked: IsChecked },
                    type: 'get',
                    cache: false,
                    contentType: 'application/json; charset=utf-8',
                    success: function (data) {
                        $('input:hidden[name="Count"]').val(data.Count);
                        $('#SelectedCount_Validate').text("");
                    }

                });
            });
            index++;
        });

    });

    function ClearSession() {

        $.ajax({
            type: 'POST',
            url: '/Approval/DeleteApprovalQueueSessionData',
            success: function (returnData) {
            }
        });
    };

    
    $(function () {
        $('.PagerLink').click(function () {
            
            $('form').attr('action', $(this).attr('href')).submit();
            return false;
        });

        $("#Reset").click(function ()
        {
            $("#ContextCode").attr("value", "");
            $("#RequestedBy").attr("value", "");
            $('form').submit();
        }

        );
    });
</script>


<style>
    input[type=checkbox] {
        border:none;
    }
    
    .gridSelectCol
    {
        width: 5%;
        text-align:center;
    }
    #Link {
        color:blue;
    }
</style>


<section class="featured">

    <div class="PageTitle">@ViewBag.Title</div>

    <!-- Tabs
	================================================== -->

    <div class="PageRow">


        <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            <li class="active"><a href="#tab2">@Resources.SearchPageHeading</a></li>
        </ul>
        

        <!-- Tabs Content -->
        <div class="tabs-container">
            <div class="tab-content" id="tab1">
                <div class="row">
                    @using (Html.BeginForm("ApprovalQueueList", "Approval", FormMethod.Get))
                    {
                        
                        <div id ="ApprovalQueueAuthorizeAll"></div>
                        
                        
                        <div class="SearchBox">
                            <div class="row">
                               
                                <div class="row">
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.Context</div>
                                        <div class="Field">
                                              @*@Html.TextBoxFor(x => x.ContextCode)*@
                                            @Html.DropDownListFor(x => x.ContextCode, ContextCodeList, new { id = "ContextCode" })
                                            <label id="ContextCode_Validate" class="validationMessage"></label>
                                        </div>
                                    </div>
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.RequestedBy</div>
                                        <div class="Field">
                                            @Html.TextBoxFor(x => x.RequestedBy)
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="TwoColumn">   
                                        <div class="label">@Resources.RequestedOnFrom</div>
                                        <div class="Field">
                                            @Html.TextBoxFor(x => x.RequestedOn, "{0:dd/MM/yyyy}", new { @class ="datepicker", @readonly="true" })
                                        </div>
                                    </div>
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.RequestedOnTo</div>
                                        <div class="Field">
                                            @Html.TextBoxFor(x => x.RequestedOnTo, "{0:dd/MM/yyyy}", new { @class ="datepicker", @readonly="true" })
                                        </div>
                                    </div>
                                </div>


                                 <div class="row">
                                     <div class="SearchColumnbtn">
                                         <div>
                                             <input id="SearchButton" name="SearchButton" class="Greenbutton" type="submit" value="@Resources.Search" onclick="ClearSession()" />
                                             <input id="ClearButton" name="ClearButton" class="Greenbutton" type="submit" value="@Resources.Clear" onclick="ClearSession()" />
                                         </div>
                                     </div>
                                     <label id="SelectedCount_Validate" class="validationMessage"></label>
                                 </div>


                                @Html.Hidden("Count")
                            </div>
                            <div class="clear"></div>
                        </div>

                        @Html.HiddenFor(x => x.Page, new { id = "page" })

                    }

                </div>
                <div class="row">

                    <div class="standard-table">

                        @MvcHtmlString.Create(grid.GetHtml(htmlAttributes: new { id = "container-body" },
                                alternatingRowStyle: "alt",
                                columns: grid.Columns(
                                    grid.Column(columnName: "IsChecked", header: "{CheckBoxHeading}", format: (item) =>
                                        {
                                            return @Html.Raw("<input type='checkbox' class = 'select' id='IsChecked'  " + (((item.Value).IsChecked == true) ? "checked" : "") + " value=" + item.RequestId + "  /> <input type='label' id='ApproveAllFlag' hidden=hidden value = " + item.ApproveAllFlag + " />");

                                        }, style: "gridSelectCol", canSort: false),
                                    grid.Column(Resources.Context, format: @<text> <a href="@Url.Content(item.ReturnURL + "QId=" + item.RequestId.ToString())" id = 'Link' > @Html.Raw(item.ContextDescription)</a> </text>),
                                    grid.Column("ApprovalDescription", Resources.Description),
                                    grid.Column("RequestedBy", Resources.RequestedBy),
                                    grid.Column("RequestedOn", Resources.RequestedOn)
                                    //grid.Column("View", format: @<text> <a href="@Url.Content(item.ReturnURL + "QId=" + item.RequestId.ToString())" id = 'Link' > @Html.Raw("View")</a> </text>)
                                    )).ToString().Replace("{CheckBoxHeading}", "<input type='checkbox' id='allBox' style = 'gridSelectCol'/>"))

                                                
                    </div>
                    <div class="SearchColumnbtn">
                        <div>
                            <input id="AuthorizeApprovalQueue" name="Authorize" class="Greenbutton" type="button" value="@Resources.AuthorizeAll" style ="float:right; width:100px" />
                        </div>
                    </div>
                </div>
                
            </div>
            
        </div>

    </div>
    
</section>
