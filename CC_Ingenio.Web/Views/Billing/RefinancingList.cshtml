@using CC_Ingenio_Resources;
@using CC_Ingenio.Web.ViewModel.Billing

@model RefinancingSearch
@{
    var grid = new WebGrid(Model.SearchResults, canPage: true, rowsPerPage: CC_Ingenio.Common.Utils.Utils.GRD_ROWS_PER_PAGE, selectionFieldName: "", ajaxUpdateContainerId: "standard-table");
    grid.Pager(WebGridPagerModes.All);
 }


    @{
        ViewBag.Title = String.Concat(new object[] { Resources.ReFinancing, " ", Resources.Search });
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="featured">

    <div class="PageTitle">@ViewBag.Title</div>

    <!-- Tabs
	================================================== -->

    <div class="PageRow">


        <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            <li class="active"> @Html.ActionLink(Resources.SearchPageHeading,"RefinancingList","Billing" )</li>
          @*  <li> @Html.ActionLink("Details","RefinancingAdd","Billing" )</li>*@
        </ul>

        <!-- Tabs Content -->
        <div class="tabs-container">
            <div class="tab-content" id="tab1">
                <div class="row">   
                    @using (Html.BeginForm("RefinancingList", "Billing", FormMethod.Post, new { id = "frmList", name = "frmList" }))
                    {
                        <div class="SearchBox">
                            <div class="row">

                                <div class="TwoColumn">
                                    <div>
                                        <div class="label">@Resources.CardNumber</div>
                                        <div class="Field">
                                            @Html.TextBoxFor(x => x.CardNumber, new {@class="NumericOnly", maxlength=16 })
                                        </div>
                                    </div>
                                </div>     
                                <div class="TwoColumn">
                                    <div class="label">@Resources.RUT</div>
                                    <div class="Field">
                                        @Html.TextBoxFor(x => x.RUT, new { name = "RUT", id = "RUT", @class="NumberHyphen", maxlength = 10 })
                                    </div>
                                </div>
                                                                                                                              
                                <div class="SearchColumnbtn">
                                    <div class="row">
                                        <span>
                                            <input id="SearchButton" name="SearchButton" class="Greenbutton" type="submit" value="@Resources.Search" />
                                        </span>
                                        <span>
                                            <input id="Button2" type="submit" name ="ClearButton"  class="Greenbutton" value="@Resources.Clear" />
                                        </span>
                                    </div>
                                </div>

                            </div>
                            <div class="clear"></div>
                        </div>

                    }

                </div>
                <div class="row">
                   
                    <div class="standard-table">

                        @grid.GetHtml(alternatingRowStyle:"alt", columns:grid.Columns(
                            grid.Column("CardNumber",Resources.CardNumber),
                                    grid.Column("RUT", Resources.RUT),   
                                    grid.Column("CustomerSegmentName",Resources.CustomerSegment),
                                    grid.Column("CustomerSubSegmentName",Resources.CustomerSubSegment),
                                    grid.Column("CustomerCardName",Resources.CustomerCardName),
                                    grid.Column("BilledOS",Resources.BilledOS, format:@<text>@string.Format("{0:N0}",item.BilledOS)</text>, style: "gridAmountRightAlign"), 
                                    grid.Column(Resources.Edit, format: 
                                            (item) =>
                                            {
                                                return Html.Raw(Html.Raw(Html.ActionLink(Resources.Edit, "RefinancingAdd", "Billing", new { Id = item.CardNumber }, null))); 
                                            })
                    ))                

                    </div>
                </div>
            </div>


        </div>

    </div>

</section>
