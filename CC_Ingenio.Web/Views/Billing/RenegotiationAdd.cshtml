@using CC_Ingenio.DataTranfer.BillingInfo;
@using CC_Ingenio.Web.Helpers;
@using CC_Ingenio_Resources;

@{
    ViewBag.Title = String.Concat(new object[] { Resources.Add, " ", Resources.ReNegotiation });
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@model RenegotiationDTO
@{
    List<SelectListItem> TransactionCodeList = new List<SelectListItem>();
    List<string> lstPriv = new List<string>();

    foreach (var item in ViewBag.TransactionCodes)
    {
        TransactionCodeList.Add(new SelectListItem { Text = item.Text, Value = item.Value });
    }
    
    if (ViewBag.Privileges != null)
    {
        foreach (var item in ViewBag.Privileges)
        {
            lstPriv.Add(item);
        }
    }
    
}


@section featured
    {
    
    }

<style>
    input[type="text"][readonly],
    select[disabled]
    {
         background:#e9e7e7;    
    }
</style>

<script type="text/javascript">
    $(document).ready( function(){
        $("#DiscountPercentage").change(function (e) {
            $("#DiscountAmount").val(Math.round(this.value * Globalize(resourceProvider.ResourceCulture).parseInt($("#NetAmount").val()) * 0.01))
            $("#NetRenegotiatedAmount").val(Globalize(resourceProvider.ResourceCulture).parseInt($("#NetAmount").val()) - Globalize(resourceProvider.ResourceCulture).parseInt($("#DiscountAmount").val()))
            $("#NetRenegotiatedAmount").change();
            $("#DiscountAmount").change();
        });
        $("#DownPayment").change(function (e) {
            if (Globalize(resourceProvider.ResourceCulture).parseFloat($('#DownPayment').val().trim()) > Globalize(resourceProvider.ResourceCulture).parseFloat($('#GrossAmount').val().trim())) {
                $('#DownPayment_Validate').text("@Html.Raw(string.Format(Resources.MsgErrValueShouldBeLessThan,Resources.DownPayment,Resources.GrossAmount))");
                $('#DownPayment').focus();
                return false;
            }
            else
            {
                $('#DownPayment_Validate').text("");
            }
            if ($("#DownPayment").val() != "")
            {
                $("#NetAmount").val(Globalize(resourceProvider.ResourceCulture).parseInt($("#GrossAmount").val()) - Globalize(resourceProvider.ResourceCulture).parseInt($("#DownPayment").val()))
                //$("#NetAmount").val(Globalize(resourceProvider.ResourceCulture).format($("#NetAmount").val(), resourceProvider.FormatAmountJSn0))
                
            }
            
            $("#NetAmount").change();
            $("#DiscountPercentage").change();
        });
        $("#NetAmount").change(function (e) {
            FormatOnBlur(e);
            $("#NetRenegotiatedAmount").val(Globalize(resourceProvider.ResourceCulture).parseInt($("#NetAmount").val()) - Globalize(resourceProvider.ResourceCulture).parseInt($("#DiscountAmount").val()))
            $("#NetRenegotiatedAmount").change();
        });

        $("#NetRenegotiatedAmount").change(function (e) {
            FormatOnBlur(e);
            if (Globalize(resourceProvider.ResourceCulture).parseFloat($('#NetRenegotiatedAmount').val().trim()) <= parseFloat(0)) {
                $('#NetRenegotiatedAmount_Validate').text("@Html.Raw(string.Format(Resources.MsgErrValueGreaterThanZero,Resources.NetRenegotiatedAmount,"0"))");
                return false;
            }
            else {
                $('#NetRenegotiatedAmount_Validate').text("");
            }
        });

        $("#DiscountAmount").change(function (e) {
            FormatOnBlur(e);
        });

        $("#frmRenegotiationSave").submit(function (e) {

            if (Globalize(resourceProvider.ResourceCulture).parseFloat($('#DownPayment').val().trim()) > Globalize(resourceProvider.ResourceCulture).parseFloat($('#GrossAmount').val().trim())) {
                $('#DownPayment_Validate').text("@Html.Raw(string.Format(Resources.MsgErrValueShouldBeLessThan,Resources.DownPayment,Resources.GrossAmount))");
                $('#DownPayment').focus();
                e.preventDefault();
            }
            if (Globalize(resourceProvider.ResourceCulture).parseFloat($('#NetRenegotiatedAmount').val().trim()) <= parseFloat(0)) {
                $('#NetRenegotiatedAmount_Validate').text("@Html.Raw(string.Format(Resources.MsgErrValueGreaterThanZero,Resources.NetRenegotiatedAmount,"0"))");
                e.preventDefault();
            }
        });
        //$('#DownPayment').focusin(function () {
        //    $('#DownPayment_Validate').text("");
        //});
        $("#NetAmount").change();
        $('#Submit').hide();
        $('#New').hide();
    });
    
</script>

