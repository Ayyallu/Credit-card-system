                                    @Html.HiddenFor(x => x.PaymentCurrency)                                   
                                    @Html.ValidationMessageFor(x => x.PaymentCurrency)
                                </div>
                            </div>

                            <div class="TwoColumn">
                                <div class="label ">@Resources.Collector</div>
                                <div class="Field">
                                    @Html.DropDownListFor(x => x.TxnTime, CollectorCodeList)
                                    @Html.HiddenFor(x => x.TxnTime)                                   
                                    @Html.ValidationMessageFor(x => x.TxnTime)
                                </div>
                            </div>

                            @*<div class="TwoColumn">
                                <div class="label">Transaction Time</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.TxnTime, new { id = "Time", name = "Time", maxlength = 8, placeholder = "hh:mm:ss" })
                                    @Html.ValidationMessageFor(x => x.TxnTime)
                                </div>
                            </div>*@
                           @* <div class="TwoColumn">
                                <div class="label">@Resources.InstrumentNo.</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.ChequeNo, new { id = "ChequeNo", maxlength = 15 })
                                   <label id="ChequeNo_Validate" class="validationMessage"></label>
                                </div>
                            </div>*@
                        </div>

                        <div class="row">
                          
                            <div class="TwoColumn">
                                <div class="label">@Resources.PaymentAmount</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.PaymentAmount, @String.Format("{0:N0}", Model.PaymentAmount), new { @class = "NumberCommaDot", id = "PaymentAmount", maxlength = 11, @style = "text-align:right", onblur = "FormatOnBlur(event)" })
                                    @Html.ValidationMessageFor(x => x.PaymentAmount)
                                </div>
                            </div>
                             <div class="TwoColumn">
                                <div class="label">@Resources.InstrumentNo.</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.ChequeNo, new { id = "ChequeNo", maxlength = 15 })
                                   <label id="ChequeNo_Validate" class="validationMessage"></label>
                                </div>
                            </div>
                        </div>

                        @Html.HiddenFor(x => x.CardNumber)
                        @Html.HiddenFor(x => x.RUT)
                        @Html.HiddenFor(x => x.ChequeNo)

                        @Html.Raw(Html.BasicButtons(lstPriv))

                    </div>
                </div>
                 }
                 
            </div>
         </div>
</section>
