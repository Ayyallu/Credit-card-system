@using CC_Ingenio.DataTranfer.BillingInfo;
@using CC_Ingenio.Web.Helpers;
@using CC_Ingenio_Resources;

@{
    ViewBag.Title = String.Concat(new object[] { Resources.Add, " ", Resources.OnlinePayment });
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model OnlinePaymentDTO
@{
    List<SelectListItem> PaymentModeList = new List<SelectListItem>();
    List<string> lstPriv = new List<string>();

    foreach (var item in ViewBag.PaymentModes)
    {
        PaymentModeList.Add(new SelectListItem { Text = item.Text, Value = item.Value });
    }

    List<SelectListItem> CurrencyCodeList = new List<SelectListItem>();
    foreach (var item in ViewBag.CurrencyCodes)
    {
        CurrencyCodeList.Add(new SelectListItem { Text = item.Text, Value = item.Value });
    }

    List<SelectListItem> CollectorCodeList = new List<SelectListItem>();
    {
      CollectorCodeList.Add(new SelectListItem { Text = "UNIRED", Value = "97023000", Selected = true });
      CollectorCodeList.Add(new SelectListItem { Text = "CCU_CAJERO_BAE", Value = "5" });
      CollectorCodeList.Add(new SelectListItem { Text = "Cia. De Seguros Continental", Value = "96573590" });
      CollectorCodeList.Add(new SelectListItem { Text = "CCU_CAJERO", Value = "90413000" });
      CollectorCodeList.Add(new SelectListItem { Text = "BAE_MULTICANAL", Value = "4" });
      CollectorCodeList.Add(new SelectListItem { Text = "CAJA_SERVIPAG", Value = "78053790" });
      CollectorCodeList.Add(new SelectListItem { Text = "BAE_CAJATRAD", Value = "96836390" });
      CollectorCodeList.Add(new SelectListItem { Text = "BCH_BOTONPAGO", Value = "97004000" });
      CollectorCodeList.Add(new SelectListItem { Text = "BAE_BOTONPAGO", Value = "2" });
      CollectorCodeList.Add(new SelectListItem { Text = "SERVIPAG_BOTONPAGO", Value = "3" });
      CollectorCodeList.Add(new SelectListItem { Text = "SANTANDER_BOTONPAGO", Value = "97036000" });
      CollectorCodeList.Add(new SelectListItem { Text = "CCU_CAJREC", Value = "7" }); 
    }

    if (ViewBag.Privileges != null)
    {
        foreach (var item in ViewBag.Privileges)
        {
            lstPriv.Add(item);
        }
    }
    
}


@section featured
    {
    
    }


<style>
    input[type="text"][disabled],
    select[disabled]
    {
         background:#e9e7e7;    
    }
</style>


<script type ="text/javascript">



    $(document).ready(function () {
     
        $("#Time").blur(function () {
            var txnTime = $(this).val();
            if (txnTime == '__:__:__') {
                $(this).val('');
            }
            else {
                var array = txnTime.split(':');
                var newTxnTime;
                if (array[0] == '__' || array[0] == '') {
                    newTxnTime = '00';
                }
                else {
                    newTxnTime = array[0];
                }
                if (array[1] == '__' || array[1] == '') {
                    newTxnTime = newTxnTime + ':00';
                }
                else {
                    newTxnTime = newTxnTime + array[1];
                }
                if (array[2] == '__' || array[2] == '') {
                    newTxnTime = newTxnTime + ':00';
                }
                else {
                    newTxnTime = newTxnTime + array[2];
                }
                $(this).val(newTxnTime);
            }
        });


        $('#Time').mask('99:99:99');


        $('#frmOnlinePaymentSave').on('submit', function (e) {
            if ($('[id*=PaymentModeCode] option:selected').text() == "Cheque") {
                if ($('#ChequeNo').val() == "") {
                    $('#ChequeNo_Validate').text("@Html.Raw(string.Format(Resources.MsgErrPleaseEnter2,Resources.ChequeNo))");
                    e.preventDefault();
                }
            }
        });

        function loading() {
            $("div.loader").show();
        }
         
        $("#btnSearch").click(function () {
            $.ajax({
                url: "/Billing/GetParentCustomersForTransaction",
                type: "GET",
                data: { ARUT: "", ACardnumber: "", ACustomername: "" , IsLoading: false},
                cache: false,
                contenttype: "application/json ; charset = utf-8",
                success: function (data) {
                    $("#RUTCardNumberSearchDiv").html(data);
                },
                error: function (ts) { alert(ts.responseText) }
            });

            loading(); // loading
            setTimeout(function () { // then show popup, deley in .5 second
                loadPopup(); // function show popup
            }, 500); // .5 second
        })

        $('#Save').hide();
        $('#Delete').hide();
        $('#Authorize').hide();
         

        $('#ChequeNo').focusin(function () {
            $('#ChequeNo_Validate').text("");
        });


        function EnableDisableChequeNo() {
                
            $('#ChequeNo_Validate').text("");
            if ($('[id*=PaymentModeCode] option:selected').text() != "Cheque") {
                $("#ChequeNo").attr('disabled', true);
                $("#ChequeNo").val("");
            }   
            else {
                $("#ChequeNo").attr('disabled', false);
            };
        }

        $("#PaymentModeCode").change(function () {
            EnableDisableChequeNo();
        })

        EnableDisableChequeNo();


    })
</script>




<section class="featured">
     <div class="PageTitle">@ViewBag.Title</div>
     <div class="PageRow">

        <!-- Tabs Navigation -->
        <ul class="tabs-nav">
            <li> @Html.ActionLink(Resources.SearchPageHeading, "OnlinePaymentList", "Billing")</li>
            <li class="active"><a href="#tab1">@Resources.DetailsPageHeading</a></li>
        </ul>
       
            <div id="RUTCardNumberSearchDiv">
       
            </div>

            <!-- Tabs Content -->
            <div class="tabs-container">
                 @using (Html.BeginForm("OnlinePaymentSave", "Billing", FormMethod.Post, new { id = "frmOnlinePaymentSave", name = "frmOnlinePaymentSave" }))
