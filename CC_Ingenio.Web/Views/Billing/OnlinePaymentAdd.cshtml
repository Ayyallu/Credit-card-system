                                    @Html.ValidationMessageFor(x => x.CardNumber)
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="TwoColumn">
                                <div class="label">@Resources.PaymentMode</div>
                                <div class="Field">
                                    @Html.DropDownListFor(x => x.PaymentModeCode, PaymentModeList, new { id = "PaymentModeCode", name = "PaymentModeCode" })      
                                    @Html.ValidationMessageFor(x => x.PaymentModeCode)
                                </div>
                            </div>
                             <div class="TwoColumn">
                                <div class="label">@Resources.TransactionDate</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.ChequeDate, new { @class = "datepicker", id = "ChequeDate", @readonly = "true",Value = Model.ChequeDate.ToShortDateString() })
                                    @Html.ValidationMessageFor(x => x.ChequeDate)
                                </div>
                            </div>
                        </div>

                        <div class="row">
                              <div class="TwoColumn">
                                <div class="label ">@Resources.PaymentCurrency</div>
                                <div class="Field">
