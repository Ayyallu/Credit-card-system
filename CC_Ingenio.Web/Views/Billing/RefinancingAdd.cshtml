</style>

<script type="text/javascript">
    $(document).ready( function(){
        $("#DiscountPercentage").change(function (e) {
            $("#DiscountAmount").val(Math.round(this.value * Globalize(resourceProvider.ResourceCulture).parseInt($("#NetAmount").val()) * 0.01))
            $("#NetRefinancedAmount").val(Globalize(resourceProvider.ResourceCulture).parseInt($("#NetAmount").val()) - Globalize(resourceProvider.ResourceCulture).parseInt($("#DiscountAmount").val()))
            $("#NetRefinancedAmount").change();
        });
        $("#DownPayment").change(function (e) {
            if (Globalize(resourceProvider.ResourceCulture).parseFloat($('#DownPayment').val().trim()) > Globalize(resourceProvider.ResourceCulture).parseFloat($('#GrossAmount').val().trim())) {
                $('#DownPayment_Validate').text("@Html.Raw(string.Format(Resources.MsgErrValueShouldBeLessThan,Resources.DownPayment,Resources.GrossAmount))");
                $('#DownPayment').focus();
                return false;
            }
            else
            {
                $('#DownPayment_Validate').text("");
            }
            if ($("#DownPayment").val() != "") {
                $("#NetAmount").val(Globalize(resourceProvider.ResourceCulture).parseInt($("#GrossAmount").val()) - Globalize(resourceProvider.ResourceCulture).parseInt($("#DownPayment").val()))
            }
            
            $("#NetAmount").change();
        });
        $("#NetAmount").change(function (e) {
            $("#NetRefinancedAmount").val(Globalize(resourceProvider.ResourceCulture).parseInt($("#NetAmount").val()) - Globalize(resourceProvider.ResourceCulture).parseInt($("#DiscountAmount").val()))
            $("#NetRefinancedAmount").change();
        });

        $("#NetRefinancedAmount").change(function (e) {
            if (Globalize(resourceProvider.ResourceCulture).parseFloat($('#NetRefinancedAmount').val().trim()) <= parseFloat(0)) {
                $('#NetRefinancedAmount_Validate').text("@Html.Raw(string.Format(Resources.MsgErrValueGreaterThanZero,Resources.NetRefinancedAmount,"0"))");
                return false;
            }
            else {
                $('#NetRefinancedAmount_Validate').text("");
            }
        });

        $("#frmRefinancingSave").submit(function (e) {
            if (Globalize(resourceProvider.ResourceCulture).parseFloat($('#DownPayment').val().trim()) > Globalize(resourceProvider.ResourceCulture).parseFloat($('#GrossAmount').val().trim())) {
                $('#DownPayment_Validate').text("@Html.Raw(string.Format(Resources.MsgErrValueShouldBeLessThan,Resources.DownPayment,Resources.GrossAmount))");
                $('#DownPayment').focus();
                e.preventDefault();
            }
            if (Globalize(resourceProvider.ResourceCulture).parseFloat($('#NetRefinancedAmount').val().trim()) <= parseFloat(0)) {
                $('#NetRefinancedAmount_Validate').text("@Html.Raw(string.Format(Resources.MsgErrValueGreaterThanZero,Resources.NetRefinancedAmount,"0"))");
                e.preventDefault();
            }
        });
        //$('#DownPayment').focusin(function () {
        //    $('#DownPayment_Validate').text("");
        //});
        $("#NetAmount").change();
        $('#Submit').hide();
        $('#New').hide();
    });
    
</script>

