@using CC_Ingenio_Resources;
@{
    ViewBag.Title = String.Concat(new object[] { Resources.PROC_OVERDUE  });
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="http://cdnjs.cloudflare.com/ajax/libs/spin.js/1.2.7/spin.min.js"></script>

@model CC_Ingenio.DataTranfer.BillingInfo.MovementToOverdue
@{
    
    
    
}

<script>
    $(document).ready(function () {

      
        $('#ExecuteButton').click(function (e) {
            if (!Validate()) {
                return false;
            }
     
                     

            //$.ajax({
            //    url: '/Billing/ExecuteProcedureForBillingTesting/',
            //    type: 'POST',
            //    data: $('#frmtest').serialize(),
            //    cache: false,
            //    success: function (data) {
            //        ShowSimpleModalDialog(data.Message, data.RedirectUrl);
            //    }
            //});



        });
        
        function Validate() {

            //else if ($('#BillDate').val() == '' && document.getElementById("ProcName").value == 'BL') {
            //    $('#BillDate_Validate').text("Please select Billing Date");
            //    return false;
            //}
            if ($('#BillDate').val() == '' ) {
                $('#BillDate_Validate').text('@Html.Raw(String.Format(Resources.MsgErrPleaseSelect, Resources.BillDate))');
                return false;
            }
            else if ($('#ProcName').val() != '') {
                $.ajax({
                    url: '/Billing/ExecMovementtoOverdue/',
                    type: 'POST',
                    data: $('#frmtest').serialize(),
                    cache: false,
                    success: function (data) {
                        $("#loading").fadeOut(0500);
                        ShowSimpleModalDialog(data.Message, data.RedirectUrl);
                    }
                });

                
            }

            return true;
        };
        


        $(function () {
            $("ExecuteButton").click(function (e) {
                var url = $(this).attr("href");
                e.preventDefault();
                $("#dialog").dialog({
                    resizable: false,
                    height: 160,
                    modal: true,
                    title: "@Resources.ApplicationName",
                    buttons: [{
                        class: "LeftButton",
                        text: resourceProvider.Yes,
                        click: function () {

                            $.post(url, function (data) {
                                // got the result in data variable. do whatever you want now
                                //may be reload the page
                                $("#dialog").dialog("close");
                                $("#frmList").submit();

                            });
                        }},
                        {
                            text: resourceProvider.No,
                            click: function () {
                            $(this).dialog("close");
                        }
                    }]
                });

                $("#dialog").text('@Html.Raw(String.Format(Resources.MsgConfDelete))'); 

                $("#dialog").dialog("open");


            });
        });

        //$('#ImportButton').click(function (e) {
        //    alert(document.getElementById("filepath").value);
        //    e.preventDefault();
        //});

        //document.getElementById("filepath").addEventListener("change", function () { alert("hai") });

        $('#ClearButton').click(function (e) {
            $('#BillDate_Validate').text('');
            $('#ProcName_Validate').text('');
        });


    });

</script>



<style type="text/css">
    #loading
    {
        z-index: 9998;
        position: fixed;
        display: none;
        height: 100%;
        width: 100%;
        background: #000000;
        background-color: rgba(0,0,0,0.9);
        color: white;
        opacity : 0.9;
        top: 0px;
        left: 0px;
    }
  
    #loadingcontent
    {
        display:table;
        position:fixed;
        left:0;
        top:0;
        width:100%;
        height:100%;
    }
  
    #loadingspinner
    {
        display: table-cell;
        vertical-align:middle;
        width: 50%;
        text-align: center;
        font-size:larger;
        padding-top:80px;
        opacity : 10;
    }
</style>



<section class="featured">

    <div class="PageTitle">@ViewBag.Title</div>

    <!-- Tabs
	================================================== -->

    <div class="PageRow">
        
        <!-- Tabs Content -->
        <div class="tabs-container">
            <div class="tab-content" id="tab1">
                <div class="row">
                    @{Html.EnableClientValidation(true);}
                    @using (Html.BeginForm("ImportIntoPullingTable", "Billing", FormMethod.Post, new {id="frmtest", enctype = "multipart/form-data" }))
                    {
                        <div class="SearchBox">
  
                            <div class="row">
                                                                            
                                                                
                            <div class="row">
                            <div class="TwoColumn">
                                <div class="label">@Resources.CardNumber</div>
                                <div class="Field">
                                    @Html.TextBoxFor(x => x.CardNumber, new {  id = "CardNumber",  onchange="$('#BillDate_Validate').text('')" })
                                    <label id="BillDate_Validate" class="validationMessage"></label>
                                </div>
                            </div>

                            
                            </div>
                                

                                
                                                                                                                                                                                                                      
                            <div class="rowbtn">
                                <span>
                                    <input id="ExecuteButton" name="ExecuteButton" class="Greenbutton" type="button" value="@Resources.Execute" />
                                </span>
                                <span>
                                    <input id="ClearButton" type="reset" name ="ClearButton"  class="Greenbutton" value="@Resources.Clear" />
                                </span>
                            </div>

                            </div>
                            <div class="clear"></div>
                        </div>

                        <div class="row">

                        </div>
                        
                        
                        <div id="loading">
                            <div id="loadingcontent">
                            <p id="loadingspinner">
                                @Resources.MsgWaitEOD
                            </p>
                        </div>
                        </div>
                    }

                </div>
                
            </div>
            
        </div>

    </div>

</section>

