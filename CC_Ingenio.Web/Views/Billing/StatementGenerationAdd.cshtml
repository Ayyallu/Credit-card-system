	================================================== -->

    <div class="PageRow">
        <!-- Tabs Content -->
        <div class="tabs-container">
            <div class="tab-content" id="tab1">
                <div class="row">
                    @using (Html.BeginForm("StatementGenerationList", "Billing", FormMethod.Get, new { id = "frmList", name = "frmList" }))
                    {
                        <div class="SearchBox">
                            <div class="row">

                                <div class="row">
                                     <div class="TwoColumn">
                                        <div class="label">@Resources.CardNumber</div>
                                        <div class="Field">
                                            @Html.TextBoxFor(x => x.CardNumber, new { name = "CardNumber", id = "CardNumber", maxlength = 16 })
                                        </div>
                                    </div>
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.RUT</div>
                                        <div class="Field">
                                            @Html.TextBoxFor(x => x.RUT, new { name = "RUT", id = "RUT", @class="NumberHyphen", maxlength = 10 })
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="TwoColumn">
                                        <div class="label">@Resources.BillMonth</div>
                                         <div class="Field">
                                             <span>@Html.DropDownListFor(x => x.BillMonth, MonthItems.AsEnumerable(), new {id="BillMonth", @class = "inline", style="width:30%"})</span>
                                             <span><label class="inline" style="font-size:100%; padding:6% 6% 0% 4%"> @Resources.BillYear </label></span>
                                             <span>@Html.DropDownListFor(x => x.BillYear, YearItems.AsEnumerable(), new {id ="BillYear", @class = "inline", style="width:30%; float:right"})</span>
                                             <label id="SearchFilter_Validate" class="validationMessage"></label>
                                        </div>
                                    </div>
                                </div>
                                
                                
                                @Html.HiddenFor(x => x.Page, new { id = "page" })
                                @Html.Hidden("Count")

                                <div class="row">                                                                                                                      
                                    <div class="SearchColumnbtn">
                                        <span>
                                            <input id="SearchButton" name="SearchButton" class="Greenbutton" type="submit" value="@Resources.Search" />
                                        </span>

                                        <span>
                                            <input id="Button2" type="submit" name ="ClearButton"  class="Greenbutton" value="@Resources.Clear" />
                                        </span>
                                    </div>
                                    <label id="SelectedCount_Validate" class="validationMessage"></label>
                                </div>
                            </div>
                            <div class="clear"></div>
                        </div>
                        
                        
                        // We want to show this while the server process is running:
                        //<div id="divProcessing">
                            //<p>Processing, please wait . . . <img src="../Images/loading.gif"></p>
                        //</div>
                        
                        <div id="loading">
                            <div id="loadingcontent">
                            <p id="loadingspinner">
                                @Resources.MsgWaitStatementGen
                            </p>
                        </div>
                        </div>
                        
                    }

                </div>


