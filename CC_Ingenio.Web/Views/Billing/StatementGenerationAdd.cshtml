@using CC_Ingenio_Resources;
@{
    ViewBag.Title = Resources.StatementGeneration ;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using CC_Ingenio.Web.ViewModel.Billing

<script src="http://cdnjs.cloudflare.com/ajax/libs/spin.js/1.2.7/spin.min.js"></script>

@model StatementGenerationSearch
@{
    var grid = new WebGrid(Model.SearchResult, canPage: true, rowsPerPage: CC_Ingenio.Common.Utils.Utils.GRD_ROWS_PER_PAGE);
    grid.Pager(WebGridPagerModes.All);

    List<SelectListItem> MonthItems = new List<SelectListItem>();
    foreach (var itm in ViewBag.Month)
    {
        MonthItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }

    List<SelectListItem> YearItems = new List<SelectListItem>();
    foreach (var itm in ViewBag.Year)
    {
        YearItems.Add(new SelectListItem { Text = itm.Text, Value = itm.Value });
    }

    if (TempData.ContainsKey("RecCount"))
    {
        TempData["RecCount"] = ((List<CC_Ingenio.DataTranfer.BillingInfo.StatementGenerationDTO>)Session["StatementGeneration"]).Where(x => x.IsChecked == true).ToList().Count;
    }
    else
    {
        TempData.Add("RecCount", ((List<CC_Ingenio.DataTranfer.BillingInfo.StatementGenerationDTO>)Session["StatementGeneration"]).Where(x => x.IsChecked == true).ToList().Count);
    }
}

<script type="text/javascript">

    var index = 1;

    $(document).ready(function () {

        // Hide the "busy" Gif at load:
        //$("#divProcessing").hide();

        //// Attach click handler to the submit button:
        //$('#StatementGenerateButton').click(function () {
        //    $('#frmStatement').submit();
        //});


        //$("#frmStatement").on("submit", function (event) {
        //    event.preventDefault();

        //    // Show the "busy" Gif:
        //    $("#divProcessing").show();
        //    var url = $(this).attr("action");
        //    var formData = $(this).serialize();
        //    $.ajax({
        //        url: url,
        //        type: "POST",
        //        data: formData,
        //        dataType: "json",
        //        success: function (returnData) {

        //            // Hide the "busy" gif:
        //            $("#divProcessing").hide();

        //            ShowSimpleModalDialog(returnData.Message, returnData.RedirectUrl);

        //        }
        //    })
        //});


        //$("#allBox").click(function () {
   
        //    var all = $("#allBox").attr("checked") ? true : false;

        //    $(".select").attr("checked", $(this).attr("checked") ? true : false);
        //    $.ajax({
        //        url: '/Billing/UpdatingStatementGenerationSessionAll/',
        //        data: { ischecked: all },
        //        type: 'get',
        //        cache: false,
        //        contentType: 'application/json; charset=utf-8',
        //        success: function (data) {

        //        }
        //    });
        //});


        $("#allBox").click(function () {

            var pageno = $("#page").val() == "" ? 0 : $("#page").val();

            var all = $("#allBox").attr("checked") ? true : false;
            $(".select").attr("checked", $(this).attr("checked") ? true : false);

            $.ajax({
                url: '/Billing/UpdatingStatementGenerationSessionAll/',
                data: { isChecked: all, Apage: pageno },
                type: 'get',
                cache: false,
                contentType: 'application/json; charset=utf-8',
                success: function (data) {
                    $('input:hidden[name="Count"]').val(data.Count);
                    $('#SelectedCount_Validate').text("");
                }
            });
        });


        $("input.select").each(function () {
            $(this).data('row', index);
            $(this).click(function () {

                var tr = $(this).parents('tr:first');
                var CardNumber = tr.find("#CardNumber").text();

                var BillMonth = tr.find("#BillMonth").text();
                var BillYear = tr.find("#BillYear").text();

                var Isprinted = tr.find('#IsChecked').attr('checked') ? "True" : "False";
                             
                $.ajax({
                    url: '/Billing/UpdatingStatementGenerationSession/',
                    //data: { ACardNumber: CardNumber, ABillMonth: BillMonth, ABillYear:BillYear, ischecked: Isprinted },
                    data: { ACardNumber: CardNumber, IsChecked: Isprinted },
                    type: 'get',
                    cache: false,
                    contentType: 'application/json; charset=utf-8',
                    success: function (data) {
                        $('input:hidden[name="Count"]').val(data.Count);
                        $('#SelectedCount_Validate').text("");
                    }
                });
            });
            index++;
        });



        $("#SearchButton").click(function (e) {
            
            if ($('#CardNumber').val() == "" && $('#BillMonth').val() == "" && $('#BillYear').val() == "") {
                $('#SearchFilter_Validate').text("@Html.Raw(String.Format(Resources.MsgErrPleaseSelect, Resources.SearchCriteria))");
                            e.preventDefault;
                            return false;
            }

            $.ajax({
                type: 'POST',
                url: '/Billing/DeletingSessionData',
                success: function (returnData) {

                    if (returnData.RedirectUrl.length > 0) {

                        window.location.href = returnData.RedirectUrl;
                        return true;
                    }
                }
            });
        });
        
        $(function () {
            $("#BillMonth").change(function () {
                $('#SearchFilter_Validate').text("");
            });
        });

        $(function () {
            $("#BillYear").change(function () {
                $('#SearchFilter_Validate').text("");
            });
        });
        
        $('#CardNumber').focusin(function () {
            $('#SearchFilter_Validate').text("");
        });
        
        $("#StatementGenerateButton").click(function (e) {
                        
            var RecCount = $('input:hidden[name="Count"]').val();
            if (!RecCount)
                RecCount = '@TempData["RecCount"]';

            if (!RecCount || RecCount == 0) {
@*                $('#SelectedCount_Validate').text("@Html.Raw(string.Format(Resources.MsgErrPleaseSelect,Resources.AtleastOneRecord))");*@
                ShowSimpleModalDialog("@Html.Raw(string.Format(Resources.MsgErrPleaseSelect,Resources.AtleastOneRecord))", "");
                return false;
            };

            $("#dialog").dialog({
                resizable: false,
                width: 400,
                height: 160,
                modal: true,
                title: resourceProvider.ApplicationName,
                buttons: [{
                    class: "LeftButton",
                    text: resourceProvider.Yes,
                    click: function () {

                        $("#loading").fadeIn(0500);
                        var opts = {
                            lines: 12, // The number of lines to draw
                            length: 7, // The length of each line
                            width: 4, // The line thickness
                            radius: 10, // The radius of the inner circle
                            color: '#FFFFFF', // #rgb or #rrggbb
                            speed: 1, // Rounds per second
                            trail: 60, // Afterglow percentage
                            shadow: false, // Whether to render a shadow
                            hwaccel: false // Whether to use hardware acceleration
                        };
                        var target = document.getElementById('loading');
                        var spinner = new Spinner(opts).spin(target);

                        $.ajax({
                            url: '/Billing/GenerateReport/',
                            type: 'POST',
                            data: $('#frmList').serialize(),
                            cache: false,
                            success: function (data) {
                                //$("#SearchButton").click();
                                $("#loading").fadeOut(0500);
                                ShowSimpleModalDialog("@Html.Raw(String.Format(Resources.MsgInfoStatementGenSuccess,Resources.Statement))", "/Billing/StatementGenerationList/");
                }
            });

                        $(this).dialog("close");
                    }
                },
                {
                    text: resourceProvider.No,
                    click: function () {
                        $(this).dialog("close");
                    }
                }]
            });

            $("#dialog").text(resourceProvider.MsgConfGenerate);

            $("#dialog").dialog("open");

                        

        });
        
    });

</script>




<style type="text/css">
    #loading
    {
        z-index: 9998;
        position: fixed;
        display: none;
        height: 100%;
        width: 100%;
        background: #000000;
        background-color: rgba(0,0,0,0.9);
        color: white;
        opacity : 0.9;
        top: 0px;
        left: 0px;
    }
  
    #loadingcontent
    {
        display:table;
        position:fixed;
        left:0;
        top:0;
        width:100%;
        height:100%;
    }
  
    #loadingspinner
    {
        display: table-cell;
        vertical-align:middle;
        width: 50%;
        text-align: center;
        font-size:larger;
        padding-top:80px;
        opacity : 10;
    }
</style>

<style>
        input[type=checkbox] {
        border:none;
